; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pigeon Simulator"
config/description="Third-person pigeon flight sim: eat bread to survive, earn points pooping on tourists and their cars."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.16, 0.22, 0.33, 1)
boot_splash/show_image=false

[autoload]

MCPRuntimeProbe="*res://addons/godot_mcp/mcp_runtime_probe.gd"
Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"
CaptureRecorder="*res://tests/capture_recorder.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

