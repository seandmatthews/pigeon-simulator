		var venue := str(rec["venue"])
		if not venue in names:
			bad.append("%s name not in the VENUES Tier-1 set" % id)
		var poi: Dictionary = tier1.get(id, {})
		if poi.is_empty():
			bad.append("%s is not a pack tier-1 venue POI" % id)
			continue
		if str(poi.get("name", "")) != venue:
			bad.append("%s text '%s' != pack name '%s'" % [id, venue,
					str(poi.get("name", ""))])
		var sign: SignText = rec["node"]
		if sign == null or not is_instance_valid(sign):
			bad.append("%s record node is gone" % id)
			continue
		if sign.display_text() != venue:
			bad.append("%s display '%s' want '%s'" % [id, sign.display_text(), venue])
		## Placement rides the pinned mount (the records ARE the mounts); the
		## cart's record node is cart-local, so the cart root carries the mount.
		var mount_node: Node3D = sign
		if str(rec["form"]) == "cart":
			mount_node = sign.get_parent()
		if mount_node.position.distance_to(rec["pos"] as Vector3) > 0.001:
			bad.append("%s node drifted off its mount" % id)
		## The budget law: readable_distance == letter × the typology's factor.
		var letter := float(rec["letter"])
		if absf(sign.effective_letter_height() - letter) > 0.0001:
			bad.append("%s letter %.3f != pinned %.3f" % [id,
					sign.effective_letter_height(), letter])
		var budget := float(SignText.SPEC[sign.typology]["budget"])
		if not is_equal_approx(sign.readable_distance(), letter * budget):
			bad.append("%s readable %.2f want %.2f" % [id, sign.readable_distance(),
					letter * budget])
		## The band override rides the record.
		if (sign.body_scale - (rec["band"] as Vector3)).length() > 0.0001:
			bad.append("%s body_scale %s want %s" % [id, sign.body_scale,
					rec["band"]])
		## Visual-only law: no collision anywhere under the sign (or its cart).
		if _has_collision(sign) or _has_collision(sign.get_parent()):
			bad.append("%s carries collision (visual-only law)" % id)
		## The overflow fit law — what the component warns past, pre-computed:
		## string width at the cap ≤ face width − 0.2 (blades: widest glyph).
		var px := letter / (float(SignText.FONT_SIZE_PX) * SignText.CAP_HEIGHT_EM)
		var face_w := (sign.body_scale if sign.body_scale != Vector3.ZERO
				else SignText.SPEC[sign.typology]["body"] as Vector3).x
		if sign.typology == SignText.Typology.BLADE:
			face_w = (SignText.SPEC[SignText.Typology.BLADE]["body"]
					as Vector3).z
		var widest := venue
		if sign.typology == SignText.Typology.BLADE:
			widest = ""
			for c2: String in venue:
				if SignText.FONT.get_string_size(c2, HORIZONTAL_ALIGNMENT_LEFT,
						-1, SignText.FONT_SIZE_PX).x \
						> SignText.FONT.get_string_size(widest,
						HORIZONTAL_ALIGNMENT_LEFT, -1, SignText.FONT_SIZE_PX).x:
					widest = c2
		var width := SignText.FONT.get_string_size(widest,
				HORIZONTAL_ALIGNMENT_LEFT, -1, SignText.FONT_SIZE_PX).x * px
		if width > face_w - 0.2:
			bad.append("%s lettering %.2f m overflows its %.2f m face" % [id,
					width, face_w])
		## The mount legs — against the committed bake body + the pack.
		var form := str(rec["form"])
		var face := str(rec["face"])
		var yaw := float(rec["yaw"])
		var want_yaw := 0.0
		if face == "poi":
			## Free-standing forms stand at the pack POI, yawed onto the
			## pack's verified facing — the facing vector IS the check.
			var n := AmesVenueSigns._facing_normal(float(poi["facing_deg"]))
			want_yaw = atan2(n.x, n.z)
			if (rec["pos"] as Vector3).distance_to(Vector3(
					float((poi["position"] as Array)[0]), 0.0,
					float((poi["position"] as Array)[1]))) > 0.02:
				bad.append("%s not at its pack POI position" % id)
		else:
			## Wall mounts hang on the pinned bake body's face plane,
			## re-derived here from the committed chunk files.
			var parts := (str(rec["body"]) as String).split(":")
			var body: Dictionary = bodies.get(str(rec["body"]), {})
			if body.is_empty():
				bad.append("%s bake body %s not in the committed chunks" % [id,
						rec["body"]])
				continue
			var bp: Array = body["p"]
			var bs: Array = body["s"]
			var band: Vector3 = rec["band"]
			var size: Vector3 = band if band != Vector3.ZERO \
					else SignText.SPEC[AmesVenueSigns._typology_of(rec)]["body"]
			var stand := size.z * 0.5 + AmesVenueSigns.WALL_GAP
			if form == "blade":
				stand = AmesVenueSigns.BLADE_STANDOFF
			var u := float(rec["wall_u"])
			var y := float(rec["mount_y"])
			var want_pos := Vector3.ZERO
			match face:
				"E":
					want_pos = Vector3(float(bp[0]) + float(bs[0]) * 0.5
							+ stand, y, u)
					want_yaw = atan2(1.0, 0.0)
				"W":
					want_pos = Vector3(float(bp[0]) - float(bs[0]) * 0.5
							- stand, y, u)
					want_yaw = atan2(-1.0, 0.0)
				"N":
					want_pos = Vector3(u, y, float(bp[2]) - float(bs[2]) * 0.5
							- stand)
					want_yaw = atan2(0.0, -1.0)
				_:
					want_pos = Vector3(u, y, float(bp[2]) + float(bs[2]) * 0.5
							+ stand)
					want_yaw = atan2(0.0, 1.0)
			if (rec["pos"] as Vector3).distance_to(want_pos) > 0.02:
				bad.append("%s mount %s off the re-derived wall mount %s"
						% [id, rec["pos"], want_pos])
			## The band fits the wall it hangs on: along-wall extent inside
			## the face span, mount below the body top.
			var along := face in ["E", "W"]
			var half_wall := float(bs[2]) * 0.5 if along else float(bs[0]) * 0.5
			var center_u := float(bp[2]) if along else float(bp[0])
			if absf(u - center_u) + size.x * 0.5 > half_wall:
				bad.append("%s band exceeds its face span" % id)
			if y > float(bp[1]) + float(bs[1]) * 0.5 + 0.01:
				bad.append("%s mounts above its body top" % id)
		if absf(wrapf(yaw - want_yaw, -PI, PI)) > 0.02:
			bad.append("%s yaw %.3f want %.3f" % [id, yaw, want_yaw])
		## The facing hemisphere: the mounted facing looks at the venue's own
		## POI facing (the Sips override rides this too — 181.3 vs west is
		## still the front half-space; the note in the table documents it).
		var rad := deg_to_rad(float(poi["facing_deg"]))
		var poi_n := Vector3(sin(rad), 0.0, -cos(rad))
		var mount_n := Vector3(sin(yaw), 0.0, cos(yaw))
		if mount_n.dot(poi_n) <= 0.0:
			bad.append("%s sign faces away from its venue" % id)
		## The street frontage: the venue's survey street is the nearest named
		## street IN FRONT of the sign, at a sidewalk-frontage distance.
		var street := AmesDataPack.nearest_street(rec["pos"] as Vector3)
		var want_street := str(frontage.get(id, ""))
		if street.is_empty() or str(street["name"]) != want_street:
			bad.append("%s frontage '%s' want '%s'" % [id,
					str(street.get("name", "<none>")), want_street])
			continue
		var d := float(street["distance_m"])
		if id == "hickory_park":
			## (T-204 re-pin) The landed-lot frontage read: the pylon stands
			## the building's north face at the lot's NE station, past the
			## parking field — Meadow Lane Court fronts at lot distance
			## (24.9 m measured), not at a storefront walk.
			if d < 20.0 or d > 70.0:
				bad.append("hickory_park lot frontage %.0f m — expected the "
					+ "landed-lot band [20, 70]" % d)
		elif id == "the_cafe":
			## (T-205) The tight-lot frontage read: Northridge Parkway runs
			## ~1.4 m north of the building's own north wall (the centerline
			## rides the frontage), so the sign hangs just off the street.
			if d < 1.0 or d > 30.0:
				bad.append("the_cafe tight frontage %.1f m — expected the "
					+ "frontage-wall band [1, 30]" % d)
		elif id == "superdog":
			## The cart's curb read: the pack's hand-placed 208-Welch position
			## sits at the EAST carriageway of the 200 block's divided section
			## (Welch maps as two one-way polylines through z 150..185), 1.3 m
			## off that carriageway's centerline — the curb the cart parks on.
			## Upper band only; the facing leg below carries the street read.
			if d > 30.0:
				bad.append("superdog curb distance %.1f m past the band" % d)
		elif d < 4.0 or d > 30.0:
			bad.append("%s frontage distance %.1f m off the sidewalk band" % [id, d])
		var to_street: Vector3 = street["point"] - (rec["pos"] as Vector3)
		to_street.y = 0.0
		to_street = to_street.normalized()
		## (T-205) The Cafe's facing floor relaxes to 0.75: Northridge's
		## nearest centerline point carries the street's ENE drift at the
		## frontage (measured dot 0.81), the wall still aims at the street.
		var face_floor := 0.75 if id == "the_cafe" else 0.9
		if mount_n.dot(to_street) < face_floor:
			bad.append("%s does not face its street (dot %.3f)" % [id,
					mount_n.dot(to_street)])
	## The night-lit acceptance sign: Welch Ave Station — the big band, lit.
	for rec: Dictionary in records:
		if str(rec["id"]) != "welch_ave_station":
			continue
		if str(rec["form"]) != "box":
			bad.append("welch_ave_station form %s want box" % rec["form"])
		if (rec["band"] as Vector3) != Vector3(8.4, 1.3, 0.35) \
				or not is_equal_approx(float(rec["letter"]), 0.80):
			bad.append("welch_ave_station band/letter off the pinned values")
		var body_mesh: MeshInstance3D = null
		for c3: Node in (rec["node"] as SignText).get_children():
			if c3.name == "Body" and c3 is MeshInstance3D:
				body_mesh = c3
		if body_mesh == null or body_mesh.mesh == null:
			bad.append("welch_ave_station body mesh missing")
		else:
			var mat := body_mesh.mesh.surface_get_material(0) as StandardMaterial3D
			if mat == null or not mat.emission_enabled \
					or mat.emission_energy_multiplier <= 0.0:
				bad.append("welch_ave_station band is not night-lit")
	## The placed The Cafe (T-205): the sign is LIVE on its own building's
	## north wall — the mount re-derives against the committed chunk massing
	## like every other wall mount, at the pack POI's z along the wall.
	var cafe_rec: Dictionary = {}
	for rec: Dictionary in records:
		if str(rec["id"]) == "the_cafe":
			cafe_rec = rec
	if cafe_rec.is_empty():
		bad.append("the_cafe produced no placed record (the T-205 placement)")
	else:
		if str(cafe_rec.get("body", "")) != "massing:way/114039922":
			bad.append("the_cafe body %s != its own building's massing"
					% str(cafe_rec.get("body", "")))
		var cafe_body: Dictionary = _venue_bake_bodies(
				[str(cafe_rec.get("body", ""))]).get("massing:way/114039922", {})
		if cafe_body.is_empty():
			bad.append("the_cafe bake body missing from the committed chunks")
		else:
			var bp: Array = cafe_body["p"]
			var bs: Array = cafe_body["s"]
			var cafe_stand: float = SignText.SPEC[SignText.Typology.PLAQUE]["body"].z \
					* 0.5 + AmesVenueSigns.WALL_GAP
			var want_z: float = float(bp[2]) - float(bs[2]) * 0.5 - cafe_stand
			var cafe_pos: Vector3 = cafe_rec["pos"]
			if absf(cafe_pos.z - want_z) > 0.05 \
					or absf(cafe_pos.x - 536.49) > 0.05 \
					or absf(cafe_pos.y - 5.4) > 0.05:
				bad.append("the_cafe mount %s != the north wall at wall_u "
						+ "536.49 (face plane %.2f)" % [cafe_pos, want_z])
	## The Superdog cart: the one PROP — parts, the red umbrella, its sign.
	for rec: Dictionary in records:
		if str(rec["id"]) != "superdog":
			continue
		if not rec.has("cart_parts") or int(rec["cart_parts"]) < 8:
			bad.append("superdog cart parts %s want >= 8" % str(rec.get("cart_parts")))
		var cart := (rec["node"] as SignText).get_parent()
		var canopy: MeshInstance3D = null
		for c5: Node in cart.get_children():
			if c5.name == "Canopy" and c5 is MeshInstance3D:
				canopy = c5
		if canopy == null or canopy.mesh == null:
			bad.append("superdog umbrella missing")
		else:
			var cm := canopy.mesh.surface_get_material(0) as StandardMaterial3D
			if cm == null or cm.albedo_color.r < 0.5 or cm.albedo_color.g > 0.3:
				bad.append("superdog umbrella is not the red read")
	## The world report keys.
	var report: Dictionary = world.last_report
	if int(report.get("venue_signs", -1)) != 14:
		bad.append("report venue_signs %s want 14 (T-205 placed the_cafe)" % str(report.get("venue_signs")))
	if int(report.get("superdog_cart_parts", -1)) < 8:
		bad.append("report superdog_cart_parts %s" % str(report.get("superdog_cart_parts")))
	_check(S, bad.is_empty(), "; ".join(bad) if not bad.is_empty() else "-")


## One walk of the committed chunk files, returning every referenced bake body
## (placeholder or massing) by its "kind:id" selector — the venue-sign mounts'
## independent derivation leg.
func _venue_bake_bodies(selectors: Array[String]) -> Dictionary:
	var out: Dictionary = {}
	var want: Dictionary = {}
	for s: String in selectors:
		want[s] = true
	var manifest: Dictionary = AmesBaker.read_manifest(AMES_CHUNKS_DIR)
	for entry: Dictionary in manifest.get("chunks", []):
		if want.is_empty():
			break
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR,
				str(entry["file"]))
		for ph: Dictionary in doc.get("placeholders", []):
			var key := "placeholder:%s" % str(ph.get("id", ""))
			if want.has(key):
				out[key] = ph
				want.erase(key)
		for m: Dictionary in doc.get("massing", []):
			var key := "massing:%s" % str(m.get("id", ""))
			if want.has(key):
				out[key] = m
				want.erase(key)
	return out


## T-199 — the tiers 2–3 venue signs + the mourned ghost plaques, live on the
## resident Ames world: 27 signed venues (15 of the 17 Tier-2 POIs + 12 of the
## 17 Tier-3 POIs) under `VenueSignsTiers` and 11 memorial plaques (the §6
## closed venues whose rooms the committed bake pins) under `GhostPlaques`.
## Every leg re-derives independently of the module tables: the mounts against
## the COMMITTED bake bodies (the chunk files walked here) and the pack POIs,
## the texts exact-matched against the survey names AND the pack names, the
## street frontage against the pack street graph BY THE SURVEY STREET NAME
## (corner venues: the nearest street overall can be the cross street — the
## survey street is the pinned frontage), the budget law through the
## component, the overflow fit law, the memorial styling constants (unlit
## bronze at ground floor), and the visual-only guard. The unsigned tier-2/3
## set is pinned too: pack POIs minus the signed tables == `UNSIGNED_T23`'s
## keys, so an unsigned venue can never silently appear or vanish.
## Law shape vs the tier-1 row (recorded): the tier-2/3 POI facings carry more
## nearest_street artifacts (facing_src snaps to the street's DIRECTION, e.g.
## BNC 1.3 / Time Out 89.3 while their walls front Welch/Kellogg), so for WALL
## mounts the orientation pin is the frontage law itself (the sign faces its
## survey street, dot ≥ 0.9) and the POI-facing hemisphere applies only to the
## free-standing forms whose yaw IS the POI facing.
func _scenario_venue_signs_tiers() -> void:
	const S := "venue_signs_tiers"
	var bad: PackedStringArray = []
	## The VENUES.md §2/§3 heading names — the byte-exact sign texts (the
	## exact-match law), typed here from the survey doc.
	var names_t2: Array[String] = [
		"Mother's Pub & Coffee", "Thumbs", "West Street Deli", "BNC Field House",
		"Blue Owl Bar", "Cornbred Barbecue", "Whiskey River",
		"London Underground", "Time Out", "The Mucky Duck Pub",
		"Torrent Brewing Company", "Aunt Maude's", "The Grove Cafe",
		"Provisions Lot F", "The Stan Tap", "Sam's Place",
		"Lost and Found Lounge",
	]
	var names_t3: Array[String] = [
		"Stomping Grounds Cafe", "Clouds", "Labyrinth Coffee",
		"Ichiban Japanese Restaurant", "Blue Fish Poke Bowl", "Macubana",
		"Dogtown University", "Thai Kitchen", "Szechuan House",
		"888 Restaurant", "El Azteca", "Carlos Quesadilla",
		"Iowa State Creamery", "Perfect Games", "Whatcha Smokin' BBQ",
		"Morning Bell Coffee Roasters", "Cafe Diem",
	]
	## The §6 plaque texts — the mourned CLOSED venues whose rooms the bake
	## pins (the year rides only where the survey pins a closure year).
	var plaque_texts: Array[String] = [
		"Es Tas Bar & Grill — 2024", "Wise Guys", "Little Taipei — 2024",
		"Fighting Burrito — 2019", "The Scene", "Café Mood",
		"DG's Tap House + Corner Pocket — 2019", "Olde Main Brewing — 2019",
		"Legends — 2012", "Battle's Bar-B-Q — 2009",
		"The Angry Irishmen — 2025",
	]
	## The survey street each venue fronts (pack street names — the frontage
	## legs read the graph BY THIS NAME).
	var frontage: Dictionary = {
		"mothers_pub_coffee": "West Street", "thumbs": "West Street",
		"west_street_deli": "West Street", "bnc_field_house": "Welch Avenue",
		"blue_owl_bar": "Welch Avenue", "cornbred_barbecue": "Main Street",
		"whiskey_river": "Main Street", "london_underground": "Main Street",
		"time_out": "Kellogg Avenue", "torrent_brewing": "Burnett Avenue",
		"aunt_maudes": "Main Street", "grove_cafe": "Main Street",
		"the_stan_tap": "Stanton Avenue", "sams_place": "Main Street",
		"stomping_grounds": "Welch Avenue", "clouds": "Stanton Avenue",
		"ichiban": "Welch Avenue", "blue_fish_poke": "Welch Avenue",
		"macubana": "Welch Avenue", "dogtown_university": "Welch Avenue",
		"thai_kitchen": "Chamberlain Street", "morning_bell": "Main Street",
		"cafe_diem": "Main Street",
		"little_taipei": "Chamberlain Street",
		"fighting_burrito": "Welch Avenue",
		"the_scene": "Welch Avenue", "cafe_mood": "Welch Avenue",
		"dgs_tap_house": "Main Street",
		"olde_main_brewing": "Main Street",
		"legends": "Stanton Avenue",
		"battles_bar_b_q": "Hayward Avenue",
		"angry_irishmen": "Main Street",
		"es_tas_bar_grill": "Welch Avenue",
		"wise_guys": "Welch Avenue",
	}
	## Frontage exceptions (the honest reads, each derived on the ticket):
	## "apron" — the free-standing pylon stands past the bake core at the
	## verified POI (the Hickory rule); "setback" — the depot fronts Main
	## across its 56 m set-back; "interior" — no survey street exists in the
	## graph where the mount stands (stadium interior / campus interior), the
	## POI-position/facing law carries it.
	var frontage_kind: Dictionary = {
		"provisions_lot_f": "apron", "szechuan_house": "apron",
		"cornbred_barbecue": "setback",
		"carlos_quesadilla": "interior", "isu_creamery": "interior",
	}
	var world := _city as AmesWorld
	if world == null:
		_check(S, false, "the harness world is not an AmesWorld")
		return
	## Table shape: 15 + 12 signed, 11 plaques, no staged entries in either.
	if AmesVenueSigns.SIGNS_T2.size() != 15:
		bad.append("SIGNS_T2 %d entries want 15" % AmesVenueSigns.SIGNS_T2.size())
	if AmesVenueSigns.SIGNS_T3.size() != 12:
		bad.append("SIGNS_T3 %d entries want 12" % AmesVenueSigns.SIGNS_T3.size())
	if AmesVenueSigns.PLAQUES.size() != 11:
		bad.append("PLAQUES %d entries want 11" % AmesVenueSigns.PLAQUES.size())
	var tier2: Dictionary = {}
	var tier3: Dictionary = {}
	for p: Dictionary in AmesDataPack.pois():
		if str(p.get("kind", "")) != "venue":
			continue
		if int(p.get("tier", -1)) == 2:
			tier2[str(p.get("id", ""))] = p
		elif int(p.get("tier", -1)) == 3:
			tier3[str(p.get("id", ""))] = p
	if tier2.size() != 17 or tier3.size() != 17:
		bad.append("pack tier-2/3 venues %d/%d want 17/17" % [tier2.size(), tier3.size()])
	## The unsigned set is closed: POI ids minus the signed tables must equal
	## `UNSIGNED_T23` exactly — no silent gaps in either direction.
	var signed_ids: Dictionary = {}
	for e: Dictionary in AmesVenueSigns.SIGNS_T2 + AmesVenueSigns.SIGNS_T3:
		signed_ids[str(e["id"])] = true
	var unsigned: Dictionary = {}
	for id: String in tier2:
		if not signed_ids.has(id):
			unsigned[id] = true
	for id: String in tier3:
		if not signed_ids.has(id):
			unsigned[id] = true
	if unsigned.size() != AmesVenueSigns.UNSIGNED_T23.size():
		bad.append("unsigned set %d want %d" % [unsigned.size(),
				AmesVenueSigns.UNSIGNED_T23.size()])
	else:
		for id: String in unsigned:
			if not AmesVenueSigns.UNSIGNED_T23.has(id):
				bad.append("unsigned %s not recorded in UNSIGNED_T23" % id)
			elif str(AmesVenueSigns.UNSIGNED_T23[id]).is_empty():
				bad.append("unsigned %s carries no reason" % id)
	var records := world.venue_signs_t23
	var plaques := world.ghost_plaques
	if records.size() != 27:
		bad.append("placed tier records %d want 27" % records.size())
	if plaques.size() != 11:
		bad.append("plaque records %d want 11" % plaques.size())
	var tiers_root := world.get_node_or_null("VenueSignsTiers") as Node3D
	var plaque_root := world.get_node_or_null("GhostPlaques") as Node3D
	if tiers_root == null or plaque_root == null:
		bad.append("missing VenueSignsTiers/GhostPlaques roots")
		tiers_root = tiers_root if tiers_root != null else Node3D.new()
		plaque_root = plaque_root if plaque_root != null else Node3D.new()
	## One walk of the committed chunks collects every mount body both record
	## sets reference — the mounts re-derive against these.
	var selectors: Array[String] = []
	for rec: Dictionary in records + plaques:
		var sel := str(rec["body"])
		if sel != "" and not sel in selectors:
			selectors.append(sel)
	var bodies := _venue_bake_bodies(selectors)
	var tier_nodes: Array[SignText] = []
	var plaque_nodes: Array[SignText] = []
	var truck_roots := 0
	for c: Node in tiers_root.get_children():
		if c.name.begins_with("Truck_"):
			truck_roots += 1
	for c: Node in tiers_root.find_children("*", "SignText", true, false):
		tier_nodes.append(c)
	for c: Node in plaque_root.find_children("*", "SignText", true, false):
		plaque_nodes.append(c)
	## The truck's topper rides INSIDE its truck root; the other 26 sign
	## faces stand alone.
	if tier_nodes.size() != 27:
		bad.append("world tier sign nodes %d want 27" % tier_nodes.size())
	if plaque_nodes.size() != 11:
		bad.append("world plaque nodes %d want 11" % plaque_nodes.size())
	if truck_roots != 1:
		bad.append("world truck roots %d want 1" % truck_roots)
	## The packs of names the tables must stay inside.
	var all_names: Dictionary = {}
	for n: String in names_t2 + names_t3:
		all_names[n] = true
	var plaque_set: Dictionary = {}
	for n: String in plaque_texts:
		plaque_set[n] = true
	var pack_names: Dictionary = {}
	for p: Dictionary in tier2.values() + tier3.values():
		pack_names[str(p.get("name", ""))] = true
	## Per-record legs (shared by the tier signs and the plaques).
	for is_plaque: bool in [false, true]:
		var rec_set: Array[Dictionary] = plaques if is_plaque else records
		for rec: Dictionary in rec_set:
			var id := str(rec["id"])
			var venue := str(rec["venue"])
			var form := str(rec["form"])
			var face := str(rec["face"])
			var yaw := float(rec["yaw"])
			var sign: SignText = rec["node"]
			if sign == null or not is_instance_valid(sign):
				bad.append("%s record node is gone" % id)
				continue
			if sign.display_text() != venue:
				bad.append("%s display '%s' want '%s'" % [id, sign.display_text(), venue])
			if is_plaque:
				if not plaque_set.has(venue):
					bad.append("%s text not a pinned plaque text: %s" % [id, venue])
			else:
				if not all_names.has(venue):
					bad.append("%s name not in the VENUES Tier-2/3 set" % id)
				if not pack_names.has(venue):
					bad.append("%s text not a pack tier-2/3 POI name" % id)
			## Placement rides the pinned mount; the truck's record node is
			## truck-local, so the truck root carries the mount.
			var mount_node: Node3D = sign
			if form == "truck":
				mount_node = sign.get_parent()
			if mount_node.position.distance_to(rec["pos"] as Vector3) > 0.001:
				bad.append("%s node drifted off its mount" % id)
			## The budget law: readable_distance == letter × the typology's
			## factor; the letter rides the pin.
			var letter := float(rec["letter"])
			if absf(sign.effective_letter_height() - letter) > 0.0001:
				bad.append("%s letter %.3f != pinned %.3f" % [id,
						sign.effective_letter_height(), letter])
			var budget := float(SignText.SPEC[sign.typology]["budget"])
			if not is_equal_approx(sign.readable_distance(), letter * budget):
				bad.append("%s readable %.2f want %.2f" % [id,
						sign.readable_distance(), letter * budget])
			## The band override rides the record.
			if (sign.body_scale - (rec["band"] as Vector3)).length() > 0.0001:
				bad.append("%s body_scale %s want %s" % [id, sign.body_scale,
						rec["band"]])
			## Visual-only law: no collision anywhere under the sign (or its
			## truck).
			if _has_collision(sign) or _has_collision(sign.get_parent()):
				bad.append("%s carries collision (visual-only law)" % id)
			## The overflow fit law, pre-computed: string width at the cap
			## ≤ face width − 0.2.
			var px := letter / (float(SignText.FONT_SIZE_PX) * SignText.CAP_HEIGHT_EM)
			var face_w := (sign.body_scale if sign.body_scale != Vector3.ZERO
					else SignText.SPEC[sign.typology]["body"] as Vector3).x
			var width := SignText.FONT.get_string_size(venue,
					HORIZONTAL_ALIGNMENT_LEFT, -1, SignText.FONT_SIZE_PX).x * px
			if width > face_w - 0.2:
				bad.append("%s lettering %.2f m overflows its %.2f m face" % [id,
						width, face_w])
			## The mount legs — against the committed bake body + the pack.
			var want_yaw := 0.0
			if face == "poi":
				## Free-standing forms stand at the pack POI, yawed onto the
				## pack's verified facing — the facing vector IS the check,
				## and the POI-facing hemisphere rides it by construction.
				var poi: Dictionary = tier2.get(id, {}) if tier2.has(id) \
						else tier3.get(id, {})
				if poi.is_empty():
					bad.append("%s is not a pack tier-2/3 venue POI" % id)
					continue
				if str(poi.get("name", "")) != venue:
					bad.append("%s text '%s' != pack name '%s'" % [id, venue,
							str(poi.get("name", ""))])
				var n := AmesVenueSigns._facing_normal(float(poi["facing_deg"]))
				want_yaw = atan2(n.x, n.z)
				if (rec["pos"] as Vector3).distance_to(Vector3(
						float((poi["position"] as Array)[0]), 0.0,
						float((poi["position"] as Array)[1]))) > 0.02:
					bad.append("%s not at its pack POI position" % id)
			else:
				## Wall mounts hang on the pinned bake body's face plane,
				## re-derived here from the committed chunk files.
				var body: Dictionary = bodies.get(str(rec["body"]), {})
				if body.is_empty():
					bad.append("%s bake body %s not in the committed chunks"
							% [id, rec["body"]])
					continue
				var bp: Array = body["p"]
				var bs: Array = body["s"]
				var band: Vector3 = rec["band"]
				var size: Vector3 = band if band != Vector3.ZERO \
						else SignText.SPEC[AmesVenueSigns._typology_of(rec)]["body"]
				var stand := size.z * 0.5 + AmesVenueSigns.WALL_GAP
				var u := float(rec["wall_u"])
				var y := float(rec["mount_y"])
				var want_pos := Vector3.ZERO
				match face:
					"E":
						want_pos = Vector3(float(bp[0]) + float(bs[0]) * 0.5
								+ stand, y, u)
						want_yaw = atan2(1.0, 0.0)
					"W":
						want_pos = Vector3(float(bp[0]) - float(bs[0]) * 0.5
								- stand, y, u)
						want_yaw = atan2(-1.0, 0.0)
					"N":
						want_pos = Vector3(u, y, float(bp[2]) - float(bs[2]) * 0.5
								- stand)
						want_yaw = atan2(0.0, -1.0)
					_:
						want_pos = Vector3(u, y, float(bp[2]) + float(bs[2]) * 0.5
								+ stand)
						want_yaw = atan2(0.0, 1.0)
				if (rec["pos"] as Vector3).distance_to(want_pos) > 0.02:
					bad.append("%s mount %s off the re-derived wall mount %s"
							% [id, rec["pos"], want_pos])
				## The band fits the wall it hangs on: along-wall extent
				## inside the face span, mount below the body top.
				var along := face in ["E", "W"]
				var half_wall := float(bs[2]) * 0.5 if along else float(bs[0]) * 0.5
				var center_u := float(bp[2]) if along else float(bp[0])
				if absf(u - center_u) + size.x * 0.5 > half_wall:
					bad.append("%s band exceeds its face span" % id)
				if y > float(bp[1]) + float(bs[1]) * 0.5 + 0.01:
					bad.append("%s mounts above its body top" % id)
			if absf(wrapf(yaw - want_yaw, -PI, PI)) > 0.02:
				bad.append("%s yaw %.3f want %.3f" % [id, yaw, want_yaw])
			## The street frontage: the venue's SURVEY street is the frontage
			## street (by name), in front of the sign, at its pinned band.
			## The apron reads (the out-of-core pylons) assert the honest
			## absence instead: NO graph street within 100 m (the Hickory
			## rule's out-of-core half).
			var kind := str(frontage_kind.get(id, "band"))
			if kind == "interior":
				pass ## No survey street exists here — the facing law carries.
			elif kind == "apron":
				var apron := AmesDataPack.nearest_street(rec["pos"] as Vector3)
				if not apron.is_empty() \
						and float(apron["distance_m"]) < 100.0:
					bad.append("%s apron frontage %.0f m — expected the "
							+ "out-of-core read (>= 100)" % [id,
							float(apron["distance_m"])])
			else:
				var want_street := str(frontage.get(id, ""))
				if want_street.is_empty():
					bad.append("%s has no pinned frontage street" % id)
				else:
					var street := _street_by_name(want_street, rec["pos"] as Vector3)
					if street.is_empty():
						bad.append("%s frontage street '%s' not in the graph"
								% [id, want_street])
					else:
						var d := float(street["distance_m"])
						var to_street: Vector3 = street["point"] \
								- (rec["pos"] as Vector3)
						to_street.y = 0.0
						to_street = to_street.normalized()
						var mount_n := Vector3(sin(yaw), 0.0, cos(yaw))
						if mount_n.dot(to_street) < 0.9:
							bad.append("%s does not face its street (dot %.3f)"
									% [id, mount_n.dot(to_street)])
						match kind:
							"setback":
								if d < 30.0 or d > 70.0:
									bad.append("%s depot set-back %.1f m off "
											+ "the pinned band (30..70)" % [id, d])
							_:
								if d < 4.0 or d > 30.0:
									bad.append("%s frontage distance %.1f m off the sidewalk band"
											% [id, d])
	## The memorial styling: every plaque is the unlit bronze ground-floor
	## read — the tone law in machine form (never a glowing sign).
	for rec: Dictionary in plaques:
		var id := str(rec["id"])
		var sign: SignText = rec["node"]
		if sign.typology != SignText.Typology.PLAQUE:
			bad.append("%s plaque typology %s want PLAQUE" % [id, sign.typology])
		if sign.lit_mode == 2:
			bad.append("%s plaque forced lit (the tone law)" % id)
		if float(rec["mount_y"]) > AmesVenueSigns.PLAQUE_MEMORIAL_MAX_Y:
			bad.append("%s mounts %.1f above the ground-floor band" % [id,
					float(rec["mount_y"])])
		if float(rec["letter"]) > AmesVenueSigns.PLAQUE_MEMORIAL_LETTER + 0.0001:
			bad.append("%s letter %.3f above the memorial cap" % [id,
					float(rec["letter"])])
		var body_mat: StandardMaterial3D = null
		for c: Node in sign.get_children():
			if c.name == "Body" and c is MeshInstance3D:
				body_mat = (c as MeshInstance3D).mesh.surface_get_material(0) \
						as StandardMaterial3D
		if body_mat == null:
			bad.append("%s plaque body material missing" % id)
		else:
			if body_mat.albedo_color != AmesVenueSigns.PLAQUE_MEMORIAL_BODY:
				bad.append("%s plaque body not the memorial bronze" % id)
			if body_mat.emission_enabled:
				bad.append("%s plaque body emits (never a glowing sign)" % id)
		var face_label: Label3D = null
		for c2: Node in sign.get_children():
			if c2 is Label3D:
				face_label = c2
		if face_label == null or face_label.modulate \
				!= AmesVenueSigns.PLAQUE_MEMORIAL_TEXT:
			bad.append("%s plaque lettering not the parchment pair" % id)
	## The Carlos Quesadilla truck: the one PROP — parts + the topper.
	for rec: Dictionary in records:
		if str(rec["id"]) != "carlos_quesadilla":
			continue
		if not rec.has("truck_parts") or int(rec["truck_parts"]) < 6:
			bad.append("carlos truck parts %s want >= 6" % str(rec.get("truck_parts")))
	## The world report keys.
	var report: Dictionary = world.last_report
	if int(report.get("venue_signs_t23", -1)) != 27:
		bad.append("report venue_signs_t23 %s want 27"
				% str(report.get("venue_signs_t23")))
	if int(report.get("ghost_plaques", -1)) != 11:
		bad.append("report ghost_plaques %s want 11"
				% str(report.get("ghost_plaques")))
	if int(report.get("cq_truck_parts", -1)) < 6:
		bad.append("report cq_truck_parts %s" % str(report.get("cq_truck_parts")))
	_check(S, bad.is_empty(), "; ".join(bad) if not bad.is_empty() else "-")


## T-200 — the street-name blades live on the resident world: one MUTCD green
## blade per SPINE street name at every T-180 pinned corner the spine set
## touches (mast-arm stacked at signal corners, post-mounted on the approach's
## right at the all-way stops). Every leg re-derives IN-SCENARIO from the
## committed data, never echoed: the CORNER LIST walked off the traffic
## graph's own pinned anchors (exact counts + the per-corner name lists),
## the TEXTS byte-exact against the picked edge's run name AND the pack
## street-name set (never retyped — the East Lincoln Way seam lands as the
## data spells it), the seam corner pinned with its four stacked blades
## (Duff/East Lincoln Way/Lincoln Way/South Duff at one corner), the
## unreachable spine names pinned as a CLOSED ledger (Mortensen/Stange/16th
## place nothing until their corners join the pinned set — a data change
## forces the conscious re-pin), the mount laws re-derived per blade (the
## mast-arm stack pose with the module's world-const twins pinned EQUAL,
## the post position with the outset clamp into its run, plate bottom clear
## of the octagon band), the MUTCD form pins (typology STREET, letter 0.22
## → 44 m budget, green/white pair, UNLIT, double-faced, plate fits its
## name through the component's own font metrics), the visual-only guard,
## and the world report key.
func _scenario_street_blades_pins() -> void:
	const S := "street_blades_pins"
	var bad: PackedStringArray = []
	var world := _city as AmesWorld
	if world == null:
		_check(S, false, "the harness world is not an AmesWorld")
		return
	var graph := world.traffic_graph
	if graph == null:
		_check(S, false, "no traffic graph on the resident world")
		return
	var records := world.street_blades
	## The spine set, typed here from the ticket (the module's own list is
	## pinned EQUAL below — the ticket is the definition, the module carries
	## it into the world build).
	var spine: Array[String] = [
		"Lincoln Way", "East Lincoln Way",
		"Welch Avenue", "Hayward Avenue", "Sheldon Avenue", "Stanton Avenue",
		"Main Street", "Duff Avenue", "South Duff Avenue",
		"Grand Avenue", "South Grand Avenue",
		"University Boulevard", "Mortensen Road",
		"South 16th Street", "Southeast 16th Street",
		"Stange Road", "Clark Avenue", "Burnett Avenue", "Douglas Avenue",
	]
	if AmesStreetBlades.SPINE_NAMES.size() != spine.size():
		bad.append("module spine set %d entries want %d"
				% [AmesStreetBlades.SPINE_NAMES.size(), spine.size()])
	else:
		for nm in spine:
			if not AmesStreetBlades.SPINE_NAMES.has(nm):
				bad.append("module spine set missing %s" % nm)
	## (a) The corner list, re-derived off the graph's pinned anchors: per
	## anchor, its spine names in `intersection_streets` order (the module's
	## own walk order). Grouped against the records below.
	var expect: Dictionary = {} ## anchor -> Array[String] spine names.
	var expect_order: Array[int] = []
	for a in graph.intersection_count():
		if graph.intersection_pin(a) == AmesTrafficGraph.PIN_NONE:
			continue
		var hits: Array[String] = []
		for nm in graph.intersection_streets(a):
			if spine.has(nm):
				hits.append(nm)
		if not hits.is_empty():
			expect[a] = hits
			expect_order.append(a)
	## The records group by anchor in the same walk order.
	var got_order: Array[int] = []
	var got: Dictionary = {} ## anchor -> Array[Dictionary] records.
	for rec: Dictionary in records:
		var a := int(rec["anchor"])
		if not got.has(a):
			got[a] = []
			got_order.append(a)
		got[a].append(rec)
	if got_order != expect_order:
		bad.append("corner order/size %d corners want %d (data drift — re-pin)"
				% [got_order.size(), expect_order.size()])
	else:
		for a in expect_order:
			var want_names: Array = expect[a]
			var got_names: Array[String] = []
			for rec: Dictionary in got[a]:
				got_names.append(str(rec["street"]))
			if got_names != want_names:
				bad.append("corner %d blades %s want %s" % [a, got_names,
						want_names])
	## The landed counts (recorded from the data, probed 2026-11-16: 70
	## pinned corners touch the spine set, 85 blades — 37 mast stacks /
	## 48 posts; T-203 re-pin 2026-11-17: the bbox east pinned four MORE
	## all-way corners on East Lincoln Way — × Des Moines / East Avenue /
	## Sumner / High — each carrying one East-Lincoln-Way post blade:
	## 74 corners, 89 blades — 37 mast stacks / 52 posts; T-204 re-pin
	## 2026-11-17: the bbox south pinned the south fabric's spine corners —
	## 99 blades — 42 mast stacks / 57 posts; T-205 re-pin 2026-11-17: the
	## bbox north pinned the north spine corners — Grand Avenue × the north
	## grid, Stange Road's first in-core corners, Bloomington Road, the
	## Northridge corridor — 130 blades — 50 mast stacks / 80 posts).
	var mast_count := 0
	var post_count := 0
	for rec: Dictionary in records:
		if str(rec["mount"]) == "mast":
			mast_count += 1
		else:
			post_count += 1
	if records.size() != 130 or mast_count != 50 or post_count != 80:
		bad.append("blade counts %d (%d mast / %d post) want 130 (50/80)"
				% [records.size(), mast_count, post_count])
	## (b) The text pins: every blade text IS its picked edge's run name,
	## byte-exact, AND a committed pack street name (the exact-match law —
	## the seam names land as the data spells them, never invented).
	var pack_names: Dictionary = {}
	for s: Dictionary in AmesDataPack.streets():
		pack_names[str(s.get("name", ""))] = true
	for rec: Dictionary in records:
		var street := str(rec["street"])
		if (rec["node"] as SignText).display_text() != street:
			bad.append("%s display text '%s' != street '%s'" % [rec["id"],
					(rec["node"] as SignText).display_text(), street])
		if graph.edge_name(int(rec["edge"])) != street:
			bad.append("%s edge %d runs '%s' want '%s'" % [rec["id"],
					int(rec["edge"]), graph.edge_name(int(rec["edge"])), street])
		if not pack_names.has(street):
			bad.append("%s text '%s' is not a pack street name" % [rec["id"],
					street])
	## (c) The seam corner: the anchor where Lincoln Way renames carries all
	## four data names — Duff Avenue / East Lincoln Way / Lincoln Way /
	## South Duff Avenue — one mast stack, slots 0..3.
	var seam_anchor := -1
	for a in expect_order:
		var names: Array = expect[a]
		if names.has("East Lincoln Way") and names.has("Lincoln Way") \
				and names.has("Duff Avenue") and names.has("South Duff Avenue"):
			seam_anchor = a
			break
	if seam_anchor < 0:
		bad.append("no seam corner (East+West Lincoln Way at Duff) in the set")
	else:
		var seam_names: Array[String] = []
		var seam_slots: Array[int] = []
		for rec: Dictionary in got[seam_anchor]:
			seam_names.append(str(rec["street"]))
			if str(rec["mount"]) != "mast":
				bad.append("seam blade %s not mast-mounted" % rec["id"])
			seam_slots.append(int(rec["stack"]))
		var seam_want: Array[String] = ["Duff Avenue", "East Lincoln Way",
				"Lincoln Way", "South Duff Avenue"]
		if seam_names != seam_want:
			bad.append("seam corner %d carries %s want the four data names"
					% [seam_anchor, seam_names])
		if seam_slots != [0, 1, 2, 3]:
			bad.append("seam stack slots %s want 0..3" % [seam_slots])
	## (d) The reachability ledger: the spine names NO pinned corner touches
	## (closed set — a bake extension that pins an unreached corner fails
	## here until the ticket re-pins the ledger). (T-204 re-pin) The bbox
	## south pinned the South 16th Street + Southeast 16th Street corners
	## (the SE-corner growth + the south strip), so both LEAVE the ledger;
	## Mortensen Road stays unreached BY NAME — the data names it "Mortensen
	## Parkway", so no corner can ever spell the spine name until a pack
	## rename — and Stange Road stays out of reach until a bake pins its
	## corners.
	var reached: Dictionary = {}
	for rec: Dictionary in records:
		reached[str(rec["street"])] = true
	var unreached: Array[String] = []
	for nm in spine:
		if not reached.has(nm):
			unreached.append(nm)
	var ledger_want: Array[String] = ["Mortensen Road", "Stange Road"]
	if unreached != ledger_want:
		bad.append("unreached spine names %s want the T-204 ledger" % [unreached])
	## (e) The mount-twin drift gate: the module's mast consts equal the
	## world's — a mast retune that forgets the twins fails here.
	if AmesStreetBlades.MAST_ARM_Y != AmesWorld.MAST_ARM_Y \
			or AmesStreetBlades.MAST_POLE_CLEAR != AmesWorld.MAST_POLE_CLEAR \
			or AmesStreetBlades.MAST_POLE_SIDE != AmesWorld.MAST_POLE_SIDE \
			or AmesStreetBlades.MAST_ARM_END_CLEAR != AmesWorld.MAST_ARM_END_CLEAR:
		bad.append("mast mount twins drifted off the world's mast consts")
	## (f) Per-blade legs: typology/budget/form + the mount re-derivation.
	var spec: Dictionary = SignText.SPEC[SignText.Typology.STREET]
	var spec_ok := (spec["body_color"] as Color).is_equal_approx(
			Color(0.043, 0.42, 0.216)) \
			and (spec["text_color"] as Color).is_equal_approx(
			Color(0.94, 0.94, 0.92)) \
			and not bool(spec["lit"]) and not bool(spec["vertical"])
	if not spec_ok:
		bad.append("STREET spec off the MUTCD pins (green/white, unlit, horizontal)")
	var stack_by_anchor: Dictionary = {} ## anchor -> seen slots (mast mounts).
	for rec: Dictionary in records:
		var id := str(rec["id"])
		var sign: SignText = rec["node"]
		if sign == null or not is_instance_valid(sign):
			bad.append("%s record node is gone" % id)
			continue
		var street := str(rec["street"])
		if sign.typology != SignText.Typology.STREET:
			bad.append("%s typology %d want STREET" % [id, sign.typology])
		if absf(sign.effective_letter_height() - AmesStreetBlades.BLADE_LETTER) > 0.0001:
			bad.append("%s letter %.3f want %.3f" % [id,
					sign.effective_letter_height(), AmesStreetBlades.BLADE_LETTER])
		if not is_equal_approx(sign.readable_distance(),
				AmesStreetBlades.BLADE_LETTER
				* float(spec["budget"])):
			bad.append("%s readable %.2f want %.2f" % [id, sign.readable_distance(),
					AmesStreetBlades.BLADE_LETTER * float(spec["budget"])])
		## The plate fits its name through the component's own metrics.
		var plate: Vector3 = rec["plate"]
		if (sign.body_scale - plate).length() > 0.0001:
			bad.append("%s body_scale %s want %s" % [id, sign.body_scale, plate])
		var px := AmesStreetBlades.BLADE_LETTER \
				/ (float(SignText.FONT_SIZE_PX) * SignText.CAP_HEIGHT_EM)
		var w := SignText.FONT.get_string_size(street, HORIZONTAL_ALIGNMENT_LEFT,
				-1, SignText.FONT_SIZE_PX).x * px
		var want_len := maxf(AmesStreetBlades.PLATE_MIN_LEN,
				w + AmesStreetBlades.PLATE_PAD * 2.0)
		if absf(plate.x - want_len) > 0.001 or absf(plate.y - 0.44) > 0.001 \
				or absf(plate.z - 0.06) > 0.001:
			bad.append("%s plate %s off its fitted dims (%.3f)" % [id, plate,
					want_len])
		## Double-faced: two unshaded labels, ±z proud, both the street name.
		var faces: Array[Label3D] = []
		_collect_faces(sign, faces)
		if faces.size() != 2:
			bad.append("%s faces %d want 2" % [id, faces.size()])
		else:
			var yaws: Array[float] = []
			for face: Label3D in faces:
				if face.shaded:
					bad.append("%s face is shaded" % id)
				if face.text != street:
					bad.append("%s face text '%s' want '%s'" % [id, face.text,
							street])
				if face.font != SignText.FONT:
					bad.append("%s face not on the bundled font" % id)
				yaws.append(wrapf(face.rotation.y, -PI, PI))
			yaws.sort()
			if absf(yaws[0] - -PI) > 0.01 or absf(yaws[1]) > 0.01:
				bad.append("%s face yaws %s want ±z pair" % [id, yaws])
		## Unlit: the body material carries no emission (retroreflective
		## paint, not a light source — the T-134 read).
		for child: Node in sign.get_children():
			if child is not MeshInstance3D:
				continue
			var mat := (child as MeshInstance3D).mesh.surface_get_material(0) \
					as StandardMaterial3D
			if mat != null and mat.emission_enabled:
				bad.append("%s body carries emission" % id)
		if _has_collision(sign):
			bad.append("%s carries collision (visual-only law)" % id)
		if sign.position.distance_to(rec["pos"] as Vector3) > 0.001:
			bad.append("%s node drifted off its mount" % id)
		## The anchor is pinned, and the mount follows the corner type.
		var a := int(rec["anchor"])
		if graph.intersection_pin(a) == AmesTrafficGraph.PIN_NONE:
			bad.append("%s sits at an unpinned anchor" % id)
		var axis := graph.edge_axis(int(rec["edge"]))
		var want_yaw := atan2(-axis.z, axis.x)
		if absf(wrapf(float(rec["yaw"]) - want_yaw, -PI, PI)) > 0.02:
			bad.append("%s yaw %.3f want %.3f" % [id, rec["yaw"], want_yaw])
		## The plate reads ACROSS its street: the face normal stands
		## perpendicular to the street axis (the MUTCD orientation).
		var face_n := Vector3(sin(float(rec["yaw"])), 0.0, cos(float(rec["yaw"])))
		if absf(face_n.dot(axis)) > 0.02:
			bad.append("%s plate faces along its street (dot %.3f)" % [id,
					face_n.dot(axis)])
		var pos := rec["pos"] as Vector3
		if str(rec["mount"]) == "mast":
			## The mast-arm stack pose, re-derived from the graph + twins.
			if not graph.intersection_is_signal(a):
				bad.append("%s mast mount at a non-signal corner" % id)
			var sig_axis := graph.intersection_signal_axis(a)
			var half := graph.intersection_signal_half_width(a)
			var lane := graph.intersection_signal_lane_off(a)
			var node := graph.intersection_signal_node(a)
			var node_pos := graph.node_pos(node)
			var right := Vector3(-sig_axis.z, 0.0, sig_axis.x)
			var along := lane + AmesTrafficGraph._STOP_OUTSET_TAIL \
					+ AmesStreetBlades.MAST_POLE_CLEAR
			var pole_pos := node_pos - sig_axis * along \
					+ right * (half + AmesStreetBlades.MAST_POLE_SIDE)
			var arm_len := (half + AmesStreetBlades.MAST_POLE_SIDE) + half \
					- AmesStreetBlades.MAST_ARM_END_CLEAR
			var station := pole_pos - right * (arm_len
					* AmesStreetBlades.ARM_BLADE_STATION)
			var k := int(rec["stack"])
			var want_y := AmesStreetBlades.MAST_ARM_Y \
					- AmesStreetBlades.ARM_BLADE_CLEAR - plate.y * 0.5 \
					- float(k) * (plate.y + AmesStreetBlades.ARM_BLADE_STACK_GAP)
			var want_pos := Vector3(station.x, want_y, station.z)
			if pos.distance_to(want_pos) > 0.02:
				bad.append("%s mast pos %s want %s" % [id, pos, want_pos])
			if not stack_by_anchor.has(a):
				stack_by_anchor[a] = {}
			var seen: Dictionary = stack_by_anchor[a]
			if seen.has(k):
				bad.append("corner %d reuses mast stack slot %d" % [a, k])
			seen[k] = true
		else:
			## The post position, re-derived with the outset clamp — the
			## offset rides the APPROACH axis (into the node, the stop-sign
			## law's own axis; the yaw axis above is the plate's, ± freely).
			if graph.intersection_is_signal(a):
				bad.append("%s post mount at a signal corner" % id)
			var member := _blade_member_of(graph, a, int(rec["edge"]))
			var geo := graph.approach_geometry(member,
					graph.edge_reverse(int(rec["edge"])))
			var app_axis: Vector3 = geo["axis"]
			var out := Vector3(-app_axis.z, 0.0, app_axis.x)
			var outset := minf(float(geo["stop_outset"])
					+ AmesTrafficGraph.SIGN_OUTSET_GAP,
					float(geo["run_length"]) - AmesStreetBlades.BLADE_RUN_MARGIN)
			var base: Vector3 = graph.node_pos(member) - app_axis * outset + out \
					* (float(geo["half_width"]) + AmesTrafficGraph.SIGN_EDGE_OFFSET
					+ AmesStreetBlades.POST_SEP)
			var want_pos := Vector3(base.x,
					AmesStreetBlades.POST_MOUNT_Y, base.z)
			if pos.distance_to(want_pos) > 0.02:
				bad.append("%s post pos %s want %s" % [id, pos, want_pos])
			## The plate bottom clears the octagon band (border top 2.67).
			if pos.y - plate.y * 0.5 < 2.8:
				bad.append("%s plate bottom %.2f inside the stop-sign band" % [id,
						pos.y - plate.y * 0.5])
			## Its post mesh part exists under the root at the right spot.
			var root := world.get_node_or_null("StreetBlades") as Node3D
			var post_node := root.get_node_or_null("Post_%s" % id.replace("/", "_")
					.replace(" ", "_")) as MeshInstance3D
			if post_node == null:
				bad.append("%s post mesh missing" % id)
			else:
				if absf(post_node.position.y * 2.0
						- (AmesStreetBlades.POST_MOUNT_Y - plate.y * 0.5)) > 0.01:
					bad.append("%s post height off the plate bottom" % id)
				if post_node.position.distance_to(Vector3(pos.x,
						post_node.position.y, pos.z)) > 0.01:
					bad.append("%s post not under its plate" % id)
				var pm := post_node.mesh.surface_get_material(0) \
						as StandardMaterial3D
				if pm == null or not pm.albedo_color.is_equal_approx(
						AmesStreetBlades.POST_COLOR):
					bad.append("%s post not the corner-post gray" % id)
	## The world report key.
	var report: Dictionary = world.last_report
	if int(report.get("street_blades", -1)) != records.size():
		bad.append("report street_blades %s want %d"
				% [str(report.get("street_blades")), records.size()])
	_check(S, bad.is_empty(), "; ".join(bad) if not bad.is_empty() else "-")


## The intersection member node that owns a given out-edge at an anchor —
## the T-200 post legs' read (the module picked the edge off a member; the
## re-derivation needs that member's node position back).
func _blade_member_of(graph: AmesTrafficGraph, anchor: int, edge: int) -> int:
	for member in graph.intersection_members(anchor):
		for e in graph.out_edges(member):
			if e == edge:
				return member
	return graph.intersection_head(anchor)


## T-201 — the campus + civic name plaques, live on the resident world: the
## pinned building list's NOMINATIVE names in plain type (name + the survey's
## own year, nothing else — no university wordmark, no Cy, no athletics
## marks, no logo shields, no railroad brands: "Ames Depot", never C&NW),
## hung on the heroes' own faces, with the Marston tower as the one
## free-standing base marker. (T-204 re-pin: Reiman Gardens was T-201's one
## staged spec — the pack marked it in_core false — and the bbox south
## landed the POI while the ticket built the hero its plaque hangs on, so
## the table now places ALL 12, zero staged.) Every leg
## re-derives independently of the module table: the texts byte-exact against
## the typed survey names + the year-suffix law, the EXCLUDED-MARK scan over
## every text, the plain-typography law on the live nodes (one slab mesh +
## one unshaded type face, the typology's cream/ink, zero emission, zero
## outline — a logo shield would be a second mesh, which cannot exist here),
## the budget + face-fit laws through the component, and the mounts against
## the LIVE hero part records (`AmesWorld`'s `*_hero_parts` arrays — the
## geometry the player flies past): the wall-exists leg (the point behind the
## slab is inside a real hero box), the CLIP leg (no hero box penetrates the
## slab's own volume — the Beardshear column law), the span/top/ground legs,
## and the marker's clear-of-the-union leg.
func _scenario_campus_plaques_pins() -> void:
	const S := "campus_plaques_pins"
	var bad: PackedStringArray = []
	var world := _city as AmesWorld
	if world == null:
		_check(S, false, "the harness world is not an AmesWorld")
		return
	var records := world.campus_plaques
	## The ticket's pinned building list, typed here from the survey
	## (LANDMARKS C1..C10 + T3, the depot per MODELING-SPECS §1.8) — the
	## byte-exact texts: the name plus AT MOST the survey's own year.
	var texts: Array[String] = [
		"Campanile — 1897",
		"Beardshear Hall — 1906",
		"Morrill Hall — 1891",
		"Farm House — 1860–61",
		"Memorial Union — 1928",
		"Parks Library — 1925",
		"Marston Water Tower — 1897",
		"Jack Trice Stadium — 1975",
		"Hilton Coliseum — 1971",
		"Ames City Hall",
		"Ames Depot — 1906",
		"Reiman Gardens — 1995",
	]
	## The year each plaque may carry ("" = the survey pins none — City Hall
	## stays name-only rather than inventing a date; the ticket's "dates may
	## appear" law).
	var years: Dictionary = {
		"campanile": "1897", "beardshear": "1906", "morrill": "1891",
		"farm_house": "1860–61", "mu": "1928", "parks": "1925",
		"marston_tower": "1897", "jack_trice": "1975", "hilton": "1971",
		"city_hall": "", "depot": "1906", "reiman_gardens": "1995",
	}
	## THE EXCLUDED LIST (the ticket's legal line, machine-read): any of
	## these in any plaque text fails the gate — names in plain type only.
	var excluded: Array[String] = [
		"Iowa State", "ISU", "Cyclone", "Cy", "MidAmerican", "C&NW",
		"North Western", "Union Pacific", "Amtrak",
	]
	## The hero part records each plaque's mount re-derives against: the
	## record array property + the `hero` tag inside it ("" = whole array).
	var hero_arrays: Dictionary = {
		"campanile": ["campanile_hero_parts", ""],
		"beardshear": ["campus_row_hero_parts", "beardshear"],
		"morrill": ["campus_row_hero_parts", "morrill"],
		"farm_house": ["campus_row_hero_parts", "farm_house"],
		"mu": ["mu_parks_hero_parts", "memorial_union"],
		"parks": ["mu_parks_hero_parts", "parks_library"],
		"marston_tower": ["marston_hero_parts", ""],
		"jack_trice": ["stadium_hero_parts", ""],
		"hilton": ["hilton_hero_parts", ""],
		"city_hall": ["civic_hero_parts", "cityhall"],
		"depot": ["depot_hero_parts", ""],
		"reiman_gardens": ["gardens_hero_parts", ""], ## (T-204) The ticket's own hero.
	}
	## Table shape: the ticket's 12, ALL placed (T-204 re-pin: Reiman
	## Gardens placed on its ticket's own hero — the table carries no staged
	## spec anymore; The Cafe's staged law lives in the venue-sign table).
	if AmesCampusPlaques.PLAQUES.size() != 12:
		bad.append("module table %d entries want 12"
				% AmesCampusPlaques.PLAQUES.size())
	var staged_ids: Array[String] = []
	for e: Dictionary in AmesCampusPlaques.PLAQUES:
		if bool(e["staged"]):
			staged_ids.append(str(e["id"]))
		if not (e["text"] as String) in texts:
			bad.append("table text not a pinned survey text: %s" % e["text"])
	if not staged_ids.is_empty():
		bad.append("staged set %s want empty — every plaque places (T-204 "
				+ "placed Reiman; a re-staged or second staged spec fails)"
				% [staged_ids])
	if records.size() != 12:
		bad.append("placed records %d want 12" % records.size())
	## The placed Reiman Gardens: the reserved slot lives.
	var plaque_root := world.get_node_or_null("CampusPlaques") as Node3D
	if plaque_root == null:
		bad.append("no CampusPlaques root")
	else:
		if plaque_root.get_node_or_null("Plaque_reiman_gardens") == null:
			bad.append("the Reiman Gardens plaque node missing — the reserved "
					+ "slot never placed")
	var reiman_record := false
	for rec: Dictionary in records:
		if str(rec["id"]) == "reiman_gardens":
			reiman_record = true
	if not reiman_record:
		bad.append("no placed reiman_gardens record")
	## The pack leg: the POI really is in the bake core now (the T-201
	## staging dependency resolved by the v3 bbox south).
	for p: Dictionary in AmesDataPack.pois():
		if str(p.get("id", "")) != "reiman_gardens":
			continue
		if not bool(p.get("in_core", true)):
			bad.append("reiman_gardens pack POI claims out-of-core — the "
					+ "placed plaque hangs off-map")
	## Per-record legs.
	for rec: Dictionary in records:
		var id := str(rec["id"])
		var text := str(rec["text"])
		if not text in texts:
			bad.append("%s text not in the pinned list" % id)
		## The year-suffix law: name + at most one " — year" matching the
		## survey's pinned year.
		var parts := text.split(" — ")
		if parts.size() > 2:
			bad.append("%s text carries more than a name + year" % id)
		var want_year := str(years.get(id, "?"))
		var got_year := parts[1] if parts.size() == 2 else ""
		if got_year != want_year:
			bad.append("%s year '%s' want '%s'" % [id, got_year, want_year])
		## THE EXCLUDED-MARK SCAN (the legal line, machine-read).
		for token: String in excluded:
			if text.contains(token):
				bad.append("%s text carries excluded mark '%s'" % [id, token])
		var sign: SignText = rec["node"]
		if sign == null or not is_instance_valid(sign):
			bad.append("%s record node is gone" % id)
			continue
		if sign.typology != SignText.Typology.PLAQUE:
			bad.append("%s typology %d want PLAQUE" % [id, sign.typology])
		if sign.display_text() != text:
			bad.append("%s display '%s' want '%s'" % [id, sign.display_text(),
					text])
		## The plain-typography law: exactly ONE body slab mesh + ONE type
		## face (a logo shield, wordmark graphic or mascot art would be a
		## second mesh / a decoration — the PLAQUE build cannot make one).
		var spec: Dictionary = SignText.SPEC[SignText.Typology.PLAQUE]
		var meshes := 0
		var faces := 0
		var body_mesh: MeshInstance3D = null
		for c2: Node in sign.get_children():
			if c2 is MeshInstance3D:
				meshes += 1
				body_mesh = c2
			elif c2 is Label3D:
				faces += 1
		if meshes != 1 or faces != 1:
			bad.append("%s carries %d meshes / %d faces want 1/1 (zero "
					+ "mark-like graphics)" % [id, meshes, faces])
		if body_mesh != null and body_mesh.mesh != null:
			var mat := body_mesh.mesh.surface_get_material(0) \
					as StandardMaterial3D
			if mat != null and mat.emission_enabled:
				bad.append("%s slab carries emission (plaques are not lit)" % id)
			if mat != null and not (mat.albedo_color as Color).is_equal_approx(
					spec["body_color"]):
				bad.append("%s slab is not the typology cream (no brand color)"
						% id)
		for c3: Node in sign.get_children():
			if c3 is Label3D:
				var label := c3 as Label3D
				if label.outline_size != 0:
					bad.append("%s type carries an outline (plain type only)"
							% id)
				if not (label.modulate as Color).is_equal_approx(
						spec["text_color"]):
					bad.append("%s type is not the typology ink" % id)
				if label.shaded:
					bad.append("%s face is shaded" % id)
		## The budget law + the face-fit law.
		var letter := float(rec["letter"])
		if absf(sign.effective_letter_height() - letter) > 0.0001:
			bad.append("%s letter %.3f != pinned %.3f" % [id,
					sign.effective_letter_height(), letter])
		if not is_equal_approx(sign.readable_distance(),
				letter * float(spec["budget"])):
			bad.append("%s readable %.2f want %.2f" % [id,
					sign.readable_distance(), letter * float(spec["budget"])])
		var band: Vector3 = rec["band"]
		if (sign.body_scale - band).length() > 0.0001:
			bad.append("%s band %s want %s" % [id, sign.body_scale, band])
		var slab: Vector3 = band if band != Vector3.ZERO \
				else (spec["body"] as Vector3)
		var px := letter / (float(SignText.FONT_SIZE_PX) * SignText.CAP_HEIGHT_EM)
		var w := SignText.FONT.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT,
				-1, SignText.FONT_SIZE_PX).x * px
		if w > slab.x - 0.2:
			bad.append("%s lettering %.2f m overflows its %.2f m face" % [id,
					w, slab.x])
		## Visual-only + placement rides the mount.
		if _has_collision(sign):
			bad.append("%s carries collision (visual-only law)" % id)
		## The mount, re-derived from the entry literals (the same face
		## formulas the module encodes).
		var face := str(rec["face"])
		var plane := float(rec["plane"])
		var u := float(rec["wall_u"])
		var y := float(rec["mount_y"])
		var stand := slab.z * 0.5 + AmesCampusPlaques.WALL_GAP
		var want_pos := Vector3.ZERO
		var want_yaw := 0.0
		var normal := Vector3.ZERO ## The outward face normal (for the legs).
		match face:
			"marker":
				want_pos = rec["marker_pos"] as Vector3
				want_yaw = atan2(1.0, 0.0)
				normal = Vector3(1.0, 0.0, 0.0)
			"E":
				want_pos = Vector3(plane + stand, y, u)
				want_yaw = atan2(1.0, 0.0)
				normal = Vector3(1.0, 0.0, 0.0)
			"W":
				want_pos = Vector3(plane - stand, y, u)
				want_yaw = atan2(-1.0, 0.0)
				normal = Vector3(-1.0, 0.0, 0.0)
			"N":
				want_pos = Vector3(u, y, plane - stand)
				want_yaw = atan2(0.0, -1.0)
				normal = Vector3(0.0, 0.0, -1.0)
			_:
				want_pos = Vector3(u, y, plane + stand)
				want_yaw = atan2(0.0, 1.0)
				normal = Vector3(0.0, 0.0, 1.0)
		if sign.position.distance_to(want_pos) > 0.001:
			bad.append("%s mount %s off the re-derived wall mount %s" % [id,
					sign.position, want_pos])
		if absf(wrapf(float(rec["yaw"]) - want_yaw, -PI, PI)) > 0.001:
			bad.append("%s yaw %.3f want %.3f" % [id, rec["yaw"], want_yaw])
		## The hero legs — against the LIVE hero part records.
		var ha: Array = hero_arrays.get(id, [])
		if ha.is_empty():
			bad.append("%s has no hero record map" % id)
			continue
		var parts_all: Array[Dictionary] = []
		for part: Dictionary in world.get(str(ha[0])):
			if str(ha[1]) == "" or str(part.get("hero", "")) == str(ha[1]):
				parts_all.append(part)
		if parts_all.is_empty():
			bad.append("%s hero records empty (%s.%s)" % [id, str(ha[0]),
					str(ha[1])])
			continue
		var union := AABB()
		var first := true
		for part: Dictionary in parts_all:
			var p: Vector3 = part["p"]
			var s: Vector3 = part["s"]
			var box := AABB(p - s * 0.5, s)
			union = box if first else union.merge(box)
			first = false
		if face == "marker":
			## The marker stands CLEAR of the hero union (the Marston
			## trestle reaches x −43.83; the marker hangs east of it) and
			## rides its post from the ground.
			var mp := want_pos
			if mp.x <= union.end.x + 0.5:
				bad.append("%s marker not clear of the tower (%.2f vs %.2f)"
						% [id, mp.x, union.end.x])
			var post := plaque_root.get_node_or_null(
					"MarkerPost_%s" % id) as MeshInstance3D
			if post == null:
				bad.append("%s marker post missing" % id)
			else:
				var pm := post.mesh.surface_get_material(0) \
						as StandardMaterial3D
				if pm == null or not pm.albedo_color.is_equal_approx(
						AmesCampusPlaques.MARKER_POST_COLOR):
					bad.append("%s marker post not the post gray" % id)
				if absf(post.position.y * 2.0
						- AmesCampusPlaques.MARKER_POST_H) > 0.01:
					bad.append("%s marker post height off the slab bottom" % id)
				if post.position.distance_to(Vector3(mp.x,
						post.position.y, mp.z)) > 0.01:
					bad.append("%s marker post not under its slab" % id)
		else:
			## Wall-exists: the point BEHIND the slab is inside a real hero
			## box — the plaque hangs on the wall the player sees.
			var behind := want_pos - normal * (slab.z * 0.5 + 0.1)
			var on_wall := false
			for part: Dictionary in parts_all:
				var p2: Vector3 = part["p"]
				var s2: Vector3 = part["s"]
				if AABB(p2 - s2 * 0.5, s2).has_point(behind):
					on_wall = true
					break
			if not on_wall:
				bad.append("%s mounts off any hero wall (behind %s)" % [id,
						behind])
			## The clip leg: NO hero box penetrates the slab's own volume
			## (the Beardshear column law) — shrink the slab a hair so the
			## designed 0.01 wall gap can never false-fail. The slab's
			## along-wall axis carries the WIDTH, the normal axis the
			## THICKNESS: for E/W faces (normal ±x) the AABB's x extent is
			## the thickness and z the width; N/S the other way.
			var half_x := slab.z * 0.5 if absf(normal.x) > 0.5 \
					else slab.x * 0.5
			var half_z := slab.x * 0.5 if absf(normal.x) > 0.5 \
					else slab.z * 0.5
			var slab_aabb := AABB(want_pos - Vector3(half_x, slab.y * 0.5,
					half_z), Vector3(half_x * 2.0, slab.y, half_z * 2.0))
			slab_aabb = slab_aabb.grow(-0.002)
			for part: Dictionary in parts_all:
				var p3: Vector3 = part["p"]
				var s3: Vector3 = part["s"]
				if slab_aabb.intersects(AABB(p3 - s3 * 0.5, s3)):
					bad.append("%s slab clips a hero box (band/patch law)"
							% id)
					break
			## Span + height legs: the slab inside the face span, below the
			## hero top, above the ground.
			var along_x := absf(normal.z) > 0.5
			var half_u := half_x if along_x else half_z
			var u_lo := union.position.x if along_x else union.position.z
			var u_hi := union.end.x if along_x else union.end.z
			if u - half_u < u_lo - 0.01 or u + half_u > u_hi + 0.01:
				bad.append("%s slab exceeds its face span" % id)
			if y + slab.y * 0.5 > union.end.y + 0.01:
				bad.append("%s mounts above its hero top" % id)
			if y - slab.y * 0.5 < 0.2:
				bad.append("%s mounts at the ground line" % id)
	## The world report key.
	var report: Dictionary = world.last_report
	if int(report.get("campus_plaques", -1)) != records.size():
		bad.append("report campus_plaques %s want %d"
				% [str(report.get("campus_plaques")), records.size()])
	_check(S, bad.is_empty(), "; ".join(bad) if not bad.is_empty() else "-")


## The nearest segment of ONE NAMED street to a world position (y ignored) —
## the T-199 frontage legs' read: {name, distance_m, point} or empty when the
## graph has no street of that name.
func _street_by_name(street_name: String, pos: Vector3) -> Dictionary:
	var best: Dictionary = {}
	var best_d2 := INF
	for s: Dictionary in AmesDataPack.streets():
		if str(s.get("name", "")) != street_name:
			continue
		var pts: Array = s.get("points", [])
		for i: int in range(pts.size() - 1):
			var a: Array = pts[i]
			var b: Array = pts[i + 1]
			var ax: float = a[0]
			var az: float = a[1]
			var dx: float = b[0] - ax
			var dz: float = b[1] - az
			var l2 := dx * dx + dz * dz
			var t := 0.0
			if l2 > 1e-12:
				t = clampf(((pos.x - ax) * dx + (pos.z - az) * dz) / l2, 0.0, 1.0)
			var px := ax + t * dx
			var pz := az + t * dz
			var d2 := (pos.x - px) * (pos.x - px) + (pos.z - pz) * (pos.z - pz)
			if d2 < best_d2:
				best_d2 = d2
				best = {
					"name": street_name,
					"distance_m": sqrt(d2),
					"point": Vector3(px, 0.0, pz),
				}
	return best


