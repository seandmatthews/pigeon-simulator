## --- helpers -------------------------------------------------------------


func _check(scenario: String, ok: bool, detail: String) -> void:
	if ok:
		print("SIM PASS %s" % scenario)
	else:
		_failures += 1
		print("SIM FAIL %s: %s" % [scenario, detail])


func _wait_frames(count: int) -> void:
	for _i in count:
		await get_tree().physics_frame


## Resets the pigeon, optionally hands it an initial velocity and heading, then
## lets the physics settle for a couple of frames.
func _set_up(airborne: bool, pos: Vector3, vel: Vector3, yaw_deg: float = 0.0) -> void:
	_player.reset_flight(pos, yaw_deg)
	if airborne:
		_player.velocity = vel
	await _wait_frames(2)


func _hold(action: String, frames: int) -> void:
	Input.action_press(action)
	await _wait_frames(frames)
	Input.action_release(action)


func _tap(action: String) -> void:
	Input.action_press(action)
	await _wait_frames(1)
	Input.action_release(action)


## Holds a pitch action until the nose crosses target_pitch (given as the sine of
## the pitch angle: negative = below horizon), with a frame budget so a broken
## model can't hang the harness.
func _pitch_until(action: String, target_pitch: float, max_frames: int) -> void:
	var rising := action == "pitch_up"
	Input.action_press(action)
	for _i in max_frames:
		await get_tree().physics_frame
		var nose := (-_player.transform.basis.z).y
		if (rising and nose >= target_pitch) or (not rising and nose <= target_pitch):
			break
	Input.action_release(action)


## Waits until the pigeon settles into the grounded waddle state, with a frame
## budget so a broken landing can't hang the harness.
func _await_grounded(max_frames: int) -> void:
	for _i in max_frames:
		await get_tree().physics_frame
		if _player.is_grounded:
			return


## The player's flat heading (radians): atan2 over the level-projected forward,
## the same read `reset_flight`'s yaw convention and the chase rig's target use.
func _flat_yaw() -> float:
	var fwd := -_player.transform.basis.z
	return atan2(-fwd.x, -fwd.z)


## (T-181, T-183 re-pin) The zone-crowd population law, the harness's one
## read: TOURISTS = the tourist-klass zones' caps (the T-181 pinned visitor
## clusters — Welch the densest — unchanged by the economy scale); ELDERS =
## the elder-klass zones' caps (the campus/shore locals, benches first +
## walkers) PLUS one favor elder per bench of every other
## `ElderSpawner.FAVOR_ZONE_IDS` zone (downtown Main's two bench sitters —
## additive population beside its full visitor cap). Every zone-crowd
## assert in this file reads through these two, so a law change re-pins
## in exactly one place per read.
func _want_zone_tourists(city: City) -> int:
	var want := 0
	for zone: AmesPedZones.Zone in city.ped_zones.zones:
		if zone.klass == "tourist":
			want += zone.cap
	return want


func _want_zone_elders(city: City) -> int:
	var want := 0
	for zone: AmesPedZones.Zone in city.ped_zones.zones:
		if zone.klass == "elder":
			want += zone.cap
		elif zone.id in ElderSpawner.FAVOR_ZONE_IDS:
			want += zone.benches.size()
	return want


func _dbg(msg: String) -> void:
	if _debug:
		print("[dbg] %s" % msg)


## Specific energy in metres: height plus speed squared over twice gravity.
func _energy(y: float, speed: float) -> float:
	return y + speed * speed / (2.0 * _player.gravity)


## --- scenarios (T-171 Ames data pack) -------------------------------------


## T-171: the committed Ames city database is load-bearing. Pure data —
## through the real `AmesDataPack` loader (static class, NO autoload), with
## the census counts and the sentinel transforms recomputed INDEPENDENTLY
## here from the closed form and the survey docs' literal coordinates, never
## through the distiller. Runs before the flight block because it touches no
## pigeon, no city and no physics.
func _scenario_ames_data_integrity() -> void:
	const S := "ames_data_integrity"
	var bad: PackedStringArray = PackedStringArray()
	var pack: Dictionary = AmesDataPack.load_pack()
	var meta: Dictionary = pack.get("meta", {})
	if str(meta.get("pack", "")) != "ames_core" or int(meta.get("version", 0)) != 4:
		bad.append("boot: pack=%s version=%s" % [meta.get("pack"), meta.get("version")])

	# --- counts (the v4 pins: the census §1/§5/§6 stock grown by T-203's east
	# strip, T-204's south strip and T-205's north strip — every count's v1
	# census pin and the strips' deltas recorded in the tickets; ames_bbox_east
	# diff-proves the east+south stories, ames_extension_north the north
	# story) ---
	var counts: Dictionary = meta.get("counts", {})
	if int(counts.get("buildings", 0)) != 10783:
		bad.append("buildings=%s (v4 pin 10783; v3 4960)" % counts.get("buildings"))
	var named_n := 0
	var authored_n := 0
	for b: Dictionary in AmesDataPack.buildings():
		if b.get("name") != null:
			named_n += 1
		if str(b.get("class", "")) == "authored":
			authored_n += 1
	if named_n != 682:
		bad.append("named_buildings=%d (v4 pin 682; v3 616)" % named_n)
	if authored_n != 682:
		bad.append("authored=%d (v4 pin 682 authored-named; v3 616)" % authored_n)
	if AmesDataPack.trees().size() != 6753:
		bad.append("trees=%d (v4 pin 6753; v3 6106)" % AmesDataPack.trees().size())
	var t1 := AmesDataPack.pois_of(1).size()
	var t2 := AmesDataPack.pois_of(2).size()
	var t3 := AmesDataPack.pois_of(3).size()
	if [t1, t2, t3] != [14, 17, 17]:
		bad.append("venue_tiers=%d/%d/%d (VENUES 14/17/17)" % [t1, t2, t3])
	if AmesDataPack.landmarks().size() != 15:
		bad.append("landmarks=%d (LANDMARKS §5 top-15)" % AmesDataPack.landmarks().size())

	# --- rail: the 14 at-grade vehicular crossings BY NAME (census §5/§7.11's
	# 9 + the north strip's 5 the v4 box revealed: the UP line exits town at
	# grade through West 190th Street, Bloomington Road, 24th, 20th, 16th) ---
	var at_grade: Array[String] = []
	for c: Dictionary in AmesDataPack.rail().get("crossings", []):
		if str(c.get("grade", "")) == "at_grade":
			at_grade.append(str(c.get("road_name", "")))
	var want: Array[String] = ["13th Street", "9th Street", "North Hazel Avenue",
			"Brookridge Avenue", "", "Duff Avenue", "Grand Avenue",
			"Kellogg Avenue", "Clark Avenue", "West 190th Street",
			"Bloomington Road", "24th Street", "20th Street", "16th Street"]
	var got_sorted: Array[String] = at_grade.duplicate()
	got_sorted.sort()
	var want_sorted: Array[String] = want.duplicate()
	want_sorted.sort()
	if got_sorted != want_sorted:
		bad.append("at_grade_crossings=%s (v4 pin 14: %s)" % [at_grade, want])

	# --- street centerline km, BOTH rules the ticket names ---
	# (a) the graph rule streets[] pins: census §4 midpoint rule, named
	#     drivable classes (261.27 on the v4 box — the street GRAPH the city
	#     code consumes; v3 123.40, v2 98.04, v1 census §4 91.93 of 92.1).
	var km: float = float(meta.get("street_km", {}).get("named_drivable_in_core", 0.0))
	if km < 259.5 or km > 263.5:
		bad.append("street_km=%.2f (v4 pin 261.27; v3 123.40, v2 98.04, census §4 v1: 91.9)" % km)
	var km_recomputed := 0.0
	for s: Dictionary in AmesDataPack.streets():
		km_recomputed += float(s.get("km", 0.0))
	if absf(km_recomputed - km) > 0.05:
		bad.append("street_km_meta_vs_polylines=%.3f/%.3f" % [km, km_recomputed])
	# (b) the survey statistic: SUMMARY §3's 99.6 km under the extra3.py §5
	#     rule (named highway ways, NODES filtered to the core bbox, haversine
	#     over consecutive survivors — folds cycleway/service/pedestrian in;
	#     the pack carries the figure and its per-class table, and the rule
	#     re-runs from committed data: python -I docs/references/ames-survey/
	#     osm/scripts/extra3.py docs/references/ames-survey/osm/ames_merged.json
	#     docs/references/ames-survey/osm/raw).
	var km_survey: float = float(meta.get("street_km", {}).get(
			"named_highway_in_core_extra3_km", 0.0))
	if km_survey < 274.9 or km_survey > 276.9:
		bad.append("street_km_extra3=%.2f (extra3 §5 v4 pin 275.9; v3 134.7, v2 105.7, SUMMARY §3 v1: 99.6)" % km_survey)

	# --- sentinel transforms (independent closed-form expectations) ---
	var m_lon: float = 111320.0 * cos(deg_to_rad(42.02))
	var exp_campanile := Vector3((-93.64604 + 93.65015) * m_lon, 0.0,
			-(42.02543 - 42.02278) * 111074.0)
	var exp_mu := Vector3((-93.645762 + 93.65015) * m_lon, 0.0,
			-(42.023667 - 42.02278) * 111074.0)
	var cam := AmesDataPack.building_by_id("way/183041212")
	var mu := AmesDataPack.building_by_id("way/183224150")
	if cam.is_empty() or mu.is_empty():
		bad.append("sentinel_buildings_missing")
	else:
		var cam_c := Vector3(float(cam["centroid"][0]), 0.0, float(cam["centroid"][1]))
		var mu_c := Vector3(float(mu["centroid"][0]), 0.0, float(mu["centroid"][1]))
		if cam_c.distance_to(exp_campanile) > 3.0:
			bad.append("campanile=%s vs expected %s (±3 m)" % [cam_c, exp_campanile])
		if mu_c.distance_to(exp_mu) > 3.0:
			bad.append("mu=%s vs expected %s (±3 m)" % [mu_c, exp_mu])
		# F-06: the MU (2229 Lincoln Way) sits NORTH of Lincoln Way — z ≤ −90 m.
		if mu_c.z > -90.0:
			bad.append("mu_not_north z=%.1f" % mu_c.z)
		# the loader's transform reproduces the pack's STORED coordinates: the
		# transform of each sentinel's own stored 6-decimal wgs84 lands on the
		# stored centroid within 0.25 m (the storage roundings: lonlat 1e-6 deg
		# ≈ 0.11 m, centroid 2 decimals)
		var cam_w: Array = cam["wgs84"]
		var mu_w: Array = mu["wgs84"]
		var t_cam := AmesDataPack.wgs84_to_local(float(cam_w[0]), float(cam_w[1]))
		var t_mu := AmesDataPack.wgs84_to_local(float(mu_w[0]), float(mu_w[1]))
		if t_cam.distance_to(cam_c) > 0.25:
			bad.append("transform_campanile=%s vs pack %s" % [t_cam, cam_c])
		if t_mu.distance_to(mu_c) > 0.25:
			bad.append("transform_mu=%s vs pack %s" % [t_mu, mu_c])

	# --- Lincoln Way reads E–W at lat 42.0228 (verification §1) ---
	var lw_entries := 0
	var lw_max_abs_z := 0.0
	var lw_dx := 0.0
	var lw_dz := 0.0
	var lw_z_sum := 0.0
	var lw_pts := 0
	for s: Dictionary in AmesDataPack.streets():
		if str(s.get("name", "")) != "Lincoln Way":
			continue
		lw_entries += 1
		var pts: Array = s.get("points", [])
		for i: int in range(pts.size()):
			var p: Array = pts[i]
			var z: float = float(p[1])
			lw_max_abs_z = maxf(lw_max_abs_z, absf(z))
			lw_z_sum += z
			lw_pts += 1
			if i > 0:
				var q: Array = pts[i - 1]
				lw_dx += float(p[0]) - float(q[0])
				lw_dz += float(p[1]) - float(q[1])
	if lw_entries == 0 or lw_pts == 0:
		bad.append("lincoln_way_missing")
	else:
		if lw_max_abs_z > 40.0:
			bad.append("lincoln_way_off_lat max|z|=%.1f m" % lw_max_abs_z)
		var bearing := absf(rad_to_deg(atan2(lw_dz, lw_dx)))
		if bearing > 5.0 and bearing < 175.0:
			bad.append("lincoln_way_not_EW bearing=%.2f deg" % bearing)
		var mean_lat := AmesDataPack.local_to_wgs84(
				Vector3(0.0, 0.0, lw_z_sum / float(lw_pts))).y
		if absf(mean_lat - 42.0228) > 0.0002:
			bad.append("lincoln_way_mean_lat=%.5f (want 42.0228 ±0.0002)" % mean_lat)

	# --- orientation spot checks (F-06): Cy's Roost SOUTH of Lincoln Way ---
	for p: Dictionary in AmesDataPack.pois():
		if str(p.get("id", "")) == "cys_roost":
			if float(p["position"][1]) < 0.0:
				bad.append("cys_roost_not_south z=%s" % p["position"][1])

	# --- typed accessors + the attribution constant ---
	# nearest_street at the ORIGIN must land ON the Lincoln Way × Welch
	# crossing (within 10 m) on a street of that crossing — the intersection's
	# own slip lanes are OSM-named "Welch Road", so the family, not one name,
	# is the pin.
	var ns: Dictionary = AmesDataPack.nearest_street(Vector3.ZERO)
	var ns_name := str(ns.get("name", ""))
	if ns.is_empty() or float(ns.get("distance_m", 1e9)) > 10.0 \
			or not (ns_name.begins_with("Welch") or ns_name == "Lincoln Way"):
		bad.append("nearest_street_at_origin=%s" % ns)
	var cam_poi: Dictionary = {}
	for p: Dictionary in AmesDataPack.pois():
		if str(p.get("id", "")) == "campanile":
			cam_poi = p
	if cam_poi.is_empty() or str(cam_poi.get("name", "")) != "Campanile" \
			or int(cam_poi.get("tier", -1)) != 4:
		bad.append("campanile_poi=%s" % cam_poi)
	if AmesDataPack.facing_to_yaw(90.0) > -1.5707 or \
			AmesDataPack.facing_to_yaw(90.0) < -1.5709:
		bad.append("facing_to_yaw_east=%f" % AmesDataPack.facing_to_yaw(90.0))
	if AmesDataPack.ATTRIBUTION != "Map data © OpenStreetMap contributors" \
			or str(meta.get("attribution", "")) != AmesDataPack.ATTRIBUTION:
		bad.append("attribution=%s/%s" % [AmesDataPack.ATTRIBUTION,
				meta.get("attribution")])

	_check(S, bad.is_empty(), "; ".join(bad))


## The directory the T-172 tool bakes into (res:// — the committed bake).
const AMES_CHUNKS_DIR := "res://data/ames/chunks"


## T-172: the committed chunk bake is load-bearing. Pure data — reads the
## committed `data/ames/chunks/` output (manifest + chunk files) and proves
## the bake consumed the WHOLE pack: instance counts sum to the pack counts,
## every building lands in some chunk at its true position, all 14 at-grade
## rail crossings (the census §5 set + T-205's north strip) are world facts
## with real ballast gaps at them, and the LaVerne water flat preserves the
## lake's polygon area. Runs beside `ames_data_integrity` before any
## rig/city/physics exists.
func _scenario_ames_bake_census() -> void:
	const S := "ames_bake_census"
	var bad: PackedStringArray = PackedStringArray()
	var manifest: Dictionary = AmesBaker.read_manifest(AMES_CHUNKS_DIR)
	if manifest.is_empty():
		_check(S, false, "no committed bake at %s — run tools/bake_ames_chunks.gd" % AMES_CHUNKS_DIR)
		return

	# --- load every chunk once, indexed by tile ---------------------------
	var chunks: Dictionary = {} ## Vector2i -> parsed chunk Dictionary.
	var counts_sum: Dictionary = {}
	var crossings: Array[Dictionary] = []
	for entry: Dictionary in manifest.get("chunks", []):
		var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
		var chunk: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		if chunk.is_empty():
			bad.append("chunk_file_missing:%s" % entry["file"])
			continue
		chunks[tile] = chunk
		var counts: Dictionary = chunk.get("counts", {})
		for key: String in AmesBaker.FAMILY_KEYS:
			var arr: Array = chunk.get(key, [])
			## The chunk's own counts field must equal its actual arrays.
			if int(counts.get(key, -1)) != arr.size():
				bad.append("counts_%s=%s vs array %d in %s" % [
						key, counts.get(key, -1), arr.size(), entry["file"]])
			counts_sum[key] = int(counts_sum.get(key, 0)) + arr.size()
		for c: Dictionary in chunk.get("crossings", []):
			crossings.append(c)
	if chunks.is_empty():
		bad.append("no_chunks_loaded")

	# --- 1. instance counts sum to the pack counts ------------------------
	var buildings: Array[Dictionary] = AmesDataPack.buildings()
	if int(counts_sum.get("massing", 0)) != buildings.size():
		bad.append("massing_total=%d (pack buildings %d)" % [counts_sum.get("massing", 0), buildings.size()])
	# self-consistency: manifest counts == parsed chunk arrays, occluders 1:1
	var manifest_totals: Dictionary = manifest.get("totals", {})
	for key: String in AmesBaker.FAMILY_KEYS:
		if int(manifest_totals.get(key, -1)) != int(counts_sum.get(key, -2)):
			bad.append("totals_%s manifest=%s parsed=%s" % [key, manifest_totals.get(key), counts_sum.get(key)])
	if int(counts_sum.get("occluders", 0)) != int(counts_sum.get("massing", 0)):
		bad.append("occluders!=massing %d/%d" % [counts_sum.get("occluders", 0), counts_sum.get("massing", 0)])
	# derived straight from the pack (independent recomputes): asphalt
	# ribbons are EVERY non-degenerate street polyline segment; creek quads
	# are EVERY non-degenerate creek centerline segment; the lawn flat AREA
	# must equal the 31 park polygons' ring-split area (triangulation may
	# re-cut the polygons, never lose them)
	var street_segs := 0
	for s: Dictionary in AmesDataPack.streets():
		var pts: Array = s.get("points", [])
		for i: int in range(pts.size() - 1):
			var dx := float(pts[i + 1][0]) - float(pts[i][0])
			var dz := float(pts[i + 1][1]) - float(pts[i][1])
			if dx * dx + dz * dz > 1e-10:
				street_segs += 1
	if int(counts_sum.get("ribbons", 0)) != street_segs:
		bad.append("ribbons=%d (pack non-degenerate street segments %d)" % [
				counts_sum.get("ribbons", 0), street_segs])
	var creek_segs := 0
	# (T-174) College Creek FEEDS the lake: centerline segments whose
	# midpoint lies inside the lake's ring union paint no ribbon — the lake
	# flat is that ground's surface. The recount here mirrors the rule with
	# the scenario's OWN ring walk + ray cast.
	var lake_rings: Array[PackedVector2Array] = _pack_split_rings(
			AmesDataPack.water()[0].get("polygon", []))
	for wtr: Dictionary in AmesDataPack.water():
		if str(wtr.get("kind", "")) != "creek":
			continue
		for line: Array in wtr.get("centerlines", []):
			for i: int in range(line.size() - 1):
				var cdx := float(line[i + 1][0]) - float(line[i][0])
				var cdz := float(line[i + 1][1]) - float(line[i][1])
				if cdx * cdx + cdz * cdz > 1e-10:
					var cmid := Vector2(
							(float(line[i][0]) + float(line[i + 1][0])) * 0.5,
							(float(line[i][1]) + float(line[i + 1][1])) * 0.5)
					var in_lake := false
					for ring: PackedVector2Array in lake_rings:
						if _point_in_ring(cmid, ring):
							in_lake = true
							break
					if not in_lake:
						creek_segs += 1
	if int(counts_sum.get("creek_quads", 0)) != creek_segs:
		bad.append("creek_quads=%d (pack non-degenerate creek segments %d, lake-interior skipped)" % [
				counts_sum.get("creek_quads", 0), creek_segs])
	var park_area := 0.0
	for park: Dictionary in AmesDataPack.parks():
		## (T-205) A park entry may carry `holes` (a park-lake): the lawn
		## side of the area law is the polygon MINUS its holes — the bake
		## subtracts the hole triangles from the lawn flat.
		park_area += _pack_split_area(park.get("polygon", []))
		for hole: Array in park.get("holes", []):
			park_area -= _pack_split_area(hole)
	var lawn_area := 0.0
	for tile: Vector2i in chunks:
		for t: Dictionary in chunks[tile].get("lawn_tris", []):
			var lv: Array = t["v"]
			var la := Vector2(float(lv[0]), float(lv[2]))
			var lb := Vector2(float(lv[3]), float(lv[5]))
			var lc := Vector2(float(lv[6]), float(lv[8]))
			lawn_area += absf((lb.x - la.x) * (lc.y - la.y) - (lc.x - la.x) * (lb.y - la.y)) * 0.5
	if park_area > 0.0 and absf(lawn_area - park_area) > park_area * 0.01:
		bad.append("lawn_area=%.1f m2 (park polygons %.1f m2, ±1%%)" % [lawn_area, park_area])

	# --- 2. every building position present in its own tile chunk ---------
	var massing_by_tile: Dictionary = {} ## Vector2i -> PackedVector2Array of centers.
	for tile: Vector2i in chunks:
		var centers := PackedVector2Array()
		for m: Dictionary in chunks[tile].get("massing", []):
			var p: Array = m["p"]
			centers.append(Vector2(float(p[0]), float(p[2])))
		massing_by_tile[tile] = centers
	var missing := 0
	var first_missing := ""
	for b: Dictionary in buildings:
		var centroid: Array = b.get("centroid", [0.0, 0.0])
		var pos := Vector2(float(centroid[0]), float(centroid[1]))
		var tile := Vector2i(floori(pos.x / 256.0), floori(pos.y / 256.0))
		if not chunks.has(tile):
			missing += 1
			if first_missing.is_empty():
				first_missing = "%s tile %s has no chunk" % [b.get("id"), tile]
			continue
		var found := false
		for c: Vector2 in massing_by_tile[tile]:
			if c.distance_to(pos) < 0.05:
				found = true
				break
		if not found:
			missing += 1
			if first_missing.is_empty():
				first_missing = "%s at %s not in chunk %s" % [b.get("id"), pos, tile]
	if missing > 0:
		bad.append("buildings_missing_from_chunks=%d (%s)" % [missing, first_missing])

	# --- 3. all 14 at-grade crossings present, with real ballast gaps -----
	var want_crossings: Array[String] = []
	var crossing_pos := {} ## road name -> Vector2 (pack side).
	for c: Dictionary in AmesDataPack.rail().get("crossings", []):
		if str(c.get("grade", "")) == "at_grade":
			var road := str(c.get("road_name", ""))
			want_crossings.append(road)
			var pos: Array = c.get("pos", [0.0, 0.0])
			crossing_pos[road] = Vector2(float(pos[0]), float(pos[1]))
	want_crossings.sort()
	var got_crossings: Array[String] = []
	for c: Dictionary in crossings:
		got_crossings.append(str(c.get("road", "")))
	got_crossings.sort()
	if got_crossings != want_crossings:
		bad.append("crossing_names=%s (want %s)" % [got_crossings, want_crossings])
	if crossings.size() != 14:
		bad.append("crossing_count=%d (want 14)" % crossings.size())
	# each crossing has a REAL gap, proven GEOMETRICALLY on the baked output:
	# the crossing's road is whatever asphalt the bake actually laid near the
	# crossing pos — ribbon quads with centers within ROAD_NEAR of it (both
	# carriageways of a divided road — the pack carries one street entry per
	# carriageway, and the ballast must clear every one that crosses the
	# track). The old midpoint-radius form here was tautological — it
	# measured the baker's own skip rule against itself and could never fail
	# (red-before measured: ballast painted OVER crossing asphalt at Kellogg
	# 85.5 m², Clark 63.9, Grand 24.4, North Hazel/Brookridge 1.6 each).
	const ROAD_NEAR := 40.0
	var ballast_quads: Array = []
	var ribbon_quads: Array = []
	for tile: Vector2i in chunks:
		for q: Dictionary in chunks[tile].get("ballast_quads", []):
			ballast_quads.append(q["q"])
		for q2: Dictionary in chunks[tile].get("ribbons", []):
			ribbon_quads.append(q2["q"])
	var road_quads_near: Array = [] ## Ribbon quads near ANY crossing.
	var roads_per_crossing := {} ## road -> quad count (the no-vacuous-pass arm).
	for road: String in crossing_pos:
		roads_per_crossing[road] = 0
	for q: Array in ribbon_quads:
		var q_mid := Vector2((float(q[0]) + float(q[6])) * 0.5,
				(float(q[2]) + float(q[8])) * 0.5)
		for road: String in crossing_pos:
			if q_mid.distance_to(crossing_pos[road]) < ROAD_NEAR:
				road_quads_near.append(q)
				roads_per_crossing[road] = int(roads_per_crossing[road]) + 1
	for road: String in crossing_pos:
		if int(roads_per_crossing[road]) == 0:
			bad.append("crossing_%s has no baked road quads within %.0f m — its gap check would be vacuous" % [road, ROAD_NEAR])
	var overlapped := 0
	var first_overlap := ""
	for q: Array in ballast_quads:
		var b_mid := Vector2((float(q[0]) + float(q[6])) * 0.5,
				(float(q[2]) + float(q[8])) * 0.5)
		var near_crossing := false
		for road: String in crossing_pos:
			if b_mid.distance_to(crossing_pos[road]) < ROAD_NEAR + 25.0:
				near_crossing = true
				break
		if not near_crossing:
			continue
		for rq: Array in road_quads_near:
			if _flat_quads_overlap(q, rq):
				overlapped += 1
				if first_overlap.is_empty():
					first_overlap = "ballast at (%.1f, %.1f)" % [b_mid.x, b_mid.y]
				break
	if overlapped > 0:
		bad.append("ballast quads over crossing-road asphalt=%d (%s)" % [overlapped, first_overlap])

	# --- 4. LaVerne water flat area: PACK PRESERVATION --------------------
	# The bake triangulates the lake polygon into `water_tris` (chunked by
	# triangle centroid — no clipping loss). The criterion arm (AC amended
	# 2026-11-09, orchestrator-approved per V-12 — the original ±2%-of-11,300
	# band was unsatisfiable against the faithful pack): the baked water area
	# matches the pack polygon's RING-SPLIT shoelace within ±1%. The DNR
	# 2.8 ac (≈11,300 m²) vs OSM-ring gap is the survey's SETTLED V-12
	# simplification difference (docs/references/ames-survey/verification/
	# VERIFICATION.md:80) — recorded here as a comment, never asserted: the
	# census scenario proves the bake PRESERVES the data pack; the real
	# world's 11,300 m² is not the polygon's job to hit. (Measured at
	# landing: baked 11,067.7 m², split shoelace 11,067.7 — the pack's own
	# `area_m2` scalar 11,040 sits 0.25 % below its true split geometry,
	# inside the 1 % follow-up threshold, so no T-171 correction is owed.)
	var la_verne := 0.0
	## (T-205) The bake now carries TWO lakes — isolate LaVerne's tris by
	## centroid (its own rings; Ada Hayden's water carries the same law in
	## `ames_extension_north`).
	var laverne_rings: Array[PackedVector2Array] = _pack_split_rings(
			AmesDataPack.water()[0].get("polygon", []))
	for tile: Vector2i in chunks:
		for t: Dictionary in chunks[tile].get("water_tris", []):
			var v: Array = t["v"]
			var a := Vector2(float(v[0]), float(v[2]))
			var b5 := Vector2(float(v[3]), float(v[5]))
			var c2 := Vector2(float(v[6]), float(v[8]))
			var centroid := (a + b5 + c2) / 3.0
			var is_laverne := false
			for ring: PackedVector2Array in laverne_rings:
				if _point_in_ring(centroid, ring):
					is_laverne = true
					break
			if not is_laverne:
				continue
			la_verne += absf((b5.x - a.x) * (c2.y - a.y) - (c2.x - a.x) * (b5.y - a.y)) * 0.5
	var split_area := _pack_split_area(AmesDataPack.water()[0].get("polygon", []))
	if split_area <= 0.0:
		bad.append("laverne_split_area_recompute_failed")
	elif absf(la_verne - split_area) > split_area * 0.01:
		bad.append("laverne_area=%.1f m2 vs pack ring-split shoelace %.1f m2 (±1%%)" % [la_verne, split_area])

	_check(S, bad.is_empty(), "; ".join(bad))


## Strict separating-axis test on two flat quads (`[[x, y, z] × 4]` corner
## arrays, x/z only): TRUE when the quads overlap OR merely touch (a shared
## edge clears on no axis). The bake keeps a GAP_MARGIN hairline back from
## crossing asphalt, so any touch of baked ballast with baked road is a real
## defect. Coded separately from the baker's margined copy on purpose.
func _flat_quads_overlap(a: Array, b: Array) -> bool:
	for idx: int in 2:
		var q: Array = a if idx == 0 else b
		for i: int in 4:
			var p := Vector2(float(q[i * 3]), float(q[i * 3 + 2]))
			var r := Vector2(float(q[((i + 1) % 4) * 3]), float(q[((i + 1) % 4) * 3 + 2]))
			var e := r - p
			if e.length_squared() < 1e-12:
				continue
			var axis := Vector2(-e.y, e.x).normalized()
			var amin := INF
			var amax := -INF
			var bmin := INF
			var bmax := -INF
			for k: int in 4:
				var da := axis.dot(Vector2(float(a[k * 3]), float(a[k * 3 + 2])))
				var db := axis.dot(Vector2(float(b[k * 3]), float(b[k * 3 + 2])))
				amin = minf(amin, da)
				amax = maxf(amax, da)
				bmin = minf(bmin, db)
				bmax = maxf(bmax, db)
			if maxf(amin - bmax, bmin - amax) > 0.0:
				return false ## Strictly separated on this axis: clear.
	return true


## Independent recompute (the no-self-test rule): the ring-split shoelace of
## a pack polygon. The stored LaVerne sequence is TWO joined OSM ways
## sharing a seam — a naive shoelace over the raw sequence undercounts by the
## seam loop, and a naive ear clip double-covers the lake; the walk below
## closes a loop at each repeated vertex and sums |signed area| over the
## simple loops. Coded here separately from the baker's splitter on purpose.
func _pack_split_area(list: Array) -> float:
	var total := 0.0
	for loop: PackedVector2Array in _pack_split_rings(list):
		var a2 := 0.0
		for i: int in loop.size():
			a2 += loop[i].cross(loop[(i + 1) % loop.size()])
		total += absf(a2 * 0.5)
	return total


## The ring walk of `_pack_split_area`, shared with the T-174 shore recount
## (the shore band is one quad per non-degenerate split-ring edge). Still the
## scenario's OWN walk — never the baker's `_split_rings`.
func _pack_split_rings(list: Array) -> Array[PackedVector2Array]:
	var pts := PackedVector2Array()
	for p: Array in list:
		pts.append(Vector2(float(p[0]), float(p[1])))
	var dedup := PackedVector2Array()
	for v: Vector2 in pts:
		if dedup.is_empty() or dedup[dedup.size() - 1] != v:
			dedup.append(v)
	var loops: Array[PackedVector2Array] = []
	var cur := PackedVector2Array()
	var seen: Dictionary = {}
	for v: Vector2 in dedup:
		var key := "%s,%s" % [v.x, v.y]
		if seen.has(key):
			var j: int = seen[key]
			var loop := PackedVector2Array()
			for k: int in range(j, cur.size()):
				loop.append(cur[k])
			var clean := PackedVector2Array()
			for w: Vector2 in loop:
				if clean.is_empty() or clean[clean.size() - 1] != w:
					clean.append(w)
			if clean.size() >= 3:
				loops.append(clean)
			cur = cur.slice(0, j + 1)
			seen.clear()
			for k: int in cur.size():
				seen["%s,%s" % [cur[k].x, cur[k].y]] = k
		else:
			seen[key] = cur.size()
			cur.append(v)
	if cur.size() >= 3:
		loops.append(cur)
	return loops


## T-172: the bake is a pure function of the pack — re-bake IN-SCENARIO into
## user:// through the same `AmesBaker` core the tool uses and require the
## identical manifest hash (per-chunk SHA-256 set + the total). Proves the
## committed bake is reproducible offline, byte for byte.
func _scenario_ames_bake_determinism() -> void:
	const S := "ames_bake_determinism"
	var committed: Dictionary = AmesBaker.read_manifest(AMES_CHUNKS_DIR)
	if committed.is_empty():
		_check(S, false, "no committed bake at %s" % AMES_CHUNKS_DIR)
		return
	const REBAKE_DIR := "user://ames_rebake_t172"
	var rebaked: Dictionary = AmesBaker.bake_to_dir(REBAKE_DIR)
	if rebaked.is_empty():
		_check(S, false, "re-bake failed (no manifest)")
		return
	var bad: PackedStringArray = PackedStringArray()
	if str(committed.get("total_sha256", "")) != str(rebaked.get("total_sha256", "")):
		bad.append("total_sha256 committed=%s rebaked=%s" % [
				committed.get("total_sha256"), rebaked.get("total_sha256")])
	var committed_by_file: Dictionary = {}
	for entry: Dictionary in committed.get("chunks", []):
		committed_by_file[str(entry["file"])] = str(entry["sha256"])
	var rebaked_by_file: Dictionary = {}
	for entry: Dictionary in rebaked.get("chunks", []):
		rebaked_by_file[str(entry["file"])] = str(entry["sha256"])
	if committed_by_file.keys() != rebaked_by_file.keys():
		bad.append("chunk_file_set differs (%d vs %d)" % [committed_by_file.size(), rebaked_by_file.size()])
	else:
		for file: String in committed_by_file:
			if committed_by_file[file] != rebaked_by_file[file]:
				bad.append("chunk_hash differs: %s" % file)
	# sweep the scratch dir so the run leaves nothing behind
	var dir := DirAccess.open(REBAKE_DIR)
	if dir != null:
		for f: String in dir.get_files():
			dir.remove(f)
		DirAccess.remove_absolute(REBAKE_DIR)
	_check(S, bad.is_empty(), "; ".join(bad))


## (T-206) The filler-dressing law over the committed chunks — pure data (beside
## the census/determinism rows, no rig), the acceptance's "variant distribution
## pins per district; bake determinism re-manifested". MODELING-SPECS §3:
## gabled residential (§3.6, the §1.10 house portraits' pitch classes), porch
## hints + chimneys as the lot-level variation (§1.10 LOD), the downtown
## cornice band (§3.2), the Campustown scruff mix (§3.3), the campus flat +
## mechanical screens (§3.7), the Lincoln Way strip mix (§3.4). Arms:
## 1. RE-MANIFESTED — an in-scenario re-bake reproduces the committed
##    total_sha256 (per-chunk identity stays the `ames_bake_determinism` law).
## 2. THE LAW — every non-hero massing entry carries a legal `v` for its
##    district and baked height; the ten hero slots carry none (the
##    silhouettes supersede 1:1 at every layer) and no roof/dress id is a
##    hero; every roof/dress entry shares its building's chunk.
## 3. FOOTPRINTS IDENTICAL — every massing p/s equals the census §7.4
##    recompute from the pack (height clamp + level ladder + footprint
##    bands, the §3.10 cap), so the collision feed (the authored boxes'
##    transforms) is unchanged by dressing; the authored count equals the
##    pack's authored class count; the district totals equal the v4
##    distribution dressing inherited (regenerated nothing).
## 4. DERIVED GEOMETRY 1:1 — roofs == gable variants; dress == the lot/roof
##    law recomputed from the massing ids (porch deck+canopy pairs, chimneys,
##    cornices, parapets, screen pairs, penthouses). Today's landing pinned
##    exactly: roofs 9,163; dress 7,223 (2,100 porch pairs, 1,688 chimneys,
##    271 cornices, 729 parapets, 156 screen pairs, 23 penthouses).
func _scenario_ames_filler_variants() -> void:
	const S := "ames_filler_variants"
	## The v4 district totals the dressing inherited (the committed manifest's
	## own pre-T-206 totals; the bbox scenario pins their pack derivation).
	const DISTRICT_TOTALS := {
		"residential": 9480, "lincolnway": 622, "campus": 292,
		"downtown": 272, "campustown": 117,
	}
	## Today's landing, pinned exactly (re-pinned per re-bake like bbox_east).
	const VARIANT_TOTALS := {
		"residential/gable_hi": 4603, "residential/gable_lo": 4560,
		"residential/parapet": 316,
		"downtown/cornice": 271,
		"campustown/parapet": 47, "campustown/flat": 47,
		"campustown/penthouse": 23,
		"campus/screen": 156, "campus/parapet": 47, "campus/flat": 82,
		"lincolnway/parapet": 319, "lincolnway/flat": 302,
	}
	const ROOF_TOTAL := 9163
	const DRESS_TOTALS := {
		"porch_deck": 2100, "porch_canopy": 2100, "chimney": 1688,
		"cornice": 271, "parapet": 729, "screen": 312, "penthouse": 23,
	}
	const GABLE_MAX_HEIGHT := 11.5 ## The baker's law, transcribed (no-self-test).
	var bad: PackedStringArray = PackedStringArray()
	var manifest: Dictionary = AmesBaker.read_manifest(AMES_CHUNKS_DIR)
	if manifest.is_empty():
		_check(S, false, "no committed bake at %s" % AMES_CHUNKS_DIR)
		return

	# --- 1. determinism re-manifested -------------------------------------
	const REBAKE_DIR := "user://ames_rebake_t206"
	var rebaked: Dictionary = AmesBaker.bake_to_dir(REBAKE_DIR)
	if rebaked.is_empty():
		bad.append("re-bake failed (no manifest)")
	elif str(rebaked.get("total_sha256", "")) != str(manifest.get("total_sha256", "")):
		bad.append("re-bake total_sha256 %s != committed %s" % [
				rebaked.get("total_sha256"), manifest.get("total_sha256")])
	var sweep := DirAccess.open(REBAKE_DIR)
	if sweep != null:
		for f: String in sweep.get_files():
			sweep.remove(f)
		DirAccess.remove_absolute(REBAKE_DIR)

	# --- load every chunk once; collect the families -----------------------
	var heroes: Dictionary = {} ## Hero id -> true (the manifest's supersede law).
	for h: Variant in manifest.get("heroes", []):
		heroes[str(h)] = true
	var var_counts: Dictionary = {} ## "district/variant" -> count.
	var dress_counts: Dictionary = {} ## role -> count.
	var want_lot_dress: Dictionary = {"porch_deck": 0, "porch_canopy": 0, "chimney": 0}
	var roof_count := 0
	var district_totals: Dictionary = {}
	var authored_count := 0
	var massing_by_id: Dictionary = {} ## id -> entry (the footprint arm).
	for entry: Dictionary in manifest.get("chunks", []):
		var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
		var chunk: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		if chunk.is_empty():
			bad.append("chunk_file_missing:%s" % entry["file"])
			continue
		var id_set: Dictionary = {}
		for m: Dictionary in chunk.get("massing", []):
			var mid := str(m.get("id", ""))
			id_set[mid] = true
			massing_by_id[mid] = m
			var dist := str(m.get("d", ""))
			district_totals[dist] = int(district_totals.get(dist, 0)) + 1
			if bool(m.get("a", false)):
				authored_count += 1
			if heroes.has(mid):
				if m.has("v"):
					bad.append("hero slot carries variant: %s" % mid)
				continue
			var v := str(m.get("v", ""))
			if v.is_empty():
				bad.append("massing without variant: %s" % mid)
				continue
			var key := "%s/%s" % [dist, v]
			var_counts[key] = int(var_counts.get(key, 0)) + 1
			# The per-district law over the entry's own baked fields.
			var h := float(m["s"][1])
			var area := float(m["s"][0]) * float(m["s"][2])
			var roll := mid.hash()
			var legal := false
			match dist:
				"residential":
					if h <= GABLE_MAX_HEIGHT:
						legal = (v == "gable_hi") if roll % 2 == 0 else (v == "gable_lo")
						# The lot-hint law recomputed for this gabled house
						# (porch deck+canopy pairs, chimneys) — accumulate.
						# House-scale only, like the bake's PORCH_HOUSE_MAX_DIM.
						var bucket0 := (roll / 2) % 10
						var house_scale := maxf(float(m["s"][0]), float(m["s"][2])) <= 16.0
						var porch0 := bucket0 < 4 or (bucket0 >= 7 and bucket0 <= 8)
						var chimney0 := (bucket0 >= 4 and bucket0 <= 6) \
								or (bucket0 >= 7 and bucket0 <= 8)
						if porch0 and house_scale:
							want_lot_dress["porch_deck"] += 1
							want_lot_dress["porch_canopy"] += 1
						if chimney0 and house_scale:
							want_lot_dress["chimney"] += 1
					else:
						legal = v == "parapet"
				"downtown":
					legal = v == "cornice"
				"campus":
					if area >= 400.0:
						legal = v == "screen"
					else:
						legal = v == ("parapet" if roll % 3 == 0 else "flat")
				"campustown":
					var bucket := (roll / 2) % 5
					var want := "parapet" if bucket < 2 else ("flat" if bucket < 4 else "penthouse")
					legal = v == want
				_:
					legal = v == ("parapet" if roll % 2 == 0 else "flat")
			if not legal:
				bad.append("illegal variant %s for %s (%s)" % [v, mid, dist])
		var roof_ids: Dictionary = {}
		for rf: Dictionary in chunk.get("roofs", []):
			roof_count += 1
			roof_ids[str(rf.get("id", ""))] = true
		for dr: Dictionary in chunk.get("dress", []):
			var role := str(dr.get("role", ""))
			dress_counts[role] = int(dress_counts.get(role, 0)) + 1
			if heroes.has(str(dr.get("id", ""))):
				bad.append("hero id in dress: %s" % str(dr.get("id", "")))
			if not id_set.has(str(dr.get("id", ""))):
				bad.append("dress id not in its chunk's massing: %s" % str(dr.get("id", "")))
		for rid: String in roof_ids:
			if heroes.has(rid):
				bad.append("hero id in roofs: %s" % rid)
			if not id_set.has(rid):
				bad.append("roof id not in its chunk's massing: %s" % rid)

	# --- 2. totals: districts unchanged, distribution pinned ---------------
	for dist: String in DISTRICT_TOTALS:
		if int(district_totals.get(dist, -1)) != int(DISTRICT_TOTALS[dist]):
			bad.append("district_%s=%d (want %d — dressing regenerated buildings?)"
					% [dist, int(district_totals.get(dist, -1)), int(DISTRICT_TOTALS[dist])])
	for key: String in VARIANT_TOTALS:
		if int(var_counts.get(key, -1)) != int(VARIANT_TOTALS[key]):
			bad.append("variants %s=%d (want %d)" % [key, int(var_counts.get(key, -1)),
					int(VARIANT_TOTALS[key])])

	# --- 3. footprints identical: the census §7.4 recompute from the pack --
	var pack_authored := 0
	var checked := 0
	for b: Dictionary in AmesDataPack.buildings():
		var bid := str(b.get("id", ""))
		var m: Dictionary = massing_by_id.get(bid, {})
		if m.is_empty():
			bad.append("pack building missing from bake: %s" % bid)
			continue
		if str(b.get("class", "")) == "authored":
			pack_authored += 1
		# Independent census-§7.4 height: clamp, ladder, footprint bands.
		var size: Array = b.get("bbox_m", [10.0, 10.0])
		var w := maxf(float(size[0]), 2.0)
		var d := maxf(float(size[1]), 2.0)
		var h: float
		var hv: Variant = b.get("height_m")
		if hv != null:
			h = clampf(float(hv), 2.5, 40.0)
		else:
			var lv: Variant = b.get("levels")
			if lv != null:
				var n := int(roundf(clampf(float(lv), 1.0, 11.0)))
				h = [4.0, 8.0, 11.0, 14.0][n - 1] if n <= 4 \
						else 14.0 + 3.0 * float(n - 4)
			else:
				var area := float(size[0]) * float(size[1])
				h = 8.0 if area < 300.0 else (11.0 if area < 1000.0 else 14.0)
		var centroid: Array = b.get("centroid", [0.0, 0.0])
		var want_p := [snappedf(float(centroid[0]), 0.001), snappedf(h * 0.5, 0.001),
				snappedf(float(centroid[1]), 0.001)]
		var want_s := [snappedf(w, 0.001), snappedf(h, 0.001), snappedf(d, 0.001)]
		var gp: Array = m["p"]
		var gs: Array = m["s"]
		# Tolerance compare (the census row's convention): the chunk files went
		# through a JSON round-trip, so a recompute can sit one float ULP from
		# the stored value while printing identically — 0.002 (half the snap
		# step) sees real dressing drift, never storage noise.
		var fp_bad := false
		for k in 3:
			if absf(float(gp[k]) - float(want_p[k])) > 0.002 \
					or absf(float(gs[k]) - float(want_s[k])) > 0.002:
				fp_bad = true
		if fp_bad:
			bad.append("footprint changed by dressing: %s" % bid)
		checked += 1
	var district_sum := 0
	for dist: String in DISTRICT_TOTALS:
		district_sum += int(DISTRICT_TOTALS[dist])
	if checked != district_sum:
		bad.append("pack walk %d != pinned district sum %d" % [checked, district_sum])
	if district_totals.size() != DISTRICT_TOTALS.size():
		bad.append("baked districts %s — unexpected district keys" % [district_totals.keys()])
	if authored_count != pack_authored:
		bad.append("authored count %d != pack %d (collision feed changed?)"
				% [authored_count, pack_authored])

	# --- 4. derived geometry 1:1 with the law ------------------------------
	var gable_count := int(var_counts.get("residential/gable_hi", 0)) \
			+ int(var_counts.get("residential/gable_lo", 0))
	if roof_count != gable_count:
		bad.append("roofs %d != gable variants %d" % [roof_count, gable_count])
	var want_dress: Dictionary = {
		"cornice": int(var_counts.get("downtown/cornice", 0)),
		"parapet": int(var_counts.get("residential/parapet", 0))
				+ int(var_counts.get("campus/parapet", 0))
				+ int(var_counts.get("campustown/parapet", 0))
				+ int(var_counts.get("lincolnway/parapet", 0)),
		"screen": int(var_counts.get("campus/screen", 0)) * 2,
		"penthouse": int(var_counts.get("campustown/penthouse", 0)),
		"porch_deck": int(want_lot_dress["porch_deck"]),
		"porch_canopy": int(want_lot_dress["porch_canopy"]),
		"chimney": int(want_lot_dress["chimney"]),
	}
	for role: String in DRESS_TOTALS:
		if int(dress_counts.get(role, -1)) != int(DRESS_TOTALS[role]):
			bad.append("dress %s=%d (want pinned %d)" % [role,
					int(dress_counts.get(role, -1)), int(DRESS_TOTALS[role])])
		if int(dress_counts.get(role, -1)) != int(want_dress.get(role, -1)):
			bad.append("dress %s=%d != law recompute %d" % [role,
					int(dress_counts.get(role, -1)), int(want_dress.get(role, -1))])

	_check(S, bad.is_empty(), "; ".join(bad))


## (T-207) The mapped canopy: all 6,753 pack `natural=tree` nodes (the census
## §5 5,637 was the v1 box; T-204 + T-205 grew the layer, recorded in the
## pack) are ONE baked instance each at the mapped position (±0 m — the data
## is the point), the archetype law over the ticket's four placements (the
## LaVerne shore ring → shore, a park polygon → oak with the grove tint, the
## campus district → oak, else the residential boulevard), per-instance
## scale/yaw/tint by the stable index hash, the per-chunk MultiMesh
## discipline at render (one node per archetype present), and the foliage
## convention (no collision, no ground record — the pigeon brushes through).
## Expected values recomputed INDEPENDENTLY from the committed bake + pack
## (the no-self-test rule): the position law re-walks the pack into per-tile
## multisets; the law arm transcribes the hash formula and re-derives
## shore/park/campus membership with its OWN ring math (this file's
## `_pack_split_rings`/`_point_in_ring` — never the baker's); the mix is
## pinned exactly as consts beside the assertion (the filler row's
## convention); the render leg instantiates the resident world once.
func _scenario_ames_tree_canopy() -> void:
	const S := "ames_tree_canopy"
	## Today's landing, pinned exactly (re-pinned per re-bake like the filler
	## row's VARIANT_TOTALS).
	const ARCHETYPE_TOTALS := {"oak": 4587, "boulevard": 2050, "shore": 116}
	## The pack v4 pin (`ames_data_integrity` pins the same layer).
	const PACK_TREES := 6753
	## The baker's shore-ring law, transcribed (no-self-test).
	const SHORE_DIST := 30.0
	## The campus-district legs of the v0 rule, transcribed (the anchor/street
	## lists are the baker's own consts; the distances are the rule's law).
	const CAMPUS_DIST_ANCHOR := 300.0
	const CAMPUS_DIST_STREET := 140.0
	## The scale/tint bands, transcribed.
	const SCALE_LO := 0.82
	const SCALE_HI := 1.18
	const TINT_LO := 0.86
	const TINT_HI := 1.08
	const GROVE_LO := 0.74
	const GROVE_HI := 0.86
	const HUE_JITTER := 0.18
	const SNAP := 0.002 ## The JSON round-trip tolerance (the census convention).
	var bad: PackedStringArray = PackedStringArray()
	var manifest: Dictionary = AmesBaker.read_manifest(AMES_CHUNKS_DIR)
	if manifest.is_empty():
		_check(S, false, "no committed bake at %s" % AMES_CHUNKS_DIR)
		return

	# --- the scenario's own pack walks (never the baker's) ------------------
	var shore_rings: Array[PackedVector2Array] = []
	for w: Dictionary in AmesDataPack.water():
		if str(w.get("kind", "")) == "lake" and w.has("polygon") \
				and str(w.get("name", "")).contains("LaVerne"):
			shore_rings.append_array(AmesBaker._split_rings(
					AmesBaker._pack_points(w.get("polygon", []))))
	## Ring AABBs — the membership walks pre-filter by box so a tree never
	## tests 500 park rings (the walks stay honest: a box miss can never
	## contain the point, a box hit still runs the full even-odd).
	var shore_boxes: Array[Rect2] = []
	for ring: PackedVector2Array in shore_rings:
		shore_boxes.append(_ring_bounds(ring))
	var park_rings: Array[PackedVector2Array] = []
	var park_boxes: Array[Rect2] = []
	for park: Dictionary in AmesDataPack.parks():
		for ring: PackedVector2Array in AmesBaker._split_rings(
				AmesBaker._pack_points(park.get("polygon", []))):
			park_rings.append(ring)
			park_boxes.append(_ring_bounds(ring))
	var campus_anchor_pts := PackedVector2Array()
	var campus_street_pts := PackedVector2Array()
	var lw_pts := PackedVector2Array()
	var downtown_pts := PackedVector2Array()
	for poi: Dictionary in AmesDataPack.pois():
		if str(poi.get("id", "")) in AmesBaker.CAMPUS_ANCHOR_IDS \
				and poi.get("position") != null:
			var pp: Array = poi["position"]
			campus_anchor_pts.append(Vector2(float(pp[0]), float(pp[1])))
	for st: Dictionary in AmesDataPack.streets():
		var sname := str(st.get("name", ""))
		if sname in AmesBaker.CAMPUS_STREET_NAMES:
			for pt: Array in st.get("points", []):
				campus_street_pts.append(Vector2(float(pt[0]), float(pt[1])))
		if sname == "Lincoln Way":
			for pt: Array in st.get("points", []):
				lw_pts.append(Vector2(float(pt[0]), float(pt[1])))
		if sname in AmesBaker.DOWNTOWN_STREET_NAMES:
			for pt: Array in st.get("points", []):
				downtown_pts.append(Vector2(float(pt[0]), float(pt[1])))

	## Nearest distance from `p` to any ring's SEGMENTS (the scenario's own
	## point-to-segment walk — the shore band reads the ring edges).
	var rings_min_dist := func(p: Vector2, rings: Array[PackedVector2Array],
			boxes: Array[Rect2]) -> float:
		var best := 1e18
		for ri: int in rings.size():
			if not boxes[ri].grow(SHORE_DIST).has_point(p):
				continue
			var ring := rings[ri]
			for i: int in ring.size():
				var a := ring[i]
				var b := ring[(i + 1) % ring.size()]
				var ab := b - a
				var l2 := ab.length_squared()
				var t := 0.0 if l2 < 1e-12 \
						else clampf((p - a).dot(ab) / l2, 0.0, 1.0)
				best = minf(best, p.distance_to(a + ab * t))
		return best

	## The campus leg UNDER THE v0 RULE'S PRIORITY (the law the bake
	## runs): campustown (the L/W corridor band) and downtown (the Main
	## band) win over the campus anchor/street rings — a Campustown tree
	## inside a campus anchor's 300 m ring is a Campustown boulevard, not
	## a lawn oak. The strict `<` comparisons are the rule's own.
	var pts_min_dist := func(p: Vector2, pts: PackedVector2Array) -> float:
		var best := 1e18
		for q: Vector2 in pts:
			best = minf(best, p.distance_to(q))
		return best
	var campus_at := func(p: Vector2) -> bool:
		if p.x >= AmesBaker.CAMPUSTOWN_X_BAND.x \
				and p.x <= AmesBaker.CAMPUSTOWN_X_BAND.y \
				and p.y >= AmesBaker.CAMPUSTOWN_Z_BAND.x \
				and p.y <= AmesBaker.CAMPUSTOWN_Z_BAND.y \
				and pts_min_dist.call(p, lw_pts) < AmesBaker.DISTRICT_DIST_LW_BAND:
			return false
		if p.x >= AmesBaker.DOWNTOWN_X_BAND.x \
				and p.x <= AmesBaker.DOWNTOWN_X_BAND.y \
				and pts_min_dist.call(p, downtown_pts) < AmesBaker.DISTRICT_DIST_SPINE:
			return false
		for q: Vector2 in campus_anchor_pts:
			if p.distance_to(q) < CAMPUS_DIST_ANCHOR:
				return true
		for q2: Vector2 in campus_street_pts:
			if p.distance_to(q2) < CAMPUS_DIST_STREET:
				return true
		return false

	## The hash-spread formula, transcribed: band `k` re-hashes the roll and
	## takes 13 bits (the baker's `_frac01` law; `hash()` is unseeded).
	## The band spread, transcribed: a splitmix-style integer finalizer
	## over (roll, band) — the avalanche the string-hash spread lacked
	## (int64 arithmetic wraps deterministically, no RNG).
	var frac01 := func(roll: int, k: int) -> float:
		var h := roll ^ (k * -7046029254386353131)
		h = (h ^ (h >> 30)) * -4658895280553007687
		h = (h ^ (h >> 27)) * -7905916399975552669
		h = h ^ (h >> 31)
		return float((h >> 11) & 0x1FFF) / 8192.0

	# --- 1. the pack is the point: the law recomputed, the bake compared ----
	## Two multisets per tile: positions alone (the ±0 arm) and whole-entry
	## law keys (archetype, scale axes, yaw, tint — the filler row's form).
	var want_pos: Dictionary = {}
	var want_law: Dictionary = {}
	var want_mix: Dictionary = {}
	var tree_pts := AmesDataPack.trees()
	for i: int in tree_pts.size():
		var x := tree_pts[i].x
		var z := tree_pts[i].y
		var p := Vector2(x, z)
		var roll := hash("tree/%d" % i)
		var arch := "boulevard"
		var grove := false
		if rings_min_dist.call(p, shore_rings, shore_boxes) <= SHORE_DIST:
			arch = "shore"
		elif _rings_contain(p, park_rings, park_boxes):
			arch = "oak"
			grove = true
		elif campus_at.call(p):
			arch = "oak"
		want_mix[arch] = int(want_mix.get(arch, 0)) + 1
		var tile := Vector2i(floori(x / 256.0), floori(z / 256.0))
		var tkey := "%d|%d" % [tile.x, tile.y]
		var pos_key := "%d|%d" % [roundi(x * 1000.0), roundi(z * 1000.0)]
		want_pos[tkey + ">" + pos_key] = int(want_pos.get(tkey + ">" + pos_key, 0)) + 1
		var sx := snappedf(SCALE_LO + (SCALE_HI - SCALE_LO) * frac01.call(roll, 0), 0.001)
		var sy := snappedf(SCALE_LO + (SCALE_HI - SCALE_LO) * frac01.call(roll, 1), 0.001)
		var sz := snappedf(SCALE_LO + (SCALE_HI - SCALE_LO) * frac01.call(roll, 2), 0.001)
		var yaw := snappedf(frac01.call(roll, 3) * TAU, 0.001)
		var lum_lo := GROVE_LO if grove else TINT_LO
		var lum_hi := GROVE_HI if grove else TINT_HI
		var lum: float = lum_lo + (lum_hi - lum_lo) * frac01.call(roll, 4)
		var rj: float = 1.0 - HUE_JITTER * 0.5 + HUE_JITTER * frac01.call(roll, 5)
		var bj: float = 1.0 - HUE_JITTER * 0.5 + HUE_JITTER * frac01.call(roll, 6)
		## The tint through Color (the bake's own float32 channel storage —
		## a float64 recompute straddles the 1e-4 snap boundary; the round
		## trip through Color IS the law).
		var tint := Color(lum * rj, lum, lum * bj)
		var ckey := "%d|%d|%d" % [roundi(tint.r * 10000.0),
				roundi(tint.g * 10000.0), roundi(tint.b * 10000.0)]
		var law_key := "%s|%d|%d|%d|%d|%s" % [arch, roundi(sx * 1000.0),
				roundi(sy * 1000.0), roundi(sz * 1000.0), roundi(yaw * 1000.0),
				ckey]
		var bucket := "%s>%s" % [tkey, law_key]
		want_law[bucket] = int(want_law.get(bucket, 0)) + 1
	if int(manifest.get("totals", {}).get("trees", -1)) != PACK_TREES:
		bad.append("totals.trees=%s (want %d)" % [
				manifest.get("totals", {}).get("trees"), PACK_TREES])
	for arch: String in ARCHETYPE_TOTALS:
		if int(want_mix.get(arch, -1)) != int(ARCHETYPE_TOTALS[arch]):
			bad.append("law_recompute %s=%d (want pinned %d — the pack moved?)"
					% [arch, int(want_mix.get(arch, -1)), int(ARCHETYPE_TOTALS[arch])])
	if want_mix.size() != ARCHETYPE_TOTALS.size():
		bad.append("law_recompute archetypes %s — unexpected keys" % [want_mix.keys()])
	var got_pos: Dictionary = {}
	var got_law: Dictionary = {}
	var got_mix: Dictionary = {}
	var tree_nodes := 0
	var off_plate := 0
	for entry: Dictionary in manifest.get("chunks", []):
		var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
		var chunk: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		if chunk.is_empty():
			bad.append("chunk_file_missing:%s" % entry["file"])
			continue
		if int(chunk.get("counts", {}).get("trees", 0)) \
				!= (chunk.get("trees", []) as Array).size():
			bad.append("counts.trees drift in %s" % entry["file"])
		var tkey := "%d|%d" % [tile.x, tile.y]
		for tr: Dictionary in chunk.get("trees", []):
			tree_nodes += 1
			var p: Array = tr["p"]
			if absf(float(p[1])) > SNAP:
				off_plate += 1
			var pos_key := "%d|%d" % [roundi(float(p[0]) * 1000.0),
					roundi(float(p[2]) * 1000.0)]
			got_pos[tkey + ">" + pos_key] = int(got_pos.get(tkey + ">" + pos_key, 0)) + 1
			var c: Array = tr["c"]
			var s: Array = tr["s"]
			got_mix[str(tr["t"])] = int(got_mix.get(str(tr["t"]), 0)) + 1
			var ckey := "%d|%d|%d" % [roundi(float(c[0]) * 10000.0),
					roundi(float(c[1]) * 10000.0), roundi(float(c[2]) * 10000.0)]
			var law_key := "%s|%d|%d|%d|%d|%s" % [str(tr["t"]),
					roundi(float(s[0]) * 1000.0), roundi(float(s[1]) * 1000.0),
					roundi(float(s[2]) * 1000.0), roundi(float(tr["a"]) * 1000.0),
					ckey]
			var bucket := "%s>%s" % [tkey, law_key]
			got_law[bucket] = int(got_law.get(bucket, 0)) + 1
	if tree_nodes != PACK_TREES:
		bad.append("baked trees %d != pack %d" % [tree_nodes, PACK_TREES])
	if off_plate > 0:
		bad.append("%d tree bases off the plate" % off_plate)
	for arch: String in ARCHETYPE_TOTALS:
		if int(got_mix.get(arch, -1)) != int(ARCHETYPE_TOTALS[arch]):
			bad.append("baked mix %s=%d (want pinned %d)" % [arch,
					int(got_mix.get(arch, -1)), int(ARCHETYPE_TOTALS[arch])])
	var pos_bad := _multiset_diff(want_pos, got_pos)
	if not pos_bad.is_empty():
		bad.append("mapped positions != baked positions 1:1 (%s)" % pos_bad)
	var law_bad := _multiset_diff(want_law, got_law)
	if not law_bad.is_empty():
		bad.append("baked tree law != pack recompute (%s)" % law_bad)

	# --- 2. the render leg: per-chunk MultiMeshes, no collision ------------
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var m: Dictionary = world.render_metrics()
	var expect_tree_mm := 0
	for entry2: Dictionary in manifest.get("chunks", []):
		var chunk2: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR,
				str(entry2["file"]))
		var present: Dictionary = {}
		for tr2: Dictionary in chunk2.get("trees", []):
			present[str(tr2["t"])] = true
		expect_tree_mm += present.size()
	var found_tree_mm := 0
	var found_tree_instances := 0
	var shader_mat_count := 0
	var chunks_root := world.get_node_or_null("Chunks") as Node3D
	if chunks_root == null:
		bad.append("no Chunks root — the world did not build")
	else:
		for c: Node in chunks_root.get_children():
			for node: Node in c.find_children("Trees*", "MultiMeshInstance3D",
					true, false):
				found_tree_mm += 1
				var mmi := node as MultiMeshInstance3D
				found_tree_instances += mmi.multimesh.instance_count
				var mat: Material = mmi.multimesh.mesh.surface_get_material(0)
				if mat is ShaderMaterial:
					shader_mat_count += 1
	if found_tree_mm != expect_tree_mm:
		bad.append("tree MultiMeshes %d != per-chunk archetype presence %d"
				% [found_tree_mm, expect_tree_mm])
	if found_tree_instances != PACK_TREES:
		bad.append("tree instances rendered %d != pack %d"
				% [found_tree_instances, PACK_TREES])
	if shader_mat_count != found_tree_mm:
		bad.append("sway ShaderMaterial on %d of %d tree nodes"
				% [shader_mat_count, found_tree_mm])
	## The foliage convention: the canopy files NO ground record. Honest
	## observable: at mapped trunks whose whole neighborhood the bake left
	## box-free (no massing/placeholder box within TREE_SHORE_DIST — a tree
	## under a mapped-inside-a-building node answers THAT building's own top,
	## the api_seam law, not the canopy's), the API answers the plate 0.0.
	var probed := 0
	var skipped_covered := 0
	var gh_worst := 0.0
	var near_cache: Dictionary = {} ## tile -> the chunk doc (the 3×3 walks).
	var near_doc := func(tile_v: Vector2i) -> Dictionary:
		if not near_cache.has(tile_v):
			near_cache[tile_v] = AmesBaker.read_chunk(AMES_CHUNKS_DIR,
					"chunk_%d_%d.json" % [tile_v.x, tile_v.y])
		return near_cache[tile_v]
	for entry3: Dictionary in manifest.get("chunks", []):
		var tile3 := Vector2i(int(entry3["cx"]), int(entry3["cz"]))
		var chunk3: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR,
				str(entry3["file"]))
		for tr3: Dictionary in chunk3.get("trees", []):
			var p3: Array = tr3["p"]
			var px := float(p3[0])
			var pz := float(p3[2])
			var covered := false
			for nx: int in range(tile3.x - 1, tile3.x + 2):
				for nz: int in range(tile3.y - 1, tile3.y + 2):
					var near3: Dictionary = near_doc.call(Vector2i(nx, nz))
					if near3.is_empty():
						continue
					for mb: Dictionary in near3.get("massing", []):
						var mp: Array = mb["p"]
						var ms: Array = mb["s"]
						if absf(px - float(mp[0])) <= float(ms[0]) * 0.5 + SHORE_DIST 								and absf(pz - float(mp[2])) <= float(ms[2]) * 0.5 + SHORE_DIST:
							covered = true
							break
					if covered:
						break
					for pb: Dictionary in near3.get("placeholders", []):
						var pp2: Array = pb["p"]
						var ps2: Array = pb["s"]
						if absf(px - float(pp2[0])) <= float(ps2[0]) * 0.5 + SHORE_DIST 								and absf(pz - float(pp2[2])) <= float(ps2[2]) * 0.5 + SHORE_DIST:
							covered = true
							break
					if covered:
						break
				if covered:
					break
			if covered:
				skipped_covered += 1
				continue
			var gh := world.ground_height(world.to_global(
					Vector3(px, 0.0, pz)))
			gh_worst = maxf(gh_worst, absf(gh))
			if absf(gh) > 0.05:
				bad.append("ground_height %f at an open-lawn trunk %s (the canopy filed a box?)"
						% [gh, str(p3)])
			probed += 1
			if probed >= 64:
				break
		if probed >= 64:
			break
	if probed < 64:
		bad.append("only %d open-lawn trunks found for the ground arm" % probed)
	print("SIM DATA %s: trees=%d mm_nodes=%d tree_mm=%d tree_instances=%d ground_probes=%d skipped_covered=%d gh_worst=%f" % [
			S, tree_nodes, int(m.mm_nodes), found_tree_mm, found_tree_instances,
			probed, skipped_covered, gh_worst])
	_check(S, bad.is_empty(), "; ".join(bad))
	world.queue_free()


## (T-217) The canopy is solid to the BIRD only. The class law: one flora-layer
## (7, bit 64) StaticBody3D per tree-bearing chunk carrying trunk + crown
## cylinders read from the same `TREE_ARCHETYPES` table the meshes build from
## (2 shapes per tree, 13,506 over the bake); rays through the REAL physics
## space answer at the crown cap and trunk-flank faces on the flora class and
## NEVER answer tree geometry on the world class; bird-class flight probes
## (the player's exact mask 69) are HELD at the cylinders while a citizen-class
## probe (mask 1) walks straight through; and the scene files pin the class
## masks — the player is the ONLY body riding the flora bit (supersedes the
## T-207 soft-canopy law "no collision, the pigeon brushes through" — the
## foliage convention itself, no ground record, still holds).
func _scenario_ames_tree_collision() -> void:
	const S := "ames_tree_collision"
	## The bake pin (the canopy row's own) and the flora bit (project.godot
	## `layer_7="flora"` — bit 7).
	const PACK_TREES := 6753
	const FLORA_BIT := 64
	## The class masks, pinned exact off the scene files (the flora law: the
	## player is the ONLY body that rides the flora bit).
	const SCENE_MASKS := {
		"res://scenes/player.tscn": 69, ## world + npc + flora (T-217).
		"res://scenes/tourist.tscn": 1, ## world.
		"res://scenes/elder.tscn": 1, ## world.
		"res://scenes/car.tscn": 9, ## world + vehicle.
		"res://scenes/poop.tscn": 13, ## world + npc + vehicle.
	}
	const TILE := 256.0
	var bad: PackedStringArray = PackedStringArray()
	var manifest: Dictionary = AmesBaker.read_manifest(AMES_CHUNKS_DIR)
	if manifest.is_empty():
		_check(S, false, "no committed bake at %s" % AMES_CHUNKS_DIR)
		return

	# --- 1. the mount: one flora body per tree-bearing chunk, 2 shapes/tree --
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var tree_chunks := 0
	var tree_shapes := 0
	var chunks_root := world.get_node_or_null("Chunks") as Node3D
	if chunks_root == null:
		bad.append("no Chunks root — the world did not build")
	else:
		for entry: Dictionary in manifest.get("chunks", []):
			var chunk: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR,
					str(entry["file"]))
			var want := (chunk.get("trees", []) as Array).size()
			if want == 0:
				continue
			tree_chunks += 1
			var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
			var body := chunks_root.get_node_or_null(
					"Chunk_%d_%d/Trees" % [tile.x, tile.y]) as StaticBody3D
			if body == null:
				bad.append("chunk %d_%d missing the Trees flora body"
						% [tile.x, tile.y])
				continue
			if body.collision_layer != FLORA_BIT:
				bad.append("flora body layer %d (want %d) at %d_%d"
						% [body.collision_layer, FLORA_BIT, tile.x, tile.y])
			if body.collision_mask != 0:
				bad.append("flora body mask %d (want 0) at %d_%d"
						% [body.collision_mask, tile.x, tile.y])
			var shapes := 0
			for c: Node in body.get_children():
				if c is CollisionShape3D \
						and (c as CollisionShape3D).shape != null:
					shapes += 1
			if shapes != want * 2:
				bad.append("chunk %d_%d shapes %d (want %d — trunk+crown per tree)"
						% [tile.x, tile.y, shapes, want * 2])
			tree_shapes += shapes
	if tree_shapes != PACK_TREES * 2:
		bad.append("total flora shapes %d (want %d)"
				% [tree_shapes, PACK_TREES * 2])

	# --- the sample walk: isolated interior trees (the 3×3 near-doc cache ----
	## the canopy row uses — a neighbor crown cylinder within 7 m would eat a
	## cap ray aimed down another tree's axis; ≥ 10 m inside the tile keeps
	## the probes' ≤ 8 m travel inside cleared chunks).
	var near_cache: Dictionary = {}
	var near_doc := func(tile_v: Vector2i) -> Dictionary:
		if not near_cache.has(tile_v):
			near_cache[tile_v] = AmesBaker.read_chunk(AMES_CHUNKS_DIR,
					"chunk_%d_%d.json" % [tile_v.x, tile_v.y])
		return near_cache[tile_v]
	var samples: Array[Dictionary] = []
	var open_sample := {}
	for entry2: Dictionary in manifest.get("chunks", []):
		## Keep walking until BOTH legs are fed — one dense grove must not
		## exhaust the sample budget before an open chunk is ever reached
		## (the first run's flight probes starved exactly that way).
		if samples.size() >= 24 and not open_sample.is_empty():
			break
		var chunk2: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR,
				str(entry2["file"]))
		var trees2: Array = chunk2.get("trees", [])
		if trees2.is_empty():
			continue
		var tile2 := Vector2i(int(entry2["cx"]), int(entry2["cz"]))
		var chunk_open := (chunk2.get("massing", []) as Array).is_empty() \
				and (chunk2.get("placeholders", []) as Array).is_empty()
		for tr2: Dictionary in trees2:
			if samples.size() >= 24 and not open_sample.is_empty():
				break
			var p2: Array = tr2["p"]
			var px := float(p2[0])
			var pz := float(p2[2])
			var lx := px - float(tile2.x) * TILE
			var lz := pz - float(tile2.y) * TILE
			if lx < 10.0 or lz < 10.0 or lx > TILE - 10.0 \
					or lz > TILE - 10.0:
				continue
			var isolated := true
			for nx: int in range(tile2.x - 1, tile2.x + 2):
				if not isolated:
					break
				for nz: int in range(tile2.y - 1, tile2.y + 2):
					if not isolated:
						break
					var nd: Dictionary = near_doc.call(Vector2i(nx, nz))
					if nd.is_empty():
						continue
					for ot: Dictionary in nd.get("trees", []):
						var op: Array = ot["p"]
						var d := Vector2(float(op[0]) - px,
								float(op[2]) - pz).length()
						if d > 0.001 and d < 7.0:
							isolated = false
							break
			if not isolated:
				continue
			var rec := {"tr": tr2, "tile": tile2, "chunk": chunk2}
			if chunk_open and open_sample.is_empty():
				open_sample = rec
			if samples.size() < 24:
				samples.append(rec)
	if samples.size() < 8:
		bad.append("only %d isolated interior trees sampled (want ≥ 8)"
				% samples.size())
	if open_sample.is_empty():
		bad.append("no isolated tree in an open chunk for the flight probes")

	# --- 2. physics truth: crown cap, trunk flank, and the world-class miss --
	var space := get_world_3d().direct_space_state
	var cap_worst := 0.0
	var trunk_worst := 0.0
	for rec2: Dictionary in samples:
		var tr3: Dictionary = rec2["tr"]
		var spec: Dictionary = AmesBaker.TREE_ARCHETYPES[str(tr3["t"])]
		var p3: Array = tr3["p"]
		var s3: Array = tr3["s"]
		var radial := maxf(float(s3[0]), float(s3[2]))
		var axis := Vector3(float(p3[0]), 0.0, float(p3[2]))
		var crown_top := (float(spec["crown_cy"]) + float(spec["crown_ry"])) \
				* float(s3[1])
		# Down the crown axis: the cap face answers at crown_top, flora class.
		var cap_from := world.to_global(axis + Vector3(0.0, crown_top + 30.0, 0.0))
		var cap_to := world.to_global(axis + Vector3(0.0, 0.5, 0.0))
		var cap_ray := PhysicsRayQueryParameters3D.create(cap_from, cap_to)
		cap_ray.collision_mask = FLORA_BIT
		var cap_hit := space.intersect_ray(cap_ray)
		if cap_hit.is_empty():
			bad.append("crown cap ray missed at %s" % str(p3))
		else:
			var hy: float = world.to_local(cap_hit["position"]).y
			cap_worst = maxf(cap_worst, absf(hy - crown_top))
			if absf(hy - crown_top) > 0.05:
				bad.append("crown cap hit y %.2f != %.2f at %s"
						% [hy, crown_top, str(p3)])
			var hit_layer := int((cap_hit["collider"]
					as CollisionObject3D).collision_layer)
			if hit_layer & FLORA_BIT == 0:
				bad.append("crown cap hit a non-flora body (layer %d) at %s"
						% [hit_layer, str(p3)])
		# Into the trunk flank at y 2 (below every crown bottom — shore's is
		# (6.8 − 2.0) × 0.82 ≈ 3.9): the radial ray answers at the cylinder's
		# surface, exactly `trunk_r` out from the axis.
		var trunk_from := world.to_global(
				axis + Vector3(3.0, 2.0, 0.0))
		var trunk_to := world.to_global(axis + Vector3(0.0, 2.0, 0.0))
		var trunk_ray := PhysicsRayQueryParameters3D.create(trunk_from, trunk_to)
		trunk_ray.collision_mask = FLORA_BIT
		var trunk_hit := space.intersect_ray(trunk_ray)
		if trunk_hit.is_empty():
			bad.append("trunk flank ray missed at %s" % str(p3))
		else:
			var hx: float = world.to_local(trunk_hit["position"]).x
			var want_x := float(p3[0]) + float(spec["trunk_r"]) * radial
			trunk_worst = maxf(trunk_worst, absf(hx - want_x))
			if absf(hx - want_x) > 0.1:
				bad.append("trunk flank hit x %.2f != %.2f (r from axis) at %s"
						% [hx, want_x, str(p3)])
		# The world class (mask 1) must NEVER answer tree geometry: the same
		# crown-axis ray rides PAST the plate top (y 0 — the segment ends at
		# y −2 so the plate's top face is inside it; the first run ended at
		# y 0.5 and missed the plate everywhere) to the plate (or a covering
		# building's own top — the api_seam law) — any hit wears no flora bit.
		var world_ray := PhysicsRayQueryParameters3D.create(cap_from,
				world.to_global(axis + Vector3(0.0, -2.0, 0.0)))
		world_ray.collision_mask = 1
		var world_hit := space.intersect_ray(world_ray)
		if world_hit.is_empty():
			bad.append("world-class crown ray hit NOTHING at %s — the plate is gone?"
					% str(p3))
		else:
			var wlayer := int((world_hit["collider"]
					as CollisionObject3D).collision_layer)
			if wlayer & FLORA_BIT != 0:
				bad.append("world-class ray answered a flora body (layer %d) at %s"
						% [wlayer, str(p3)])

	# --- 3. the flight probes: the bird class is HELD, the citizen passes ----
	var probe_offs: Array[float] = []
	if not open_sample.is_empty():
		var tr4: Dictionary = open_sample["tr"]
		var spec4: Dictionary = AmesBaker.TREE_ARCHETYPES[str(tr4["t"])]
		var p4: Array = tr4["p"]
		var s4: Array = tr4["s"]
		var radial4 := maxf(float(s4[0]), float(s4[2]))
		var axis4 := Vector3(float(p4[0]), 0.0, float(p4[2]))
		var trunk_r4 := float(spec4["trunk_r"]) * radial4
		var crown_r4 := float(spec4["crown_rxz"]) * radial4
		var crown_mid4 := float(spec4["crown_cy"]) * float(s4[1])
		## Any radial approach — both cylinders are yaw-invariant.
		var dir4 := Vector3(1.0, 0.0, 0.0)
		## The bird class (player.tscn's exact mask): a 0.3 m sphere flying
		## straight at the tree at pigeon-cruise speed is HELD outside the
		## trunk cylinder (y 2, below every crown bottom) and outside the
		## crown cylinder (at crown mid-height).
		for probe_def: Array in [[2.0, trunk_r4 + 0.3, 6.0],
				[crown_mid4, crown_r4 + 0.3, 8.0]]:
			var y4 := float(probe_def[0])
			var min_hold := float(probe_def[1])
			var start4 := float(probe_def[2])
			var bird := CharacterBody3D.new()
			var bird_shape := CollisionShape3D.new()
			var sphere := SphereShape3D.new()
			sphere.radius = 0.3
			bird_shape.shape = sphere
			bird.add_child(bird_shape)
			bird.collision_layer = 2
			bird.collision_mask = 69 ## world + npc + flora — the player class.
			add_child(bird)
			bird.global_position = world.to_global(
					axis4 + dir4 * start4 + Vector3(0.0, y4, 0.0))
			for _i in 120: ## 2 s at 60 Hz — 8 m/s covers the start distance 4×.
				bird.velocity = -dir4 * 8.0
				bird.move_and_slide()
			var off4 := bird.global_position - world.to_global(axis4)
			var radial_off := Vector2(off4.x, off4.z).length()
			var along4 := off4.dot(dir4)
			probe_offs.append(radial_off)
			if radial_off < min_hold - 0.2:
				bad.append("bird probe at y %.1f reached %.2f m from the axis (hold ≥ %.2f — it flew through)"
						% [y4, radial_off, min_hold])
			if radial_off > start4:
				bad.append("bird probe at y %.1f never approached (%.2f m out)"
						% [y4, radial_off])
			if along4 < 0.0:
				bad.append("bird probe at y %.1f tunneled to the far side (along %.2f)"
						% [y4, along4])
			bird.queue_free()
		## The citizen class (tourist.tscn's exact mask): the SAME trunk-band
		## approach walks straight through — the flora layer is not in its
		## mask, the T-207 soft-world behavior the citizens keep.
		var walker := CharacterBody3D.new()
		var walker_shape := CollisionShape3D.new()
		var wsphere := SphereShape3D.new()
		wsphere.radius = 0.3
		walker_shape.shape = wsphere
		walker.add_child(walker_shape)
		walker.collision_layer = 4 ## npc
		walker.collision_mask = 1 ## world — the citizen class.
		add_child(walker)
		walker.global_position = world.to_global(
				axis4 + dir4 * 6.0 + Vector3(0.0, 2.0, 0.0))
		for _j in 120:
			walker.velocity = -dir4 * 8.0
			walker.move_and_slide()
		var woff := walker.global_position - world.to_global(axis4)
		var along := woff.dot(dir4)
		## "Walks straight through" = the walker CROSSED the axis to the far
		## side (the first run measured |offset| and caught it 10 m PAST the
		## tree — pass-through proven, the assert read backwards).
		if along > 0.5:
			bad.append("citizen probe stopped %.2f m short of the axis (mask 1 must walk straight through)"
					% along)
		walker.queue_free()

	# --- 4. the class law over the scene files -------------------------------
	for scene_path: String in SCENE_MASKS:
		var packed: PackedScene = load(scene_path) as PackedScene
		if packed == null:
			bad.append("scene missing: %s" % scene_path)
			continue
		var inst := packed.instantiate() as CollisionObject3D
		if inst == null:
			bad.append("scene root is not a physics body: %s" % scene_path)
			continue
		var want_mask := int(SCENE_MASKS[scene_path])
		if inst.collision_mask != want_mask:
			bad.append("%s mask %d (want %d — the flora law moved?)"
					% [scene_path.get_file(), inst.collision_mask, want_mask])
		if scene_path.contains("player") \
				and inst.collision_mask & FLORA_BIT == 0:
			bad.append("player lost the flora bit")
		if not scene_path.contains("player") \
				and inst.collision_mask & FLORA_BIT != 0:
			bad.append("%s rides the flora bit (citizens must pass through)"
					% scene_path.get_file())
		inst.free()

	print("SIM DATA %s: chunks=%d shapes=%d rays=%d cap_worst=%f trunk_worst=%f probe_offs=%s" % [
			S, tree_chunks, tree_shapes, samples.size(), cap_worst,
			trunk_worst, str(probe_offs)])
	_check(S, bad.is_empty(), "; ".join(bad))
	world.queue_free()


## A ring's bounding box (the membership walks' pre-filter).
func _ring_bounds(ring: PackedVector2Array) -> Rect2:
	var lo := ring[0]
	var hi := lo
	for v: Vector2 in ring:
		lo = lo.min(v)
		hi = hi.max(v)
	return Rect2(lo, hi - lo)


## TRUE when any ring whose box contains `p` passes the even-odd test.
func _rings_contain(p: Vector2, rings: Array[PackedVector2Array],
		boxes: Array[Rect2]) -> bool:
	for ri: int in rings.size():
		if boxes[ri].has_point(p) and _point_in_ring(p, rings[ri]):
			return true
	return false


## A one-line multiset equality read: "want=N got=M <key>" at the first drift,
## "" when equal (the law arms' shared form).
func _multiset_diff(want: Dictionary, got: Dictionary) -> String:
	if want.size() != got.size():
		return "bucket count %d != %d" % [want.size(), got.size()]
	for k: String in want:
		if int(got.get(k, 0)) != int(want[k]):
			return "want=%d got=%d at %s" % [int(want[k]), int(got.get(k, 0)),
					k.substr(0, 40)]
	return ""


## (T-203; T-204 + T-205 re-pins) The bbox east: the smallest map growth,
## fixing the census's own ⚠ (Bandshell Park sat ~30 m outside the v1 east
## edge). Data pack v2 — the E edge −93.6100 → −93.6070, +248 m east (the
## ticket's 200–300 m band); W/S/N and the origin are the census lines,
## untouched; T-204 grew south and T-205 north (the consts authority lives in
## `ames_extension_north`). FOUR legs, mostly pure data (the playable leg
## instantiates the world once):
## 1. THE CONSTS — meta carries the v4 box (version 4, schema ames_core/v4),
##    the v1 east + v2 south + v3 north edge stamps, and the original
##    widening measures 200–300 m east through the pack's own transform.
## 2. BANDSHELL INSIDE — the downtown_bandshell landmark flips `in_core`; the
##    park way (named "Bandshell Park") rides the pack's parks wholly inside
##    the new east edge; its lawn is painted on the bake (the park tile's
##    lawn_tris); and the supersede is 1:1 — the Durham Bandshell way
##    (way/269752151, the strip's newly-landed authored slot) rides the bake's
##    massing flagged authored while the manifest `heroes` list hides it at
##    runtime (the T-192 hero's own law, extended to the way that came inside).
## 3. PLAYABLE — over the park block the world answers ground 0.0 (flat lawn,
##    no box standing — the supersede holds), the render bounds span the block
##    (the ground plate + off-world guard cover it), and the nearest GROUND
##    bread spot is inside the T-176 reach band (150 m) at both the park
##    center and the bandshell POI.
## 4. THE RE-PIN, DIFF-PROVEN (+delta recorded, three strips deep) — the v1
##    census pins and the recorded strip deltas live as consts here; the
##    pack's counts must equal v1 + east + south + north on every moved
##    family; each strip's classification is proven strip-ONLY from the pack
##    data (the census §6 rule's split, guards disjoint — the east bucket
##    owns both corner growths, the south and north strips stay the
##    west-of-v1-east CSV-less sets); the meta delta keys must record all
##    three strips; the unchanged families (venues 14/17/17, landmarks 15)
##    stay pinned, and the at-grade rail crossings now pin the 14 (the
##    census 9 + the north strip's 5 the v4 box revealed).
func _scenario_ames_bbox_east() -> void:
	const S := "ames_bbox_east"
	## The v1 census pins (BUILD-CENSUS §1/§3/§5 + the T-171 pack), the
	## recorded T-203 east-strip deltas, and the recorded T-204 south-strip
	## deltas — THE "+delta recorded" record, two strips deep.
	const V1_BUILDINGS := 3737
	const V1_NAMED := 512
	const V1_TREES := 5637
	const V1_PARKING_LOTS := 480
	const V1_PARKING_HA := 73.6
	const V1_STREET_KM := 91.93
	const V1_EXTRA3_KM := 99.6
	const EAST_BUILDINGS := 711 ## v2 397 (44/3/350); the v3 south widening
	const EAST_NAMED := 58 ##    grew the box past the strip's southern tail
	const EAST_SEMI := 3 ##      (+113 SE-corner buildings) and the v4 north
	const EAST_PROCEDURAL := 650 ## widening past its northern tail (+201
	const EAST_TREES := 78 ##    NE-corner buildings; the east guard fires
	const EAST_PARKING_LOTS := 52 ## first, so both corner growths ride HERE).
	const EAST_PARKING_HA := 9.45
	const EAST_STREET_KM := 6.11
	const EAST_EXTRA3_KM := 6.1
	const SOUTH_BUILDINGS := 713 ## The T-204 strip: CSV-less, south of the
	const SOUTH_NAMED := 47 ##    v2 south edge AND west of the v1 east edge
	const SOUTH_SEMI := 9 ##      (the §6 rule split; disjoint from the east).
	const SOUTH_PROCEDURAL := 657
	const SOUTH_TREES := 391
	const SOUTH_PARKING_LOTS := 39
	const SOUTH_PARKING_HA := 11.38
	const SOUTH_STREET_KM := 25.36
	const SOUTH_EXTRA3_KM := 29.0
	const NORTH_BUILDINGS := 5622 ## The T-205 strip: CSV-less, north of the
	const NORTH_NAMED := 65 ##    v3 north edge AND west of the v1 east edge
	const NORTH_SEMI := 27 ##     (the §6 rule split; disjoint from the others).
	const NORTH_PROCEDURAL := 5530
	const NORTH_TREES := 647
	const NORTH_PARKING_LOTS := 68
	const NORTH_PARKING_HA := 19.54
	const NORTH_STREET_KM := 137.87
	const NORTH_EXTRA3_KM := 141.2
	const REACH_BAR := 150.0 ## The T-176 gate band (bread_reach's own bar).
	var bad: PackedStringArray = PackedStringArray()

	# --- leg 1: the consts (the v4 box — T-205 grew the north edge; the
	# consts authority is `ames_extension_north`) --------------------------
	var meta: Dictionary = AmesDataPack.meta()
	var bbox: Array = meta.get("core_bbox_wsen", [])
	if [str(meta.get("pack", "")), int(meta.get("version", 0)),
			str(meta.get("schema", ""))] != ["ames_core", 4, "ames_core/v4"]:
		bad.append("boot: pack=%s version=%s schema=%s (want ames_core/4/ames_core/v4)"
				% [meta.get("pack"), meta.get("version"), meta.get("schema")])
	if bbox.size() < 4 or [float(bbox[0]), float(bbox[1]), float(bbox[2]),
			float(bbox[3])] != [-93.659, 42.003, -93.607, 42.078]:
		bad.append("core_bbox_wsen=%s (want the v4 box: E −93.607, S 42.003, N 42.078)" % str(bbox))
	var v1_east: float = float(meta.get("core_bbox_east_v1", 0.0))
	if not is_equal_approx(v1_east, -93.61):
		bad.append("core_bbox_east_v1=%s (want −93.61)" % str(v1_east))
	var v2_south: float = float(meta.get("core_bbox_south_v2", 0.0))
	if not is_equal_approx(v2_south, 42.012):
		bad.append("core_bbox_south_v2=%s (want 42.012)" % str(v2_south))
	var v3_north: float = float(meta.get("core_bbox_north_v3", 0.0))
	if not is_equal_approx(v3_north, 42.0355):
		bad.append("core_bbox_north_v3=%s (want 42.0355)" % str(v3_north))
	var m_per_deg_lon := 111320.0 * cos(deg_to_rad(42.02))
	var grown_m := (-93.607 - v1_east) * m_per_deg_lon
	if grown_m < 200.0 or grown_m > 300.0:
		bad.append("eastward growth %.1f m outside the ticket's 200–300 m band"
				% grown_m)

	# --- leg 2: Bandshell inside ------------------------------------------
	var bandshell: Dictionary = {}
	for p: Dictionary in AmesDataPack.landmarks():
		if str(p.get("id", "")) == "downtown_bandshell":
			bandshell = p
			break
	if bandshell.is_empty():
