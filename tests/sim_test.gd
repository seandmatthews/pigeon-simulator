	]


func _xf_arrays_equal(a: Array, b: Array) -> bool:
	if a.size() != b.size():
		return false
	for i in a.size():
		if not (a[i] as Transform3D).is_equal_approx(b[i] as Transform3D):
			return false
	return true


## The obey arms at one signal corner: a staged mover drives the corner's
## widest primary approach to its line, timed so its registration lands ~3 s
## into a RED window for its phase group — while red it holds (speed < 0.3,
## committed false) with the patience clock FROZEN (a red never force-commits),
## then rolls within the green (committed inside 2 s of the phase flip, past
## the bar). The crosswalk arm stages a fresh mover timed into a GREEN window
## with the pigeon parked in the corner's real eastbound band: registered and
## green, the car stays (committed false for ≥ 3 s of green — pedestrian
## priority). Returns {ok, detail}.
func _intersections_signal_obey(graph: AmesTrafficGraph, anchor: int) -> Dictionary:
	var node := graph.intersection_signal_node(anchor)
	var edge := -1
	for e in graph.edge_count():
		if graph.edge_to(e) == node and graph.edge_class(e) == "primary" \
				and graph.edge_length(e) > 60.0:
			edge = e
			break
	if edge < 0:
		return {"ok": false, "detail": "no primary approach into the corner"}
	var group := graph.approach_signal_group(node, edge)
	var spawner := CarSpawner.new()
	spawner.city = _city
	spawner.player = _player
	spawner.target_moving = 0
	spawner.target_parked = 0
	spawner.name = "CarSpawner_intersections"
	add_child(spawner)
	await _wait_frames(2)
	## The mover stages ~22 m before its node (≈ 8 m before its line) —
	## accel-from-rest plus the brake profile register it ≈ 2.7 s later.
	## Time the staging into a red window for the entry's phase group.
	var drive_s := 2.7
	var stage_at := _next_phase_frame(group, false, drive_s, 3.0)
	await _wait_frames(maxi(stage_at - int(TrafficControl.now() * 60.0), 1))
	var mover := _intersections_stage_mover(spawner, graph, edge)
	## The red hold: registered, speed 0, patience frozen — sampled across ≥
	## 1.5 s of remaining red, then the green commit inside 2.5 s of the flip.
	var red_seen := 0
	var patience_a := -1.0
	var patience_b := -1.0
	var committed_at := -1.0
	var t_reg := -1.0
	for f in 30 * 60:
		await _wait_frames(1)
		var entry: Dictionary = mover.stops[0] if mover.stops.size() > 0 else {}
		if not bool(entry.get("registered", false)):
			continue
		if t_reg < 0.0:
			t_reg = TrafficControl.now()
		var red := TrafficControl.signal_red_for_group(group)
		var hspeed := Vector2(mover.velocity.x, mover.velocity.z).length()
		if red and not bool(entry.get("committed", false)):
			red_seen += 1
			if patience_a < 0.0:
				patience_a = mover._patience
			patience_b = mover._patience
			if hspeed > 0.35:
				red_seen = -999 ## A red hold that let the car roll: defect.
		if bool(entry.get("committed", false)) and committed_at < 0.0:
			committed_at = TrafficControl.now() - t_reg
		if committed_at >= 0.0 \
				and Vector2(mover.velocity.x, mover.velocity.z).length() > 1.0:
			break
		if f > 25 * 60:
			break
	var red_ok := red_seen >= 60 and patience_a >= 0.0 \
			and absf(patience_b - patience_a) < 0.001 \
			and committed_at >= 0.0 and committed_at <= 13.0
	## The crosswalk arm: a fresh mover timed into a GREEN window with the
	## pigeon standing in the corner's real band — the yield holds it.
	var geo := graph.approach_geometry(node, edge)
	var band: Dictionary = geo["band"]
	var band_global := _city.to_global(
			Vector3(band["center"].x, 0.0, band["center"].y))
	await _set_up(false, band_global, Vector3.ZERO)
	await _await_grounded(60)
	var stage2 := _next_phase_frame(group, true, drive_s, 3.0)
	await _wait_frames(maxi(stage2 - int(TrafficControl.now() * 60.0), 1))
	var mover2 := _intersections_stage_mover(spawner, graph, edge)
	var green_hold := 0
	var t2_reg := -1.0
	for f in 30 * 60:
		await _wait_frames(1)
		var entry2: Dictionary = mover2.stops[0] if mover2.stops.size() > 0 else {}
		if not bool(entry2.get("registered", false)):
			continue
		if t2_reg < 0.0:
			t2_reg = TrafficControl.now()
		if not TrafficControl.signal_red_for_group(group) \
				and not bool(entry2.get("committed", false)) \
				and mover2._crosswalk_blocked(entry2):
			green_hold += 1
		if f > 25 * 60:
			break
	var yield_ok := green_hold >= 120 and t2_reg >= 0.0
	mover.queue_free()
	mover2.queue_free()
	spawner.free()
	await _wait_frames(2)
	var ok := red_ok and yield_ok
	var detail := "red_frames=%d patience_delta=%.3f committed@+%.1fs green_hold_frames=%d" % [
			red_seen, absf(patience_b - patience_a), committed_at, green_hold]
	return {"ok": ok, "detail": detail}


## Stages one traffic mover on a directed edge aimed at the corner (the calm
## probes' production-stamp shape).
func _intersections_stage_mover(spawner: CarSpawner,
		graph: AmesTrafficGraph, edge: int) -> Car:
	var lane := graph.edge_points(edge)
	var arc := maxf(graph.edge_length(edge) - 22.0, 5.0)
	var start := _lane_arc_point(lane, arc)
	var path := PackedVector3Array()
	var acc := 0.0
	for i in range(1, lane.size()):
		acc += lane[i - 1].distance_to(lane[i])
		if acc >= arc + 8.0:
			path.append(_city.to_global(Vector3(lane[i].x, 0.0, lane[i].y)))
	if path.is_empty():
		var last := lane[lane.size() - 1]
		path.append(_city.to_global(Vector3(last.x, 0.0, last.y)))
	var car: Car = CAR_SCENE.instantiate() as Car
	car.traffic = spawner.traffic_ctrl
	car.player = _player
	add_child(car)
	var stops: Array[Dictionary] = [spawner._stop_entry_graph(
			graph.edge_to(edge), edge, -1)]
	car.start_route(_city.to_global(Vector3(start.x, 0.0, start.y)), path,
			stops, spawner._edge_block_global(edge), PackedVector3Array(),
			graph.edge_to(edge))
	return car


## The first future frame that sits EARLY in a phase window serving the
## wanted color for `group` — at least `drive_s` of staging drive plus
## `lead_s` ahead, and within the first `lead_s` of the window, so the
## registration lands with most of the window still to run. Deterministic
## off the physics clock.
func _next_phase_frame(group: int, want_green: bool, drive_s: float,
		lead_s: float) -> int:
	var start_frame := int(TrafficControl.now() * 60.0) + int((drive_s + lead_s) * 60.0)
	var wanted_phase := group if want_green else 1 - group
	var window := int(TrafficControl.SIGNAL_GREEN_SECONDS * 60.0)
	var frame := start_frame
	for _k in 6:
		if int(frame / window) % 2 == wanted_phase \
				and frame % window < int(lead_s * 60.0):
			return frame
		frame += window - (frame % window)
	return start_frame


## --- scenarios (T-185 Lake LaVerne + the swans) ----------------------------


## (T-185) The lake cluster's R3 ticket, machine-checked on the resident Ames
## world. Arms, every expectation re-derived from the COMMITTED PACK (the
## no-self-test rule — never through the world's own constants):
## 1. THE SWANS: exactly TWO (`Lancelot`, `Elaine`), each the bird rig
##    (`swan.gd`/`swan.tscn` — NOT the T-138 people rig: no PeopleRig, no
##    AnimationPlayer, no citizen class) and structurally yield-ing: no
##    PhysicsBody3D and no Area3D anywhere in the bird, no splat/eat hooks —
##    not perchable, not splat-able, not bread-able (the owner scope guard).
## 2. THE CIRCUIT: the world's closed loop is IN-POLYGON at every point
##    (in the water, Swan Island excluded) with a ≥ 2.0 m shore clearance,
##    and its span ≤ 122 m (the AC bar; the probe-measured 54 m pins the
##    sanity band [50, 70] — a degenerate dot or a shore-hugging ring fails),
##    and it ACTUALLY carries the birds: each swan advances ≥ 3 m along it
##    over the live window.
## 3. NEVER LEAVE THE WATER: 600 live frames (10 s — one full tuck period)
##    sampling BOTH swans every frame: every world-local XZ position
##    in-polygon (own ring walk + even-odd), y riding the water top + the
##    wake bob (|y| ≤ 0.15), total travel ≥ 3 m, and the idle proved live —
##    the y bob oscillates (> 0.005 m range) and a wing pivot moves its
##    fold (rotation range > 0.05 rad) within the window.
## 4. DIMS RE-PIN: the pack's LaVerne rings measure 236×122 m (±2, the
##    survey ground truth ames_placeholder_dims pins on the bake) and the
##    shore read the ticket owns is PRESENT: every ring-split edge carries a
##    pale waterline fringe quad hugging the ring (center ≤ width + 0.5 m
##    off it) at the pinned stack level (origin y 0.02 → top 0.03, above the
##    shore band's 0.018 and the water's 0.02), plus ≥ 1 reed clump standing
##    IN the water (origin in-polygon) within 1.6 m of the waterline.
## The T-163 sit law needs no arm here: this ticket ships no bench, seat or
## sit code — the sit rows (`elder_seats_on_the_bench`,
## `sitters_clear_their_seats`) run unchanged in this same suite and are the
## untouched proof.
func _scenario_laverne_swans() -> void:
	const S := "laverne_swans_present"
	var bad: PackedStringArray = PackedStringArray()
	var city: AmesWorld = _city as AmesWorld
	if city == null:
		_check(S, false, "the harness world is not the Ames world")
		return

	# --- 1. exactly two, the bird rig, yields to everything ----------------
	var swans: Array[Swan] = city.swans
	if swans.size() != 2:
		bad.append("swans=%d != exactly 2" % swans.size())
	var names := {}
	for swan: Swan in swans:
		names[swan.name] = true
		if swan.get_script() != SWAN_SCRIPT:
			bad.append("%s is not the swan.gd bird rig" % swan.name)
		if swan.circuit.size() < 3:
			bad.append("%s swims no circuit" % swan.name)
		var stack: Array[Node] = [swan]
		while not stack.is_empty():
			var child: Node = stack.pop_back()
			if child is PhysicsBody3D or child is Area3D:
				bad.append("%s carries a physics node (%s) — must yield" % [
						swan.name, child.get_class()])
				break
			if child is AnimationPlayer:
				bad.append("%s carries an AnimationPlayer — the bird rig is not the people rig" % swan.name)
				break
			stack.append_array(child.get_children())
		if swan.has_method("on_splatted") or swan.has_method("eat"):
			bad.append("%s carries a splat/eat hook — ambient only" % swan.name)
	for want: String in ["Lancelot", "Elaine"]:
		if not names.has(want):
			bad.append("swan %s missing" % want)
	if not bad.is_empty():
		_check(S, false, "; ".join(bad))
		return

	# --- 2. the circuit: in-polygon, clearance, span, real ----------------
	var rings: Array[PackedVector2Array] = _pack_split_rings(
			AmesDataPack.water()[0].get("polygon", []))
	var basin := PackedVector2Array()
	var island := PackedVector2Array()
	for ring: PackedVector2Array in rings:
		if ring.size() > basin.size():
			island = basin
			basin = ring
		else:
			island = ring
	if basin.size() < 3:
		bad.append("no LaVerne basin ring in the pack")
	var circuit: PackedVector3Array = city.swan_circuit
	if circuit.size() < 16:
		bad.append("swan_circuit has %d points — not a real loop" % circuit.size())
	else:
		var lo := Vector2(INF, INF)
		var hi := Vector2(-INF, -INF)
		var worst_edge := INF
		for pv: Vector3 in circuit:
			var p := Vector2(pv.x, pv.z)
			lo = lo.min(p)
			hi = hi.max(p)
			if not _point_in_ring(p, basin) or _point_in_ring(p, island):
				bad.append("circuit point (%.1f, %.1f) outside the water" % [p.x, p.y])
				break
			worst_edge = minf(worst_edge, _poly_edge_dist(p, basin))
		var span := hi - lo
		if span.x > 122.0 or span.y > 122.0:
			bad.append("circuit span %.1fx%.1f exceeds the 122 m bar" % [span.x, span.y])
		if span.x < 50.0 or span.y < 50.0:
			bad.append("circuit span %.1fx%.1f below the pinned sanity band (probe 54x54)" % [span.x, span.y])
		if worst_edge < 2.0:
			bad.append("circuit hugs the shore (%.2f m clearance, pinned >= 2.0)" % worst_edge)

	# --- 3 + 4 pack dims: the water at its survey ground truth ------------
	var wlo := Vector2(INF, INF)
	var whi := Vector2(-INF, -INF)
	for ring2: PackedVector2Array in rings:
		for q: Vector2 in ring2:
			wlo = wlo.min(q)
			whi = whi.max(q)
	var water_span := whi - wlo
	if absf(water_span.x - 236.0) > 2.0 or absf(water_span.y - 122.0) > 2.0:
		bad.append("pack lake %.1fx%.1f != survey 236x122 (+-2)" % [water_span.x, water_span.y])

	# --- 5. the shore read the ticket owns: pale fringe + reeds -----------
	var pale: Array[Transform3D] = city._pale_edge_xfs
	var reeds: Array[Transform3D] = city._reed_xfs
	if pale.is_empty():
		bad.append("no pale waterline fringe queued — the shore read is missing")
	## Nearest-ring edge distance (the island's own shoreline carries its
	## fringe/reeds too — they hug THAT ring, not the basin's).
	var ring_edge_dist := func(p: Vector2) -> float:
		var best := INF
		for ring3: PackedVector2Array in rings:
			best = minf(best, _poly_edge_dist(p, ring3))
		return best
	var pale_hug := 0.0
	for xf: Transform3D in pale:
		if absf(xf.origin.y - 0.02) > 1e-6:
			bad.append("pale fringe origin y %.3f != the pinned 0.02 (top 0.03)" % xf.origin.y)
			break
		pale_hug = maxf(pale_hug, ring_edge_dist.call(Vector2(xf.origin.x, xf.origin.z)))
	## The stock recount from the pack (the skeleton-palette ring walk): one
	## fringe quad per non-degenerate ring-split edge; one reed clump on the
	## hash-picked ≥ 6 m edges, three slivers each.
	var want_pale := 0
	var want_clumps := 0
	var counter := 0
	for ring4: PackedVector2Array in rings:
		for i4: int in ring4.size():
			var a4 := ring4[i4]
			var b4 := ring4[(i4 + 1) % ring4.size()]
			var edge4 := b4 - a4
			if edge4.length_squared() < 1e-10:
				continue
			want_pale += 1
			var h4 := hash(str(counter))
			counter += 1
			if h4 % 3 == 0 and edge4.length() >= 6.0:
				want_clumps += 1
	if pale.size() != want_pale:
		bad.append("pale quads %d != ring-split edge recount %d" % [pale.size(), want_pale])
	if want_clumps == 0:
		bad.append("the reed hash picked no clumps — the hint is empty")
	elif reeds.size() != want_clumps * 3:
		bad.append("reed slivers %d != clump recount %d x3" % [reeds.size(), want_clumps])
	if pale_hug > 1.7: ## PALE_EDGE_WIDTH 1.2 + slack — the fringe hugs the ring.
		bad.append("pale fringe strays %.2f m off the lake ring" % pale_hug)
	if reeds.is_empty():
		bad.append("no reed clumps queued — the reed hint is missing")
	var worst_reed := 0.0
	for xf2: Transform3D in reeds:
		var p2 := Vector2(xf2.origin.x, xf2.origin.z)
		if not _point_in_ring(p2, basin) or _point_in_ring(p2, island):
			bad.append("reed sliver at (%.1f, %.1f) not standing in the water" % [p2.x, p2.y])
			break
		if xf2.origin.y < 0.29 or xf2.origin.y > 0.55:
			bad.append("reed sliver height %.2f out of the pinned 0.6..1.1 band" % (xf2.origin.y * 2.0))
			break
		worst_reed = maxf(worst_reed, ring_edge_dist.call(p2))
	if worst_reed > 1.6: ## REED_INSET 1.0 + stand-offset slack.
		bad.append("reed sliver strays %.2f m off the waterline" % worst_reed)

	if not bad.is_empty():
		_check(S, false, "; ".join(bad))
		return

	# --- 3. the live birds: 600 frames, in-polygon ALWAYS -----------------
	var y_min := INF
	var y_max := -INF
	var wing_lo := INF
	var wing_hi := -INF
	var travel := 0.0
	var prev := PackedVector3Array()
	for swan2: Swan in swans:
		prev.append(swan2.global_position)
	var out_count := 0
	var first_out := ""
	for f: int in 600:
		await _wait_frames(1)
		for k: int in swans.size():
			var swan3: Swan = swans[k]
			var g := swan3.global_position
			var local := city.to_local(g)
			var pxz := Vector2(local.x, local.z)
			if not _point_in_ring(pxz, basin) or _point_in_ring(pxz, island):
				out_count += 1
				if first_out.is_empty():
					first_out = "%s at (%.1f, %.1f) frame %d" % [swan3.name, pxz.x, pxz.y, f]
			if absf(local.y) > 0.15:
				bad.append("%s rides y %.3f off the water top" % [swan3.name, local.y])
			y_min = minf(y_min, local.y)
			y_max = maxf(y_max, local.y)
			var wl: Node3D = swan3.wing_l
			wing_lo = minf(wing_lo, wl.rotation.z)
			wing_hi = maxf(wing_hi, wl.rotation.z)
			var d := g.distance_to(prev[k])
			if d < 0.2:
				travel += d
			prev[k] = g
	if out_count > 0:
		bad.append("swans left the water %d frames (first: %s)" % [out_count, first_out])
	if travel < 3.0:
		bad.append("swans traveled %.1f m over 10 s — not circuiting" % travel)
	if y_max - y_min <= 0.005:
		bad.append("no wake bob (y range %.4f)" % (y_max - y_min))
	if wing_hi - wing_lo <= 0.05:
		bad.append("no wing-tuck idle (pivot range %.4f rad)" % (wing_hi - wing_lo))
	_check(S, bad.is_empty(), "pale=%d reeds=%d travel=%.1f bob=%.3f tuck=%.3f; %s"
			% [pale.size(), reeds.size(), travel, y_max - y_min,
			wing_hi - wing_lo, "; ".join(bad)])


## --- scenarios (T-186 the campanile hero) ----------------------------------


## (T-186) The campanile hero re-pins T-175's dims row onto the HERO. The bake
## slot is read independently (the four placeholder parts — the 1:1 anchor:
## same id `way/183041212`, same chunk, same position), then the hero is
## proved on a live world through four arms:
## A. THE SCHEDULE — the retained part record: the stack tops out at the
##    survey's settled 33.5 m (the AC bar ±2 m), the plinth rides the bake
##    slot's exact center (6.8 × 6.7), the shaft is the slender 4.9 m needle,
##    THREE arcade crowns stack in the head band (28.4 / 29.5 / 30.9 — the
##    three open-arcade tiers) and the landable deck closes at 33.5;
## B. THE COLLISION CLASS, live — the hero's own shapes answer the T-175
##    probe set on the REAL physics space: the shaft's west-face ray hits at
##    the 4.9 m face (±0.3), a vertical ray at the slot center lands on the
##    deck at 33.5 ± 0.05, and the chunk body stays layer-1 `world`;
## C. THE OPEN ARCADES, live — at each tier's opening height a ray through
##    the openings MISSES (perch-through: only piers/mullions/crowns collide)
##    while the same-height pier rays HIT at each tier's own face;
## D. THE SWAP, 1:1 — the chunk's gray `Placeholders` MultiMesh lost exactly
##    the four campanile parts (its instance_count == the file's count − 4,
##    both walked independently), the `HeroCampanile` family is mounted under
##    that same chunk node, the superseded slots file NO ground tops anymore
##    (the hero's own tops answer: the center queries the 33.5 deck, a point
##    5 m east queries the plate) and the anchor-cap crumb stays pinned at
##    the cap top + `City.ANCHOR_CRUMB_LIFT` (±0.005).
func _scenario_campanile_hero_dims() -> void:
	const S := "campanile_hero_dims"
	const CAM_ID := "way/183041212"
	var bad: PackedStringArray = PackedStringArray()
	## The bake slot, walked independently (the no-self-test rule).
	var cap_top := 0.0
	var slot_center := Vector2.ZERO
	var baked_parts := 0
	var slot_chunk := Vector2i(10, 10)
	var slot_chunk_ph_count := 0
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		var carries := false
		for ph: Dictionary in doc.get("placeholders", []):
			if str(ph.get("id", "")) != CAM_ID:
				continue
			carries = true
			baked_parts += 1
			if str(ph.get("part", "")) == "cap":
				cap_top = float(ph["p"][1]) + float(ph["s"][1]) * 0.5
			elif str(ph.get("part", "")) == "shaft":
				slot_center = Vector2(float(ph["p"][0]), float(ph["p"][2]))
		if carries:
			slot_chunk = Vector2i(int(entry["cx"]), int(entry["cz"]))
			slot_chunk_ph_count = (doc.get("placeholders", []) as Array).size()
	if baked_parts != 4 or slot_center == Vector2.ZERO or absf(cap_top - 33.5) > 0.01 \
			or slot_chunk_ph_count < 4:
		_check(S, false, "bake slot mismatch: parts=%d cap_top=%.2f center=%s chunk=%s(%d)"
				% [baked_parts, cap_top, slot_center, slot_chunk, slot_chunk_ph_count])
		return
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	## --- A. the retained schedule (world-local == pack-local) ---------------
	var parts := world.campanile_hero_parts
	var stack_top := -1.0
	if parts.is_empty():
		bad.append("no retained hero parts — the hero never built")
	else:
		var lo := Vector3(INF, INF, INF)
		var hi := Vector3(-INF, -INF, -INF)
		var plinth_seen := false
		var shaft_seen := false
		var deck_seen := false
		var crowns: Array[float] = []
		for part: Dictionary in parts:
			var p: Vector3 = part["p"]
			var s: Vector3 = part["s"]
			lo = lo.min(p - s * 0.5)
			hi = hi.max(p + s * 0.5)
			if s.is_equal_approx(Vector3(6.8, 2.0, 6.7)):
				plinth_seen = true
				if Vector2(p.x, p.z).distance_to(slot_center) > 0.01:
					bad.append("plinth %s off the bake slot %s" % [p, slot_center])
			elif s.is_equal_approx(Vector3(4.9, 24.4, 4.9)):
				shaft_seen = true
				if Vector2(p.x, p.z).distance_to(slot_center) > 0.01:
					bad.append("shaft %s off the bake slot %s" % [p, slot_center])
			elif s.is_equal_approx(Vector3(2.5, 0.2, 2.45)):
				deck_seen = true
				if absf((p.y + s.y * 0.5) - 33.5) > 0.005:
					bad.append("deck top %.3f != the settled 33.5" % (p.y + s.y * 0.5))
			elif s.y > 0.25 and s.y < 0.4 and p.y > 26.4 and p.y < 30.9 \
					and s.x > 4.0:
				crowns.append(snappedf(p.y + s.y * 0.5, 0.01)) ## A tier crown's top.
		if not plinth_seen:
			bad.append("no 6.8x2.0x6.7 plinth in the schedule")
		if not shaft_seen:
			bad.append("no 4.9x24.4x4.9 shaft in the schedule")
		if not deck_seen:
			bad.append("no 2.5x0.2x2.45 deck in the schedule")
		crowns.sort()
		if crowns.size() != 3:
			bad.append("arcade crowns %d != the three tiers (found %s)" % [crowns.size(), crowns])
		for want: float in [28.4, 29.5, 30.9]:
			var hit := false
			for got: float in crowns:
				if absf(got - want) <= 0.02:
					hit = true
					break
			if not hit:
				bad.append("tier crown %.1f missing from %s" % [want, crowns])
		stack_top = hi.y
		if absf(hi.y - 33.5) > 2.0:
			bad.append("hero top %.2f outside the AC bar 33.5 ±2" % hi.y)
		if absf(lo.y) > 0.01:
			bad.append("hero base %.2f off the plate" % lo.y)
	## --- B. the collision class, live ---------------------------------------
	var space := get_world_3d().direct_space_state
	var shaft_from := world.to_global(Vector3(slot_center.x - 20.0, 15.0, slot_center.y))
	var shaft_to := world.to_global(Vector3(slot_center.x, 15.0, slot_center.y))
	var shaft_ray := PhysicsRayQueryParameters3D.create(shaft_from, shaft_to)
	shaft_ray.collision_mask = 1
	var shaft_hit := space.intersect_ray(shaft_ray)
	if shaft_hit.is_empty():
		bad.append("shaft ray missed — the hero carries no layer-1 collider")
	else:
		var face_x: float = world.to_local(shaft_hit["position"]).x
		if absf(face_x - (slot_center.x - 2.45)) > 0.3:
			bad.append("shaft ray hit x %.2f != the 4.9 face %.2f (+-0.3)"
					% [face_x, slot_center.x - 2.45])
	var deck_from := world.to_global(Vector3(slot_center.x, 40.0, slot_center.y))
	var deck_to := world.to_global(Vector3(slot_center.x, 30.0, slot_center.y))
	var deck_ray := PhysicsRayQueryParameters3D.create(deck_from, deck_to)
	deck_ray.collision_mask = 1
	var deck_hit := space.intersect_ray(deck_ray)
	if deck_hit.is_empty():
		bad.append("deck ray missed — the landable pad is gone")
	else:
		var deck_y: float = world.to_local(deck_hit["position"]).y
		if absf(deck_y - 33.5) > 0.05:
			bad.append("deck ray hit y %.3f != the pad 33.5 (+-0.05)" % deck_y)
	var chunk_node := world.get_node_or_null(
			"Chunks/Chunk_%d_%d" % [slot_chunk.x, slot_chunk.y]) as Node3D
	if chunk_node == null:
		bad.append("chunk %s missing" % slot_chunk)
	else:
		## The name lookup cannot serve here — the gray MM took the
		## "Placeholders" name first, so Godot auto-renamed the body. Scan.
		var bodies: Array[StaticBody3D] = []
		for child: Node in chunk_node.get_children():
			if child is StaticBody3D:
				bodies.append(child)
		if bodies.is_empty():
			bad.append("chunk carries no static bodies — the collision class moved")
		for b: StaticBody3D in bodies:
			## (T-217) the canopy's flora body rides layer 7 beside the world
			## body in tree-bearing chunks — the only legal second class
			## (bird-only collision, mask 0).
			if b.collision_layer == 64:
				continue
			if b.collision_layer != 1:
				bad.append("body %s layer %d != 1 (world)" % [b.name, b.collision_layer])
	## --- C. the open arcades, live ------------------------------------------
	## [ray y, opening z-offsets (miss), pier z-offset, expected pier face x]
	var probes := [
		[27.2, [-0.95, 0.95], 2.075, slot_center.x - 2.45], ## Tier 1.
		[28.85, [-0.96, 0.96], 2.05, slot_center.x - 2.35], ## Tier 2.
		[30.025, [0.0], 1.975, slot_center.x - 2.25], ## Tier 3.
	]
	for probe: Array in probes:
		for off: float in probe[1]:
			var miss_from := world.to_global(Vector3(slot_center.x - 10.0, probe[0],
					slot_center.y + off))
			var miss_to := world.to_global(Vector3(slot_center.x + 10.0, probe[0],
					slot_center.y + off))
			var miss_ray := PhysicsRayQueryParameters3D.create(miss_from, miss_to)
			miss_ray.collision_mask = 1
			if not space.intersect_ray(miss_ray).is_empty():
				bad.append("tier y %.2f opening blocked at z%+.2f — the arcade is not open" % [
						probe[0], off])
		var pier_from := world.to_global(Vector3(slot_center.x - 10.0, probe[0],
				slot_center.y + float(probe[2])))
		var pier_to := world.to_global(Vector3(slot_center.x, probe[0],
				slot_center.y + float(probe[2])))
		var pier_ray := PhysicsRayQueryParameters3D.create(pier_from, pier_to)
		pier_ray.collision_mask = 1
		var pier_hit := space.intersect_ray(pier_ray)
		if pier_hit.is_empty():
			bad.append("tier y %.2f pier ray missed — no pier collider" % probe[0])
		else:
			var pier_x: float = world.to_local(pier_hit["position"]).x
			if absf(pier_x - float(probe[3])) > 0.3:
				bad.append("tier y %.2f pier hit x %.2f != face %.2f (+-0.3)" % [
						probe[0], pier_x, float(probe[3])])
	## --- D. the swap, 1:1 ----------------------------------------------------
	if chunk_node != null:
		## The gray family's MM lives on the chunk ROOT (its "Placeholders"
		## name is why the BODY got auto-renamed — scan by type + name).
		var found_mm := false
		var mm_count := -1
		for child: Node in chunk_node.get_children():
			if child is MultiMeshInstance3D and (child as MultiMeshInstance3D).name == "Placeholders":
				found_mm = true
				mm_count = (child as MultiMeshInstance3D).multimesh.instance_count
				break
		if not found_mm:
			## The family may legitimately VANISH: when the chunk's whole gray
			## family WAS the slot (chunk_1_-2 carries exactly the campanile's
			## four parts), the renderer builds no Placeholders MM at all —
			## the honest 1:1 for a single-hero chunk.
			if slot_chunk_ph_count != 4:
				bad.append("chunk has no gray Placeholders MM and %d other parts — the family vanished, not swapped"
						% (slot_chunk_ph_count - 4))
		elif mm_count != slot_chunk_ph_count - 4:
			bad.append("gray MM instances %d != file %d - 4 (the slot did not swap 1:1)" % [
					mm_count, slot_chunk_ph_count])
		var hero := chunk_node.get_node_or_null("HeroCampanile") as Node3D
		if hero == null:
			bad.append("no HeroCampanile family under the chunk")
		else:
			var hero_boxes := hero.get_node_or_null("Boxes") as MultiMeshInstance3D
			if hero_boxes == null:
				bad.append("HeroCampanile carries no Boxes MM")
			elif hero_boxes.multimesh.instance_count != world.campanile_hero_parts.size():
				bad.append("hero MM instances %d != record %d" % [
						hero_boxes.multimesh.instance_count, world.campanile_hero_parts.size()])
	## The ground record: the hero files its own true tops.
	var deck_query := world.ground_height(world.to_global(Vector3(slot_center.x, 0.0, slot_center.y)))
	if absf(deck_query - 33.5) > 0.005:
		bad.append("ground record at the slot center answers %.3f != the deck 33.5" % deck_query)
	var plate_query := world.ground_height(world.to_global(Vector3(slot_center.x + 5.0, 0.0, slot_center.y)))
	if absf(plate_query) > 0.001:
		bad.append("ground record 5 m east answers %.3f — the hero over-files the plate" % plate_query)
	## The anchor-cap crumb stays pinned (the T-175 rule carries through the swap).
	var want_crumb := Vector3(slot_center.x, cap_top + City.ANCHOR_CRUMB_LIFT, slot_center.y)
	var crumb_ok := false
	for i: int in world.bread_spots.size():
		if world.bread_spots[i].distance_to(want_crumb) < 0.005 \
				and i < world.bread_spot_kinds.size() \
				and world.bread_spot_kinds[i] == City.BreadKind.ROOF:
			crumb_ok = true
			break
	if not crumb_ok:
		bad.append("no cap crumb at %s (world.bread_spots %d)" % [want_crumb, world.bread_spots.size()])
	_check(S, bad.is_empty(), "parts=%d top=%.2f; %s"
			% [parts.size(), stack_top, "; ".join(bad)])
	world.queue_free()


## (T-186) The hero wears the survey's photo-corrected palette. The hexes are
## re-derived here from MODELING-SPECS §1.1's estimates (never from the
## world's own constants), then held against the retained part record — the
## queue the exact render consumed — plus the LIVE reads headless can make
## (the cap mesh's vertex colors and the clock dials' material). The F-01
## correction is the point: the brick family must read BUFF/TAN (warm
## r>g>b ordering, red-dominance capped) — the dossier's red needle fails
## here by construction — and must not be the T-175 placeholder gray either:
## the swap actually re-colored the slot. Every pinned band must be present,
## the cap family must sit DARK against the shaft, and the dial white pops.
func _scenario_campanile_palette() -> void:
	const S := "campanile_palette"
	var bad: PackedStringArray = PackedStringArray()
	## MODELING-SPECS §1.1's hex estimates, verbatim. The clock white is NOT
	## in this table: the dials are CylinderMeshes (not record boxes), so
	## their pin is held by the LIVE material arm below — stronger than a
	## record read.
	var hexes: Dictionary = {
		"brick": Color("c9a56a"), ## Brick, sunlit.
		"brick_shade": Color("8a6d3f"), ## Brick, mid/shaded.
		"slot": Color("6e5533"), ## Recessed slots / deep shadow.
		"slate": Color("3f444d"), ## Pyramidal cap (dark slate).
		"trim": Color("c6c0b2"), ## Base trim / limestone accents.
	}
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var parts := world.campanile_hero_parts
	if parts.is_empty():
		_check(S, false, "no retained hero parts — the hero never built")
		world.queue_free()
		return
	var bands_seen: Dictionary = {}
	var brick_color := Color(0.0, 0.0, 0.0, 0.0)
	for part: Dictionary in parts:
		var band := str(part["band"])
		bands_seen[band] = true
		if band == "hand":
			## The dial hands: the doc pins "black numerals" descriptively,
			## not a hex — the law here is darkness (the black-numerals read).
			var hc: Color = part["color"]
			var hl: float = hc.r * 0.299 + hc.g * 0.587 + hc.b * 0.114
			if hl > 0.25:
				bad.append("hand color %s luminance %.3f > 0.25 — not the black-numerals read"
						% [hc, hl])
			continue
		if not hexes.has(band):
			bad.append("band %s wears no pinned hex" % band)
			continue
		var want: Color = hexes[band]
		var got: Color = part["color"]
		if absf(got.r - want.r) > 0.02 or absf(got.g - want.g) > 0.02 \
				or absf(got.b - want.b) > 0.02:
			bad.append("band %s color %s != the pinned hex %s" % [band, got, want])
		if band == "brick":
			brick_color = got
	## Every pinned band present (a vestigial or missing family fails); the
	## hand band must appear too (the clock band is the live dials' duty).
	for band: String in hexes:
		if not bands_seen.has(band):
			bad.append("band %s never used — the family is missing" % band)
	if not bands_seen.has("hand"):
		bad.append("band hand never used — the dials carry no hands")
	## THE F-01 LAW: the brick family reads BUFF/TAN, not red. (Color carries
	## no distance_to in Godot 4 — the channels' Euclidean gap, the
	## skeleton-palette scenario's own subtraction form.)
	if brick_color.a > 0.0:
		var gray_gap := Color(0.78, 0.76, 0.70) - brick_color ## The T-175 slot gray.
		var not_gray: float = sqrt(gray_gap.r * gray_gap.r + gray_gap.g * gray_gap.g
				+ gray_gap.b * gray_gap.b)
		if not_gray < 0.05:
			bad.append("brick %.3f is the placeholder gray — the swap did not re-color" % not_gray)
		var red_dominance := brick_color.r - brick_color.g
		if red_dominance > 0.18:
			bad.append("brick red-dominance %.3f > 0.18 — that is the red needle F-01 corrected" % red_dominance)
		if not (brick_color.r > brick_color.g and brick_color.g > brick_color.b):
			bad.append("brick %s is not the warm r>g>b buff order" % brick_color)
		if brick_color.g - brick_color.b < 0.12:
			bad.append("brick tan depth %.3f < 0.12" % (brick_color.g - brick_color.b))
		## The dark hat: the cap family must sit clearly darker than the shaft.
		var slate: Color = hexes["slate"]
		var lum := func(col: Color) -> float:
			return col.r * 0.299 + col.g * 0.587 + col.b * 0.114
		if lum.call(slate) + 0.25 > lum.call(brick_color):
			bad.append("cap slate not dark against the shaft (slate %.3f vs brick %.3f)" % [
					lum.call(slate), lum.call(brick_color)])
	else:
		bad.append("no brick part in the record")
	## The LIVE reads: the cap roof's vertex colors are the slate hex, the
	## dial material is the white hex — both round-trip headless.
	for chunk_entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(chunk_entry["file"]))
		var carries := false
		for ph: Dictionary in doc.get("placeholders", []):
			if str(ph.get("id", "")) == "way/183041212":
				carries = true
				break
		if not carries:
			continue
		var tile := Vector2i(int(chunk_entry["cx"]), int(chunk_entry["cz"]))
		var chunk_node := world.get_node_or_null(
				"Chunks/Chunk_%d_%d" % [tile.x, tile.y]) as Node3D
		if chunk_node == null:
			bad.append("chunk %s missing" % tile)
			break
		var hero := chunk_node.get_node_or_null("HeroCampanile") as Node3D
		if hero == null:
			bad.append("no HeroCampanile under %s" % tile)
			break
		var roof := hero.get_node_or_null("CapRoof") as MeshInstance3D
		if roof == null or roof.mesh == null:
			bad.append("no CapRoof mesh — the pyramid is missing")
		else:
			var mesh := roof.mesh as ArrayMesh
			var colors := mesh.surface_get_arrays(0)[Mesh.ARRAY_COLOR] as PackedColorArray
			var want_slate: Color = hexes["slate"]
			if colors.is_empty():
				bad.append("CapRoof carries no vertex colors")
			else:
				for col: Color in colors:
					if absf(col.r - want_slate.r) > 0.02 or absf(col.g - want_slate.g) > 0.02 \
							or absf(col.b - want_slate.b) > 0.02:
						bad.append("CapRoof vertex %s != the slate hex %s" % [col, want_slate])
						break
		var dials := 0
		for child: Node in hero.get_children():
			var dial := child as MeshInstance3D
			if child.name.begins_with("Clock") and dial != null and dial.mesh is CylinderMesh:
				dials += 1
				var mat := (dial.mesh as CylinderMesh).material as StandardMaterial3D
				if mat == null:
					bad.append("%s carries no material" % child.name)
				else:
					var want_clock := Color("f1eee7") ## Clock dial (white), the doc's hex.
					var dial_gap: Color = mat.albedo_color - want_clock
					var dial_dist: float = sqrt(dial_gap.r * dial_gap.r
							+ dial_gap.g * dial_gap.g + dial_gap.b * dial_gap.b)
					if dial_dist > 0.02:
						bad.append("%s albedo %s != the dial white %s (gap %.3f)" % [
								child.name, mat.albedo_color, want_clock, dial_dist])
		if dials != 4:
			bad.append("clock dials %d != 4" % dials)
		break
	_check(S, bad.is_empty(), "parts=%d bands=%d; %s"
			% [parts.size(), bands_seen.size(), "; ".join(bad)])
	world.queue_free()


