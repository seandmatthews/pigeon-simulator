		print("SIM INFO reticle pin=%s damped_impact=%s (%.2f m, bar 0.5) undamped=%s (damped-vs-undamped %.2f m)" % [
				pin, impact, pin.distance_to(impact), undamped, impact.distance_to(undamped)])
