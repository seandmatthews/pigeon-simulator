		## worst 38.0 — the campus lawn grid's half-diagonal; bar >2×
		## headroom).
	var reach_worst := 0.0
	var reach_ok := true
	var own_worst := 0.0
	var own_ok := true
	var cafe_worst := 0.0
	var bench_pts: Array[Vector2] = []
	for zone: AmesPedZones.Zone in zones.zones:
		if zone.id in ElderSpawner.FAVOR_ZONE_IDS:
			for bench: Transform3D in zone.benches:
