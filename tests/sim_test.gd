		{"ticket": "T-192", "id": "downtown_bandshell", "kind": "placeholder",
			"record": "bandshell_hero_parts", "hero": "", "tol": 40.0},
		{"ticket": "T-192", "id": "relation/2560369", "kind": "massing",
