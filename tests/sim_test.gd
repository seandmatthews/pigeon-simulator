## The hand-placed (spot-less) crumbs of `spawner` within `radius` (flat) of
## `pos` — the share-toss count the economy scenario reads.
func _hand_crumbs_near(spawner: BreadSpawner, pos: Vector3, radius: float) -> int:
	var n := 0
	for crumb in spawner.living_crumbs():
		if crumb.spot_index >= 0 or crumb.is_queued_for_deletion():
			continue
		var flat := Vector2(crumb.global_position.x - pos.x,
				crumb.global_position.z - pos.z)
		if flat.length() <= radius:
			n += 1
	return n


## The distance from `p` to the nearest EDGE of the closed polygon `poly` —
## the pack-derivation legs' boundary read (independently recomputed, never
## through the zone builder's own helpers).
func _poly_edge_dist(p: Vector2, poly: PackedVector2Array) -> float:
	var best := INF
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		var ab := b - a
		var t := clampf((p - a).dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
		best = minf(best, p.distance_to(a + ab * t))
	return best


## The scenario's own point-in-polygon (independent of AmesParking's).
func _parking_in_polygon(x: float, z: float, poly: PackedVector2Array) -> bool:
	var inside := false
	var j := poly.size() - 1
	for i in poly.size():
		var xi := poly[i].x
		var zi := poly[i].y
		var xj := poly[j].x
		var zj := poly[j].y
		if (zi > z) != (zj > z) \
				and x < (xj - xi) * (z - zi) / (zj - zi) + xi:
			inside = not inside
		j = i
	return inside


## The scenario's own rail-contact read over the pack's centerlines.
func _parking_near_rail(x: float, z: float) -> bool:
	var segs: Array = AmesDataPack.rail().get("centerlines", [])
	for line: Variant in segs:
		var pts: Array = line
		for i in pts.size() - 1:
			var a := Vector2(float((pts[i] as Array)[0]),
					float((pts[i] as Array)[1]))
			var b := Vector2(float((pts[i + 1] as Array)[0]),
					float((pts[i + 1] as Array)[1]))
			var dx := b.x - a.x
			var dz := b.y - a.y
			var l2 := dx * dx + dz * dz
			var t := 0.0
			if l2 > 1e-12:
				t = clampf(((x - a.x) * dx + (z - a.y) * dz) / l2, 0.0, 1.0)
			var px := a.x + t * dx
			var pz := a.y + t * dz
			if Vector2(x - px, z - pz).length() <= AmesParking.RAIL_CLEAR:
				return true
	return false


## The gate's own band containment (the T-181 fence read): a pack-local point
## inside any pinned anchor's crosswalk band, recomputed from the graph.
func _ped_in_band(graph: AmesTrafficGraph, p: Vector2) -> bool:
	for a in graph.intersection_count():
		if graph.intersection_pin(a) == AmesTrafficGraph.PIN_NONE:
			continue
		for member in graph.intersection_members(a):
			for edge in graph.node_in_edges(member):
				var geo := graph.approach_geometry(member, edge)
				if not bool(geo["fits"]):
					continue
				var band: Dictionary = geo["band"]
				var rel := p - (band["center"] as Vector2)
				var axis := band["axis"] as Vector2
				if absf(rel.dot(axis)) <= float(band["half_along"]) \
						and absf(rel.dot(Vector2(-axis.y, axis.x))) \
								<= float(band["half_across"]):
					return true
	return false


## The live road-contact read for one flat pack-local position: true when the
## point stands within a road's half-width + 0.5 m OUTSIDE every pinned band.
func _ped_road_contact(graph: AmesTrafficGraph, p: Vector2) -> bool:
	var hit := graph.nearest_run(p.x, p.y)
	if hit.is_empty():
		return false
	if float(hit["dist"]) >= graph.run_half_width(int(hit["run"])) + 0.5:
		return false
	return not _ped_in_band(graph, p)


## The nearest pinned anchor to a pack-local XZ point (−1 when none within
## 10 m) — the named-corner reads.
func _nearest_pinned_anchor(graph: AmesTrafficGraph, xz: Vector2) -> int:
	var best := -1
	var best_d := 10.0
	for a in graph.intersection_count():
		if graph.intersection_pin(a) == AmesTrafficGraph.PIN_NONE:
			continue
		var p := graph.node_pos(graph.intersection_head(a))
		var d := Vector2(p.x - xz.x, p.z - xz.y).length()
		if d < best_d:
			best_d = d
			best = a
	return best


## One basis column's length (the box extent that column carries).
func _xf_basis_len(xf: Transform3D, col: int) -> float:
	var v := xf.basis[col]
	return Vector3(v.x, v.y, v.z).length()


