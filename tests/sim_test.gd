## The channels' Euclidean gap — Color carries no distance_to in Godot 4
## (the campanile palette scenario's subtraction form, hoisted for the row's
## five live material arms).
func _color_gap(a: Color, b: Color) -> float:
	var gap := a - b
	return sqrt(gap.r * gap.r + gap.g * gap.g + gap.b * gap.b)


## The hue in degrees [0, 360) — Color.get_h() exists but the scenario keeps
## the arithmetic explicit where a hue law is asserted on it (the T-193
## green/blue banding arms; −1.0 for the achromatic case).
func _hue_deg(c: Color) -> float:
	var mx := maxf(c.r, maxf(c.g, c.b))
	var mn := minf(c.r, minf(c.g, c.b))
	if mx - mn < 1e-6:
		return -1.0
	var d := mx - mn
	var h := 0.0
	if mx == c.r:
		h = fposmod((c.g - c.b) / d, 6.0)
	elif mx == c.g:
		h = (c.b - c.r) / d + 2.0
	else:
		h = (c.r - c.g) / d + 4.0
	h *= 60.0
	return fposmod(h, 360.0)


## (T-188) The west classical row re-pins its slots onto the HEROES — the
## T-186 swap law generalized to Beardshear (placeholder slot), Morrill /
## Farm House / Marston Hall (authored massing slots). Every expectation is
## re-derived from the COMMITTED DATA (the no-self-test rule): the bake's own
## placeholder/massing entries walked here for the slot geometry and the gray
## families' file counts, the pack's building records for the envelopes, and
## MODELING-SPECS §1.4's palette table as verbatim scenario literals — never
## through the world's own constants:
## A. THE SWAP — each hero's retained record exists with the slot-exact body
##    (Beardshear's 41.1 × 14 × 66 at the placeholder block part's center,
##    the dome drum 9 × 4 × 9 at the slot's own +12 x; Morrill 27.7 × 40.3
##    walls, Marston 31.4 × 12 × 64.2 body at their massing centroids; Farm
##    House's main block + wing spanning exactly the slot's 18.8 × 21.5
##    envelope), and the gray families shrank by exactly the superseded
##    entries (chunk (0,−2): the whole placeholder family WAS Beardshear's —
##    the MM legitimately vanishes, the campanile-chunk precedent — and its
##    massing MM loses Morrill + Marston; chunk (1,−2): −1 for Farm House);
## B. THE DIMS — Beardshear top exactly the slot's settled 20.0 with the
##    dome stack on it; Morrill's walls top within ±2 of the census §3
##    3-level ladder (11.0 — the bake's 30.0 `height_m` is the bogus OSM
##    default class the census records and the baker's own hero law
##    overrides), ridge 15.0 + cone 16.8, the AABB carrying the turret's
##    projection; Farm House walls-above-knoll exactly the 2-level ladder
##    (8.0), knoll 1.4, ridge 12.9; Marston keeps the pack's tagged 12.0;
## C. THE PALETTE — every band at its §1.4 hex ±0.02, the dome trio
##    GREEN-dominant (F-03: g > r and g > b — the only green dome in town;
##    no brick/stone band is), the window band's luminance ≤ 0.25 (the
##    campanile `hand` darkness-law precedent — the survey pins no window
##    hex), every pinned band used;
## D. THE MESHES, LIVE — the dome cap's material is dome_mid, the Morrill
##    hip a single slate surface (a full hip), the Farm House gable two
##    surfaces (shingle slopes + brick ends), the turret drum brick + cone
##    slate;
## E. THE SEAMS, LIVE — layer-1 rays answer the heroes' faces (the
##    Beardshear body face + a portico column, the dome top at 20.0, the
##    Morrill wall face + ridge 15.0 + the turret drum's round cardinal at
##    r 2.6 + the cone tip 16.8, the Farm House wall + Marston body and
##    pavilion faces); `ground_height` answers dome 20.0 (the bake slot's
##    old crumb height — byte continuity), Morrill ridge 15.0, Farm House
##    knoll 1.4 and attic top 10.6, Marston 12.0; the four roof crumbs ride
##    the pinned tops as ROOF spots (Beardshear's byte-identical to the
##    pre-swap bake-derived pin).
func _scenario_campus_row_heroes() -> void:
	const S := "campus_row_heroes"
	var bad: PackedStringArray = PackedStringArray()
	const BE_ID := "way/33725619"
	const MO_ID := "way/158023244"
	const FH_ID := "way/158023219"
	const MA_ID := "way/183216666"
	## --- the bake slots, walked independently --------------------------------
	var be_center := Vector2.ZERO
	var mo_center := Vector2.ZERO
	var fh_center := Vector2.ZERO
	var ma_center := Vector2.ZERO
	var mo_box := Vector2.ZERO
	var fh_box := Vector2.ZERO
	var ma_box := Vector2.ZERO
	var be_chunk := Vector2i(99, 99)
	var mo_chunk := Vector2i(99, 99)
	var fh_chunk := Vector2i(99, 99)
	var ma_chunk := Vector2i(99, 99)
	## The two row chunks' file walks: totals AND retired counts — the
	## placeholders wearing a superseded hero id (the campanile's four in
	## (1,−2), Beardshear's three in (0,−2) — in these two chunks every
	## hero-id placeholder IS one of the two superseded slots) and the
	## massing wearing ANY hero id (the manifest set + the three runtime
	## joins — Beardshear's own bbox massing and the campanile's were
	## retired since T-175).
	var hero_ids := {}
	for hid: Variant in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("heroes", []):
		hero_ids[str(hid)] = true
	hero_ids[MO_ID] = true
	hero_ids[FH_ID] = true
	hero_ids[MA_ID] = true
	var chunk_walks := {}
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
		if tile != Vector2i(0, -2) and tile != Vector2i(1, -2):
			continue
		var walk: Dictionary = chunk_walks.get(tile, {
			"ph_file": 0, "ph_retired": 0, "ma_file": 0, "ma_retired": 0 })
		for ph: Dictionary in doc.get("placeholders", []):
			walk["ph_file"] += 1
			if hero_ids.has(str(ph.get("id", ""))):
				walk["ph_retired"] += 1
			if str(ph.get("id", "")) == BE_ID:
				be_chunk = tile
				if str(ph.get("part", "")) == "block":
					be_center = Vector2(float(ph["p"][0]), float(ph["p"][2]))
		for m: Dictionary in doc.get("massing", []):
			var mid := str(m.get("id", ""))
			if bool(m.get("a", false)):
				walk["ma_file"] += 1
				if hero_ids.has(mid):
					walk["ma_retired"] += 1
			if mid == MO_ID:
				mo_chunk = tile
				mo_center = Vector2(float(m["p"][0]), float(m["p"][2]))
				mo_box = Vector2(float(m["s"][0]), float(m["s"][2]))
			elif mid == FH_ID:
				fh_chunk = tile
				fh_center = Vector2(float(m["p"][0]), float(m["p"][2]))
				fh_box = Vector2(float(m["s"][0]), float(m["s"][2]))
			elif mid == MA_ID:
				ma_chunk = tile
				ma_center = Vector2(float(m["p"][0]), float(m["p"][2]))
				ma_box = Vector2(float(m["s"][0]), float(m["s"][2]))
		chunk_walks[tile] = walk
	var ph0: int = chunk_walks[Vector2i(0, -2)]["ph_file"]
	var ph0r: int = chunk_walks[Vector2i(0, -2)]["ph_retired"]
	var ma0: int = chunk_walks[Vector2i(0, -2)]["ma_file"]
	var ma0r: int = chunk_walks[Vector2i(0, -2)]["ma_retired"]
	var ph1: int = chunk_walks[Vector2i(1, -2)]["ph_file"]
	var ph1r: int = chunk_walks[Vector2i(1, -2)]["ph_retired"]
	var ma1: int = chunk_walks[Vector2i(1, -2)]["ma_file"]
	var ma1r: int = chunk_walks[Vector2i(1, -2)]["ma_retired"]
	if be_center == Vector2.ZERO or mo_center == Vector2.ZERO \
			or fh_center == Vector2.ZERO or ma_center == Vector2.ZERO:
		_check(S, false, "bake slot walk failed: be=%s mo=%s fh=%s ma=%s" % [
				be_center, mo_center, fh_center, ma_center])
		return
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var parts := world.campus_row_hero_parts
	if parts.is_empty():
		_check(S, false, "no retained row-hero parts — the heroes never built")
		world.queue_free()
		return

	## --- A. the swap: slot-exact bodies + the gray families' shrinkage -------
	var be_body: Dictionary = {}
	var be_drum: Dictionary = {}
	var mo_body: Dictionary = {}
	var fh_main: Dictionary = {}
	var fh_wing: Dictionary = {}
	var ma_body: Dictionary = {}
	for part: Dictionary in parts:
		var s: Vector3 = part["s"]
		var p: Vector3 = part["p"]
		var hero: String = part["hero"]
		if hero == "beardshear" and s.is_equal_approx(Vector3(41.1, 14.0, 66.0)):
			be_body = part
		elif hero == "beardshear" and s.is_equal_approx(Vector3(9.0, 4.0, 9.0)):
			be_drum = part
		elif hero == "morrill" and s.is_equal_approx(Vector3(mo_box.x, 9.6, mo_box.y)):
			mo_body = part
		elif hero == "farm_house" and s.is_equal_approx(Vector3(fh_box.x, 8.0, 14.0)):
			fh_main = part
		elif hero == "farm_house" and s.is_equal_approx(Vector3(13.0, 5.5, 7.5)):
			fh_wing = part
		elif hero == "marston_hall" and s.is_equal_approx(
				Vector3(ma_box.x, 12.0, ma_box.y)):
			ma_body = part
	if be_body.is_empty():
		bad.append("Beardshear's slot-exact body 41.1x14x66 missing from the record")
	else:
		var bp: Vector3 = be_body["p"]
		if Vector2(bp.x, bp.z).distance_to(be_center) > 0.01:
			bad.append("Beardshear body %s off the bake slot %s" % [bp, be_center])
	if be_drum.is_empty():
		bad.append("Beardshear's dome drum 9x4x9 missing from the record")
	else:
		var dp: Vector3 = be_drum["p"]
		if absf(dp.x - (be_center.x + 12.0)) > 0.01 \
				or absf(dp.z - be_center.y) > 0.01:
			bad.append("dome drum %s off the slot's +12 x offset" % dp)
	if mo_body.is_empty():
		bad.append("Morrill's walls %s x 9.6 missing (want the slot %s)" % [
				mo_box, mo_center])
	else:
		var mp: Vector3 = mo_body["p"]
		if Vector2(mp.x, mp.z).distance_to(mo_center) > 0.01:
			bad.append("Morrill walls %s off the massing slot %s" % [mp, mo_center])
	if ma_body.is_empty():
		bad.append("Marston's body %s x 12 missing (want the slot %s)" % [
				ma_box, ma_center])
	if fh_main.is_empty() or fh_wing.is_empty():
		bad.append("Farm House main block or wing missing from the record")
	else:
		## The envelope: main + wing flush span exactly the slot's z extent.
		var fz: float = (fh_main["s"] as Vector3).z + (fh_wing["s"] as Vector3).z
		if absf(fz - fh_box.y) > 0.01:
			bad.append("Farm House z envelope %.2f != the slot %.2f" % [fz, fh_box.y])
		if absf((fh_main["s"] as Vector3).x - fh_box.x) > 0.01:
			bad.append("Farm House x envelope %.2f != the slot %.2f" % [
					(fh_main["s"] as Vector3).x, fh_box.x])
	## The gray families: walked file counts vs the live MMs.
	var hero_chunk := {
		"beardshear": be_chunk, "morrill": mo_chunk, "farm_house": fh_chunk,
		"marston_hall": ma_chunk,
	}
	var record_counts := {}
	var box_counts := {}
	for part: Dictionary in parts:
		var hero: String = part["hero"]
		record_counts[hero] = int(record_counts.get(hero, 0)) + 1
		if not bool(part.get("mesh", false)):
			box_counts[hero] = int(box_counts.get(hero, 0)) + 1
	for hero: String in ["beardshear", "morrill", "farm_house", "marston_hall"]:
		if not record_counts.has(hero):
			bad.append("hero %s carries no record parts" % hero)
			continue
		var tile: Vector2i = hero_chunk[hero]
		var chunk_node := world.get_node_or_null(
				"Chunks/Chunk_%d_%d" % [tile.x, tile.y]) as Node3D
		if chunk_node == null:
			bad.append("chunk %s missing" % tile)
			continue
		var row_root := chunk_node.get_node_or_null("HeroRowBeardshear") as Node3D
		if hero == "morrill":
			row_root = chunk_node.get_node_or_null("HeroRowMorrill") as Node3D
		elif hero == "farm_house":
			row_root = chunk_node.get_node_or_null("HeroRowFarmHouse") as Node3D
		elif hero == "marston_hall":
			row_root = chunk_node.get_node_or_null("HeroRowMarstonHall") as Node3D
		if row_root == null:
			bad.append("no HeroRow family for %s under %s" % [hero, tile])
		else:
			var boxes_mm := row_root.get_node_or_null("Boxes") as MultiMeshInstance3D
			if boxes_mm == null:
				bad.append("%s carries no Boxes MM" % row_root.name)
			elif boxes_mm.multimesh.instance_count != int(box_counts.get(hero, 0)):
				bad.append("%s box MM %d != the record's box count %d" % [hero,
						boxes_mm.multimesh.instance_count, int(box_counts.get(hero, 0))])
	var c0 := world.get_node_or_null("Chunks/Chunk_0_-2") as Node3D
	var c1 := world.get_node_or_null("Chunks/Chunk_1_-2") as Node3D
	if c0 == null or c1 == null:
		_check(S, false, "chunk nodes missing: c0=%s c1=%s" % [c0 != null, c1 != null])
		world.queue_free()
		return
	for pair: Array in [[c0, Vector2i(0, -2), ph0, ph0r, ma0, ma0r],
			[c1, Vector2i(1, -2), ph1, ph1r, ma1, ma1r]]:
		var node: Node3D = pair[0]
		var tile: Vector2i = pair[1]
		var ph_file: int = pair[2]
		var ph_retired: int = pair[3]
		var ma_file: int = pair[4]
		var ma_retired: int = pair[5]
		if node == null:
			bad.append("chunk %s missing" % tile)
			continue
		var found_ph := false
		var found_ma := false
		var ma_count := -1
		for child: Node in node.get_children():
			if child is MultiMeshInstance3D:
				var mm3 := (child as MultiMeshInstance3D).multimesh
				if (child as MultiMeshInstance3D).name == "Placeholders":
					found_ph = true
				elif (child as MultiMeshInstance3D).name == "Massing":
					found_ma = true
					ma_count = mm3.instance_count
		## Beardshear's 3 parts ARE chunk (0,−2)'s whole placeholder family —
		## the family legitimately vanishes (the campanile-chunk precedent);
		## any other leftover count is a swap failure.
		if ph_file - ph_retired > 0:
			if not found_ph:
				bad.append("chunk %s lost its placeholder family (%d - %d remain)"
						% [tile, ph_file, ph_retired])
		elif found_ph:
			bad.append("chunk %s kept a placeholder MM after the full swap" % tile)
		if not found_ma or ma_count != ma_file - ma_retired:
			bad.append("chunk %s massing MM %d != file %d - %d retired" % [
					tile, ma_count, ma_file, ma_retired])

	## --- B. the dims ----------------------------------------------------------
	var per_lo := {}
	var per_hi := {}
	for part: Dictionary in parts:
		var p: Vector3 = part["p"]
		var s: Vector3 = part["s"]
		var hero: String = part["hero"]
		var plo: Vector3 = per_lo.get(hero, Vector3(INF, INF, INF))
		var phi: Vector3 = per_hi.get(hero, Vector3(-INF, -INF, -INF))
		per_lo[hero] = plo.min(p - s * 0.5)
		per_hi[hero] = phi.max(p + s * 0.5)
	for hero: String in ["beardshear", "morrill", "farm_house", "marston_hall"]:
		if not per_hi.has(hero):
			_check(S, false, "hero %s absent from the record — the arms cannot run" % hero)
			world.queue_free()
			return
	## Beardshear: the settled slot total on the dome, AABB with the portico
	## steps' projection (body 41.1 + 2.2 pavilion + 1.0 column run + 5.2
	## step reach east of the face; 41.5/66.4 cornice west/north-south).
	var be_span := (per_hi["beardshear"] as Vector3) - (per_lo["beardshear"] as Vector3)
	if absf((per_hi["beardshear"] as Vector3).y - 20.0) > 0.05:
		bad.append("Beardshear top %.3f != the slot's settled 20.0" % (per_hi["beardshear"] as Vector3).y)
	if absf(be_span.x - 47.5) > 0.5 or absf(be_span.z - 66.4) > 0.5:
		bad.append("Beardshear AABB %.1fx%.1f != the pinned 47.5x66.4 (±0.5)" % [be_span.x, be_span.z])
	## Morrill: the census ladder on the WALLS (9.6 within 11.0 ±2 — the bake
	## slot's 30.0 was the bogus OSM default), the ridge + cone pins, the
	## turret-projected AABB.
	var mo_span := (per_hi["morrill"] as Vector3) - (per_lo["morrill"] as Vector3)
	if absf((per_hi["morrill"] as Vector3).y - 16.8) > 0.05:
		bad.append("Morrill top %.3f != the cone tip 16.8" % (per_hi["morrill"] as Vector3).y)
	if not mo_body.is_empty() and absf((mo_body["s"] as Vector3).y) > 0.01:
		var wall_h := (mo_body["s"] as Vector3).y
		if absf(wall_h - 11.0) > 2.0:
			bad.append("Morrill wall height %.2f outside the census 3-level ladder 11.0 (±2)"
					% wall_h)
	if absf(mo_span.x - 30.0) > 0.5 or absf(mo_span.z - 42.6) > 0.5:
		bad.append("Morrill AABB %.1fx%.1f != the pinned 30.0x42.6 (±0.5)" % [mo_span.x, mo_span.z])
	## Farm House: knoll top, the 2-level ladder on the walls-above-knoll
	## (8.0 = the census §7.4 ladder's 2-level row, ±2), the ridge, the
	## chimney-topped AABB over the knoll.
	var fh_span := (per_hi["farm_house"] as Vector3) - (per_lo["farm_house"] as Vector3)
	if absf((per_hi["farm_house"] as Vector3).y - 14.3) > 0.05:
		bad.append("Farm House top %.3f != the chimneys' 14.3" % (per_hi["farm_house"] as Vector3).y)
	if not fh_main.is_empty():
		var fh_wall_h := (fh_main["s"] as Vector3).y
		if absf(fh_wall_h - 8.0) > 2.0:
			bad.append("Farm House wall height %.2f outside the 2-level ladder 8.0 (±2)"
					% fh_wall_h)
		var fh_base := (fh_main["p"] as Vector3).y - fh_wall_h * 0.5
		if absf(fh_base - 1.4) > 0.05:
			bad.append("Farm House walls stand at %.2f, not on the 1.4 knoll" % fh_base)
	if absf(fh_span.x - 26.3) > 0.5 or absf(fh_span.z - 29.0) > 0.5:
		bad.append("Farm House AABB %.1fx%.1f != the pinned 26.3x29.0 (±0.5)" % [fh_span.x, fh_span.z])
	## Marston: the pack's tagged height, the slot-exact envelope.
	var ma_span := (per_hi["marston_hall"] as Vector3) - (per_lo["marston_hall"] as Vector3)
	if absf((per_hi["marston_hall"] as Vector3).y - 12.0) > 0.05:
		bad.append("Marston top %.3f != the pack's tagged 12.0" % (per_hi["marston_hall"] as Vector3).y)
	if absf(ma_span.x - 37.8) > 0.5 or absf(ma_span.z - 64.6) > 0.5:
		bad.append("Marston AABB %.1fx%.1f != the pinned 37.8x64.6 (±0.5)" % [ma_span.x, ma_span.z])

	## --- C. the palette (§1.4's rows, verbatim scenario literals) ------------
	var hexes: Dictionary = {
		"limestone": Color("c8c1ae"),
		"limestone_shade": Color("a29b8b"),
		"dome_light": Color("8fb98f"),
		"dome_mid": Color("5e8f68"),
		"dome_dark": Color("4a7055"),
		"morrill_brick": Color("a8503a"),
		"morrill_shade": Color("7c3a2b"),
		"morrill_slate": Color("3f444c"),
		"morrill_banding": Color("8c4a3c"),
		"farm_brick": Color("9a4a34"),
		"farm_trim": Color("edeae2"),
		"farm_roof": Color("4e4e52"),
		"knoll": Color("5f7f42"),
	}
	var bands_seen := {}
	var dome_seen := {}
	for part: Dictionary in parts:
		var band := str(part["band"])
		bands_seen[band] = true
		var got: Color = part["color"]
		if band == "window":
			var wl: float = got.r * 0.299 + got.g * 0.587 + got.b * 0.114
			if wl > 0.25:
				bad.append("window band %s luminance %.3f > 0.25 — openings must read dark"
						% [got, wl])
			continue
		if not hexes.has(band):
			bad.append("band %s wears no pinned §1.4 hex" % band)
			continue
		var want: Color = hexes[band]
		if absf(got.r - want.r) > 0.02 or absf(got.g - want.g) > 0.02 \
				or absf(got.b - want.b) > 0.02:
			bad.append("band %s color %s != the pinned hex %s" % [band, got, want])
		if band.begins_with("dome_"):
			dome_seen[band] = true
			if not (got.g > got.r and got.g > got.b):
				bad.append("dome band %s %s is not green-dominant — F-03's only-green-dome law" % [band, got])
		elif got.g > got.r and got.g > got.b and band != "knoll":
			bad.append("band %s %s is green-dominant outside the dome family + the knoll" % [band, got])
	for band: String in hexes:
		if not bands_seen.has(band):
			bad.append("band %s never used — the family is missing" % band)
	for band: String in ["dome_light", "dome_mid", "dome_dark"]:
		if not dome_seen.has(band):
			bad.append("dome band %s never used — the estimate trio is incomplete" % band)
	if not bands_seen.has("window"):
		bad.append("band window never used — the openings are missing")

	## --- D. the meshes, live --------------------------------------------------
	var be_node := (c0 as Node3D).get_node_or_null("HeroRowBeardshear") as Node3D
	var mo_node := (c0 as Node3D).get_node_or_null("HeroRowMorrill") as Node3D
	var fh_node := (c1 as Node3D).get_node_or_null("HeroRowFarmHouse") as Node3D
	if be_node == null or mo_node == null or fh_node == null:
		bad.append("a hero row node is missing (be=%s mo=%s fh=%s)" % [
				be_node != null, mo_node != null, fh_node != null])
	else:
		var dome := be_node.get_node_or_null("DomeCap") as MeshInstance3D
		if dome == null or dome.mesh == null:
			bad.append("no DomeCap mesh — the green dome is missing")
		else:
			var want_mid := Color("5e8f68")
			var dm := (dome.mesh as CylinderMesh).material as StandardMaterial3D
			if dm == null or absf(dm.albedo_color.r - want_mid.r) > 0.02 \
					or absf(dm.albedo_color.g - want_mid.g) > 0.02 \
					or absf(dm.albedo_color.b - want_mid.b) > 0.02:
				bad.append("DomeCap albedo %s != the F-03 estimate #5E8F68" % [
						dm.albedo_color if dm != null else "<null>"])
		var hip := mo_node.get_node_or_null("HipRoof") as MeshInstance3D
		if hip == null or hip.mesh == null:
			bad.append("no HipRoof mesh — the slate hip is missing")
		else:
			var hip_mesh := hip.mesh as ArrayMesh
			if hip_mesh.get_surface_count() != 1:
				bad.append("HipRoof surfaces %d != 1 (a full hip has no gable ends)" % hip_mesh.get_surface_count())
			else:
				var want_slate := Color("3f444c")
				var hm := hip_mesh.surface_get_material(0) as StandardMaterial3D
				if hm == null or _color_gap(hm.albedo_color, want_slate) > 0.02:
					bad.append("HipRoof albedo %s != the Morrill slate #3F444C" % [
							hm.albedo_color if hm != null else "<null>"])
		var drum := mo_node.get_node_or_null("TurretDrum") as MeshInstance3D
		if drum == null or drum.mesh == null:
			bad.append("no TurretDrum mesh — the corner turret is missing")
		else:
			var want_brick := Color("a8503a")
			var dm2 := (drum.mesh as CylinderMesh).material as StandardMaterial3D
			if dm2 == null or _color_gap(dm2.albedo_color, want_brick) > 0.02:
				bad.append("TurretDrum albedo %s != the Morrill brick #A8503A" % [
						dm2.albedo_color if dm2 != null else "<null>"])
		var cone := mo_node.get_node_or_null("TurretCone") as MeshInstance3D
		if cone == null or cone.mesh == null:
			bad.append("no TurretCone mesh — the conical roof is missing")
		else:
			var want_slate2 := Color("3f444c")
			var cm := (cone.mesh as CylinderMesh).material as StandardMaterial3D
			if cm == null or _color_gap(cm.albedo_color, want_slate2) > 0.02:
				bad.append("TurretCone albedo %s != the Morrill slate #3F444C" % [
						cm.albedo_color if cm != null else "<null>"])
		var gable := fh_node.get_node_or_null("GableRoof") as MeshInstance3D
		if gable == null or gable.mesh == null:
			bad.append("no GableRoof mesh — the farmhouse gable is missing")
		else:
			var gable_mesh := gable.mesh as ArrayMesh
			if gable_mesh.get_surface_count() != 2:
				bad.append("GableRoof surfaces %d != 2 (shingle slopes + brick ends)" % gable_mesh.get_surface_count())
			else:
				var want_roof := Color("4e4e52")
				var want_end := Color("9a4a34")
				var gm0 := gable_mesh.surface_get_material(0) as StandardMaterial3D
				var gm1 := gable_mesh.surface_get_material(1) as StandardMaterial3D
				if gm0 == null or _color_gap(gm0.albedo_color, want_roof) > 0.02:
					bad.append("GableRoof slope albedo %s != the weathered shingle #4E4E52" % [
							gm0.albedo_color if gm0 != null else "<null>"])
				if gm1 == null or _color_gap(gm1.albedo_color, want_end) > 0.02:
					bad.append("GableRoof end albedo %s != the Farm House brick #9A4A34" % [
							gm1.albedo_color if gm1 != null else "<null>"])

	## --- E. the seams, live ---------------------------------------------------
	var space := get_world_3d().direct_space_state
	var probe := func(from: Vector3, to: Vector3) -> Dictionary:
		var ray := PhysicsRayQueryParameters3D.create(world.to_global(from),
				world.to_global(to))
		ray.collision_mask = 1
		return space.intersect_ray(ray)
	## Beardshear: the west body face, a portico column, the dome top.
	var west: Dictionary = probe.call(Vector3(be_center.x - 40.0, 8.0, be_center.y),
			Vector3(be_center.x, 8.0, be_center.y))
	if west.is_empty():
		bad.append("Beardshear west-face ray missed")
	else:
		var wx: float = world.to_local((west as Dictionary)["position"]).x
		if absf(wx - (be_center.x - 20.55)) > 0.3:
			bad.append("Beardshear west face x %.2f != the 41.1 face %.2f (±0.3)" % [
					wx, be_center.x - 20.55])
	var col: Dictionary = probe.call(Vector3(be_center.x + 12.0 + 20.55 + 6.0, 4.5, be_center.y + 1.7),
			Vector3(be_center.x + 20.55, 4.5, be_center.y + 1.7))
	if col.is_empty():
		bad.append("portico column ray missed — the portico is not solid")
	else:
		var colx: float = world.to_local((col as Dictionary)["position"]).x
		if absf(colx - (be_center.x + 20.55 + 3.3)) > 0.2:
			bad.append("portico column x %.2f != the column run face %.2f (±0.2)" % [
					colx, be_center.x + 20.55 + 3.3])
	var dome_top: Dictionary = probe.call(Vector3(be_center.x + 12.0, 40.0, be_center.y),
			Vector3(be_center.x + 12.0, 10.0, be_center.y))
	if dome_top.is_empty():
		bad.append("dome-top ray missed — the dome mass is gone")
	else:
		var dy: float = world.to_local((dome_top as Dictionary)["position"]).y
		if absf(dy - 20.0) > 0.1:
			bad.append("dome top y %.2f != the settled 20.0 (±0.1)" % dy)
	## Morrill: the east wall face, the ridge, the turret drum's cardinal, the cone tip.
	var mo_face: Dictionary = probe.call(Vector3(mo_center.x + 40.0, 5.0, mo_center.y + 10.0),
			Vector3(mo_center.x, 5.0, mo_center.y + 10.0))
	if mo_face.is_empty():
		bad.append("Morrill east-face ray missed")
	else:
		var mx: float = world.to_local((mo_face as Dictionary)["position"]).x
		if absf(mx - (mo_center.x + mo_box.x * 0.5)) > 0.3:
			bad.append("Morrill east face x %.2f != the wall face %.2f (±0.3)" % [
					mx, mo_center.x + mo_box.x * 0.5])
	var mo_ridge: Dictionary = probe.call(Vector3(mo_center.x, 30.0, mo_center.y),
			Vector3(mo_center.x, 5.0, mo_center.y))
	if mo_ridge.is_empty():
		bad.append("Morrill ridge ray missed")
	else:
		var my: float = world.to_local((mo_ridge as Dictionary)["position"]).y
		if absf(my - 15.0) > 0.1:
			bad.append("Morrill ridge y %.2f != the pinned 15.0 (±0.1)" % my)
	var turret := Vector2(mo_center.x + mo_box.x * 0.5 - 1.2,
			mo_center.y + mo_box.y * 0.5 - 1.2)
	var drum_ray: Dictionary = probe.call(Vector3(turret.x + 10.0, 6.0, turret.y),
			Vector3(turret.x, 6.0, turret.y))
	if drum_ray.is_empty():
		bad.append("turret drum ray missed — the round corner turret is not solid")
	else:
		var dx2: float = world.to_local((drum_ray as Dictionary)["position"]).x
		if absf(dx2 - (turret.x + 2.6)) > 0.2:
			bad.append("turret drum cardinal x %.2f != the r-2.6 round read %.2f (±0.2)" % [
					dx2, turret.x + 2.6])
	var cone_ray: Dictionary = probe.call(Vector3(turret.x, 30.0, turret.y),
			Vector3(turret.x, 10.0, turret.y))
	if cone_ray.is_empty():
		bad.append("turret cone ray missed")
	else:
		var cy: float = world.to_local((cone_ray as Dictionary)["position"]).y
		if absf(cy - 16.8) > 0.15:
			bad.append("turret cone tip y %.2f != the pinned 16.8 (±0.15)" % cy)
	## Farm House: the west wall face (above the porch roof).
	var fh_face: Dictionary = probe.call(Vector3(fh_center.x - 30.0, 5.0, fh_center.y - 3.75 + 5.0),
			Vector3(fh_center.x, 5.0, fh_center.y - 3.75 + 5.0))
	if fh_face.is_empty():
		bad.append("Farm House west-face ray missed")
	else:
		var fx: float = world.to_local((fh_face as Dictionary)["position"]).x
		if absf(fx - (fh_center.x - fh_box.x * 0.5)) > 0.3:
			bad.append("Farm House west face x %.2f != the wall face %.2f (±0.3)" % [
					fx, fh_center.x - fh_box.x * 0.5])
	## Marston: the pavilion face on the axis, the body face off it.
	var ma_pav: Dictionary = probe.call(Vector3(ma_center.x + 40.0, 5.0, ma_center.y + 4.0),
			Vector3(ma_center.x, 5.0, ma_center.y + 4.0))
	if ma_pav.is_empty():
		bad.append("Marston pavilion ray missed")
	else:
		var px: float = world.to_local((ma_pav as Dictionary)["position"]).x
		if absf(px - (ma_center.x + ma_box.x * 0.5 + 2.0)) > 0.3:
			bad.append("Marston pavilion face x %.2f != the +2.0 projection %.2f (±0.3)" % [
					px, ma_center.x + ma_box.x * 0.5 + 2.0])
	var ma_face: Dictionary = probe.call(Vector3(ma_center.x + 40.0, 8.0, ma_center.y + 20.0),
			Vector3(ma_center.x, 8.0, ma_center.y + 20.0))
	if ma_face.is_empty():
		bad.append("Marston body-face ray missed")
	else:
		var mx2: float = world.to_local((ma_face as Dictionary)["position"]).x
		if absf(mx2 - (ma_center.x + ma_box.x * 0.5)) > 0.3:
			bad.append("Marston body face x %.2f != the slot face %.2f (±0.3)" % [
					mx2, ma_center.x + ma_box.x * 0.5])
	## The ground record: the heroes answer their true tops.
	var queries := [
		[Vector3(be_center.x + 12.0, 0.0, be_center.y), 20.0, "Beardshear dome"],
		[Vector3(mo_center.x, 0.0, mo_center.y), 15.0, "Morrill ridge"],
		[Vector3(fh_center.x, 0.0, fh_center.y - 3.75), 12.9, "Farm House ridge"],
		[Vector3(fh_center.x + 11.0, 0.0, fh_center.y - 9.0), 1.4, "Farm House knoll"],
		[Vector3(mo_center.x + 6.0, 0.0, mo_center.y + 16.0), 10.6, "Morrill attic"],
		[Vector3(ma_center.x, 0.0, ma_center.y), 12.0, "Marston roof"],
	]
	for q: Array in queries:
		var got_h := world.ground_height(world.to_global(q[0] as Vector3))
		if absf(got_h - float(q[1])) > 0.05:
			bad.append("ground record at %s answers %.3f != the %s %.1f" % [
					q[2], got_h, q[2], float(q[1])])
	## The roof crumbs: one ROOF spot per hero at its pinned top.
	var lift: float = AmesWorld.SPOT_LIFT
	var want_crumbs := {
		"beardshear": Vector3(be_center.x + 12.0, 20.0 + lift, be_center.y),
		"morrill": Vector3(mo_center.x, 15.0 + lift, mo_center.y),
		"farm_house": Vector3(fh_center.x, 12.9 + lift, fh_center.y - 3.75),
		"marston_hall": Vector3(ma_center.x, 12.0 + lift, ma_center.y),
	}
	for hero: String in want_crumbs:
		var want_crumb: Vector3 = want_crumbs[hero]
		var crumb_ok := false
		for i: int in world.bread_spots.size():
			if world.bread_spots[i].distance_to(want_crumb) < 0.005 \
					and i < world.bread_spot_kinds.size() \
					and world.bread_spot_kinds[i] == City.BreadKind.ROOF:
				crumb_ok = true
				break
		if not crumb_ok:
			bad.append("no %s roof crumb at %s" % [hero, want_crumb])
	_check(S, bad.is_empty(), "parts=%d bands=%d be_top=%.2f mo_top=%.2f fh_top=%.2f; %s"
			% [parts.size(), bands_seen.size(), per_hi["beardshear"].y,
			per_hi["morrill"].y, per_hi["farm_house"].y, "; ".join(bad)])
	world.queue_free()


## --- scenario (T-189 the MU + Parks heroes) ---------------------------------


## (T-189) The Memorial Union + Parks Library re-pin their slots onto the
## HEROES — the T-188 swap law carried to the corner block at Lincoln Way &
## Morrill Rd/Lynn (F-06's CORRECTED corner — the ledger item) and the
## library block closing the lawn's east read, every expectation re-derived
## from the committed bake slots (walked in-scenario from the chunk files) +
## the survey docs as verbatim scenario literals:
## THE SWAP — MU (`way/183224150`) keeps the bake block part's slot envelope
## EXACT (the 109.8 × 20.0 × 109.9 body AT the block center ±0.01) while its
## block/tower/tower_cap parts render/collide/file NOTHING anymore (chunk
## (1,−1)'s whole gray placeholder family WAS the MU — the MM legitimately
## vanishes, the campanile-chunk precedent); Parks (`way/33725897`) swaps its
## block/addition parts the same 1:1 way (chunk (0,−3)'s whole family was
## Parks — same vanishing read; its authored bbox massing already rides the
## bake's `heroes` list). THE CORNER — the hero tower stands at the bake's
## own tower part, the block's SOUTHWEST corner (5.0 m in from each edge:
## Lincoln Way south + Morrill Rd/Lynn west — the F-06 correction, one block
## east of Stanton, pinned as west-half/south-half + the slot inset).
## THE DIMS — MU tops at the TOWER CROWN 36.0: THE TICKET'S ESTIMATE (survey
## VERIFICATION: tower height UNKNOWABLE — no authoritative source; the ~148
## ft figure unsourced, likely Campanile confusion; tooling band ≈35–45 m
## UNVERIFIED; this build pins 36.0, the photo-19 squat read — the
## uncertainty note is the ticket's job, the pin is this row's), the dark
## slate hip ridge 24.0, the arcade apron roof 13.0 + its corner pavilions
## 14.8, the per-hero AABBs pinned with the dress projections (MU 110.6 ×
## 123.9 over the hip eave, the proud north dress and the zodiac ring's
## south reach; Parks 97.9 × 123.1 over the portal piers + glass proud);
## Parks tops at the 1925 core's 24.0, the
## 1961/1983 additions band at 20.0.
## THE PALETTE — every band at its §1.4 hex ±0.02 (limestone #C8C1AE + shade
## #A29B8B — F-02's PALE GRAY LIMESTONE, NOT dark brick; the slate row
## #3F444C shared with Morrill; the additions' curtain-wall glass #3E4A50 +
## the white spandrel panels #EDEDEA — the survey's pinned white), the
## window band darkness-lawed (luminance ≤ 0.25), and the ZODIAC BRONZE
## held by its law (TRADITIONS §9.5 pins the WORD, no hex: r > g > b
## ordering, luminance ≤ 0.45, dark against the limestone by ≥ 0.25).
## THE MESHES, LIVE — the MU hip a single-surface slate ArrayMesh (a full
## hip), the zodiac's two flat bronze cylinders (ring + proud disc) at the
## Gold Star Hall threshold read — one bay east of the tower bay, just
## outside the south wall line (a survey-anchored approximation: the
## tradition pins the HALL, no source surveys the door).
## THE SEAMS, LIVE — layer-1 rays answer the MU tower's west (Morrill Rd)
## face, the body's south (Lincoln Way) face, the apron front, the tower
## crown at 36.0 and the hip ridge at 24.0; the Parks core's east (lawn)
## face + the portal pier and lintel faces (the portal is a FRAME read
## against the mass — no interior is modeled); `ground_height` answers the
## body 20.0 / ridge 24.0 / apron 13.0 / corner pavilions 14.8 / tower 36.0,
## the Parks core 24.0 + the three addition masses 20.0 — and the PLATE
## (0.0) through the zodiac decal (students walk AROUND it: the walkability
## query never answers the bronze); the two roof crumbs ride the pinned tops
## (MU at the tower crown, Parks at the core top).
func _scenario_mu_parks_heroes() -> void:
	const S := "mu_parks_heroes"
	var bad: PackedStringArray = PackedStringArray()
	const MU_ID := "way/183224150"
	const PK_ID := "way/33725897"
	## --- the bake slots, walked independently --------------------------------
	var mu_center := Vector2.ZERO
	var mu_tower := Vector2.ZERO
	var pk_center := Vector2.ZERO
	var pk_box := Vector2.ZERO
	var mu_chunk := Vector2i(99, 99)
	var pk_chunk := Vector2i(99, 99)
	## The two hero chunks' file walks: totals AND retired counts — in BOTH
	## chunks every hero-id placeholder IS one of the two superseded slots
	## (the campanile-chunk precedent: the whole gray family retires), and
	## the massing wearing ANY hero id (the manifest set — both ids already
	## ride it) retires from the massing families (the render family counts
	## EVERY massing entry — authored AND filler — so the walk does too).
	var hero_ids := {}
	for hid: Variant in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("heroes", []):
		hero_ids[str(hid)] = true
	var chunk_walks := {}
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
		if tile != Vector2i(1, -1) and tile != Vector2i(0, -3):
			continue
		var walk: Dictionary = chunk_walks.get(tile, {
			"ph_file": 0, "ph_retired": 0, "ma_file": 0, "ma_retired": 0 })
		for ph: Dictionary in doc.get("placeholders", []):
			walk["ph_file"] += 1
			if hero_ids.has(str(ph.get("id", ""))):
				walk["ph_retired"] += 1
			if str(ph.get("id", "")) == MU_ID:
				mu_chunk = tile
				if str(ph.get("part", "")) == "block":
					mu_center = Vector2(float(ph["p"][0]), float(ph["p"][2]))
				elif str(ph.get("part", "")) == "tower":
					mu_tower = Vector2(float(ph["p"][0]), float(ph["p"][2]))
			elif str(ph.get("id", "")) == PK_ID:
				pk_chunk = tile
				if str(ph.get("part", "")) == "block":
					pk_center = Vector2(float(ph["p"][0]), float(ph["p"][2]))
					pk_box = Vector2(float(ph["s"][0]), float(ph["s"][2]))
		for m: Dictionary in doc.get("massing", []):
			walk["ma_file"] += 1
			if hero_ids.has(str(m.get("id", ""))):
				walk["ma_retired"] += 1
		chunk_walks[tile] = walk
	var ph_mu: int = chunk_walks[Vector2i(1, -1)]["ph_file"]
	var ph_mu_r: int = chunk_walks[Vector2i(1, -1)]["ph_retired"]
	var ma_mu: int = chunk_walks[Vector2i(1, -1)]["ma_file"]
	var ma_mu_r: int = chunk_walks[Vector2i(1, -1)]["ma_retired"]
	var ph_pk: int = chunk_walks[Vector2i(0, -3)]["ph_file"]
	var ph_pk_r: int = chunk_walks[Vector2i(0, -3)]["ph_retired"]
	var ma_pk: int = chunk_walks[Vector2i(0, -3)]["ma_file"]
	var ma_pk_r: int = chunk_walks[Vector2i(0, -3)]["ma_retired"]
	if mu_center == Vector2.ZERO or mu_tower == Vector2.ZERO \
			or pk_center == Vector2.ZERO:
		_check(S, false, "bake slot walk failed: mu=%s tower=%s pk=%s" % [
				mu_center, mu_tower, pk_center])
		return
	## THE CORNER (the ledger item): the bake's tower part at the block's
	## southwest corner — west half (the Morrill Rd/Lynn corridor side,
	## F-06's correction: one block EAST of Stanton), south half (Lincoln
	## Way), exactly 5.0 m in from each face.
	var wx := mu_center.x - 54.9
	var sz := mu_center.y + 54.95
	if mu_tower.x >= mu_center.x or mu_tower.y <= mu_center.y:
		bad.append("MU tower %s not in the block's SW quadrant (F-06 corner)" % mu_tower)
	if absf(mu_tower.x - (wx + 5.0)) > 0.01 or absf(mu_tower.y - (sz - 5.0)) > 0.01:
		bad.append("MU tower %s off the bake's 5.0-inset corner slot" % mu_tower)
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var parts := world.mu_parks_hero_parts
	if parts.is_empty():
		_check(S, false, "no retained MU/Parks hero parts — the heroes never built")
		world.queue_free()
		return

	## --- A. the swap: slot-exact bodies + the gray families' vanishing -------
	var mu_body: Dictionary = {}
	var mu_shaft: Dictionary = {}
	var mu_crown: Dictionary = {}
	var pk_core: Dictionary = {}
	var pk_wing: Dictionary = {}
	var pk_band: Dictionary = {}
	var pk_leg: Dictionary = {}
	for part: Dictionary in parts:
		var s: Vector3 = part["s"]
		var p: Vector3 = part["p"]
		var hero: String = part["hero"]
		if hero == "memorial_union" and s.is_equal_approx(Vector3(109.8, 20.0, 109.9)):
			mu_body = part
		elif hero == "memorial_union" and s.is_equal_approx(Vector3(10.0, 34.2, 10.0)):
			mu_shaft = part
		elif hero == "memorial_union" and s.is_equal_approx(Vector3(9.0, 1.2, 9.0)):
			mu_crown = part
		elif hero == "parks_library" and s.is_equal_approx(
				Vector3(39.6, 24.0, 53.6)):
			pk_core = part
		elif hero == "parks_library" and absf(s.y - 20.0) < 0.01 \
				and absf(s.x - 95.5) < 0.01:
			pk_wing = part
		elif hero == "parks_library" and absf(s.y - 20.0) < 0.01 \
				and absf(s.x - (pk_box.x - 39.6)) < 0.01:
			pk_band = part
		elif hero == "parks_library" and s.is_equal_approx(
				Vector3(39.6, 20.0, 34.65)):
			pk_leg = part
	if mu_body.is_empty():
		bad.append("MU's slot-exact body 109.8x20x109.9 missing from the record")
	else:
		var bp: Vector3 = mu_body["p"]
		if Vector2(bp.x, bp.z).distance_to(mu_center) > 0.01:
			bad.append("MU body %s off the bake slot %s" % [bp, mu_center])
	if mu_shaft.is_empty() or mu_crown.is_empty():
		bad.append("MU tower shaft or crown missing from the record")
	else:
		var tp: Vector3 = mu_shaft["p"]
		if Vector2(tp.x, tp.z).distance_to(mu_tower) > 0.01:
			bad.append("MU tower shaft %s off the bake's corner slot %s" % [tp, mu_tower])
	if pk_core.is_empty() or pk_wing.is_empty() or pk_band.is_empty() or pk_leg.is_empty():
		bad.append("Parks core/west-band/south-leg composition missing from the record")
	else:
		var cp: Vector3 = pk_core["p"]
		var want_core_x: float = pk_center.x + pk_box.x * 0.5 - 19.8
		if absf(cp.x - want_core_x) > 0.01 or absf(cp.z - pk_center.y) > 0.01:
			bad.append("Parks core %s off the lawn frontage (want x %.2f)" % [
					cp, want_core_x])
	## The gray families: both hero chunks' placeholder families WERE the
	## slots — they legitimately vanish; the massing MMs shrink by exactly
	## the retired authored bboxes.
	var hero_chunk := {
		"memorial_union": mu_chunk, "parks_library": pk_chunk,
	}
	var record_counts := {}
	var box_counts := {}
	for part2: Dictionary in parts:
		var hero2: String = part2["hero"]
		record_counts[hero2] = int(record_counts.get(hero2, 0)) + 1
		if not bool(part2.get("mesh", false)):
			box_counts[hero2] = int(box_counts.get(hero2, 0)) + 1
	for hero: String in ["memorial_union", "parks_library"]:
		if not record_counts.has(hero):
			bad.append("hero %s carries no record parts" % hero)
			continue
		var tile2: Vector2i = hero_chunk[hero]
		var chunk_node := world.get_node_or_null(
				"Chunks/Chunk_%d_%d" % [tile2.x, tile2.y]) as Node3D
		if chunk_node == null:
			bad.append("chunk %s missing" % tile2)
			continue
		var row_name := "HeroRowMemorialUnion" if hero == "memorial_union" \
				else "HeroRowParksLibrary"
		var row_root := chunk_node.get_node_or_null(row_name) as Node3D
		if row_root == null:
			bad.append("no %s under %s" % [row_name, tile2])
		else:
			var boxes_mm := row_root.get_node_or_null("Boxes") as MultiMeshInstance3D
			if boxes_mm == null:
				bad.append("%s carries no Boxes MM" % row_root.name)
			elif boxes_mm.multimesh.instance_count != int(box_counts.get(hero, 0)):
				bad.append("%s box MM %d != the record's box count %d" % [hero,
						boxes_mm.multimesh.instance_count, int(box_counts.get(hero, 0))])
	var c_mu := world.get_node_or_null("Chunks/Chunk_1_-1") as Node3D
	var c_pk := world.get_node_or_null("Chunks/Chunk_0_-3") as Node3D
	if c_mu == null or c_pk == null:
		_check(S, false, "chunk nodes missing: mu=%s pk=%s" % [
				c_mu != null, c_pk != null])
		world.queue_free()
		return
	for pair: Array in [[c_mu, Vector2i(1, -1), ph_mu, ph_mu_r, ma_mu, ma_mu_r],
			[c_pk, Vector2i(0, -3), ph_pk, ph_pk_r, ma_pk, ma_pk_r]]:
		var node: Node3D = pair[0]
		var tile3: Vector2i = pair[1]
		var ph_file: int = pair[2]
		var ph_retired: int = pair[3]
		var ma_file: int = pair[4]
		var ma_retired: int = pair[5]
		var found_ph := false
		var found_ma := false
		var ma_count := -1
		for child: Node in node.get_children():
			if child is MultiMeshInstance3D:
				if (child as MultiMeshInstance3D).name == "Placeholders":
					found_ph = true
				elif (child as MultiMeshInstance3D).name == "Massing":
					found_ma = true
					ma_count = (child as MultiMeshInstance3D).multimesh.instance_count
		## The whole gray placeholder family WAS the slot in both chunks —
		## it legitimately vanishes (the campanile-chunk precedent).
		if ph_file - ph_retired > 0:
			if not found_ph:
				bad.append("chunk %s lost its placeholder family (%d - %d remain)"
						% [tile3, ph_file, ph_retired])
		elif found_ph:
			bad.append("chunk %s kept a placeholder MM after the full swap" % tile3)
		if not found_ma or ma_count != ma_file - ma_retired:
			bad.append("chunk %s massing MM %d != file %d - %d retired" % [
					tile3, ma_count, ma_file, ma_retired])

	## --- B. the dims (the tower estimate is the ticket's, the pin is here) ---
	var per_lo := {}
	var per_hi := {}
	for part3: Dictionary in parts:
		var p3: Vector3 = part3["p"]
		var s3: Vector3 = part3["s"]
		var hero3: String = part3["hero"]
		var plo: Vector3 = per_lo.get(hero3, Vector3(INF, INF, INF))
		var phi: Vector3 = per_hi.get(hero3, Vector3(-INF, -INF, -INF))
		per_lo[hero3] = plo.min(p3 - s3 * 0.5)
		per_hi[hero3] = phi.max(p3 + s3 * 0.5)
	for hero4: String in ["memorial_union", "parks_library"]:
		if not per_hi.has(hero4):
			_check(S, false, "hero %s absent from the record — the arms cannot run" % hero4)
			world.queue_free()
			return
	## MU: the tower crown closes at the ESTIMATE 36.0 (survey tooling band
	## ≈35–45 m UNVERIFIED — recorded with its uncertainty in the ticket;
	## the superseded bake read was 29.0), the hip ridge 24.0, the apron
	## 13.0 + corner pavilions 14.8; the AABB with the hip's 0.4 eave
	## overhang (the widest read), the proud north entry dress (arcade front
	## + entry pavilion at nz − 8.72) and the zodiac ring's south reach: span
	## 110.6 × 123.9.
	var mu_top: float = (per_hi["memorial_union"] as Vector3).y
	if absf(mu_top - 36.0) > 0.05:
		bad.append("MU top %.3f != the ticket's tower-crown estimate 36.0" % mu_top)
	if mu_top < 35.0 or mu_top > 45.0:
		bad.append("MU tower estimate %.2f outside the survey's ≈35–45 m UNVERIFIED band" % mu_top)
	if not mu_crown.is_empty() and absf(((mu_crown["p"] as Vector3).y \
			+ (mu_crown["s"] as Vector3).y * 0.5) - 36.0) > 0.05:
		bad.append("MU crown box %s does not close at 36.0" % mu_crown["p"])
	var mu_span := (per_hi["memorial_union"] as Vector3) \
			- (per_lo["memorial_union"] as Vector3)
	if absf(mu_span.x - 110.6) > 0.5 or absf(mu_span.z - 123.9) > 0.5:
		bad.append("MU AABB %.1fx%.1f != the pinned 110.6x123.9 (±0.5)" % [
				mu_span.x, mu_span.z])
	## Parks: the 1925 core tops the composition at 24.0, the additions band
	## at 20.0; the AABB over the portal piers (+2.4 west proud) + the glass
	## proud (±0.11 on z): 97.9 × 123.1.
	var pk_top: float = (per_hi["parks_library"] as Vector3).y
	if absf(pk_top - 24.0) > 0.05:
		bad.append("Parks top %.3f != the 1925 core's 24.0" % pk_top)
	var pk_span := (per_hi["parks_library"] as Vector3) \
			- (per_lo["parks_library"] as Vector3)
	if absf(pk_span.x - 97.9) > 0.5 or absf(pk_span.z - 123.1) > 0.5:
		bad.append("Parks AABB %.1fx%.1f != the pinned 97.9x123.1 (±0.5)" % [
				pk_span.x, pk_span.z])
	if not pk_wing.is_empty() and absf((pk_wing["s"] as Vector3).y - 20.0) > 0.05:
		bad.append("Parks 1961 wing height %.2f != the additions' 20.0 band" % [
				(pk_wing["s"] as Vector3).y])

	## --- C. the palette (§1.4's rows, verbatim scenario literals) ------------
	var hexes: Dictionary = {
		"limestone": Color("c8c1ae"),
		"limestone_shade": Color("a29b8b"),
		"mu_slate": Color("3f444c"),
		"addition_glass": Color("3e4a50"),
		"addition_panel": Color("eded ea".replace(" ", "")),
	}
	var bands_seen := {}
	for part4: Dictionary in parts:
		var band := str(part4["band"])
		bands_seen[band] = true
		var got: Color = part4["color"]
		if band == "window":
			var wl: float = got.r * 0.299 + got.g * 0.587 + got.b * 0.114
			if wl > 0.25:
				bad.append("window band %s luminance %.3f > 0.25 — openings must read dark"
						% [got, wl])
			continue
		if band == "zodiac_bronze":
			## The bronze LAW (no survey hex — TRADITIONS §9.5's word):
			## warm ordering, dark, and clearly dark against the limestone.
			var zl: float = got.r * 0.299 + got.g * 0.587 + got.b * 0.114
			if not (got.r > got.g and got.g > got.b):
				bad.append("zodiac_bronze %s is not bronze-ordered (want r>g>b)" % got)
			if zl > 0.45:
				bad.append("zodiac_bronze luminance %.3f > 0.45 — must read dark" % zl)
			var ls := Color("c8c1ae")
			var lsl: float = ls.r * 0.299 + ls.g * 0.587 + ls.b * 0.114
			if lsl - zl < 0.25:
				bad.append("zodiac_bronze %.3f not ≥0.25 dark against the limestone %.3f"
						% [zl, lsl])
			continue
		if not hexes.has(band):
			bad.append("band %s wears no pinned §1.4 hex" % band)
			continue
		var want: Color = hexes[band]
		if absf(got.r - want.r) > 0.02 or absf(got.g - want.g) > 0.02 \
				or absf(got.b - want.b) > 0.02:
			bad.append("band %s color %s != the pinned hex %s" % [band, got, want])
	for band2: String in hexes:
		if not bands_seen.has(band2):
			bad.append("band %s never used — the family is missing" % band2)
	for band3: String in ["window", "zodiac_bronze"]:
		if not bands_seen.has(band3):
			bad.append("band %s never used — the family is missing" % band3)

	## --- D. the meshes, live ---------------------------------------------------
	var mu_node := (c_mu as Node3D).get_node_or_null("HeroRowMemorialUnion") as Node3D
	var pk_node := (c_pk as Node3D).get_node_or_null("HeroRowParksLibrary") as Node3D
	if mu_node == null or pk_node == null:
		bad.append("a hero node is missing (mu=%s pk=%s)" % [
				mu_node != null, pk_node != null])
	else:
		var hip := mu_node.get_node_or_null("SlateHip") as MeshInstance3D
		if hip == null or hip.mesh == null:
			bad.append("no SlateHip mesh — the dark slate hip is missing")
		else:
			var hip_mesh := hip.mesh as ArrayMesh
			if hip_mesh.get_surface_count() != 1:
				bad.append("SlateHip surfaces %d != 1 (a full hip has no gable ends)"
						% hip_mesh.get_surface_count())
			else:
				var want_slate := Color("3f444c")
				var hm := hip_mesh.surface_get_material(0) as StandardMaterial3D
				if hm == null or _color_gap(hm.albedo_color, want_slate) > 0.02:
					bad.append("SlateHip albedo %s != the §1.4 slate #3F444C" % [
							hm.albedo_color if hm != null else "<null>"])
		## The zodiac: two flat bronze cylinders at the threshold read — the
		## position read off the RECORD (world-local), the albedos off the
		## LIVE nodes.
		var z_disc := mu_node.get_node_or_null("ZodiacDisc") as MeshInstance3D
		var z_ring := mu_node.get_node_or_null("ZodiacRing") as MeshInstance3D
		if z_disc == null or z_ring == null:
			bad.append("the zodiac decal is missing (disc=%s ring=%s)" % [
					z_disc != null, z_ring != null])
		else:
			var want_bronze := Color(0.43, 0.35, 0.2)
			for z_node: MeshInstance3D in [z_ring, z_disc]:
				var zm := (z_node.mesh as CylinderMesh).material as StandardMaterial3D
				if zm == null or _color_gap(zm.albedo_color, want_bronze) > 0.02:
					bad.append("%s albedo %s != the bronze law color" % [
							z_node.name, zm.albedo_color if zm != null else "<null>"])
			var want_z := Vector2(mu_tower.x + 8.0,
					mu_center.y + 54.95 + 2.2) ## The threshold read.
			for rec: Dictionary in parts:
				if str(rec["band"]) == "zodiac_bronze" and bool(rec["mesh"]):
					var rp: Vector3 = rec["p"]
					var half: float = (rec["s"] as Vector3).x * 0.5
					if (rec["s"] as Vector3).y > 0.04: ## The proud disc.
						if Vector2(rp.x, rp.z).distance_to(want_z) > 0.05 \
								or absf(rp.y - 0.04) > 0.01:
							bad.append("zodiac disc %s != the Gold Star Hall threshold read %s"
									% [rp, want_z])
						if half > 2.7:
							bad.append("zodiac disc radius %.2f > the 2.6 read" % half)
					else: ## The ring.
						if Vector2(rp.x, rp.z).distance_to(want_z) > 0.05:
							bad.append("zodiac ring %s != the threshold read %s" % [
									rp, want_z])
			if absf(z_disc.position.y - 0.04) > 0.01:
				bad.append("zodiac disc y %.3f != the flat 0.04 decal read" % z_disc.position.y)

	## --- E. the seams, live -----------------------------------------------------
	var space := get_world_3d().direct_space_state
	var probe := func(from: Vector3, to: Vector3) -> Dictionary:
		var ray := PhysicsRayQueryParameters3D.create(world.to_global(from),
				world.to_global(to))
		ray.collision_mask = 1
		return space.intersect_ray(ray)
	## MU: the tower's west face (the Morrill Rd/Lynn read — the CORRECT
	## corner), the body's south face (Lincoln Way), the apron front, the
	## crown top, the hip ridge.
	var t_face: Dictionary = probe.call(Vector3(wx - 30.0, 10.0, mu_tower.y),
			Vector3(mu_tower.x, 10.0, mu_tower.y))
	if t_face.is_empty():
		bad.append("MU tower west-face ray missed")
	else:
		var tfx: float = world.to_local((t_face as Dictionary)["position"]).x
		if absf(tfx - wx) > 0.3:
			bad.append("MU tower west face x %.2f != the slot's %.2f (±0.3)" % [tfx, wx])
	var s_face: Dictionary = probe.call(Vector3(mu_center.x - 30.0, 10.0, sz + 20.0),
			Vector3(mu_center.x - 30.0, 10.0, mu_center.y))
	if s_face.is_empty():
		bad.append("MU south-face ray missed")
	else:
		var sfz: float = world.to_local((s_face as Dictionary)["position"]).z
		if absf(sfz - sz) > 0.3:
			bad.append("MU south face z %.2f != the Lincoln Way face %.2f (±0.3)" % [
					sfz, sz])
	var apron_z: float = mu_center.y - 54.95 - 6.0
	var a_face: Dictionary = probe.call(Vector3(mu_center.x + 20.0, 6.0, apron_z - 30.0),
			Vector3(mu_center.x + 20.0, 6.0, mu_center.y))
	if a_face.is_empty():
		bad.append("MU apron-front ray missed")
	else:
		var afz: float = world.to_local((a_face as Dictionary)["position"]).z
		if absf(afz - apron_z) > 0.3:
			bad.append("MU apron front z %.2f != the proud face %.2f (±0.3)" % [
					afz, apron_z])
	var crown_ray: Dictionary = probe.call(Vector3(mu_tower.x, 60.0, mu_tower.y),
			Vector3(mu_tower.x, 20.0, mu_tower.y))
	if crown_ray.is_empty():
		bad.append("tower crown ray missed")
	else:
		var cy: float = world.to_local((crown_ray as Dictionary)["position"]).y
		if absf(cy - 36.0) > 0.1:
			bad.append("tower crown y %.2f != the estimate pin 36.0 (±0.1)" % cy)
	var ridge_ray: Dictionary = probe.call(Vector3(mu_center.x, 40.0, mu_center.y),
			Vector3(mu_center.x, 10.0, mu_center.y))
	if ridge_ray.is_empty():
		bad.append("MU ridge ray missed")
	else:
		var ry: float = world.to_local((ridge_ray as Dictionary)["position"]).y
		if absf(ry - 24.0) > 0.1:
			bad.append("MU hip ridge y %.2f != the pinned 24.0 (±0.1)" % ry)
	## Parks: the core's east (lawn) face + the portal pier and lintel faces.
	var pk_ex: float = pk_center.x + pk_box.x * 0.5
	var pk_face: Dictionary = probe.call(Vector3(pk_ex + 30.0, 8.0, pk_center.y + 11.75),
			Vector3(pk_center.x, 8.0, pk_center.y + 11.75))
	if pk_face.is_empty():
		bad.append("Parks east-face ray missed")
	else:
		var pfx: float = world.to_local((pk_face as Dictionary)["position"]).x
		if absf(pfx - pk_ex) > 0.3:
			bad.append("Parks east face x %.2f != the lawn frontage %.2f (±0.3)" % [
					pfx, pk_ex])
	var pk_wx: float = pk_center.x - pk_box.x * 0.5
	var pk_cz: float = pk_center.y + (61.45 - 26.8) * 0.5 ## The 1983 band's center z.
	var pier_ray: Dictionary = probe.call(Vector3(pk_wx - 30.0, 5.0, pk_cz - 9.0),
			Vector3(pk_wx, 5.0, pk_cz - 9.0))
	if pier_ray.is_empty():
		bad.append("portal pier ray missed")
	else:
		var prx: float = world.to_local((pier_ray as Dictionary)["position"]).x
		if absf(prx - (pk_wx - 2.4)) > 0.2:
			bad.append("portal pier face x %.2f != the +2.4 proud %.2f (±0.2)" % [
					prx, pk_wx - 2.4])
	var lintel_ray: Dictionary = probe.call(Vector3(pk_wx - 30.0, 16.0, pk_cz),
			Vector3(pk_wx, 16.0, pk_cz))
	if lintel_ray.is_empty():
		bad.append("portal lintel ray missed")
	else:
		var lrx: float = world.to_local((lintel_ray as Dictionary)["position"]).x
		if absf(lrx - (pk_wx - 2.4)) > 0.2:
			bad.append("portal lintel face x %.2f != the +2.4 proud %.2f (±0.2)" % [
					lrx, pk_wx - 2.4])
	## The ground record: the heroes answer their true tops — and the plate
	## through the zodiac (students walk AROUND it).
	var queries := [
		[Vector3(mu_center.x - 40.0, 0.0, mu_center.y), 20.0, "MU body"],
		[Vector3(mu_center.x, 0.0, mu_center.y), 24.0, "MU hip ridge"],
		[Vector3(mu_center.x + 20.0, 0.0, mu_center.y - 57.95), 13.0, "MU apron roof"],
		[Vector3(mu_center.x - 48.0, 0.0, mu_center.y - 57.95), 14.8, "MU corner pavilion"],
		[Vector3(mu_tower.x, 0.0, mu_tower.y), 36.0, "MU tower crown"],
		[Vector3(mu_tower.x + 8.0, 0.0, mu_center.y + 54.95 + 2.2), 0.0, "zodiac plate"],
		[Vector3(pk_center.x + pk_box.x * 0.5 - 19.8, 0.0, pk_center.y), 24.0, "Parks core"],
		[Vector3(pk_center.x, 0.0, pk_center.y - 47.9), 20.0, "Parks 1961 wing"],
		[Vector3(pk_center.x - 30.0, 0.0, pk_center.y + 10.0), 20.0, "Parks 1983 band"],
		[Vector3(pk_center.x + pk_box.x * 0.5 - 19.8, 0.0, pk_center.y + 43.0), 20.0,
			"Parks 1983 south leg"],
	]
	for q: Array in queries:
		var got_h := world.ground_height(world.to_global(q[0] as Vector3))
		if absf(got_h - float(q[1])) > 0.05:
			bad.append("ground record at %s answers %.3f != the %s %.1f" % [
					q[2], got_h, q[2], float(q[1])])
	## The roof crumbs: one ROOF spot per hero at its pinned top.
	var lift: float = AmesWorld.SPOT_LIFT
	var want_crumbs := {
		"memorial_union": Vector3(mu_tower.x, 36.0 + lift, mu_tower.y),
		"parks_library": Vector3(pk_center.x + pk_box.x * 0.5 - 19.8,
				24.0 + lift, pk_center.y),
	}
	for hero5: String in want_crumbs:
		var want_crumb: Vector3 = want_crumbs[hero5]
		var crumb_ok := false
		for i: int in world.bread_spots.size():
			if world.bread_spots[i].distance_to(want_crumb) < 0.005 \
					and i < world.bread_spot_kinds.size() \
					and world.bread_spot_kinds[i] == City.BreadKind.ROOF:
				crumb_ok = true
				break
		if not crumb_ok:
			bad.append("no %s roof crumb at %s" % [hero5, want_crumb])
	_check(S, bad.is_empty(), "parts=%d bands=%d mu_top=%.2f pk_top=%.2f; %s"
			% [parts.size(), bands_seen.size(), per_hi["memorial_union"].y,
			per_hi["parks_library"].y, "; ".join(bad)])
	world.queue_free()


## --- scenario (T-190 the Marston Water Tower hero) ---------------------------


## (T-190) The campus beacon re-pins its slot onto the HERO — the T-186 swap
## law carried to the tallest object on campus, every expectation re-derived
## from the committed bake slot (walked in-scenario from the chunk file) +
## the survey docs as verbatim scenario literals:
## THE SWAP — Marston (`way/861201396`) supersedes its slot's six placeholder
## parts (four legs + tank + cap — chunk (−1,−2)'s whole gray placeholder
## family WAS the tower, so the MM legitimately vanishes, the campanile-chunk
## precedent; its bbox massing already rides the bake's `heroes` list so the
## massing family shrinks by exactly the retired authored bbox, walked
## total-minus-retired INCLUDING the filler entries the render family
## consumes).
## THE DIMS — the total closes at the survey's settled 51.2 (the AC ±2 band,
## pinned exact; taller than the campanile's 33.5 — the beacon read), the
## tank drum 36.0→48.2 (the LANDMARKS C2 12.2 m × 7.3 m cylinder, the slot
## stack's own span), the trestle carrying photo 11's full-height
## proportions: the balcony walkway at 36.05 = 70.4% of the total (the
## photo's trestle fraction), the base spread 14.0 ≈ 1.92× the tank diameter
## (the photo's flare read), the bowl hang to 33.2, the top cornice lip flush
## at 48.2, the cone closing at 51.2; the record AABB pinned at the legs'
## splay (14.0 × 12.4 ±0.5 — the OSM polygon's 13.9 z reads the footing
## apron; the six-leg hexagon is the structure; the deviation recorded
## in-ticket).
## THE PALETTE — the white steel pinned (§1.4 verbatim, F-03's correction:
## WHITE painted steel, NOT the dossier's dark tank): tank #EDEDEA / shade
## #D8D8D4, legs #C9C9C4; the brace + medallion bands carry NO survey hex and
## are held by darkness laws (luminance ≤ 0.45; the medallion also ≥ 0.25
## dark against the white tank — the campanile `hand` precedent).
## THE MESHES, LIVE — the tank drum and the cone at their albedos off the
## live nodes; the medallion ring + proud disc turned to face EAST (the
## campus-facing read — photos 10/12), positions off the record ±0.05.
## THE SEAMS, LIVE — layer-1 rays answer the 0° leg's east face at its
## splayed position (y 10, the flare re-derived from the row's literals),
## the cornice top at 48.2, the cone slope at r 3.4 and the tip plane at
## 51.2 down the axis; `ground_height` answers the tank top 48.2 (the survey
## answer kept — the cone tip files NO walkable top), the balcony ring 36.05,
## and the PLATE (0.0) between the legs (the trestle is open); the roof crumb
## rides the cone tip as a ROOF spot (byte-identical to the bake-derived
## cap pin this swap retires).
func _scenario_marston_hero_dims() -> void:
	const S := "marston_hero_dims"
	var bad: PackedStringArray = PackedStringArray()
	const MT_ID := "way/861201396"
	## --- the bake slot, walked independently --------------------------------
	var mt_center := Vector2.ZERO
	var ph_file := 0
	var ph_retired := 0
	var ma_file := 0
	var ma_retired := 0
	var hero_ids := {}
	for hid: Variant in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("heroes", []):
		hero_ids[str(hid)] = true
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
		if tile != Vector2i(-1, -2):
			continue
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		for ph: Dictionary in doc.get("placeholders", []):
			ph_file += 1
			if hero_ids.has(str(ph.get("id", ""))):
				ph_retired += 1
			if str(ph.get("id", "")) == MT_ID and str(ph.get("part", "")) == "tank":
				mt_center = Vector2(float(ph["p"][0]), float(ph["p"][2]))
		for m: Dictionary in doc.get("massing", []):
			ma_file += 1
			if hero_ids.has(str(m.get("id", ""))):
				ma_retired += 1
	if mt_center == Vector2.ZERO:
		_check(S, false, "bake slot walk failed: the tank part is missing")
		return
	if ph_file != 6 or ph_retired != 6:
		bad.append("chunk (-1,-2) placeholder walk %d/%d != the tower's six retired parts" % [
				ph_retired, ph_file])
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var parts := world.marston_hero_parts
	if parts.is_empty():
		_check(S, false, "no retained Marston hero parts — the hero never built")
		world.queue_free()
		return

	## --- A. the swap: the gray family vanishes, the hero mounts ---------------
	var chunk_node := world.get_node_or_null("Chunks/Chunk_-1_-2") as Node3D
	if chunk_node == null:
		_check(S, false, "chunk (-1,-2) missing")
		world.queue_free()
		return
	var found_ph := false
	for child: Node in chunk_node.get_children():
		if child is MultiMeshInstance3D \
				and (child as MultiMeshInstance3D).name == "Placeholders":
			found_ph = true
	if found_ph:
		bad.append("chunk (-1,-2) kept a placeholder MM after the full swap")
	var ma_mm := chunk_node.get_node_or_null("Massing") as MultiMeshInstance3D
	if ma_mm == null or ma_mm.multimesh.instance_count != ma_file - ma_retired:
		bad.append("chunk (-1,-2) massing MM %d != file %d - %d retired" % [
				ma_mm.multimesh.instance_count if ma_mm != null else -1,
				ma_file, ma_retired])
	var hero_root := chunk_node.get_node_or_null("HeroMarstonTower") as Node3D
	if hero_root == null:
		bad.append("no HeroMarstonTower under chunk (-1,-2)")
	else:
		var boxes_mm := hero_root.get_node_or_null("Boxes") as MultiMeshInstance3D
		var box_count := 0
		for part: Dictionary in parts:
			if not bool(part.get("mesh", false)):
				box_count += 1
		if boxes_mm == null:
			bad.append("HeroMarstonTower carries no Boxes MM")
		elif boxes_mm.multimesh.instance_count != box_count:
			bad.append("trestle box MM %d != the record's box count %d" % [
					boxes_mm.multimesh.instance_count, box_count])

	## --- B. the dims (the survey pin + photo 11's proportions) ----------------
	var lo := Vector3(INF, INF, INF)
	var hi := Vector3(-INF, -INF, -INF)
	var tank := {}
	var cone := {}
	var cornice := {}
	var balcony := {}
	var bowl := {}
	var med_ring := {}
	var med_disc := {}
	for part2: Dictionary in parts:
		var p2: Vector3 = part2["p"]
		var s2: Vector3 = part2["s"]
		lo = lo.min(p2 - s2 * 0.5)
		hi = hi.max(p2 + s2 * 0.5)
		if not bool(part2.get("mesh", false)):
			continue
		var band := str(part2["band"])
		if band == "tank" and absf(s2.y - 12.2) < 0.01:
			tank = part2
		elif band == "tank" and absf(s2.y - 0.5) < 0.01 and absf(s2.x - 7.9) < 0.01:
			cornice = part2
		elif band == "tank" and absf(s2.y - 3.0) < 0.01:
			cone = part2
		elif band == "legs" and absf(s2.y - 0.5) < 0.01 and absf(s2.x - 7.9) < 0.01:
			balcony = part2
		elif band == "tank_shade":
			bowl = part2
		elif band == "medallion" and s2.x < 0.07:
			med_ring = part2
		elif band == "medallion":
			med_disc = part2
	if tank.is_empty() or cone.is_empty() or cornice.is_empty() or balcony.is_empty() \
			or bowl.is_empty() or med_ring.is_empty() or med_disc.is_empty():
		bad.append("the hero record misses a family (tank=%s cone=%s cornice=%s "
				+ "balcony=%s bowl=%s med_ring=%s med_disc=%s)" % [
				tank.is_empty(), cone.is_empty(), cornice.is_empty(),
				balcony.is_empty(), bowl.is_empty(),
				med_ring.is_empty(), med_disc.is_empty()])
	else:
		if absf(hi.y - 51.2) > 0.05:
			bad.append("tower top %.3f != the survey's settled 51.2 (AC ±2 band)" % hi.y)
		if hi.y <= 33.5:
			bad.append("tower top %.2f not taller than the campanile's 33.5 — the beacon read" % hi.y)
		if lo.y < -0.15:
			bad.append("tower base %.3f sinks past the plate (the brace work-point corners round %.1f)" % [
					lo.y, -lo.y])
		var span := hi - lo
		if absf(span.x - 14.0) > 0.5 or absf(span.z - 12.4) > 0.5:
			bad.append("record AABB %.1fx%.1f != the legs' splay 14.0x12.4 (±0.5)" % [
					span.x, span.z])
		if span.x / 7.3 < 1.7:
			bad.append("base spread %.1f under 1.7× the tank diameter — the photo-11 flare read" % span.x)
		var tp: Vector3 = tank["p"]
		if absf((tp.y + 6.1) - 48.2) > 0.05 or absf((tp.y - 6.1) - 36.0) > 0.05:
			bad.append("tank drum %s != the slot stack's 36.0→48.2 span" % tp)
		## The trestle fraction: the balcony walkway closes the legs at
		## 70.4% of the total (photo 11's full-height read).
		if absf((balcony["p"] as Vector3).y + 0.25 - 36.05) > 0.05:
			bad.append("balcony top %.3f != the walkway pin 36.05 (the 70.4%% trestle fraction)"
					% ((balcony["p"] as Vector3).y + 0.25))
		if absf((balcony["p"] as Vector3).y + 0.25 - 36.05) <= 0.05 \
				and ((balcony["p"] as Vector3).y + 0.25) / 51.2 < 0.684:
			bad.append("trestle fraction %.3f under the photo's ~0.70 read" % [
					((balcony["p"] as Vector3).y + 0.25) / 51.2])
		var cp: Vector3 = cone["p"]
		if absf((cp.y + 1.5) - 51.2) > 0.05:
			bad.append("cone %s does not close at 51.2" % cp)
		if absf((cornice["p"] as Vector3).y + 0.25 - 48.2) > 0.05:
			bad.append("cornice top %.3f != the tank-top lip 48.2" % [
					(cornice["p"] as Vector3).y + 0.25])
		var bp: Vector3 = bowl["p"]
		var bowl_bottom: float = bp.y - (bowl["s"] as Vector3).y * 0.5
		if absf(bowl_bottom - 33.2) > 0.05:
			bad.append("bowl bottom %.3f != the photo-11 hang 33.2" % bowl_bottom)
		## The medallion on the EAST face (the campus-facing read), positions
		## off the record ±0.05.
		var rp: Vector3 = med_ring["p"]
		var want_ring := Vector3(mt_center.x + 3.70, 42.8, mt_center.y)
		if rp.distance_to(want_ring) > 0.05:
			bad.append("medallion ring %s != the east-face read %s" % [rp, want_ring])
		var dp: Vector3 = med_disc["p"]
		if dp.distance_to(want_ring + Vector3(0.05, 0.0, 0.0)) > 0.05:
			bad.append("medallion disc %s != the proud read %s" % [dp, want_ring])

	## --- C. the palette (§1.4's rows, verbatim scenario literals) --------------
	var hexes: Dictionary = {
		"tank": Color("eded ea".replace(" ", "")),
		"tank_shade": Color("d8d8d4"),
		"legs": Color("c9c9c4"),
	}
	var bands_seen := {}
	for part3: Dictionary in parts:
		var band3 := str(part3["band"])
		bands_seen[band3] = true
		var got: Color = part3["color"]
		if band3 == "brace" or band3 == "medallion":
			## The dark laws (no survey hex — the photos' dark lattice and the
			## seal's dark silhouette): luminance ≤ 0.45; the medallion also
			## ≥ 0.25 dark against the white tank (F-03's correction).
			var wl: float = got.r * 0.299 + got.g * 0.587 + got.b * 0.114
			if wl > 0.45:
				bad.append("%s band %s luminance %.3f > 0.45 — must read dark" % [
						band3, got, wl])
			if band3 == "medallion":
				var white := Color("eded ea".replace(" ", ""))
				var whl: float = white.r * 0.299 + white.g * 0.587 + white.b * 0.114
				if whl - wl < 0.25:
					bad.append("medallion %.3f not ≥0.25 dark against the white tank %.3f" % [
							wl, whl])
			continue
		if not hexes.has(band3):
			bad.append("band %s wears no pinned §1.4 hex" % band3)
			continue
		var want: Color = hexes[band3]
		if _color_gap(got, want) > 0.02:
			bad.append("band %s color %s != the pinned hex %s" % [band3, got, want])
	for band4: String in hexes:
		if not bands_seen.has(band4):
			bad.append("band %s never used — the family is missing" % band4)
	for band5: String in ["brace", "medallion"]:
		if not bands_seen.has(band5):
			bad.append("band %s never used — the family is missing" % band5)

	## --- D. the meshes, live ---------------------------------------------------
	if hero_root != null:
		var tank_node := hero_root.get_node_or_null("TankCylinder") as MeshInstance3D
		var cone_node := hero_root.get_node_or_null("CapCone") as MeshInstance3D
		var ring_node := hero_root.get_node_or_null("MedallionRing") as MeshInstance3D
		var disc_node := hero_root.get_node_or_null("MedallionDisc") as MeshInstance3D
		if tank_node == null or cone_node == null or ring_node == null or disc_node == null:
			bad.append("a named mesh is missing (tank=%s cone=%s ring=%s disc=%s)" % [
					tank_node != null, cone_node != null, ring_node != null, disc_node != null])
		else:
			var want_white := Color("eded ea".replace(" ", ""))
			for m_node: MeshInstance3D in [tank_node, cone_node]:
				var mat := (m_node.mesh as CylinderMesh).material as StandardMaterial3D
				if mat == null or _color_gap(mat.albedo_color, want_white) > 0.02:
					bad.append("%s albedo %s != the tank white #EDEDEA" % [
							m_node.name, mat.albedo_color if mat != null else "<null>"])
			var want_med := Color(0.38, 0.38, 0.36)
			for m_node2: MeshInstance3D in [ring_node, disc_node]:
				var mat2 := (m_node2.mesh as CylinderMesh).material as StandardMaterial3D
				if mat2 == null or _color_gap(mat2.albedo_color, want_med) > 0.02:
					bad.append("%s albedo %s != the medallion dark" % [
							m_node2.name, mat2.albedo_color if mat2 != null else "<null>"])
			## The medallion faces EAST (its local +Y turned onto +X).
			var face_x: Vector3 = disc_node.transform.basis * Vector3.UP
			if absf(face_x.x - 1.0) > 0.01 or absf(face_x.y) > 0.01:
				bad.append("medallion faces %s != due east" % face_x)

	## --- E. the seams, live ------------------------------------------------------
	var space := get_world_3d().direct_space_state
	var probe := func(from: Vector3, to: Vector3) -> Dictionary:
		var ray := PhysicsRayQueryParameters3D.create(world.to_global(from),
				world.to_global(to))
		ray.collision_mask = 1
		return space.intersect_ray(ray)
	## The 0° leg's east face at y 10 — the splay re-derived from the row's
	## literals (base 6.725 → top 2.95 over 36.0, the 0.55 m section).
	var r10: float = lerpf(6.725, 2.95, 10.0 / 36.0)
	var lean: float = atan2(6.725 - 2.95, 36.0)
	var want_face: float = r10 + 0.275 * cos(lean)
	var leg_ray: Dictionary = probe.call(Vector3(mt_center.x + 30.0, 10.0, mt_center.y),
			Vector3(mt_center.x, 10.0, mt_center.y))
	if leg_ray.is_empty():
		bad.append("leg east-face ray missed")
	else:
		var lx: float = world.to_local((leg_ray as Dictionary)["position"]).x
		if absf(lx - (mt_center.x + want_face)) > 0.3:
			bad.append("leg east face x %.2f != the splay read %.2f (±0.3)" % [
					lx, mt_center.x + want_face])
	## The cornice top at 48.2 (down at r 3.75 — outside the cone base 3.55,
	## inside the lip 3.95).
	var cornice_ray: Dictionary = probe.call(Vector3(mt_center.x + 3.75, 60.0, mt_center.y),
			Vector3(mt_center.x + 3.75, 30.0, mt_center.y))
	if cornice_ray.is_empty():
		bad.append("cornice ray missed")
	else:
		var cy: float = world.to_local((cornice_ray as Dictionary)["position"]).y
		if absf(cy - 48.2) > 0.1:
			bad.append("cornice top y %.2f != the tank-top lip 48.2 (±0.1)" % cy)
	## The cone slope at r 3.4 (the photo-11 cap read, re-derived).
	var slope_y: float = 48.2 + (3.55 - 3.4) * 3.0 / (3.55 - 0.22)
	var slope_ray: Dictionary = probe.call(Vector3(mt_center.x + 3.4, 60.0, mt_center.y),
			Vector3(mt_center.x + 3.4, 40.0, mt_center.y))
	if slope_ray.is_empty():
		bad.append("cone slope ray missed")
	else:
		var sy: float = world.to_local((slope_ray as Dictionary)["position"]).y
		if absf(sy - slope_y) > 0.1:
			bad.append("cone slope y %.2f != the frustum read %.2f (±0.1)" % [sy, slope_y])
	## The tip plane down the axis — the beacon's very point.
	var tip_ray: Dictionary = probe.call(Vector3(mt_center.x, 60.0, mt_center.y),
			Vector3(mt_center.x, 40.0, mt_center.y))
	if tip_ray.is_empty():
		bad.append("tip ray missed")
	else:
		var ty: float = world.to_local((tip_ray as Dictionary)["position"]).y
		if absf(ty - 51.2) > 0.1:
			bad.append("tip plane y %.2f != the survey 51.2 (±0.1)" % ty)
	## The ground record: the tank top kept, the balcony ring, the open
	## trestle (the old cap square's 51.2 answer is gone — the tip files no
	## walkable top).
	var queries := [
		[Vector3(mt_center.x, 0.0, mt_center.y), 48.2, "tank top"],
		[Vector3(mt_center.x + 3.8, 0.0, mt_center.y), 36.05, "balcony ring"],
		[Vector3(mt_center.x + 6.5, 0.0, mt_center.y), 0.0, "the plate between the legs"],
	]
	for q: Array in queries:
		var got_h := world.ground_height(world.to_global(q[0] as Vector3))
		if absf(got_h - float(q[1])) > 0.05:
			bad.append("ground record at %s answers %.3f != the %s %.1f" % [
					q[2], got_h, q[2], float(q[1])])
	## The roof crumb: one ROOF spot at the cone tip + the lift —
	## byte-identical to the bake-derived cap pin this swap retires.
	var lift: float = AmesWorld.SPOT_LIFT
	var want_crumb := Vector3(mt_center.x, 51.2 + lift, mt_center.y)
	var crumb_ok := false
	for i: int in world.bread_spots.size():
		if world.bread_spots[i].distance_to(want_crumb) < 0.005 \
				and i < world.bread_spot_kinds.size() \
				and world.bread_spot_kinds[i] == City.BreadKind.ROOF:
			crumb_ok = true
			break
	if not crumb_ok:
		bad.append("no roof crumb at the cone tip %s" % want_crumb)
	_check(S, bad.is_empty(), "parts=%d bands=%d top=%.2f; %s"
			% [parts.size(), bands_seen.size(), hi.y, "; ".join(bad)])
	world.queue_free()


## --- scenario (T-191 the Jack Trice Stadium complex) -------------------------


## (T-191) The stadium complex re-pins its slots onto the HEROES — the
## T-186 swap law carried to the town's biggest silhouette set (the #1 and
## #2 from-the-air reads), every expectation re-derived from the COMMITTED
## bake slots (walked in-scenario from the chunk files) + the pack + the
## survey docs as verbatim scenario literals:
## A. THE SWAP — `way/613735866` (the bowl) supersedes its slot's 39 baked
##    placeholder parts (36 ring segments + 2 berms + the pitch across
##    chunks (4,3)/(4,4) — walked, not trusted) and `way/180651868` (the
##    drum) its 13 (12 segments + the roof across (4,0)/(5,0)); every
##    affected chunk's gray placeholder family shrinks to exactly its
##    non-superseded remainder and the massing families shrink by the
##    retired bbox entries.
## B. THE DIMS (the T-175 rows re-pinned on the heroes' own records) — the
##    bowl ring union 183 × 208 ±2 (V-09, measured 183.1 × 208.1 on the
##    bake's chord schedule) and the drum union 138 × 105 ±2 (§1.3);
##    THE FIELD ORIENTATION assertion: the pitch rides the slot's
##    53 × 113 with its LONG axis N–S (s.z 113 > s.x 53, z growing
##    southward — the V-09 ground truth, the Wikipedia misquote
##    corrected), centered on the bowl; the hillside reach law re-pinned
##    (the berm union's north edge past the ring's north edge, both NE/NW
##    sides present); the press tower entirely in the west half, west face
##    ON the ring face, topping at the 29.0 roof; the Sukup hint south
##    (top 22.0), the videoboard north at the V-11 24.2 × 11.0 (top 29.0,
##    on the Jacobson mass); the statue bands at the recorded plaza
##    offset, pedestal top 1.32, the figure topping ~2.9 (presence, the
##    simplified dignified read).
## C. THE PALETTE — §1.3's rows verbatim ±0.02 (cardinal #A6192E, gold
##    #C9A94E, bowl + press concrete #9C9C94, press glass #6E7B82, Sukup
##    glass #C9C68F, field grass #4E7A3A, markings #E8E8E2, Hilton
##    concrete #A69E8F + streaks #8C857A, lot asphalt #56585C) + the
##    darkness laws where the survey pins no hex (videoboard ≤ 0.25, the
##    statue bronze/stone ≤ 0.35 — the dignity read, Hilton seal ≤ 0.45 —
##    the medallion law).
## D. THE MESHES, LIVE — the Hilton arc-roof slab node + the seal disc
##    turned to face EAST (the University Blvd approach read), albedos off
##    the live nodes.
## E. THE SEAMS, LIVE — layer-1 rays answer the south rim band at x −60
##    (the landable row's own re-derivation, band ±4), the north wall's
##    outer face at the ring envelope, the press tower's west face, the
##    berm crest; `ground_height` answers the pitch 0.6, the berm steps
##    6.0/10.5, the south deck 16.0, the press roof 29.0, the Sukup top
##    22.0, the videoboard top 29.0, the statue pedestal 1.32, the drum
##    wall 20.0, the drum roof 23.0 and the canopy 9.2; the roof crumbs —
##    the stadium's re-pins at the press-tower roof (the superseded
##    ring-top read's new anchor, recorded in-ticket), Hilton's
##    byte-identical at the drum roof top.
## F. THE TAILGATE LOTS — the flats' ear-clip tri count equals the
##    in-scenario recount over the census §3 tailgate box (the literals
##    lat < 42.0225, lon −93.6445…−93.6260 — re-derived from the pack's
##    parking layer, never through the world's flags), the stall-marking
##    count equals the recount of the coarse grid over the same polygons,
##    every marking transform inside the tailgate union, the LotFlats
##    vertex color the asphalt hex (through the mesh path's linear
##    conversion) and the marking MM mounted white.
func _scenario_stadium_complex_dims() -> void:
	const S := "stadium_complex_dims"
	var bad: PackedStringArray = PackedStringArray()
	const JT_ID := "way/613735866"
	const HI_ID := "way/180651868"
	const DIM_TOL := 2.0
	## --- the bake slots, walked independently --------------------------------
	var jt_center := Vector2.ZERO
	var hi_center := Vector2.ZERO
	var jt_parts := {}
	var hi_parts := {}
	var chunk_rest: Dictionary = {} ## tile -> the gray family's remainder after the swap
	var chunk_massing: Dictionary = {} ## tile -> [file massing, non-hero massing]
	var hero_ids := {}
	for hid: Variant in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("heroes", []):
		hero_ids[str(hid)] = true
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		var rest := 0
		for ph: Dictionary in doc.get("placeholders", []):
			var pid := str(ph.get("id", ""))
			if pid == JT_ID:
				jt_parts[str(ph.get("part", ""))] = jt_parts.get(
						str(ph.get("part", "")), 0) + 1
				if str(ph.get("part", "")) == "pitch":
					jt_center = Vector2(float(ph["p"][0]), float(ph["p"][2]))
			elif pid == HI_ID:
				hi_parts[str(ph.get("part", ""))] = hi_parts.get(
						str(ph.get("part", "")), 0) + 1
				if str(ph.get("part", "")) == "roof":
					hi_center = Vector2(float(ph["p"][0]), float(ph["p"][2]))
			if hero_ids.has(pid):
				continue ## The slot the hero supersedes — off the gray family.
			rest += 1
		chunk_rest[tile] = rest ## The gray family's remainder after the swap.
		var ma_hero := 0
		for m: Dictionary in doc.get("massing", []):
			if hero_ids.has(str(m.get("id", ""))):
				ma_hero += 1
		chunk_massing[tile] = [doc.get("massing", []).size(), ma_hero]
	if jt_center == Vector2.ZERO or hi_center == Vector2.ZERO:
		_check(S, false, "bake slot walk failed: pitch/roof anchors missing")
		return
	var jt_file: int = int(jt_parts.get("bowl", 0)) + int(jt_parts.get("berm", 0)) \
			+ int(jt_parts.get("pitch", 0))
	var hi_file: int = int(hi_parts.get("drum", 0)) + int(hi_parts.get("roof", 0))
	if jt_file != 39 or int(jt_parts.get("bowl", 0)) != 36 \
			or int(jt_parts.get("berm", 0)) != 2 or int(jt_parts.get("pitch", 0)) != 1:
		bad.append("bake slot walk %s != the bowl's 39 parts (36+2+1)" % str(jt_parts))
	if hi_file != 13 or int(hi_parts.get("drum", 0)) != 12 \
			or int(hi_parts.get("roof", 0)) != 1:
		bad.append("bake slot walk %s != the drum's 13 parts (12+1)" % str(hi_parts))
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var jt_record := world.stadium_hero_parts
	var hi_record := world.hilton_hero_parts
	if jt_record.is_empty() or hi_record.is_empty():
		_check(S, false, "no retained stadium/Hilton hero parts — the hero never built")
		world.queue_free()
		return

	## --- A. the swap, per affected chunk --------------------------------------
	for tile: Vector2i in [Vector2i(4, 3), Vector2i(4, 4), Vector2i(4, 0), Vector2i(5, 0)]:
		var chunk_node := world.get_node_or_null("Chunks/Chunk_%d_%d" % [tile.x, tile.y]) as Node3D
		if chunk_node == null:
			bad.append("chunk %s missing" % tile)
			continue
		var rest: int = chunk_rest.get(tile, 0)
		var ph_mm := chunk_node.get_node_or_null("Placeholders") as MultiMeshInstance3D
		if rest == 0:
			if ph_mm != null:
				bad.append("chunk %s kept a placeholder MM after the full swap" % tile)
		elif ph_mm == null or ph_mm.multimesh.instance_count != rest:
			bad.append("chunk %s placeholder MM %d != the non-superseded remainder %d" % [
					tile, ph_mm.multimesh.instance_count if ph_mm != null else -1, rest])
		var want_ma: Array = chunk_massing.get(tile, [0, 0])
		var ma_mm := chunk_node.get_node_or_null("Massing") as MultiMeshInstance3D
		var want_ma_count := int(want_ma[0]) - int(want_ma[1])
		if want_ma_count == 0:
			if ma_mm != null:
				bad.append("chunk %s kept a massing MM after the hero retirements" % tile)
		elif ma_mm == null or ma_mm.multimesh.instance_count != want_ma_count:
			bad.append("chunk %s massing MM %d != file %d - %d hero bbox" % [tile,
					ma_mm.multimesh.instance_count if ma_mm != null else -1,
					want_ma[0], want_ma[1]])
	var hero_root := world.get_node_or_null("Chunks/Chunk_4_3/HeroJackTrice") as Node3D
	if hero_root == null:
		bad.append("no HeroJackTrice under chunk (4,3)")
	var hilton_root := world.get_node_or_null("Chunks/Chunk_4_0/HeroHilton") as Node3D
	if hilton_root == null:
		bad.append("no HeroHilton under chunk (4,0)")

	## --- B. the dims (the T-175 rows re-pinned on the heroes' records) --------
	var bowl_lo := Vector3(INF, INF, INF)
	var bowl_hi := Vector3(-INF, -INF, -INF)
	var berm_lo := Vector3(INF, INF, INF)
	var berm_hi := Vector3(-INF, -INF, -INF)
	var pitch := {}
	var deck_gold := 0
	var press_lo := Vector3(INF, INF, INF)
	var press_hi := Vector3(-INF, -INF, -INF)
	var sukup := {}
	var board := {}
	var plaza := {}
	var pedestal := {}
	var bronze_lo := Vector3(INF, INF, INF)
	var bronze_hi := Vector3(-INF, -INF, -INF)
	for part: Dictionary in jt_record:
		var p: Vector3 = part["p"]
		var s: Vector3 = part["s"]
		var band := str(part["band"])
		if band.begins_with("bowl") or band == "bowl":
			bowl_lo = bowl_lo.min(p - s * 0.5)
			bowl_hi = bowl_hi.max(p + s * 0.5)
			if band == "bowl_gold":
				deck_gold += 1
		elif band == "berm":
			berm_lo = berm_lo.min(p - s * 0.5)
			berm_hi = berm_hi.max(p + s * 0.5)
		elif band == "pitch":
			pitch = part
		elif band.begins_with("press"):
			press_lo = press_lo.min(p - s * 0.5)
			press_hi = press_hi.max(p + s * 0.5)
		elif band == "sukup":
			sukup = part
		elif band == "videoboard":
			board = part
		elif band == "statue_plaza":
			plaza = part
		elif band == "statue_stone":
			pedestal = part
		elif band == "statue_bronze":
			bronze_lo = bronze_lo.min(p - s * 0.5)
			bronze_hi = bronze_hi.max(p + s * 0.5)
	if bowl_hi == Vector3(-INF, -INF, -INF):
		bad.append("the bowl ring bands are missing from the record")
	else:
		var span := bowl_hi - bowl_lo
		if absf(span.x - 183.0) > DIM_TOL or absf(span.z - 208.0) > DIM_TOL:
			bad.append("bowl ring %.1fx%.1f != the survey's 183x208 (+-%.0f)" % [
					span.x, span.z, DIM_TOL])
	if pitch.is_empty():
		bad.append("the pitch part is missing from the record")
	else:
		## THE FIELD ORIENTATION: the long axis N–S (s.z 113 > s.x 53 —
		## z grows southward; the V-09 ground truth).
		var ps: Vector3 = pitch["s"]
		if absf(ps.x - 53.0) > 0.05 or absf(ps.z - 113.0) > 0.05:
			bad.append("pitch %s != the V-09 pitch 53x113 (+-0.05)" % ps)
		if ps.z <= ps.x:
			bad.append("pitch long axis %s is NOT north-south — the V-09 assertion" % ps)
		var pp: Vector3 = pitch["p"]
		if absf(pp.x - jt_center.x) > 0.05 or absf(pp.z - jt_center.y) > 0.05:
			bad.append("pitch center %s != the slot center %s" % [pp, jt_center])
	if berm_hi == Vector3(-INF, -INF, -INF):
		bad.append("the hillside (berm) band is missing from the record")
	else:
		if berm_lo.z >= bowl_lo.z:
			bad.append("hillside does not reach past the north rim (%.1f >= %.1f)" % [
					berm_lo.z, bowl_lo.z])
		var east := false
		var west := false
		for part2: Dictionary in jt_record:
			if str(part2["band"]) == "berm":
				if (part2["p"] as Vector3).x > jt_center.x:
					east = true
				else:
					west = true
		if not (east and west):
			bad.append("hillside lacks a NE/NW side (east=%s west=%s)" % [east, west])
		if absf(berm_hi.y - 10.5) > 0.05:
			bad.append("hillside crest %.2f != the stepped 10.5" % berm_hi.y)
	if press_hi == Vector3(-INF, -INF, -INF):
		bad.append("the press tower band is missing from the record")
	else:
		if press_hi.x >= jt_center.x:
			bad.append("press tower crosses into the east half (hi.x %.1f)" % press_hi.x)
		if absf(press_lo.x - (jt_center.x - 91.5)) > 0.05:
			bad.append("press west face %.2f != ON the ring face %.2f" % [
					press_lo.x, jt_center.x - 91.5])
		if absf(press_hi.y - 29.0) > 0.05:
			bad.append("press roof %.2f != the 3-level tower top 29.0" % press_hi.y)
		if press_hi.y <= bowl_hi.y:
			bad.append("press roof %.1f does not rise above the decks %.1f" % [
					press_hi.y, bowl_hi.y])
	if sukup.is_empty():
		bad.append("the Sukup hint is missing from the record")
	else:
		if _part_min(sukup).z <= jt_center.y:
			bad.append("Sukup hint is not at the south end")
		if absf((sukup["p"] as Vector3).y + (sukup["s"] as Vector3).y * 0.5 - 22.0) > 0.05:
			bad.append("Sukup top %.2f != the club band 22.0" % [
					(sukup["p"] as Vector3).y + (sukup["s"] as Vector3).y * 0.5])
	if board.is_empty():
		bad.append("the videoboard is missing from the record")
	else:
		if _part_max(board).z >= jt_center.y:
			bad.append("videoboard is not at the north end")
		var bs: Vector3 = board["s"]
		if absf(bs.x - 24.2) > 0.05 or absf(bs.y - 11.0) > 0.05 or absf(bs.z - 1.2) > 0.05:
			bad.append("videoboard %s != the V-11 24.2x11.0 slab" % bs)
	if plaza.is_empty() or pedestal.is_empty() or bronze_hi == Vector3(-INF, -INF, -INF):
		bad.append("the statue bands are missing from the record (plaza=%s stone=%s bronze=%s)"
				% [plaza.is_empty(), pedestal.is_empty(),
				bronze_hi == Vector3(-INF, -INF, -INF)])
	else:
		var want_pos := Vector2(jt_center.x + 58.0, jt_center.y - 140.0)
		var plaza_xz := Vector2((plaza["p"] as Vector3).x, (plaza["p"] as Vector3).z)
		if plaza_xz.distance_to(want_pos) > 0.05:
			bad.append("statue plaza %s != the recorded NE-plaza position %s" % [
					plaza_xz, want_pos])
		var pt_top: float = (pedestal["p"] as Vector3).y + (pedestal["s"] as Vector3).y * 0.5
		if absf(pt_top - 1.32) > 0.05:
			bad.append("statue pedestal top %.2f != the plinth 1.32" % pt_top)
		if bronze_lo.y < pt_top - 0.05:
			bad.append("statue figure sinks into the pedestal")
		if bronze_hi.y < 2.4:
			bad.append("statue figure top %.2f lacks presence (want >= 2.4)" % bronze_hi.y)
	## The drum: ring union + roof overhang + portico east.
	var drum_lo := Vector3(INF, INF, INF)
	var drum_hi := Vector3(-INF, -INF, -INF)
	var roof := {}
	var canopy := {}
	var streaks := 0
	for part3: Dictionary in hi_record:
		var p3: Vector3 = part3["p"]
		var s3: Vector3 = part3["s"]
		var band3 := str(part3["band"])
		if band3 == "drum" or band3 == "drum_streak":
			drum_lo = drum_lo.min(p3 - s3 * 0.5)
			drum_hi = drum_hi.max(p3 + s3 * 0.5)
			if band3 == "drum_streak":
				streaks += 1
		elif band3 == "hilton_roof" and bool(part3.get("mesh", false)):
			roof = part3
		elif band3 == "hilton_portico" and absf(s3.y - 1.0) < 0.05:
			canopy = part3
	if drum_hi == Vector3(-INF, -INF, -INF):
		bad.append("the drum bands are missing from the record")
	else:
		var dspan := drum_hi - drum_lo
		if absf(dspan.x - 138.0) > DIM_TOL or absf(dspan.z - 105.0) > DIM_TOL:
			bad.append("drum ring %.1fx%.1f != the survey's 138x105 (+-%.0f)" % [
					dspan.x, dspan.z, DIM_TOL])
	if roof.is_empty():
		bad.append("the arc roof slab is missing from the record")
	else:
		if (roof["p"] as Vector3).distance_to(Vector3(hi_center.x, 21.5, hi_center.y)) > 0.05:
			bad.append("roof slab %s != the drum roof center" % roof["p"])
		var rs: Vector3 = roof["s"]
		if rs.x <= drum_hi.x - drum_lo.x or rs.z <= drum_hi.z - drum_lo.z:
			bad.append("roof %s does not overhang the drum ring" % rs)
		if absf((roof["p"] as Vector3).y + 1.5 - 23.0) > 0.05:
			bad.append("roof top %.2f != the slot's own 23.0" % [
					(roof["p"] as Vector3).y + 1.5])
	if canopy.is_empty():
		bad.append("the portico canopy is missing from the record")
	else:
		if _part_min(canopy).x <= drum_hi.x - 20.0:
			bad.append("portico canopy does not project east")

	## --- C. the palette (§1.3's rows, verbatim scenario literals) --------------
	var hexes: Dictionary = {
		"bowl_cardinal": Color("a6192e"),
		"bowl_gold": Color("c9a94e"),
		"bowl_concrete": Color("9c9c94"),
		"berm": Color("4e7a3a"),
		"pitch": Color("4e7a3a"),
		"field_mark": Color("e8e8e2"),
		"press_concrete": Color("9c9c94"),
		"press_glass": Color("6e7b82"),
		"sukup": Color("c9c68f"),
		"statue_plaza": Color("9c9c94"),
		"drum": Color("a69e8f"),
		"drum_streak": Color("8c857a"),
		"hilton_roof": Color("a69e8f"),
		"hilton_portico": Color("a69e8f"),
	}
	var bands_seen := {}
	for record: Array in [jt_record, hi_record]:
		for part4: Dictionary in record:
			var band4 := str(part4["band"])
			bands_seen[band4] = true
			var got: Color = part4["color"]
			if band4 == "videoboard":
				if _luminance(got) > 0.25:
					bad.append("videoboard luminance %.3f > 0.25 — must read black" % _luminance(got))
				continue
			if band4 == "statue_bronze" or band4 == "statue_stone":
				if _luminance(got) > 0.35:
					bad.append("%s luminance %.3f > 0.35 — the dignity dark law" % [
							band4, _luminance(got)])
				continue
			if band4 == "hilton_seal":
				if _luminance(got) > 0.45:
					bad.append("hilton seal luminance %.3f > 0.45 — the medallion law" % _luminance(got))
				continue
			if not hexes.has(band4):
				bad.append("band %s wears no pinned §1.3 hex" % band4)
				continue
			var want: Color = hexes[band4]
			if _color_gap(got, want) > 0.02:
				bad.append("band %s color %s != the pinned hex %s" % [band4, got, want])
	for need: String in ["bowl_cardinal", "bowl_gold", "bowl_concrete", "berm",
			"pitch", "field_mark", "press_concrete", "press_glass", "sukup",
			"videoboard", "statue_plaza", "statue_stone", "statue_bronze",
			"drum", "drum_streak", "hilton_roof", "hilton_portico", "hilton_seal"]:
		if not bands_seen.has(need):
			bad.append("band %s never used — the family is missing" % need)
	if deck_gold < 4:
		bad.append("gold section accents %d < 4 — the striping read is missing" % deck_gold)
	if streaks < 2:
		bad.append("streak panels %d < 2 — the stained-drum read is missing" % streaks)

	## --- D. the meshes, live -----------------------------------------------------
	if hilton_root != null:
		var roof_node := hilton_root.get_node_or_null("RoofSlab") as MeshInstance3D
		var seal_node := hilton_root.get_node_or_null("SealDisc") as MeshInstance3D
		if roof_node == null or seal_node == null:
			bad.append("a named Hilton mesh is missing (roof=%s seal=%s)" % [
					roof_node != null, seal_node != null])
		else:
			var roof_mat := (roof_node.mesh as ArrayMesh).surface_get_material(0) as StandardMaterial3D
			if roof_mat == null or _color_gap(roof_mat.albedo_color, Color("a69e8f")) > 0.02:
				bad.append("roof slab albedo != the Hilton concrete #A69E8F")
			var seal_mat := (seal_node.mesh as CylinderMesh).material as StandardMaterial3D
			if seal_mat == null or _luminance(seal_mat.albedo_color) > 0.45:
				bad.append("seal disc albedo breaks the medallion dark law")
			## The seal faces EAST (its local +Y turned onto +x).
			var face_x: Vector3 = seal_node.transform.basis * Vector3.UP
			if absf(face_x.x - 1.0) > 0.01 or absf(face_x.y) > 0.01:
				bad.append("seal faces %s != due east" % face_x)

	## --- E. the seams, live ------------------------------------------------------
	var space := get_world_3d().direct_space_state
	var probe := func(from: Vector3, to: Vector3) -> Dictionary:
		var ray := PhysicsRayQueryParameters3D.create(world.to_global(from),
				world.to_global(to))
		ray.collision_mask = 1
		return space.intersect_ray(ray)
	## The south rim band at x −60, y 10 (the landable row's own re-derivation).
	var rim_hit: Dictionary = probe.call(Vector3(jt_center.x - 60.0, 10.0, jt_center.y + 140.0),
			Vector3(jt_center.x - 60.0, 10.0, jt_center.y))
	if rim_hit.is_empty():
		bad.append("south rim ray missed — no collider in the decked south rim")
	else:
		var rim_z: float = world.to_local((rim_hit as Dictionary)["position"]).z
		if rim_z < jt_center.y + 87.55 or rim_z > jt_center.y + 95.55:
			bad.append("south rim ray hit z %.2f outside the band (want %.1f ±4)" % [
					rim_z, jt_center.y + 91.55])
	## The north wall's outer face at the ring envelope (y 3, under the 6 m wall).
	var wall_hit: Dictionary = probe.call(Vector3(jt_center.x, 3.0, jt_center.y - 140.0),
			Vector3(jt_center.x, 3.0, jt_center.y))
	if wall_hit.is_empty():
		bad.append("north wall ray missed")
	else:
		var wall_z: float = world.to_local((wall_hit as Dictionary)["position"]).z
		if absf(wall_z - (jt_center.y - 103.59)) > 2.0:
			bad.append("north wall face z %.2f != the ring envelope read %.2f (±2)" % [
					wall_z, jt_center.y - 103.59])
	## The press tower's west face ON the ring face (y 15 — the glass level).
	var press_hit: Dictionary = probe.call(Vector3(jt_center.x - 130.0, 15.0, jt_center.y),
			Vector3(jt_center.x, 15.0, jt_center.y))
	if press_hit.is_empty():
		bad.append("press tower ray missed")
	else:
		var press_x: float = world.to_local((press_hit as Dictionary)["position"]).x
		if absf(press_x - (jt_center.x - 91.5)) > 0.3:
			bad.append("press west face x %.2f != the ring face %.2f (±0.3)" % [
					press_x, jt_center.x - 91.5])
	## The ground record (the walkability query). The berm step-1 point sits
	## under the crest box's own reach (z −115 is inside step 1's z band
	## −120..−96 but outside step 2's −112..−97); the drum wall point sits
	## outside the roof's walkable filing (the T-175 slot's own 118 × 90
	## box, kept byte-identical) on the ring band.
	var queries := [
		[Vector3(jt_center.x, 0.0, jt_center.y), 0.6, "pitch"],
		[Vector3(jt_center.x + 52.0, 0.0, jt_center.y - 115.0), 6.0, "berm step 1"],
		[Vector3(jt_center.x + 52.0, 0.0, jt_center.y - 104.5), 10.5, "berm crest"],
		[Vector3(jt_center.x, 0.0, jt_center.y + 95.0), 16.0, "south deck"],
		[Vector3(jt_center.x - 79.0, 0.0, jt_center.y), 29.0, "press roof"],
		[Vector3(jt_center.x, 0.0, jt_center.y + 86.0), 22.0, "Sukup top"],
		[Vector3(jt_center.x, 0.0, jt_center.y - 105.0), 29.0, "videoboard top"],
		[Vector3(jt_center.x + 58.0, 0.0, jt_center.y - 140.0), 1.32, "statue pedestal"],
		[Vector3(hi_center.x, 0.0, hi_center.y - 50.0), 20.0, "drum wall"],
		[Vector3(hi_center.x, 0.0, hi_center.y), 23.0, "drum roof"],
		[Vector3(hi_center.x + 72.0, 0.0, hi_center.y), 9.2, "portico canopy"],
	]
	for q: Array in queries:
		var got_h := world.ground_height(world.to_global(q[0] as Vector3))
		if absf(got_h - float(q[1])) > 0.05:
			bad.append("ground record at %s answers %.3f != the %s %.1f" % [
					q[2], got_h, q[2], float(q[1])])
	## The roof crumbs: the stadium's at the press-tower roof (the re-pin
	## this swap makes — the superseded ring-top read re-anchors), Hilton's
	## byte-identical at the drum roof top.
	var lift: float = AmesWorld.SPOT_LIFT
	for crumb: Array in [[Vector3(jt_center.x - 79.0, 29.0 + lift, jt_center.y), "press tower"],
			[Vector3(hi_center.x, 23.0 + lift, hi_center.y), "drum roof"]]:
		var crumb_ok := false
		for i: int in world.bread_spots.size():
			if world.bread_spots[i].distance_to(crumb[0]) < 0.005 \
					and i < world.bread_spot_kinds.size() \
					and world.bread_spot_kinds[i] == City.BreadKind.ROOF:
				crumb_ok = true
				break
		if not crumb_ok:
			bad.append("no roof crumb at the %s %s" % [crumb[1], crumb[0]])

	## --- F. the tailgate lots (the census §3 box, re-derived here) --------------
	var lot_polys: Array[PackedVector2Array] = []
	var union := Rect2()
	for lot: Dictionary in AmesDataPack.parking():
		var poly_arr: Array = lot.get("polygon", [])
		var wgs: Array = lot.get("wgs84", [])
		if poly_arr.size() < 3 or wgs.size() < 2:
			continue
		var lon := float(wgs[0])
		var lat := float(wgs[1])
		if not (lat < 42.0225 and lon > -93.6445 and lon < -93.6260):
			continue
		var poly := PackedVector2Array()
		var min_x := INF
		var min_z := INF
		var max_x := -INF
		var max_z := -INF
		for q2: Variant in poly_arr:
			var v := Vector2(float((q2 as Array)[0]), float((q2 as Array)[1]))
			poly.append(v)
			min_x = minf(min_x, v.x)
			min_z = minf(min_z, v.y)
			max_x = maxf(max_x, v.x)
			max_z = maxf(max_z, v.y)
		lot_polys.append(poly)
		union = union.merge(Rect2(min_x, min_z, max_x - min_x, max_z - min_z))
	if lot_polys.is_empty():
		bad.append("the tailgate recount found no lots — the census §3 box is broken")
	else:
		var tris := 0
		var marks := 0
		for poly2: PackedVector2Array in lot_polys:
			for ring: PackedVector2Array in AmesBaker._split_rings(poly2):
				tris += AmesBaker._triangulate(ring).size()
			var min_x2 := INF
			var min_z2 := INF
			var max_x2 := -INF
			var max_z2 := -INF
			for p5: Vector2 in poly2:
				min_x2 = minf(min_x2, p5.x)
				min_z2 = minf(min_z2, p5.y)
				max_x2 = maxf(max_x2, p5.x)
				max_z2 = maxf(max_z2, p5.y)
			var long_x := (max_x2 - min_x2) >= (max_z2 - min_z2)
			var a_lo := min_x2 if long_x else min_z2
			var a_hi := max_x2 if long_x else max_z2
			var b_lo := min_z2 if long_x else min_x2
			var b_hi := max_z2 if long_x else max_x2
			var row := b_lo + 2.5
			while row <= b_hi:
				var stall := a_lo + 1.375
				while stall <= a_hi:
					var pa := Vector2(stall, row - 2.5)
					var pb := Vector2(stall, row + 2.5)
					var pc := Vector2(stall, row)
					if not long_x:
						pa = Vector2(row - 2.5, stall)
						pb = Vector2(row + 2.5, stall)
						pc = Vector2(row, stall)
					if Geometry2D.is_point_in_polygon(pa, poly2) \
							and Geometry2D.is_point_in_polygon(pb, poly2) \
							and Geometry2D.is_point_in_polygon(pc, poly2):
						marks += 1
					stall += 2.75
				row += 6.0
		if world.lot_flat_tris != tris:
			bad.append("lot flat tris %d != the ear-clip recount %d" % [
					world.lot_flat_tris, tris])
		if world.lot_marking_xfs.size() != marks:
			bad.append("lot markings %d != the grid recount %d" % [
					world.lot_marking_xfs.size(), marks])
		if marks < 1000:
			bad.append("lot markings %d < 1000 — the 8.9 ha hint read is missing" % marks)
		for xf: Transform3D in world.lot_marking_xfs:
			var pos: Vector3 = xf.origin
			if pos.x < union.position.x or pos.x > union.end.x \
					or pos.z < union.position.y or pos.z > union.end.y:
				bad.append("lot marking at %s outside the tailgate union" % pos)
				break
		var lots_root := world.get_node_or_null("StadiumLots") as Node3D
		var flats: MeshInstance3D = null
		var marks_node: MultiMeshInstance3D = null
		if lots_root != null:
			flats = lots_root.get_node_or_null("LotFlats") as MeshInstance3D
			marks_node = lots_root.get_node_or_null("LotMarkings") as MultiMeshInstance3D
		if lots_root == null or flats == null or marks_node == null:
			bad.append("the StadiumLots family is not mounted (root=%s flats=%s marks=%s)" % [
					lots_root != null, flats != null, marks_node != null])
		else:
			var arrays: Array = (flats.mesh as ArrayMesh).surface_get_arrays(0)
			var cols: PackedColorArray = arrays[Mesh.ARRAY_COLOR]
			if cols.is_empty() or _color_gap(_linear_to_srgb(cols[0]), Color("56585c")) > 0.02:
				bad.append("lot flats vertex color != the asphalt #56585C (linear-space)")
			if marks_node.multimesh.instance_count != world.lot_marking_xfs.size():
				bad.append("marking MM %d != the retained record %d" % [
						marks_node.multimesh.instance_count, world.lot_marking_xfs.size()])
	_check(S, bad.is_empty(), "jt=%d hi=%d bowl=%.1fx%.1f drum=%.1fx%.1f lots=%d/%d; %s"
			% [jt_record.size(), hi_record.size(),
			bowl_hi.x - bowl_lo.x if bowl_hi.x > -INF else -1.0,
			bowl_hi.z - bowl_lo.z if bowl_hi.z > -INF else -1.0,
			drum_hi.x - drum_lo.x if drum_hi.x > -INF else -1.0,
			drum_hi.z - drum_lo.z if drum_hi.z > -INF else -1.0,
			world.lot_flat_tris, world.lot_marking_xfs.size(), "; ".join(bad)])
	world.queue_free()


## --- scenario (T-208 the tailgate dressing) ----------------------------------
## The gameday lot dress machine-pinned (the ticket's Gate 1b row), every
## expectation re-derived from the COMMITTED DATA — the pack's parking layer
## (the census §3 tailgate box literals, the T-191 recount's own walk) plus
## the bake's own Jack Trice pitch anchor (the T-191 slot walk) — never
## through the world's flags. The walk law transcribed in-scenario: the
## pinned tier bands, the aisle-band site lattice (the T-182 row module's
## closed form), the fill/kind/color hash bands (the exact roll keys), the
## footprint clip, the prop assembly; the T-182 guard PRIMITIVES shared (the
## census row pins their behavior — a prop and a stall must disagree about
## nothing). The live world compared record by record: the per-lot
## tier/count table, every family queue element-wise, the cycling palettes,
## the mounted MultiMeshes, and the arms the ticket actually writes:
## DENSITY GRADIENT (near fill > mid fill, the far lots car-only), the
## GENTLE MIX (the canopy distribution pinned at its landed shares), STRUCTURAL CLEARANCE (every site
## ≥ 2 m planar off every stall and gap slot of its lot — the fleet's
## park_spots_near stays open), VISUAL-ONLY (no physics in the family) and
## the ADDITIVE LAW (the T-182 dressing stock byte-unchanged by the dress).
func _scenario_tailgate_dressing_pins() -> void:
	const S := "tailgate_dressing_pins"
	## The law's consts, transcribed (a silent retune fails this row).
	const NEAR_DIST := 320.0
	const MID_DIST := 620.0
	const NEAR_FILL := 55
	const MID_FILL := 22
	const SITE_PITCH := 5.2
	const KIND_RV := 12
	const KIND_TABLE := 26
	const KIND_FLAG := 7
	const TENT_CARDINAL := 38
	const TENT_GOLD := 32
	const PROP_STALL_CLEAR := 2.0
	## The landed landing (re-pinned per re-bake like the census row's 8798):
	## the totals the first splitmix landing measured, pinned so a pack or
	## law drift fails the same night instead of silently re-reading.
	const LANDED_TENTS := 191
	const LANDED_RVS := 47
	const LANDED_TABLES := 107
	const LANDED_FLAGS := 29
	const LANDED_NEAR := 9
	const LANDED_MID := 4
	const LANDED_FAR := 13
	const LANDED_CANOPY_CARDINAL := 73
	const LANDED_CANOPY_GOLD := 55
	const LANDED_CANOPY_WHITE := 63
	var bad: PackedStringArray = PackedStringArray()

	## --- the scenario's own data walks (never the world's flags) -------------
	var pitch := Vector2.ZERO
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		for ph: Dictionary in doc.get("placeholders", []):
			if str(ph.get("id", "")) == "way/613735866" \
					and str(ph.get("part", "")) == "pitch":
				pitch = Vector2(float(ph["p"][0]), float(ph["p"][2]))
	if pitch == Vector2.ZERO:
		_check(S, false, "the bake walk found no Jack Trice pitch anchor")
		return
	var want_centers: Dictionary = {} ## lot id → the pack's own center.
	for lot: Dictionary in AmesDataPack.parking():
		var poly_arr: Array = lot.get("polygon", [])
		var wgs: Array = lot.get("wgs84", [])
		if poly_arr.size() < 3 or wgs.size() < 2:
			continue
		var lon := float(wgs[0])
		var lat := float(wgs[1])
		if not (lat < 42.0225 and lon > -93.6445 and lon < -93.6260):
			continue
		var c: Array = lot.get("center", [0.0, 0.0])
		want_centers[str(lot.get("id", ""))] = Vector2(float(c[0]), float(c[1]))
	if want_centers.is_empty():
		_check(S, false, "the pack walk found no tailgate lots — the census §3 box is broken")
		return

	## --- the live world -------------------------------------------------------
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	if world.parking == null or world.tailgate_dress_lots.is_empty():
		_check(S, false, "the world built no parking system or no tailgate dress")
		world.queue_free()
		return

	## --- the walk law, transcribed -------------------------------------------
	var recomp: Dictionary = {} ## lot id → the record dict, the world's form.
	var want_tent: Array[Transform3D] = []
	var want_tent_leg: Array[Transform3D] = []
	var want_rv: Array[Transform3D] = []
	var want_rv_band: Array[Transform3D] = []
	var want_table: Array[Transform3D] = []
	var want_cooler: Array[Transform3D] = []
	var want_pole: Array[Transform3D] = []
	var want_flag: Array[Transform3D] = []
	var want_tent_cols: Array[Color] = []
	var want_flag_cols: Array[Color] = []
	var near_sites := 0
	var near_dressed := 0
	var mid_sites := 0
	var mid_dressed := 0
	var tier_counts := [0, 0, 0]
	var sites_by_lot: Dictionary = {} ## lot id → the site (x, z) list, for the clearance arm.
	for lot: AmesParking.Lot in world.parking.lots:
		if not lot.in_tailgate or lot.polygon.size() < 3:
			continue
		if not want_centers.has(lot.id):
			bad.append("world lot %s is not in the scenario's census walk" % lot.id)
			continue
		var center: Vector2 = want_centers[lot.id]
		var dist := center.distance_to(pitch)
		var tier := 0 if dist <= NEAR_DIST else (1 if dist <= MID_DIST else 2)
		tier_counts[tier] += 1
		var rec: Dictionary = {"tier": tier, "sites": 0, "dressed": 0,
				"tents": 0, "rvs": 0, "tables": 0, "flags": 0}
		recomp[lot.id] = rec
		sites_by_lot[lot.id] = [] ## PackedVector2Array via append below.
		if tier == 2:
			continue ## The outlying lots stay car-only (T-182's stock).
		var fill := NEAR_FILL if tier == 0 else MID_FILL
		var long_x := lot.aabb.size.x >= lot.aabb.size.y
		var row_start := lot.aabb.position.y if long_x else lot.aabb.position.x
		var row_end := lot.aabb.end.y if long_x else lot.aabb.end.x
		var along_start := lot.aabb.position.x if long_x else lot.aabb.position.y
		var along_end := lot.aabb.end.x if long_x else lot.aabb.end.y
		var module: float = AmesParking.LOT_STALL_DEPTH + AmesParking.LOT_AISLE
		var candidates := world.parking.street_guard_candidates(lot)
		var row_span := row_end - row_start
		var row_count := 0
		if row_span >= AmesParking.LOT_STALL_DEPTH * 0.5:
			row_count = floori((row_span - AmesParking.LOT_STALL_DEPTH * 0.5)
					/ module) + 1
		var along_span := along_end - along_start
		var site_count := 0
		if along_span >= SITE_PITCH * 0.5:
			site_count = floori(along_span / SITE_PITCH - 0.5) + 1
		for row in row_count:
			var row_pos := row_start + module * float(row)
			var site_cross := row_pos + AmesParking.LOT_STALL_DEPTH \
					+ AmesParking.LOT_AISLE * 0.5
			for k in site_count:
				var u := along_start + SITE_PITCH * (float(k) + 0.5)
				var x := u if long_x else site_cross
				var z := site_cross if long_x else u
				rec["sites"] = int(rec["sites"]) + 1
				if tier == 0:
					near_sites += 1
				else:
					mid_sites += 1
				var roll := hash("tailgate/%s/%d/%d" % [lot.id, row, k])
				var fill_roll := (_tg_band(roll, 0) * 100) >> 13
				if fill_roll >= fill:
					continue
				var kind_roll := (_tg_band(roll, 1) * 100) >> 13
				var color_roll := _tg_band(roll, 2)
				var facing := Vector2(0.0, 1.0 if row % 2 == 0 else -1.0)
				if not long_x:
					facing = Vector2(1.0 if row % 2 == 0 else -1.0, 0.0)
				var kind := 3
				var kp := kind_roll
				if kp < KIND_RV:
					kind = 0
				elif kp < KIND_RV + KIND_TABLE:
					kind = 1
				elif kp < KIND_RV + KIND_TABLE + KIND_FLAG:
					kind = 2
				var ha := 1.5
				var hc := 1.5
				if kind == 0:
					ha = 4.5
					hc = 1.3
				elif kind == 1:
					ha = 1.3
					hc = 0.6
				elif kind == 2:
					ha = 0.95
					hc = 0.35
				var clip_ok := true
				for d_along: float in [-ha, 0.0, ha]:
					for d_across: float in [-hc, 0.0, hc]:
						var px := (x + d_along) if long_x else (x + d_across)
						var pz := (z + d_across) if long_x else (z + d_along)
						if not Geometry2D.is_point_in_polygon(Vector2(px, pz),
								lot.polygon):
							clip_ok = false
				if not clip_ok:
					continue
				if not world.parking.prop_guard_ok(x, z, candidates):
					continue
				rec["dressed"] = int(rec["dressed"]) + 1
				if tier == 0:
					near_dressed += 1
				else:
					mid_dressed += 1
				(sites_by_lot[lot.id] as Array).append(Vector2(x, z))
				var cp := (color_roll * 100) >> 13
				var ground := world.ground_height(world.to_global(Vector3(x, 0.0, z)))
				var base := Transform3D(
						Basis(Vector3.UP, atan2(-facing.x, -facing.y)),
						Vector3(x, ground, z))
				match kind:
					0:
						want_rv.append(base * Transform3D(
								Basis.from_scale(AmesWorld.TG_RV_SIZE),
								Vector3(0.0, AmesWorld.TG_RV_CY, 0.0)))
						want_rv_band.append(base * Transform3D(
								Basis.from_scale(AmesWorld.TG_RV_BAND),
								Vector3(0.0, AmesWorld.TG_RV_BAND_CY, 0.0)))
						rec["rvs"] = int(rec["rvs"]) + 1
					1:
						want_table.append(base * Transform3D(
								Basis.from_scale(AmesWorld.TG_TABLE_SIZE),
								Vector3(0.0, AmesWorld.TG_TABLE_CY, 0.0)))
						want_cooler.append(base * Transform3D(
								Basis.from_scale(AmesWorld.TG_COOLER_SIZE),
								AmesWorld.TG_COOLER_LOCAL))
						rec["tables"] = int(rec["tables"]) + 1
					2:
						want_pole.append(base * Transform3D(
								Basis.from_scale(AmesWorld.TG_POLE),
								Vector3(0.0, AmesWorld.TG_POLE_CY, 0.0)))
						want_flag.append(base * Transform3D(
								Basis.from_scale(AmesWorld.TG_FLAG_SIZE),
								AmesWorld.TG_FLAG_LOCAL))
						want_flag_cols.append(AmesWorld.TG_COLOR_CARDINAL
								if (color_roll & 1) == 0
								else AmesWorld.TG_COLOR_GOLD)
						rec["flags"] = int(rec["flags"]) + 1
					3:
						want_tent.append(base * Transform3D(
								Basis.from_scale(AmesWorld.TG_TENT_SIZE),
								Vector3(0.0, AmesWorld.TG_TENT_TOP_Y, 0.0)))
						for sx: float in [-AmesWorld.TG_TENT_LEG_XZ,
								AmesWorld.TG_TENT_LEG_XZ]:
							for sz: float in [-AmesWorld.TG_TENT_LEG_XZ,
									AmesWorld.TG_TENT_LEG_XZ]:
								want_tent_leg.append(base * Transform3D(
										Basis.from_scale(AmesWorld.TG_TENT_LEG),
										Vector3(sx, AmesWorld.TG_TENT_LEG.y * 0.5,
												sz)))
						want_tent_cols.append(AmesWorld.TG_COLOR_CARDINAL
								if cp < TENT_CARDINAL
								else (AmesWorld.TG_COLOR_GOLD
										if cp < TENT_CARDINAL + TENT_GOLD
										else AmesWorld.TG_COLOR_CANOPY_WHITE))
						rec["tents"] = int(rec["tents"]) + 1

	## --- A. the per-lot records + the landed pins ------------------------------
	var total_tents := 0
	var total_rvs := 0
	var total_tables := 0
	var total_flags := 0
	for id: String in recomp:
		var rec: Dictionary = recomp[id]
		total_tents += int(rec["tents"])
		total_rvs += int(rec["rvs"])
		total_tables += int(rec["tables"])
		total_flags += int(rec["flags"])
		var got: Dictionary = world.tailgate_dress_lots.get(id, {})
		if got.is_empty():
			bad.append("lot %s missing from the world's dress record" % id)
			continue
		for key: String in ["tier", "sites", "dressed", "tents", "rvs", "tables", "flags"]:
			if int(got.get(key, -1)) != int(rec[key]):
				bad.append("lot %s record %s=%d != recompute %d" % [id, key,
						int(got.get(key, -1)), int(rec[key])])
	if world.tailgate_dress_lots.size() != want_centers.size():
		bad.append("the world's dress record covers %d lots != the census walk's %d" % [
				world.tailgate_dress_lots.size(), want_centers.size()])
	if total_tents != LANDED_TENTS or total_rvs != LANDED_RVS \
			or total_tables != LANDED_TABLES or total_flags != LANDED_FLAGS:
		bad.append("landed totals %d/%d/%d/%d != the pin %d/%d/%d/%d" % [
				total_tents, total_rvs, total_tables, total_flags,
				LANDED_TENTS, LANDED_RVS, LANDED_TABLES, LANDED_FLAGS])
	if int(tier_counts[0]) != LANDED_NEAR or int(tier_counts[1]) != LANDED_MID \
			or int(tier_counts[2]) != LANDED_FAR:
		bad.append("tier counts %d/%d/%d != the pin %d/%d/%d" % [tier_counts[0],
				tier_counts[1], tier_counts[2], LANDED_NEAR, LANDED_MID, LANDED_FAR])

	## --- B. DENSITY GRADIENT — the ticket's "fills hardest" law ----------------
	if near_sites <= 0 or mid_sites <= 0:
		bad.append("the gradient arms have no sites (near=%d mid=%d)" % [near_sites, mid_sites])
	else:
		var near_rate := float(near_dressed) / float(near_sites)
		var mid_rate := float(mid_dressed) / float(mid_sites)
		if near_rate <= mid_rate:
			bad.append("the gradient is inverted: near fill %.3f <= mid %.3f" % [
					near_rate, mid_rate])

	## --- C. the family queues, element-wise ------------------------------------
	var queues := [
			[tailgate_families_tent(world), want_tent],
			[tailgate_families_leg(world), want_tent_leg],
			[tailgate_families_rv(world), want_rv],
			[tailgate_families_band(world), want_rv_band],
			[tailgate_families_table(world), want_table],
			[tailgate_families_cooler(world), want_cooler],
			[tailgate_families_pole(world), want_pole],
			[tailgate_families_flag(world), want_flag],
	]
	for pair: Array in queues:
		var got: Array = pair[0]
		var want: Array = pair[1]
		if got.size() != want.size():
			bad.append("family queue %d != recompute %d" % [got.size(), want.size()])
			continue
		for i: int in want.size():
			var a: Transform3D = got[i]
			var w2: Transform3D = want[i]
			if a.origin.distance_to(w2.origin) > 1e-4 \
					or a.basis.get_euler().distance_to(w2.basis.get_euler()) > 1e-4:
				bad.append("family transform %d drifted: %s vs %s" % [i, a, w2])
				break

	## --- D. the palettes --------------------------------------------------------
	if world.tailgate_tent_colors.size() != want_tent_cols.size():
		bad.append("tent palette %d != recompute %d" % [
				world.tailgate_tent_colors.size(), want_tent_cols.size()])
	else:
		for i: int in want_tent_cols.size():
			if world.tailgate_tent_colors[i] != want_tent_cols[i]:
				bad.append("tent color %d drifted" % i)
				break
	if world.tailgate_flag_colors.size() != want_flag_cols.size():
		bad.append("flag palette %d != recompute %d" % [
				world.tailgate_flag_colors.size(), want_flag_cols.size()])
	else:
		for i: int in want_flag_cols.size():
			if world.tailgate_flag_colors[i] != want_flag_cols[i]:
				bad.append("flag color %d drifted" % i)
				break

	## --- E. the GENTLE MIX — the canopy distribution pinned ---------------------
	## The ticket's "cardinal-gold tent distribution is a pinned mix (the
	## invasion-flavored read stays gentle)": the landed shares carry all
	## three colors at their pinned counts (the per-lot monochrome possibility
	## is the hash's honest outcome at small counts — a same-color tent row is
	## a real tailgate read, not a law break; the multiset compare in D ties
	## the mix to the recompute, this arm pins the landed landing).
	var cardinal := 0
	var gold := 0
	var white := 0
	for col: Color in world.tailgate_tent_colors:
		if col == AmesWorld.TG_COLOR_CARDINAL:
			cardinal += 1
		elif col == AmesWorld.TG_COLOR_GOLD:
			gold += 1
		elif col == AmesWorld.TG_COLOR_CANOPY_WHITE:
			white += 1
	if cardinal + gold + white != total_tents:
		bad.append("the canopy mix %d/%d/%d != the tent total %d" % [
				cardinal, gold, white, total_tents])
	if cardinal <= 0 or gold <= 0 or white <= 0:
		bad.append("the gentle mix lost a color: c/g/w=%d/%d/%d" % [
				cardinal, gold, white])
	if cardinal != LANDED_CANOPY_CARDINAL or gold != LANDED_CANOPY_GOLD \
			or white != LANDED_CANOPY_WHITE:
		bad.append("canopy mix %d/%d/%d != the pin %d/%d/%d" % [cardinal, gold,
				white, LANDED_CANOPY_CARDINAL, LANDED_CANOPY_GOLD,
				LANDED_CANOPY_WHITE])

	## --- F. STRUCTURAL CLEARANCE — props never take a stall or a gap -----------
	var cleared := 0
	for id: String in sites_by_lot:
		var lot: AmesParking.Lot = _tailgate_lot(world, id)
		if lot == null:
			continue
		var stall_xfs: Array[Transform3D] = []
		stall_xfs.append_array(lot.stalls)
		stall_xfs.append_array(lot.gaps)
		for site: Vector2 in sites_by_lot[id]:
			var worst := INF
			for xf: Transform3D in stall_xfs:
				worst = minf(worst, Vector2(xf.origin.x - site.x,
						xf.origin.z - site.y).length())
			if worst < PROP_STALL_CLEAR:
				bad.append("lot %s prop at %s sits %.2f m off a stall (< %.1f)" % [
						id, site, worst, PROP_STALL_CLEAR])
				break
			cleared += 1

	## --- G. VISUAL-ONLY — the family carries no physics -------------------------
	var lots_root := world.get_node_or_null("StadiumLots") as Node3D
	if lots_root == null:
		bad.append("no StadiumLots root")
	else:
		for node: Node in lots_root.find_children("*", "Node3D", true, false):
			if node is StaticBody3D or node is CollisionShape3D \
					or node is CollisionObject3D:
				bad.append("the tailgate family carries physics at %s" % node.name)
				break
		for family: String in ["LotFlats", "LotMarkings", "TentCanopies", "TentLegs",
				"RvBodies", "RvBands", "Tables", "Coolers", "FlagPoles", "Flags"]:
			var fam: Node = lots_root.get_node_or_null(NodePath(family))
			if fam == null:
				bad.append("StadiumLots lost %s" % family)
				continue
			if fam is MultiMeshInstance3D:
				var want_count := tailgate_family_count(world, family)
				if (fam as MultiMeshInstance3D).multimesh.instance_count \
						!= want_count:
					bad.append("%s MM %d != the retained queue %d" % [family,
							(fam as MultiMeshInstance3D).multimesh.instance_count,
							want_count])

	## --- H. the ADDITIVE LAW — the T-182 stock unchanged by the dress -----------
	var body_mm := world.get_node_or_null("Parking/LotBodies") as MultiMeshInstance3D
	if body_mm == null \
			or body_mm.multimesh.instance_count != world.parking.dressed_car_count():
		bad.append("the parking stock moved: the LotBodies MM %d no longer mounts " +
				"exactly the parking system's %d stalls" % [
				body_mm.multimesh.instance_count if body_mm != null else -1,
				world.parking.dressed_car_count()])

	print("SIM DATA %s: lots=%d near=%d mid=%d far=%d dressed=%d/%d tents=%d rvs=%d tables=%d flags=%d canopy c/g/w=%d/%d/%d cleared=%d" % [
			S, want_centers.size(), tier_counts[0], tier_counts[1], tier_counts[2],
			near_dressed + mid_dressed, near_sites + mid_sites,
			total_tents, total_rvs, total_tables, total_flags,
			cardinal, gold, white, cleared])
	_check(S, bad.is_empty(), "tents=%d rvs=%d tables=%d flags=%d tiers=%d/%d/%d; %s"
			% [total_tents, total_rvs, total_tables, total_flags,
			tier_counts[0], tier_counts[1], tier_counts[2], "; ".join(bad)])
	world.queue_free()


## The band spread (the T-207 law, transcribed — the world's `_tg_band`):
## a splitmix-style integer finalizer over (roll, band); the 13-bit read
## feeds the percentage bands ((b * 100) >> 13 → 0..99) and the flag parity
## rides its LSB.
func _tg_band(roll: int, band: int) -> int:
	var h := roll ^ (band * -7046029254386353131)
	h = (h ^ (h >> 30)) * -4658895280553007687
	h = (h ^ (h >> 27)) * -7905916399975552669
	h = h ^ (h >> 31)
	return (h >> 11) & 0x1FFF


## The world's tailgate lot object for an id (null when absent).
func _tailgate_lot(world: AmesWorld, id: String) -> AmesParking.Lot:
	for lot: AmesParking.Lot in world.parking.lots:
		if lot.id == id:
			return lot
	return null


## The world's retained queue for one tailgate family name (the mounted-MM
## arms read these; the helper keeps the family table in one place).
func tailgate_families_tent(world: AmesWorld) -> Array[Transform3D]:
	return world.tailgate_tent_xfs


func tailgate_families_leg(world: AmesWorld) -> Array[Transform3D]:
	return world.tailgate_tent_leg_xfs


func tailgate_families_rv(world: AmesWorld) -> Array[Transform3D]:
	return world.tailgate_rv_xfs


func tailgate_families_band(world: AmesWorld) -> Array[Transform3D]:
	return world.tailgate_rv_band_xfs


func tailgate_families_table(world: AmesWorld) -> Array[Transform3D]:
	return world.tailgate_table_xfs


func tailgate_families_cooler(world: AmesWorld) -> Array[Transform3D]:
	return world.tailgate_cooler_xfs


func tailgate_families_pole(world: AmesWorld) -> Array[Transform3D]:
	return world.tailgate_flag_pole_xfs


func tailgate_families_flag(world: AmesWorld) -> Array[Transform3D]:
	return world.tailgate_flag_xfs


func tailgate_family_count(world: AmesWorld, family: String) -> int:
	match family:
		"LotFlats":
			return -1 ## Not a MM — the count arm skips it via the type check.
		"LotMarkings":
			return world.lot_marking_xfs.size()
		"TentCanopies":
			return world.tailgate_tent_xfs.size()
		"TentLegs":
			return world.tailgate_tent_leg_xfs.size()
		"RvBodies":
			return world.tailgate_rv_xfs.size()
		"RvBands":
			return world.tailgate_rv_band_xfs.size()
		"Tables":
			return world.tailgate_table_xfs.size()
		"Coolers":
			return world.tailgate_cooler_xfs.size()
		"FlagPoles":
			return world.tailgate_flag_pole_xfs.size()
		"Flags":
			return world.tailgate_flag_xfs.size()
	return -1


## One record entry's min/max corners (p ∓ s·0.5), the dims arms' helpers.
func _part_min(part: Dictionary) -> Vector3:
	return (part["p"] as Vector3) - (part["s"] as Vector3) * 0.5


func _part_max(part: Dictionary) -> Vector3:
	return (part["p"] as Vector3) + (part["s"] as Vector3) * 0.5


## The rec.709 luminance the darkness laws walk.
func _luminance(c: Color) -> float:
	return c.r * 0.299 + c.g * 0.587 + c.b * 0.114


## The mesh path's linear vertex colors back to sRGB for the palette arms.
func _linear_to_srgb(c: Color) -> Color:
	var f := func(v: float) -> float:
		return v * 12.92 if v <= 0.0031308 else 1.055 * pow(v, 1.0 / 2.4) - 0.055
	return Color(f.call(c.r), f.call(c.g), f.call(c.b), c.a)


## --- scenario (T-192 the downtown heroes + the Main Street fabric) ----------


## (T-192) Downtown's identity set on the resident Ames world, every
## expectation re-derived from the COMMITTED DATA (the bake slots walked
## in-scenario from the chunk files, the pack, the survey's §1.7 rows as
## verbatim scenario literals — never through the world's own constants):
## A. THE SWAPS — the bandshell (`downtown_bandshell`) supersedes its slot's
##    EIGHT baked placeholder parts (7 shell piers + the stage deck, chunk
##    (13,−2) — the chunk's whole gray family, so its placeholder MM
##    vanishes, the campanile-chunk precedent); the City Hall
##    (`relation/2560369`) and Municipal (`way/237834146`) slots' authored
##    bbox massing retires through the runtime hero set (the T-188 Morrill
##    law — the carrier chunks' massing MMs shrink by exactly 1 each, the
##    tiles re-derived from the walked slot centers); the three hero roots
##    mount under their carrier chunks.
## B. THE BANDSHELL (the L3 organic shell) — the record unions the OSM way
##    269752151 footprint at its TRUE position: 25.4 × 14.6 ±2 centered on
##    the literal (3360.9, −377.7) — ~35 m north of the retired slot at the
##    park POI's centroid (the reach arm: hero center to slot center > 30,
##    the ticket's "true position" law); apex 11.6 (the air-read crown);
##    the nested scallop — 4 front rings (copper/mint/cream/mint, ≥8 chords
##    each) + 2 rear copper profile rings, all ground-filed; the stage deck
##    at the slot's own 1.2 top, the pier pair topping 7.2, the south annex
##    at 3.0; the §1.7 palette verbatim ±0.02 (arch #4A5A57, mint #DCE8DC,
##    cream #EDE9D8, pier brick #9C4A34) + the grille's dark law (≤ 0.25).
## C. THE CIVIC PAIR — City Hall 82.3 × 14 × 78.5 ±0.05 at its slot center
##    wearing #A8663F (its OWN bake slot color), Municipal 26.7 × 11 × 25.3
##    wearing #8A4A36; each carries the cornice stone band #D6CDBB at its
##    top and the cartouche-entry stone proud of the Clark (east) / Kellogg
##    (west) face; ground answers the roofs 14.0 / 11.0; the roof crumbs
##    ride the tops.
## D. THE FABRIC — the cornice count equals the in-scenario recount over the
##    chunk files with the row-band literals (the no-self-test rule), every
##    cornice inside the row bands wearing #D6CDBB; the lamp run equals the
##    polyline recount (pitch 32, inset 24, clear 16, offset 6.9, the pack's
##    own Main points), maroon #5C2E35 poles + blue #2E4E9E banners, one
##    banner per lamp, bracket pairs; the blade count equals the bar-token
##    recount over the pack names (window + Main-projection side, re-derived
##    here), blades dark (≤ 0.25) with the neon tube at the scenario's own
##    pinned literal #E85224; the DowntownFabric families mount and every
##    live MM count equals its retained-record count.
## E. THE SEAMS, LIVE — layer-1 rays answer the City Hall east (Clark) face,
##    the Municipal west (Kellogg) face, the bandshell stage's south face
##    and the arch crown from above; ground_height answers the stage deck
##    1.2, a pier top 7.2, the arch crown 11.6, the annex 3.0, the roofs
##    14.0 / 11.0, and a blade top 7.4; the bandshell's roof crumb rides the
##    arch crown, the civic pair's their roof centers.
func _scenario_downtown_heroes() -> void:
	const S := "downtown_heroes"
	var bad: PackedStringArray = PackedStringArray()
	const DIM_TOL := 2.0
	const BS_CENTER := Vector2(3360.9, -377.7) ## The OSM way 269752151 footprint center.
	const SLOT_CENTER := Vector2(3353.52, -412.08) ## The park POI's centroid (the retired slot).
	## --- the bake slots, walked independently --------------------------------
	var shell_parts := {}
	var hall_slot := Vector2.ZERO
	var hall_top := 0.0
	var municipal_slot := Vector2.ZERO
	var municipal_top := 0.0
	var chunk_rest: Dictionary = {} ## tile -> the gray family's remainder after the swaps
	var chunk_massing: Dictionary = {} ## tile -> [file massing, hero massing]
	var hero_ids := {}
	for hid: Variant in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("heroes", []):
		hero_ids[str(hid)] = true
	hero_ids["relation/2560369"] = true
	hero_ids["way/237834146"] = true
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var tile := Vector2i(int(entry["cx"]), int(entry["cz"]))
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		var rest := 0
		for ph: Dictionary in doc.get("placeholders", []):
			var pid := str(ph.get("id", ""))
			if pid == "downtown_bandshell":
				var part := str(ph.get("part", ""))
				shell_parts[part] = int(shell_parts.get(part, 0)) + 1
				continue ## The slot the hero supersedes — off the gray family.
			rest += 1
		chunk_rest[tile] = rest
		var ma_hero := 0
		for m: Dictionary in doc.get("massing", []):
			if not hero_ids.has(str(m.get("id", ""))):
				continue
			ma_hero += 1
			var mx := float(m["p"][0])
			var mz := float(m["p"][2])
			if str(m.get("id", "")) == "relation/2560369":
				hall_slot = Vector2(mx, mz)
				hall_top = float(m["p"][1]) + float(m["s"][1]) * 0.5
			elif str(m.get("id", "")) == "way/237834146":
				municipal_slot = Vector2(mx, mz)
				municipal_top = float(m["p"][1]) + float(m["s"][1]) * 0.5
		chunk_massing[tile] = [doc.get("massing", []).size(), ma_hero]
	var shell_total: int = int(shell_parts.get("shell", 0)) \
			+ int(shell_parts.get("stage", 0))
	if shell_total != 8 or int(shell_parts.get("shell", 0)) != 7 \
			or int(shell_parts.get("stage", 0)) != 1:
		bad.append("bake slot walk %s != the bandshell's 8 parts (7+1)" % str(shell_parts))
	if hall_slot == Vector2.ZERO or municipal_slot == Vector2.ZERO:
		bad.append("bake slot walk failed: civic anchors missing")
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var shell_record := world.bandshell_hero_parts
	var civic_record := world.civic_hero_parts
	var fabric_record := world.fabric_parts
	if shell_record.is_empty() or civic_record.is_empty() or fabric_record.is_empty():
		bad.append("no retained bandshell/civic/fabric parts — a hero never built")
		_check(S, false, "; ".join(bad))
		world.queue_free()
		return

	## --- A. the swaps, per affected chunk --------------------------------------
	var shell_tile := Vector2i(floori(BS_CENTER.x / 256.0), floori(BS_CENTER.y / 256.0))
	var hall_tile := Vector2i(floori(hall_slot.x / 256.0), floori(hall_slot.y / 256.0))
	var mun_tile := Vector2i(floori(municipal_slot.x / 256.0),
			floori(municipal_slot.y / 256.0))
	for pair: Array in [[shell_tile, true], [hall_tile, false], [mun_tile, false]]:
		var tile: Vector2i = pair[0]
		var chunk_node := world.get_node_or_null(
				"Chunks/Chunk_%d_%d" % [tile.x, tile.y]) as Node3D
		if chunk_node == null:
			bad.append("chunk %s missing" % tile)
			continue
		var rest: int = chunk_rest.get(tile, 0)
		var ph_mm := chunk_node.get_node_or_null("Placeholders") as MultiMeshInstance3D
		if pair[1]:
			## The bandshell chunk's whole gray family retired — the MM
			## vanishes outright (the campanile-chunk precedent).
			if ph_mm != null:
				bad.append("chunk %s kept a placeholder MM after the full swap" % tile)
		elif rest == 0:
			if ph_mm != null:
				bad.append("chunk %s kept a placeholder MM after the full swap" % tile)
		elif ph_mm == null or ph_mm.multimesh.instance_count != rest:
			bad.append("chunk %s placeholder MM %d != the non-superseded remainder %d" % [
					tile, ph_mm.multimesh.instance_count if ph_mm != null else -1, rest])
		var want_ma: Array = chunk_massing.get(tile, [0, 0])
		var ma_mm := chunk_node.get_node_or_null("Massing") as MultiMeshInstance3D
		var want_ma_count := int(want_ma[0]) - int(want_ma[1])
		if want_ma_count == 0:
			if ma_mm != null:
				bad.append("chunk %s kept a massing MM after the hero retirements" % tile)
		elif ma_mm == null or ma_mm.multimesh.instance_count != want_ma_count:
			bad.append("chunk %s massing MM %d != file %d - %d hero bbox" % [tile,
					ma_mm.multimesh.instance_count if ma_mm != null else -1,
					want_ma[0], want_ma[1]])
	if world.get_node_or_null("Chunks/Chunk_%d_%d/HeroBandshell"
			% [shell_tile.x, shell_tile.y]) == null:
		bad.append("no HeroBandshell under chunk %s" % shell_tile)
	## The civic pair mounts through `_row_commit` — its root names carry the
	## `HeroRow` prefix (the T-188 row law).
	if world.get_node_or_null("Chunks/Chunk_%d_%d/HeroRowCityHall"
			% [hall_tile.x, hall_tile.y]) == null:
		bad.append("no HeroRowCityHall under chunk %s" % hall_tile)
	if world.get_node_or_null("Chunks/Chunk_%d_%d/HeroRowMunicipal"
			% [mun_tile.x, mun_tile.y]) == null:
		bad.append("no HeroRowMunicipal under chunk %s" % mun_tile)

	## --- B. the bandshell (the true-position read) ------------------------------
	var bs_lo := Vector3(INF, INF, INF)
	var bs_hi := Vector3(-INF, -INF, -INF)
	var arch_lo := Vector3(INF, INF, INF)
	var arch_hi := Vector3(-INF, -INF, -INF)
	var stage := {}
	var pier_lo := Vector3(INF, INF, INF)
	var pier_hi := Vector3(-INF, -INF, -INF)
	var annex := {}
	var arch_chords := 0
	var mint_chords := 0
	var cream_chords := 0
	for part: Dictionary in shell_record:
		var p: Vector3 = part["p"]
		var s: Vector3 = part["s"]
		var band := str(part["band"])
		bs_lo = bs_lo.min(p - s * 0.5)
		bs_hi = bs_hi.max(p + s * 0.5)
		if band == "arch":
			arch_lo = arch_lo.min(p - s * 0.5)
			arch_hi = arch_hi.max(p + s * 0.5)
			arch_chords += 1
		elif band == "shell_mint":
			mint_chords += 1
		elif band == "shell_cream":
			cream_chords += 1
		elif band == "pier_brick":
			pier_lo = pier_lo.min(p - s * 0.5)
			pier_hi = pier_hi.max(p + s * 0.5)
			if s.y <= 1.3:
				stage = part
		elif band == "backstage":
			annex = part
	if bs_hi == Vector3(-INF, -INF, -INF):
		bad.append("the bandshell record is empty")
	else:
		var span := bs_hi - bs_lo
		if absf(span.x - 25.4) > DIM_TOL or absf(span.z - 14.6) > DIM_TOL:
			bad.append("bandshell %.1fx%.1f != the OSM footprint 25.4x14.6 (+-%.0f)" % [
					span.x, span.z, DIM_TOL])
		var center := (bs_lo + bs_hi) * 0.5
		if Vector2(center.x, center.z).distance_to(BS_CENTER) > DIM_TOL:
			bad.append("bandshell center %s != the OSM footprint center %s" % [
					Vector2(center.x, center.z), BS_CENTER])
		## THE TRUE POSITION: the hero stands at the structure, ~35 m north of
		## the retired park-centroid slot (the ticket's law).
		if Vector2(center.x, center.z).distance_to(SLOT_CENTER) <= 30.0:
			bad.append("bandshell still reads at the slot centroid %s — not the true position"
					% Vector2(center.x, center.z))
	if arch_hi == Vector3(-INF, -INF, -INF):
		bad.append("the copper arch band is missing from the record")
	else:
		## The record files the chords' world AABBs (the T-190 law) — the
		## straddling apex chords' corners overshoot the true arc crown by
		## the AABB slop, so the union tops at ~11.73 against the 11.6 read.
		if absf(arch_hi.y - 11.6) > 0.2:
			bad.append("arch crown %.2f != the photo-read apex 11.6 (+-0.2, the AABB law)"
					% arch_hi.y)
		if arch_hi.y <= pier_hi.y:
			bad.append("the arch does not rise above the piers")
	if stage.is_empty():
		bad.append("the stage deck is missing from the record")
	else:
		var st_top: float = (stage["p"] as Vector3).y + (stage["s"] as Vector3).y * 0.5
		if absf(st_top - 1.2) > 0.05:
			bad.append("stage top %.2f != the slot's own 1.2" % st_top)
	if annex.is_empty():
		bad.append("the rear annex is missing from the record")
	else:
		if (annex["p"] as Vector3).z <= BS_CENTER.y:
			bad.append("the annex is not south of the shell center")
	if arch_chords < 8 or mint_chords < 8 or cream_chords < 8:
		bad.append("the nested scallop is thin (arch=%d mint=%d cream=%d — want >= 8 each)"
				% [arch_chords, mint_chords, cream_chords])

	## --- C. the civic pair -------------------------------------------------------
	var hall := {}
	var municipal := {}
	for part2: Dictionary in civic_record:
		var band2 := str(part2["band"])
		var s2: Vector3 = part2["s"]
		if band2 == "civic_brick" and s2.x > 40.0:
			hall = part2
		elif band2 == "civic_brick_dark" and s2.x > 20.0:
			municipal = part2
	if hall.is_empty() or municipal.is_empty():
		bad.append("the civic pair's body records are missing (hall=%s mun=%s)" % [
				not hall.is_empty(), not municipal.is_empty()])
	else:
		var hs: Vector3 = hall["s"]
		if absf(hs.x - 82.3) > 0.05 or absf(hs.y - 14.0) > 0.05 \
				or absf(hs.z - 78.5) > 0.05:
			bad.append("City Hall block %s != the slot envelope 82.3x14x78.5" % hs)
		if (hall["p"] as Vector3).distance_to(Vector3(hall_slot.x,
				(hall["p"] as Vector3).y, hall_slot.y)) > 0.05:
			bad.append("City Hall block not at its slot center")
		var ms: Vector3 = municipal["s"]
		if absf(ms.x - 26.7) > 0.05 or absf(ms.y - 11.0) > 0.05 \
				or absf(ms.z - 25.3) > 0.05:
			bad.append("Municipal block %s != the slot envelope 26.7x11x25.3" % ms)
		if (municipal["p"] as Vector3).distance_to(Vector3(municipal_slot.x,
				(municipal["p"] as Vector3).y, municipal_slot.y)) > 0.05:
			bad.append("Municipal block not at its slot center")
	var cornice_stone := 0
	var cartouche := 0
	var hall_east := 0
	var mun_west := 0
	for part3: Dictionary in civic_record:
		var p3: Vector3 = part3["p"]
		var s3: Vector3 = part3["s"]
		if str(part3["band"]) == "cornice_stone" and s3.y > 0.5:
			cornice_stone += 1
		if str(part3["band"]) == "cartouche_stone":
			cartouche += 1
			if hall != {} and p3.x > (hall["p"] as Vector3).x + 30.0:
				hall_east += 1
			if municipal != {} and p3.x < (municipal["p"] as Vector3).x - 8.0:
				mun_west += 1
	if cornice_stone < 2:
		bad.append("the civic cornice bands are missing (%d)" % cornice_stone)
	if cartouche < 4 or hall_east < 1 or mun_west < 1:
		bad.append("the cartouche entries are thin (total=%d hall-east=%d mun-west=%d)"
				% [cartouche, hall_east, mun_west])

	## --- the palette (§1.7's rows, verbatim scenario literals) -------------------
	var hexes: Dictionary = {
		"arch": Color("4a5a57"),
		"shell_mint": Color("dce8dc"),
		"shell_cream": Color("ede9d8"),
		"pier_brick": Color("9c4a34"),
		"stage_floor": Color("ede9d8"),
		"backstage": Color("9c4a34"),
		"civic_brick": Color("a8663f"),
		"civic_brick_dark": Color("8a4a36"),
		"cornice_stone": Color("d6cdbb"),
		"cartouche_stone": Color("d6cdbb"),
		"cornice": Color("d6cdbb"),
		"lamp": Color("5c2e35"),
		"lamp_arm": Color("5c2e35"),
		"lamp_shade": Color("5c2e35"),
		"banner_arm": Color("5c2e35"),
		"banner": Color("2e4e9e"),
	}
	var bands_seen := {}
	for record: Array in [shell_record, civic_record, fabric_record]:
		for part4: Dictionary in record:
			var band4 := str(part4["band"])
			bands_seen[band4] = true
			var got: Color = part4["color"]
			if band4 == "grille" or band4 == "civic_door" or band4 == "blade":
				if _luminance(got) > 0.25:
					bad.append("%s luminance %.3f > 0.25 — must read dark" % [band4, _luminance(got)])
				continue
			if band4 == "blade_neon":
				if _color_gap(got, Color(0.91, 0.32, 0.14)) > 0.02:
					bad.append("blade neon %s != the scenario's pinned tube read" % got)
				continue
			if not hexes.has(band4):
				bad.append("band %s wears no pinned §1.7 hex" % band4)
				continue
			var want: Color = hexes[band4]
			if _color_gap(got, want) > 0.02:
				bad.append("band %s color %s != the pinned hex %s" % [band4, got, want])
	for need: String in ["arch", "shell_mint", "shell_cream", "pier_brick",
			"stage_floor", "backstage", "grille", "civic_brick", "civic_brick_dark",
			"cornice_stone", "cartouche_stone", "civic_door", "cornice",
			"lamp", "lamp_arm", "lamp_shade", "banner_arm", "banner",
			"blade", "blade_neon"]:
		if not bands_seen.has(need):
			bad.append("band %s never used — the family is missing" % need)

	## --- D. the fabric, recounted ------------------------------------------------
	## The cornice recount: the row-band literals re-derived over the chunk
	## files, the hero ids skipped the same way the build skips them.
	var cornice_recount := 0
	for entry2: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc2: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry2["file"]))
		for m2: Dictionary in doc2.get("massing", []):
			if not bool(m2.get("a", false)) or hero_ids.has(str(m2.get("id", ""))):
				continue
			if str(m2.get("d", "")) != "downtown":
				continue
			var x2 := float(m2["p"][0])
			var z2 := float(m2["p"][2])
			if x2 < 2752.0 or x2 > 3292.0:
				continue
			if (z2 >= -286.0 and z2 <= -236.0) or (z2 >= -372.0 and z2 <= -322.0):
				cornice_recount += 1
	var cornices := 0
	for part5: Dictionary in fabric_record:
		if str(part5["band"]) == "cornice":
			cornices += 1
			var cp: Vector3 = part5["p"]
			if cp.x < 2752.0 or cp.x > 3292.0 \
					or not ((cp.z >= -286.0 and cp.z <= -236.0)
					or (cp.z >= -372.0 and cp.z <= -322.0)):
				bad.append("cornice at %s outside the frontage row bands" % cp)
				break
	if cornices != cornice_recount:
		bad.append("cornices %d != the row-band recount %d" % [cornices, cornice_recount])
	if cornices < 40:
		bad.append("cornices %d < 40 — the pinned-row read is missing" % cornices)
	## The lamp recount: the pack's own Main points, the same pitch literals.
	var main_pts: Array[Vector2] = []
	for street: Dictionary in AmesDataPack.streets():
		if str(street.get("name", "")) != "Main Street":
			continue
		for q: Variant in street.get("points", []):
			var v := Vector2(float((q as Array)[0]), float((q as Array)[1]))
			if v.x >= 2752.0 and v.x <= 3292.0:
				main_pts.append(v)
	main_pts.sort_custom(func(a: Vector2, b: Vector2) -> bool: return a.x < b.x)
	var walk: Array[Vector2] = []
	for p6: Vector2 in main_pts:
		if walk.is_empty() or walk.back().distance_to(p6) > 0.5:
			walk.append(p6)
	var main_z := 0.0
	for p7: Vector2 in walk:
		main_z += p7.y
	main_z /= float(walk.size())
	var cross_xs: Array[float] = []
	for street2: Dictionary in AmesDataPack.streets():
		if str(street2.get("name", "")) == "Main Street":
			continue
		for q2: Variant in street2.get("points", []):
			var v2 := Vector2(float((q2 as Array)[0]), float((q2 as Array)[1]))
			if v2.x >= 2747.0 and v2.x <= 3297.0 and absf(v2.y - main_z) < 25.0:
				cross_xs.append(v2.x)
	var run_len := 0.0
	for i2 in walk.size() - 1:
		run_len += walk[i2].distance_to(walk[i2 + 1])
	var lamp_recount := 0
	var s_pos := 24.0
	while s_pos <= run_len - 24.0:
		var acc := 0.0
		var at: Vector2 = walk.back()
		for i3 in walk.size() - 1:
			var seg := walk[i3].distance_to(walk[i3 + 1])
			if acc + seg >= s_pos:
				at = walk[i3].lerp(walk[i3 + 1], (s_pos - acc) / maxf(seg, 0.001))
				break
			acc += seg
		var skip := false
		for cx2: float in cross_xs:
			if absf(at.x - cx2) < 16.0:
				skip = true
				break
		if not skip:
			lamp_recount += 1
		s_pos += 32.0
	var lamps := 0
	var banners := 0
	var brackets := 0
	for part6: Dictionary in fabric_record:
		match str(part6["band"]):
			"lamp":
				lamps += 1
			"banner":
				banners += 1
				var bp: Vector3 = part6["p"]
				if absf(bp.y - 3.4) > 0.05:
					bad.append("banner at %s not at the bracket band" % bp)
					break
			"banner_arm":
				brackets += 1
	if lamps != lamp_recount:
		bad.append("lamps %d != the polyline recount %d" % [lamps, lamp_recount])
	if lamps < 8:
		bad.append("lamps %d < 8 — the Main furniture run is missing" % lamps)
	if banners != lamps or brackets != lamps * 2:
		bad.append("banner furniture mismatch (banners %d, brackets %d, lamps %d)" % [
				banners, brackets, lamps])
	## The blade recount: the bar-token walk over the pack names.
	var blade_recount := 0
	for b3: Dictionary in AmesDataPack.buildings():
		var nm := str(b3.get("name", "")).to_lower()
		var hit := false
		for tok: String in ["whiskey river", "mary jane"]:
			if nm.contains(tok):
				hit = true
				break
		if not hit:
			continue
		var bc: Array = b3["centroid"]
		var bx3 := float(bc[0])
		var bz3 := float(bc[1])
		if bx3 < 2752.0 or bx3 > 3292.0 or bz3 < -300.0 or bz3 > -220.0:
			continue
		var mz3 := INF
		var best_d := INF
		for p8: Vector2 in walk:
			var d := absf(p8.x - bx3)
			if d < best_d:
				best_d = d
				mz3 = p8.y
		if mz3 == INF:
			continue
		blade_recount += 1
	var blades := 0
	var neons := 0
	var blade_at := Vector3.ZERO
	for part7: Dictionary in fabric_record:
		if str(part7["band"]) == "blade":
			blades += 1
			blade_at = part7["p"]
		elif str(part7["band"]) == "blade_neon":
			neons += 1
	if blades != blade_recount or neons != blades * 2:
		bad.append("blades %d != the token recount %d (neons %d)" % [
				blades, blade_recount, neons])
	if blades < 1:
		bad.append("no blade sign seeded — the bar-sign typology is missing")
	## The families, live.
	var fabric_root := world.get_node_or_null("DowntownFabric") as Node3D
	if fabric_root == null:
		bad.append("no DowntownFabric root")
	else:
		for family: Array in [["Cornices", cornices], ["LampPoles", lamps],
				["LampShades", lamps], ["Banners", banners],
				["BannerBrackets", brackets], ["BladeBoards", blades],
				["BladeNeons", neons]]:
			var node := fabric_root.get_node_or_null(str(family[0])) as MultiMeshInstance3D
			if node == null:
				bad.append("fabric family %s not mounted" % family[0])
			elif node.multimesh.instance_count != int(family[1]):
				bad.append("fabric family %s MM %d != retained %d" % [
						family[0], node.multimesh.instance_count, int(family[1])])
		if fabric_root.get_node_or_null("Furniture") == null:
			bad.append("the furniture collision body is missing")

	## --- E. the seams, live -------------------------------------------------------
	var space := get_world_3d().direct_space_state
	var probe := func(from: Vector3, to: Vector3) -> Dictionary:
		var ray := PhysicsRayQueryParameters3D.create(world.to_global(from),
				world.to_global(to))
		ray.collision_mask = 1
		return space.intersect_ray(ray)
	## City Hall's east (Clark) face at the entry band.
	var hall_hit: Dictionary = probe.call(
			Vector3(hall_slot.x + 60.0, 3.0, hall_slot.y),
			Vector3(hall_slot.x, 3.0, hall_slot.y))
	if hall_hit.is_empty():
		bad.append("City Hall east-face ray missed")
	else:
		var hall_x: float = world.to_local((hall_hit as Dictionary)["position"]).x
		if absf(hall_x - (hall_slot.x + 41.15)) > 0.3:
			bad.append("City Hall east face x %.2f != the slot face %.2f (+-0.3)" % [
					hall_x, hall_slot.x + 41.15])
	## The Municipal Building's west (Kellogg) face.
	var mun_hit: Dictionary = probe.call(
			Vector3(municipal_slot.x - 40.0, 3.0, municipal_slot.y),
			Vector3(municipal_slot.x, 3.0, municipal_slot.y))
	if mun_hit.is_empty():
		bad.append("Municipal west-face ray missed")
	else:
		var mun_x: float = world.to_local((mun_hit as Dictionary)["position"]).x
		if absf(mun_x - (municipal_slot.x - 13.35)) > 0.3:
			bad.append("Municipal west face x %.2f != the slot face %.2f (+-0.3)" % [
					mun_x, municipal_slot.x - 13.35])
	## The bandshell stage's south face (the lawn approach; x offset +9 keeps
	## the ray inside the deck's 25.4 span but clear of the annex's 11.3) +
	## the crown above.
	var stage_hit: Dictionary = probe.call(
			Vector3(BS_CENTER.x + 9.0, 0.6, BS_CENTER.y + 20.0),
			Vector3(BS_CENTER.x + 9.0, 0.6, BS_CENTER.y))
	if stage_hit.is_empty():
		bad.append("bandshell stage ray missed")
	else:
		var stage_z: float = world.to_local((stage_hit as Dictionary)["position"]).z
		if absf(stage_z - (BS_CENTER.y + 2.3)) > 0.3:
			bad.append("stage south face z %.2f != the deck edge %.2f (+-0.3)" % [
					stage_z, BS_CENTER.y + 2.3])
	var crown_hit: Dictionary = probe.call(
			Vector3(BS_CENTER.x, 20.0, BS_CENTER.y - 5.2),
			Vector3(BS_CENTER.x, 5.0, BS_CENTER.y - 5.2))
	if crown_hit.is_empty():
		bad.append("arch crown ray missed")
	else:
		var crown_y: float = world.to_local((crown_hit as Dictionary)["position"]).y
		if absf(crown_y - 11.6) > 0.2:
			bad.append("arch crown y %.2f != the apex 11.6 (+-0.2)" % crown_y)
	## The ground record (the walkability query).
	var queries := [
		[Vector3(BS_CENTER.x, 0.0, BS_CENTER.y - 2.3), 1.2, "bandshell stage"],
		[Vector3(BS_CENTER.x - 10.6, 0.0, BS_CENTER.y - 5.2), 7.2, "bandshell pier"],
		[Vector3(BS_CENTER.x, 0.0, BS_CENTER.y - 5.2), -1.0, "arch crown"],
		[Vector3(BS_CENTER.x, 0.0, BS_CENTER.y + 5.0), 3.0, "bandshell annex"],
		[Vector3(hall_slot.x, 0.0, hall_slot.y), 14.0, "City Hall roof"],
		[Vector3(municipal_slot.x, 0.0, municipal_slot.y), 11.0, "Municipal roof"],
		[Vector3(blade_at.x, 0.0, blade_at.z), 7.4, "blade top"],
	]
	for gq: Array in queries:
		var got_h := world.ground_height(world.to_global(gq[0] as Vector3))
		if gq[2] == "arch crown":
			## The crown's walk answer IS the filed AABB top — the same
			## corners the record's arch band unions (the rotated-chord
			## filing law), read off the record, never hard-coded.
			if absf(got_h - arch_hi.y) > 0.05:
				bad.append("ground record at the arch crown answers %.3f != the filed AABB top %.3f"
						% [got_h, arch_hi.y])
			continue
		if absf(got_h - float(gq[1])) > 0.05:
			bad.append("ground record at %s answers %.3f != the %s %.1f" % [
					gq[2], got_h, gq[2], float(gq[1])])
	## The roof crumbs: the bandshell's at the arch crown (the game-native
	## perch this swap files), the civic pair's at their roof centers.
	var lift: float = AmesWorld.SPOT_LIFT
	for crumb: Array in [[Vector3(BS_CENTER.x, 11.6 + lift, BS_CENTER.y - 5.2), "arch crown"],
			[Vector3(hall_slot.x, hall_top + lift, hall_slot.y), "City Hall roof"],
			[Vector3(municipal_slot.x, municipal_top + lift, municipal_slot.y), "Municipal roof"]]:
		var crumb_ok := false
		for i4: int in world.bread_spots.size():
			if world.bread_spots[i4].distance_to(crumb[0]) < 0.005 \
					and i4 < world.bread_spot_kinds.size() \
					and world.bread_spot_kinds[i4] == City.BreadKind.ROOF:
				crumb_ok = true
				break
		if not crumb_ok:
			bad.append("no roof crumb at the %s %s" % [crumb[1], crumb[0]])
	_check(S, bad.is_empty(),
			"shell=%d civic=%d fabric=%d bs=%.1fx%.1f cornices=%d lamps=%d blades=%d; %s"
			% [shell_record.size(), civic_record.size(), fabric_record.size(),
			bs_hi.x - bs_lo.x if bs_hi.x > -INF else -1.0,
			bs_hi.z - bs_lo.z if bs_hi.z > -INF else -1.0,
			cornices, lamps, blades, "; ".join(bad)])
	world.queue_free()


## --- scenario (T-193 the civic water tanks) ----------------------------------


## (T-193) The city's bulb-on-stem pair re-pins its slots onto the HEROES —
## the T-190 swap law carried to the town's sky-level signature (LANDMARKS
## T8: the BRET stand-in anchoring north Ames + one of the "two others" on
## the east side) — every expectation re-derived from the COMMITTED bake
## slots (walked in-scenario from the chunk files) + the `images/misc/02`
## photo read as verbatim scenario literals:
## A. THE SWAP — `city_water_tank_north` supersedes its slot's three
##    placeholder parts (stem/bulb/cap — chunk (10,−5)'s gray tank stack)
##    and `city_water_tank_east` its three (chunk (13,2)); each affected
##    chunk's gray placeholder family shrinks to exactly its non-superseded
##    remainder and the heroes mount through their own roots with their
##    diamond boxes as the only MM members;
## B. THE DIMS (photo 02 on the slot stack's own spans) — each tank's union
##    tops at the slot total 30.0 and bases on the plate, the stem at the
##    photo's ≈3× ratio (Ø6.6 on 0..16), the mushroom shoulder flaring
##    Ø6.6→Ø20 over 16..17.2, the white drum Ø20 spanning 17.2..28.0 (the
##    slot bulb's own box, round), the four banding stripes 0.6 m tall at
##    17.5/18.1/27.1/27.7 — blue inner at the skirt seam, green above,
##    mirrored at the roof edge — the roof dome closing at 30.0 with the
##    dark railing band on its perimeter, and the DIAMOND a Ø10 on-point
##    square proud of the town-facing wall (the north tank's logo looks
##    south, the east tank's west — the record files the box's world AABB
##    10.0 × 10.0 × 0.07 on the face normal, the T-192 rotated-chord law);
## C. THE PALETTE (no survey hex: photo 01 is a blue duotone print — every
##    pixel near hue 215° — and photo 02 is dusk-cast, so this scenario
##    pins its own literals and holds the hue/luminance laws that make them
##    green/blue) — the diamond + green stripes read green (hue 90..170°,
##    saturated), the blue stripes read blue (hue 200..250°), the white
##    field reads white (luminance ≥ 0.85, near-neutral), the stem wears the
##    concrete-gray literal, the railing stays dark (luminance ≤ 0.45 — the
##    T-190 dark-law precedent);
## D. THE MESHES, LIVE — the stem/shoulder/drum/dome albedos off the live
##    nodes at their literals, the four stripes' exact values, the railing
##    dark;
## E. THE SEAMS, LIVE — layer-1 rays answer the drum wall at Ø20 on the east
##    axis, the town-facing wall behind the VISUAL-ONLY diamond (the
##    medallion convention — the proud face itself is proven by its record
##    entry + the single-diamond Boxes MM, not by a ray: the 10-gon's chord
##    face at the apothem 9.5106 from the south, the vertex at 10.0 from the
##    west), the stem at Ø6.6, and the dome slope over the frustum read;
##    `ground_height` answers the PLATE at both tank centers (the
##    not-landable law — the retired slot's 16/28/30 walk answers stay
##    retired, the dome files no walkable top); and the render budget's
##    bake-derived expectation re-derived in-row (−6 more placeholder parts
##    — the T-186 law).
func _scenario_civic_tanks_dims() -> void:
	const S := "civic_tanks_dims"
	var bad: PackedStringArray = PackedStringArray()
	const NORTH_ID := "city_water_tank_north"
	const EAST_ID := "city_water_tank_east"
	## --- the bake slots, walked independently --------------------------------
	var centers := {NORTH_ID: Vector2.ZERO, EAST_ID: Vector2.ZERO}
	var slot_parts := {NORTH_ID: 0, EAST_ID: 0}
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		for ph: Dictionary in doc.get("placeholders", []):
			var pid := str(ph.get("id", ""))
			if not centers.has(pid):
				continue
			slot_parts[pid] = int(slot_parts[pid]) + 1
			if str(ph.get("part", "")) == "bulb":
				centers[pid] = Vector2(float(ph["p"][0]), float(ph["p"][2]))
	if (centers[NORTH_ID] as Vector2) == Vector2.ZERO \
			or (centers[EAST_ID] as Vector2) == Vector2.ZERO:
		_check(S, false, "bake slot walk failed: a tank bulb part is missing")
		return
	for pid: String in [NORTH_ID, EAST_ID]:
		if int(slot_parts[pid]) != 3:
			bad.append("%s slot walk %d != the stack's three parts (stem/bulb/cap)"
					% [pid, int(slot_parts[pid])])
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var parts := world.civic_tank_hero_parts
	if parts.is_empty():
		_check(S, false, "no retained civic tank parts — the heroes never built")
		world.queue_free()
		return
	if parts.size() != 50:
		bad.append("record %d != the 2 × 25 schedule (1 diamond box + 8 round families "
				+ "+ 16 railing posts each)" % parts.size())

	## --- A+B+C. per-tank: the swap, the dims, the palette ---------------------
	var north_diamond := {}
	var east_diamond := {}
	for tank_id: String in [NORTH_ID, EAST_ID]:
		var key := "civic_tank_north" if tank_id == NORTH_ID else "civic_tank_east"
		var c: Vector2 = centers[tank_id]
		var lo := Vector3(INF, INF, INF)
		var hi := Vector3(-INF, -INF, -INF)
		var stem := {}
		var skirt := {}
		var drum := {}
		var dome := {}
		var diamond := {}
		var band_counts := {}
		for part: Dictionary in parts:
			if str(part["hero"]) != key:
				continue
			var p: Vector3 = part["p"]
			var s: Vector3 = part["s"]
			lo = lo.min(p - s * 0.5)
			hi = hi.max(p + s * 0.5)
			var band := str(part["band"])
			band_counts[band] = int(band_counts.get(band, 0)) + 1
			match band:
				"stem":
					stem = part
				"skirt":
					skirt = part
				"drum":
					drum = part
				"dome":
					dome = part
				"diamond":
					diamond = part
		if stem.is_empty() or skirt.is_empty() or drum.is_empty() or dome.is_empty() \
				or diamond.is_empty():
			bad.append("%s record misses a family (stem=%s skirt=%s drum=%s dome=%s diamond=%s)"
					% [key, stem.is_empty(), skirt.is_empty(), drum.is_empty(),
					dome.is_empty(), diamond.is_empty()])
			continue
		if tank_id == NORTH_ID:
			north_diamond = diamond
		else:
			east_diamond = diamond
		## The dims: the slot stack's own spans, the photo-02 shapes.
		if absf(hi.y - 30.0) > 0.05:
			bad.append("%s top %.3f != the slot total 30.0" % [key, hi.y])
		if lo.y < -0.05:
			bad.append("%s base %.3f sinks past the plate" % [key, lo.y])
		var ss: Vector3 = stem["s"]
		if absf(ss.x - 6.6) > 0.05 or absf(ss.y - 16.0) > 0.05:
			bad.append("%s stem %.1fx%.1f != the photo-02 ratio Ø6.6 on 0..16"
					% [key, ss.x, ss.y])
		var sk: Dictionary = skirt
		var skirt_top: float = (sk["p"] as Vector3).y + (sk["s"] as Vector3).y * 0.5
		if absf(skirt_top - 17.2) > 0.05:
			bad.append("%s shoulder top %.3f != the flare's close 17.2" % [key, skirt_top])
		var ds: Vector3 = drum["s"]
		var dp: Vector3 = drum["p"]
		if absf(ds.x - 20.0) > 0.05 or absf(ds.z - 20.0) > 0.05 \
				or absf(ds.y - 10.8) > 0.05:
			bad.append("%s drum %.1fx%.1fx%.1f != the slot bulb's Ø20 on 17.2..28.0"
					% [key, ds.x, ds.y, ds.z])
		elif absf((dp.y - ds.y * 0.5) - 17.2) > 0.05:
			bad.append("%s drum bottom %.3f != the shoulder seam 17.2"
					% [key, dp.y - ds.y * 0.5])
		var dome_top: float = (dome["p"] as Vector3).y + (dome["s"] as Vector3).y * 0.5
		if absf(dome_top - 30.0) > 0.05:
			bad.append("%s dome top %.3f != the slot cap top 30.0" % [key, dome_top])
		## The banding: four stripes at the pinned centers, blue inner at the
		## skirt seam / green above / mirrored at the roof edge.
		var want_stripes := {
			"band_blue": [17.5, 27.7],
			"band_green": [18.1, 27.1],
		}
		for band: String in ["band_blue", "band_green"]:
			var ys: Array[float] = []
			for part2: Dictionary in parts:
				if str(part2["hero"]) == key and str(part2["band"]) == band:
					ys.append((part2["p"] as Vector3).y)
					var s2: Vector3 = part2["s"]
					if absf(s2.y - 0.6) > 0.01 or absf(s2.x - 20.18) > 0.01:
						bad.append("%s %s stripe %.2fx%.2f != the 0.6 m band on Ø20.18"
								% [key, band, s2.x, s2.y])
			ys.sort()
			var want: Array = want_stripes[band]
			if ys.size() != 2 or absf(ys[0] - float(want[0])) > 0.05 \
					or absf(ys[1] - float(want[1])) > 0.05:
				bad.append("%s %s stripes %s != the pinned pair %s" % [
						key, band, ys, want])
		## The railing: sixteen dark posts on the dome's rim (the round-1 shot
		## review law — POSTS, never a solid ring: its top disc paints a fat
		## dark roof from the air).
		var rail_count := int(band_counts.get("railing", 0))
		if rail_count != 16:
			bad.append("%s railing posts %d != 16" % [key, rail_count])
		else:
			var posts_on_rim := 0
			for part3: Dictionary in parts:
				if str(part3["hero"]) != key or str(part3["band"]) != "railing":
					continue
				var wl: float = (part3["color"] as Color).r * 0.299 \
						+ (part3["color"] as Color).g * 0.587 \
						+ (part3["color"] as Color).b * 0.114
				if wl > 0.45:
					bad.append("%s railing post luminance %.3f > 0.45 — must read dark"
							% [key, wl])
				var pp: Vector3 = part3["p"]
				var ps: Vector3 = part3["s"]
				if absf(Vector2(pp.x - c.x, pp.z - c.y).length() - 9.5) < 0.05 \
						and absf(pp.y - 28.7) < 0.05 \
						and absf(ps.x - 0.18) < 0.005 and absf(ps.y - 0.8) < 0.005 \
						and absf(ps.z - 0.18) < 0.005:
					posts_on_rim += 1
			if posts_on_rim != 16:
				bad.append("%s railing posts on the dome rim %d != 16" % [key, posts_on_rim])
		## C. the palette: every band at its scenario literal ±0.02, the hue
		## laws holding the green/blue read.
		var literals := {
			"stem": Color(0.655, 0.647, 0.635),
			"skirt": Color(0.847, 0.843, 0.816),
			"drum": Color(0.937, 0.933, 0.91),
			"dome": Color(0.937, 0.933, 0.91),
			"band_green": Color(0.118, 0.376, 0.263),
			"band_blue": Color(0.157, 0.271, 0.447),
			"diamond": Color(0.075, 0.302, 0.231),
		}
		var seen_bands := {}
		for part4: Dictionary in parts:
			if str(part4["hero"]) != key:
				continue
			var band4 := str(part4["band"])
			seen_bands[band4] = true
			var got: Color = part4["color"]
			if literals.has(band4):
				if _color_gap(got, literals[band4]) > 0.02:
					bad.append("%s band %s color %s != the pinned literal %s"
							% [key, band4, got, literals[band4]])
			if band4 == "diamond" or band4 == "band_green":
				var hue := _hue_deg(got)
				var sat := (maxf(got.r, maxf(got.g, got.b))
						- minf(got.r, minf(got.g, got.b))) \
						/ maxf(maxf(got.r, maxf(got.g, got.b)), 1e-6)
				if hue < 90.0 or hue > 170.0:
					bad.append("%s %s hue %.0f outside the green law 90..170" % [key, band4, hue])
				if sat < 0.25:
					bad.append("%s %s saturation %.2f < 0.25 — must read colored" % [key, band4, sat])
			elif band4 == "band_blue":
				var hue2 := _hue_deg(got)
				if hue2 < 200.0 or hue2 > 250.0:
					bad.append("%s band_blue hue %.0f outside the blue law 200..250" % [key, hue2])
			elif band4 == "drum" or band4 == "dome":
				var wl2: float = got.r * 0.299 + got.g * 0.587 + got.b * 0.114
				if wl2 < 0.85:
					bad.append("%s %s luminance %.3f < 0.85 — the field must read white" % [key, band4, wl2])
				var sat2: float = (maxf(got.r, maxf(got.g, got.b))
						- minf(got.r, minf(got.g, got.b))) / maxf(maxf(got.r, maxf(got.g, got.b)), 1e-6)
				if sat2 > 0.12:
					bad.append("%s %s saturation %.2f > 0.12 — too tinted for the white read" % [key, band4, sat2])
		for want_band: String in ["stem", "skirt", "drum", "dome", "band_green",
				"band_blue", "railing", "diamond"]:
			if not seen_bands.has(want_band):
				bad.append("%s band %s never used — the family is missing" % [key, want_band])
		## B. the diamond: the Ø10 on-point square on the town-facing wall.
		var dpos: Vector3 = diamond["p"]
		var dsize: Vector3 = diamond["s"]
		if tank_id == NORTH_ID:
			if absf(dsize.x - 10.0) > 0.05 or absf(dsize.y - 10.0) > 0.05 \
					or absf(dsize.z - 0.07) > 0.01:
				bad.append("north diamond AABB %s != the 10.0 × 10.0 × 0.07 on-point read" % dsize)
			if absf(dpos.x - c.x) > 0.05 or absf(dpos.z - (c.y + 10.12)) > 0.05 \
					or absf(dpos.y - 22.6) > 0.05:
				bad.append("north diamond %s != the SOUTH town-facing wall (z %+.2f, mid-drum)"
						% [dpos, c.y + 10.12])
		else:
			if absf(dsize.z - 10.0) > 0.05 or absf(dsize.y - 10.0) > 0.05 \
					or absf(dsize.x - 0.07) > 0.01:
				bad.append("east diamond AABB %s != the 10.0 × 10.0 × 0.07 on-point read" % dsize)
			if absf(dpos.z - c.y) > 0.05 or absf(dpos.x - (c.x - 10.12)) > 0.05 \
					or absf(dpos.y - 22.6) > 0.05:
				bad.append("east diamond %s != the WEST town-facing wall (x −10.12, mid-drum)"
						% dpos)

	## --- D. the meshes, live ---------------------------------------------------
	for rig: Dictionary in [
		{"chunk": "Chunk_10_-5", "root": "HeroCivicTankNorth", "id": NORTH_ID},
		{"chunk": "Chunk_13_2", "root": "HeroCivicTankEast", "id": EAST_ID},
	]:
		var chunk_node := world.get_node_or_null("Chunks/%s" % str(rig["chunk"])) as Node3D
		if chunk_node == null:
			bad.append("chunk %s missing" % rig["chunk"])
			continue
		## The gray family shrank to exactly its non-superseded remainder
		## (the chunk file walked by its tile — the chunk node sits at the
		## tile center, the file grid's own key).
		var ph_mm := chunk_node.get_node_or_null("Placeholders") as MultiMeshInstance3D
		var want_remainder := 0
		for entry3: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
			var tile := Vector2i(int(entry3["cx"]), int(entry3["cz"]))
			var tile_center := Vector3(tile.x * 256.0 + 128.0, 0.0, tile.y * 256.0 + 128.0)
			if (chunk_node as Node3D).position.distance_to(tile_center) > 0.5:
				continue
			var doc3: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry3["file"]))
			for ph: Dictionary in doc3.get("placeholders", []):
				if not _is_superseded_t193(str(ph.get("id", ""))):
					want_remainder += 1
		if ph_mm == null:
			if want_remainder > 0:
				bad.append("%s lost its placeholder family (%d non-superseded remain)"
						% [rig["chunk"], want_remainder])
		elif ph_mm.multimesh.instance_count != want_remainder:
			bad.append("%s placeholder MM %d != the non-superseded remainder %d" % [
					rig["chunk"], ph_mm.multimesh.instance_count, want_remainder])
		var hero_root := chunk_node.get_node_or_null(str(rig["root"])) as Node3D
		if hero_root == null:
			bad.append("no %s under %s" % [rig["root"], rig["chunk"]])
			continue
		var boxes_mm := hero_root.get_node_or_null("Boxes") as MultiMeshInstance3D
		if boxes_mm == null or boxes_mm.multimesh.instance_count != 17:
			bad.append("%s Boxes MM %s != the diamond + 16 posts" % [rig["root"],
					boxes_mm.multimesh.instance_count if boxes_mm != null else -1])
		var want_albedo := {
			"Stem": Color(0.655, 0.647, 0.635),
			"SkirtCone": Color(0.847, 0.843, 0.816),
			"BulbDrum": Color(0.937, 0.933, 0.91),
			"RoofDome": Color(0.937, 0.933, 0.91),
			"BandBlueBottom": Color(0.157, 0.271, 0.447),
			"BandGreenBottom": Color(0.118, 0.376, 0.263),
			"BandGreenTop": Color(0.118, 0.376, 0.263),
			"BandBlueTop": Color(0.157, 0.271, 0.447),
		}
		for mesh_name: String in want_albedo:
			var mesh_node := hero_root.get_node_or_null(mesh_name) as MeshInstance3D
			if mesh_node == null or not (mesh_node.mesh is CylinderMesh):
				bad.append("%s named mesh %s missing" % [rig["root"], mesh_name])
				continue
			var mat := (mesh_node.mesh as CylinderMesh).material as StandardMaterial3D
			if mat == null or _color_gap(mat.albedo_color, want_albedo[mesh_name]) > 0.02:
				bad.append("%s %s albedo %s != the pinned literal" % [
						mesh_node.name if mesh_node != null else mesh_name,
						mesh_name, mat.albedo_color if mat != null else "<null>"])
		var rail_node := hero_root.get_node_or_null("RailingRing") as MeshInstance3D
		if rail_node != null:
			bad.append("%s still carries a solid RailingRing — the posts law removed it"
					% rig["root"])

	## --- E. the seams, live ------------------------------------------------------
	var space := get_world_3d().direct_space_state
	var probe := func(from: Vector3, to: Vector3) -> Dictionary:
		var ray := PhysicsRayQueryParameters3D.create(world.to_global(from),
				world.to_global(to))
		ray.collision_mask = 1
		return space.intersect_ray(ray)
	for seam: Dictionary in [
		{"id": NORTH_ID, "key": "civic_tank_north"},
		{"id": EAST_ID, "key": "civic_tank_east"},
	]:
		var c2: Vector2 = centers[str(seam["id"])]
		## The drum wall at Ø20 on the east axis (the 10-gon's vertex plane).
		var drum_ray: Dictionary = probe.call(
				Vector3(c2.x + 30.0, 22.6, c2.y), Vector3(c2.x, 22.6, c2.y))
		if drum_ray.is_empty():
			bad.append("%s drum ray missed" % seam["key"])
		else:
			var dx: float = world.to_local((drum_ray as Dictionary)["position"]).x
			if absf(dx - (c2.x + 10.0)) > 0.15:
				bad.append("%s drum wall x %.2f != Ø20 (±0.15)" % [seam["key"], dx])
		## The town-facing wall behind the visual-only diamond (the medallion
		## convention — the diamond's proud geometry is proven by its record
		## entry + the single-diamond Boxes MM, not by a ray): from the south
		## the 10-gon's chord face answers the apothem 9.5106, from the west
		## the vertex answers the full 10.0.
		if str(seam["id"]) == NORTH_ID:
			var face_ray: Dictionary = probe.call(
					Vector3(c2.x, 22.6, c2.y + 30.0), Vector3(c2.x, 22.6, c2.y))
			if face_ray.is_empty():
				bad.append("north town-facing wall ray missed")
			else:
				var fz: float = world.to_local((face_ray as Dictionary)["position"]).z
				if absf(fz - (c2.y + 9.5106)) > 0.1:
					bad.append("north town-facing wall z %.2f != the 10-gon apothem %.2f (±0.1)"
							% [fz, c2.y + 9.5106])
		else:
			var face_ray2: Dictionary = probe.call(
					Vector3(c2.x - 30.0, 22.6, c2.y), Vector3(c2.x, 22.6, c2.y))
			if face_ray2.is_empty():
				bad.append("east town-facing wall ray missed")
			else:
				var fx: float = world.to_local((face_ray2 as Dictionary)["position"]).x
				if absf(fx - (c2.x - 10.0)) > 0.1:
					bad.append("east town-facing wall x %.2f != Ø20 (±0.1)" % fx)
		## The stem at Ø6.6.
		var stem_ray: Dictionary = probe.call(
				Vector3(c2.x + 20.0, 8.0, c2.y), Vector3(c2.x, 8.0, c2.y))
		if stem_ray.is_empty():
			bad.append("%s stem ray missed" % seam["key"])
		else:
			var sx: float = world.to_local((stem_ray as Dictionary)["position"]).x
			if absf(sx - (c2.x + 3.3)) > 0.15:
				bad.append("%s stem face x %.2f != Ø6.6 (±0.15)" % [seam["key"], sx])
		## The dome slope over the frustum read (down at r 9.0: the taper
		## 9.3→1.6 over 28..30 lands the surface at y 28.078).
		var dome_ray: Dictionary = probe.call(
				Vector3(c2.x + 9.0, 40.0, c2.y), Vector3(c2.x + 9.0, 20.0, c2.y))
		if dome_ray.is_empty():
			bad.append("%s dome ray missed" % seam["key"])
		else:
			var dy: float = world.to_local((dome_ray as Dictionary)["position"]).y
			if absf(dy - 28.078) > 0.1:
				bad.append("%s dome slope y %.2f != the frustum read 28.078 (±0.1)"
						% [seam["key"], dy])
		## The not-landable law: the plate answers at the tank centers —
		## the retired slot's 16/28/30 walk answers stay retired, the dome
		## files no walkable top.
		var gh := world.ground_height(world.to_global(Vector3(c2.x, 0.0, c2.y)))
		if absf(gh) > 0.05:
			bad.append("%s ground record answers %.3f at the center — the crown must file nothing"
					% [seam["key"], gh])
	_check(S, bad.is_empty(),
		"parts=%d north=%.0f,%.0f east=%.0f,%.0f; %s"
		% [parts.size(), (centers[NORTH_ID] as Vector2).x, (centers[NORTH_ID] as Vector2).y,
		(centers[EAST_ID] as Vector2).x, (centers[EAST_ID] as Vector2).y,
		"; ".join(bad)])
	world.queue_free()


## (T-193) The scenario-local supersede mirror — the ids the tanks' heroes
## retire, walked against the runtime placeholder MMs (the world's own
## `_row_superseded_placeholder` covers the other heroes too; the remainder
## arm here counts only the tank slots so the chunk file walk stays local).
func _is_superseded_t193(id: String) -> bool:
	return id == "city_water_tank_north" or id == "city_water_tank_east"


## --- scenario (T-194 the rail corridor) --------------------------------------

## The town's motion landmark (LANDMARKS §5 item 12) on the resident Ames
## world, every expectation re-derived from the COMMITTED DATA (the pack's
## rail crossings + centerlines + streets, the bake's chunk files — never
## through the world's own constants). Arms:
## A. THE DATA LAYER — the pack's 9 at-grade crossings (the downtown four
##    named), the depot slot's three placeholder parts in the bake (chunk
##    (10,−1)), and the world's retained route re-proven against the pack's
##    26 main-line ways: every route vertex IS a way vertex, all 13 ways of
##    one track are consumed end-to-end, the west/east ends + length pin,
##    and the route passes the 6 main-line at-grade crossings (the two
##    Jewell-branch ones stay far off it).
## B. THE COAL DRAG — the consist schedule (32 boxes: 8 loco + 12 hoppers ×
##    2), the §1.8 livery at its literals + hue/luminance laws (weathered
##    yellow #D9A02C, shield white #E8E6E0 / blue #1C3F94, hoppers #6B655C),
##    the loop-timer pins (period 360 s, speed 31.3 = the tagged 70-mph
##    class, first pass at 25 s — hidden/gap/wrap states + arc arithmetic),
##    the live clock advance + visibility flip, and the scope guard (no
##    CollisionObject3D anywhere in the rig).
## C. THE DEPOT — the 1:1 swap (the slot's gray stack retired), the photo-08
##    dims on the slot's own envelope (wall 92.8 × 7.0 × 19.9, hip top 9.5
##    over the 88.16 × 16.915 base, canopy slab at the CORRECTED track face
##    z −173.04 — the pack's own geometry puts the main line south of the
##    footprint — top 4.0), the walk seam (ridge answers 9.5, canopy 4.0,
##    the retired north-face slot answers the plate), the closed 6-band
##    palette with NO sign band (the no-Amtrak law), the live loft + arch
##    albedos, and the live collision seams (wall face, canopy top, hip
##    slope).
## D. THE CROSSBUCKS — one pin per at-grade crossing (9), two assemblies
##    each (18 posts / 36 arms) at the derived setback past the matched
##    street's half-width, the arms at ±45° in the plane facing along the
##    road; the museum wigwag at Duff (4 boxes + the red disc).
## E. THE FENCE — the right-of-way lines at ±5.0/9.5 off the route, the
##    18 m post pitch (exact count from the route length), the two strand
##    lines at 0.55/1.05, and the crossing gap (nothing within 17.5 m of
##    any at-grade crossing).
## F. THE NO-GATING PROBE — the coal drag's consist held straddling the Duff
##    crossing while a REAL staged mover drives its graph lane THROUGH the
##    crossing: minimum distance < 12 m to the crossing center and the
##    signed side flips — cars cross regardless (the fence; the train is
##    dressing that moves).
func _scenario_rail_dressing_pins() -> void:
	const S := "rail_dressing_pins"
	var bad: PackedStringArray = PackedStringArray()

	## --- A. the data layer -----------------------------------------------------
	var at_grade: Array[Dictionary] = []
	for crossing: Dictionary in AmesDataPack.rail().get("crossings", []):
		if str(crossing.get("grade", "")) == "at_grade":
			at_grade.append(crossing)
	if at_grade.size() != 14:
		bad.append("pack at-grade crossings %d != the census 9 + the north strip's 5" % at_grade.size())
	var downtown := ["Grand Avenue", "Clark Avenue", "Kellogg Avenue", "Duff Avenue"]
	for name_want: String in downtown:
		var found := false
		for c: Dictionary in at_grade:
			if str(c.get("road_name", "")) == name_want:
				found = true
				break
		if not found:
			bad.append("downtown crossing %s missing from the pack set" % name_want)

	## The depot slot in the bake (walked from the chunk files, not trusted).
	var slot_parts := 0
	var slot_center := Vector2.ZERO
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		for ph: Dictionary in doc.get("placeholders", []):
			if str(ph.get("id", "")) != "way/260524827":
				continue
			slot_parts += 1
			if str(ph.get("part", "")) == "wall":
				slot_center = Vector2(float(ph["p"][0]), float(ph["p"][2]))
	if slot_parts != 3 or slot_center != Vector2(2652.99, -184.99):
		bad.append("depot slot walk: %d parts, center %s != the bake's 3 at (2652.99, -184.99)"
				% [slot_parts, slot_center])

	## The route re-proven against the pack's ways (A continued, on the
	## harness's far world — the world built once at boot).
	var route: PackedVector3Array = _city.rail_route
	var total := 0.0 ## The chained track's length (m) — the fence arms re-read it.
	if route.size() < 13:
		bad.append("retained route has only %d vertices" % route.size())
	else:
		var way_verts: Array[Vector2] = []
		var way_count := 0
		for line: Array in AmesDataPack.rail().get("centerlines", []):
			way_count += 1
			for p: Array in line:
				way_verts.append(Vector2(float(p[0]), float(p[1])))
		var worst := 0.0
		for v: Vector3 in route:
			var v2 := Vector2(v.x, v.z)
			var bd := INF
			for w: Vector2 in way_verts:
				bd = minf(bd, v2.distance_to(w))
			worst = maxf(worst, bd)
		if worst > 0.01:
			bad.append("route vertex %.3f m off the nearest way vertex — the chain invented points" % worst)
		var served := 0
		for line: Array in AmesDataPack.rail().get("centerlines", []):
			var a_ok := false
			var b_ok := false
			var a := Vector2(float((line[0] as Array)[0]), float((line[0] as Array)[1]))
			var b := Vector2(float((line[line.size() - 1] as Array)[0]),
					float((line[line.size() - 1] as Array)[1]))
			for v2: Vector3 in route:
				var rv := Vector2(v2.x, v2.z)
				if rv.distance_to(a) < 0.01:
					a_ok = true
				if rv.distance_to(b) < 0.01:
					b_ok = true
			if a_ok and b_ok:
				served += 1
		if served != 13:
			bad.append("route serves %d ways end-to-end != one track's 13" % served)
		var west := route[0]
		var east := route[route.size() - 1]
		## (T-203 re-pin) The main line's in-core east tail grew with the bbox
		## east: the chain now walks to (3522.0, −266.8) — 4502.7 m (v1: the
		## east end (3297.47, −217.26), 4272.6 m). The west end is untouched.
		if Vector2(west.x, west.z).distance_to(Vector2(-724.6, -1404.39)) > 1.0 \
				or Vector2(east.x, east.z).distance_to(Vector2(3522.0, -266.8)) > 1.0:
			bad.append("route ends %s..%s != the westmost way endpoint walking east" % [west, east])
		total = 0.0
		for i in route.size() - 1:
			total += (route[i + 1] as Vector3).distance_to(route[i])
		if absf(total - 4502.7) > 5.0:
			bad.append("route length %.1f != the chained track's 4502.7 (±5)" % total)
		var route_crossings := 0
		for c: Dictionary in at_grade:
			var pos := Vector2(float((c["pos"] as Array)[0]), float((c["pos"] as Array)[1]))
			var dmin := INF
			for i in route.size() - 1:
				var a3 := Vector2(route[i].x, route[i].z)
				var b3 := Vector2(route[i + 1].x, route[i + 1].z)
				var seg := b3 - a3
				var l2 := seg.length_squared()
				var t := 0.0
				if l2 > 1e-12:
					t = clampf((pos - a3).dot(seg) / l2, 0.0, 1.0)
				dmin = minf(dmin, (a3 + seg * t).distance_to(pos))
			if dmin < 10.0:
				route_crossings += 1
			if str(c.get("road_name", "")) == "Duff Avenue" and dmin > 2.0:
				bad.append("Duff crossing %.1f m off the route — the drag must run it" % dmin)
		if route_crossings != 6:
			bad.append("route passes %d at-grade crossings != the main line's 6 (the Jewell branch stays off)" % route_crossings)

	## --- B. the coal drag -------------------------------------------------------
	var train: AmesTrain = _city.train
	if train == null:
		bad.append("no coal drag staged by the world")
	else:
		if train.consist_boxes() != 32:
			bad.append("consist %d boxes != 32 (8 loco + 12 hoppers × 2)" % train.consist_boxes())
		var band_counts := {}
		var body_color := Color.BLACK
		var hopper_color := Color.BLACK
		var shield_white_color := Color.BLACK
		var shield_blue_color := Color.BLACK
		for part: Dictionary in train.part_schedule:
			var band := str(part["band"])
			band_counts[band] = int(band_counts.get(band, 0)) + 1
			match band:
				"loco_body":
					body_color = part["color"] as Color
				"hopper":
					hopper_color = part["color"] as Color
				"shield_white":
					shield_white_color = part["color"] as Color
				"shield_blue":
					shield_blue_color = part["color"] as Color
		for want: Array in [["loco_frame", 1], ["loco_body", 1], ["loco_roof", 1],
				["loco_glass", 1], ["shield_white", 2], ["shield_blue", 2],
				["hopper", 12], ["coal", 12]]:
			if int(band_counts.get(str(want[0]), 0)) != int(want[1]):
				bad.append("consist band %s count %d != %d" % [want[0],
						int(band_counts.get(str(want[0]), 0)), int(want[1])])
		## The §1.8 livery: the rows verbatim, plus the laws that make the
		## colors read (yellow hue, blue hue, white luminance).
		if _color_gap(body_color, Color(0.851, 0.627, 0.173)) > 0.02:
			bad.append("loco body %s != the weathered yellow #D9A02C" % body_color)
		var yellow_hue := _hue_deg(body_color)
		if yellow_hue < 35.0 or yellow_hue > 55.0:
			bad.append("loco body hue %.0f outside the yellow law 35..55" % yellow_hue)
		if _color_gap(hopper_color, Color(0.420, 0.396, 0.361)) > 0.02:
			bad.append("hopper %s != the brown-gray #6B655C" % hopper_color)
		if _color_gap(shield_white_color, Color(0.910, 0.902, 0.878)) > 0.02:
			bad.append("shield white %s != #E8E6E0" % shield_white_color)
		var wl := shield_white_color.r * 0.299 + shield_white_color.g * 0.587 \
				+ shield_white_color.b * 0.114
		if wl < 0.8:
			bad.append("shield white luminance %.2f < 0.8 — must read white" % wl)
		if _color_gap(shield_blue_color, Color(0.110, 0.247, 0.580)) > 0.02:
			bad.append("shield blue %s != #1C3F94" % shield_blue_color)
		var blue_hue := _hue_deg(shield_blue_color)
		if blue_hue < 200.0 or blue_hue > 250.0:
			bad.append("shield blue hue %.0f outside the blue law 200..250" % blue_hue)
		## The loop schedule: the pinned constants + the state arithmetic.
		if absf(train.RUN_PERIOD_S - 360.0) > 0.001:
			bad.append("RUN_PERIOD_S %.1f != the pinned 360" % train.RUN_PERIOD_S)
		if absf(train.RUN_SPEED_MPS - 31.3) > 0.001:
			bad.append("RUN_SPEED_MPS %.2f != the tagged 70-mph class 31.3" % train.RUN_SPEED_MPS)
		if absf(train.RUN_START_DELAY_S - 25.0) > 0.001:
			bad.append("RUN_START_DELAY_S %.1f != the pinned 25" % train.RUN_START_DELAY_S)
		var start_arc := float(train.state_at(0.0)["nose_arc"])
		var st_pre := train.state_at(20.0)
		var st_run := train.state_at(25.0)
		var st_mid := train.state_at(25.0 + train.traverse_time() * 0.5)
		var st_gap := train.state_at(25.0 + train.traverse_time() + 5.0)
		var st_wrap := train.state_at(25.0 + train.RUN_PERIOD_S + 1.0)
		if bool(st_pre["visible"]):
			bad.append("drag visible before the first pass (t=20)")
		if not bool(st_run["visible"]) \
				or absf(float(st_run["nose_arc"]) - start_arc) > 0.05:
			bad.append("first pass t=25: vis=%s arc=%.2f != tail-at-start %.2f" % [
					str(st_run["visible"]), float(st_run["nose_arc"]), start_arc])
		if not bool(st_mid["visible"]):
			bad.append("drag hidden mid-traverse")
		else:
			var want_arc := start_arc + train.traverse_time() * 0.5 * train.RUN_SPEED_MPS
			if absf(float(st_mid["nose_arc"]) - want_arc) > 0.5:
				bad.append("mid-traverse arc %.1f != the speed law %.1f" % [
						float(st_mid["nose_arc"]), want_arc])
		if bool(st_gap["visible"]):
			bad.append("drag still visible in the between-pass gap")
		if not bool(st_wrap["visible"]):
			bad.append("drag did not wrap at period+1")
		## The live clock + visibility flip.
		train.clock = 24.9
		await _wait_frames(2)
		if bool(train.state_at(train.clock)["visible"]) != train.visible:
			bad.append("train visibility does not follow the schedule state")
		train.clock = 30.0
		await _wait_frames(2)
		if not train.visible:
			bad.append("drag not visible at t=30 (inside the first traverse)")
		var arc0 := float(train.state_at(train.clock)["nose_arc"])
		await _wait_frames(60)
		var arc1 := float(train.state_at(train.clock)["nose_arc"])
		if arc1 - arc0 < 25.0 or arc1 - arc0 > 40.0:
			bad.append("live arc advance %.1f m over 60 frames != the 31.3 m/s law band" % (arc1 - arc0))
		## The scope guard: no physics body anywhere in the rig.
		if train.find_children("*", "CollisionObject3D", true, false).size() != 0:
			bad.append("coal drag carries a physics body — the dressing must gate nothing")

	## --- C. the depot -----------------------------------------------------------
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var parts := world.depot_hero_parts
	if parts.is_empty():
		bad.append("no retained depot parts — the hero never built")
	else:
		if parts.size() != 28:
			bad.append("depot record %d entries != 25 boxes + 3 meshes" % parts.size())
		var band_set := {}
		var wall := {}
		var canopy := {}
		var loft := {}
		for part: Dictionary in parts:
			var band := str(part["band"])
			band_set[band] = true
			if not bool(part["mesh"]) and band == "brick" \
					and absf((part["s"] as Vector3).x - 92.8) < 0.05 \
					and absf((part["s"] as Vector3).y - 7.0) < 0.05:
				wall = part
			if not bool(part["mesh"]) and band == "tile" \
					and absf((part["s"] as Vector3).y - 0.8) < 0.05:
				canopy = part
			if bool(part["mesh"]) and band == "tile":
				loft = part
		for want_band: String in ["brick", "tile", "trim", "green", "steel", "cap"]:
			if not band_set.has(want_band):
				bad.append("depot band %s never used — the family is missing" % want_band)
		## The no-Amtrak law: the band set is CLOSED at the six dressing
		## bands — no sign band exists for the preserved depot's blank read.
		for stray_band: Variant in band_set:
			if not (stray_band as String) in ["brick", "tile", "trim", "green", "steel", "cap"]:
				bad.append("depot carries stray band %s — the preserved depot wears no marks" % stray_band)
		if wall.is_empty() or absf(((wall["p"] as Vector3) - Vector3(2652.99, 3.5, -184.99)).length()) > 0.05:
			bad.append("depot wall %s != the slot's own 92.8 × 7.0 × 19.9 at (2652.99, 3.5, -184.99)"
					% (wall.get("p", "<none>")))
		var canopy_top: float = (canopy["p"] as Vector3).y + (canopy["s"] as Vector3).y * 0.5 \
				if not canopy.is_empty() else -1.0
		if canopy.is_empty() or absf(canopy_top - 4.0) > 0.05 \
				or absf((canopy["p"] as Vector3).z - -173.04) > 0.05:
			bad.append("depot canopy %s != the slot slab at the CORRECTED track face (top 4.0, z -173.04)"
					% (canopy.get("p", "<none>")))
		if loft.is_empty() or absf((loft["s"] as Vector3).x - 88.16) > 0.05 \
				or absf((loft["s"] as Vector3).y - 2.5) > 0.05:
			bad.append("depot hip loft %s != the slot roof's 88.16 × 2.5 × 16.915 envelope"
					% (loft.get("s", "<none>")))
		var north_stray := false
		for part: Dictionary in parts:
			if (part["p"] as Vector3).z < -190.0:
				north_stray = true
		if north_stray:
			bad.append("a depot part sits north of z -190 — the retired north-face canopy slot must stay retired")

	## The walk seam: the ridge answers 9.5, the wall 7.0 under it, the
	## canopy 4.0 at the track face, and the RETIRED north slot answers the
	## plate (the T-190 retire-the-slot-answers law).
	var gh_ridge := world.ground_height(world.to_global(Vector3(2652.99, 0.0, -184.99)))
	var gh_wall := world.ground_height(world.to_global(Vector3(2652.99, 0.0, -191.0)))
	var gh_canopy := world.ground_height(world.to_global(Vector3(2652.99, 0.0, -173.04)))
	var gh_retired := world.ground_height(world.to_global(Vector3(2652.99, 0.0, -195.94)))
	if absf(gh_ridge - 9.5) > 0.05:
		bad.append("ridge walk answer %.2f != the slot roof top 9.5" % gh_ridge)
	if absf(gh_wall - 7.0) > 0.05:
		bad.append("wall walk answer %.2f != 7.0" % gh_wall)
	if absf(gh_canopy - 4.0) > 0.05:
		bad.append("canopy walk answer %.2f != 4.0 at the track face" % gh_canopy)
	if absf(gh_retired) > 0.05:
		bad.append("retired north-face slot answers %.2f — must answer the plate" % gh_retired)

	## The live meshes + the collision seams (the T-193 probe pattern).
	var chunk_node := world.get_node_or_null("Chunks/Chunk_10_-1") as Node3D
	if chunk_node == null:
		bad.append("chunk Chunk_10_-1 missing")
	else:
		var ph_mm := chunk_node.get_node_or_null("Placeholders") as MultiMeshInstance3D
		if ph_mm != null:
			bad.append("depot chunk still carries a placeholder family — the gray stack must be fully retired")
		var hero_root := chunk_node.get_node_or_null("HeroDepot") as Node3D
		if hero_root == null:
			bad.append("no HeroDepot under Chunk_10_-1")
		else:
			var boxes_mm := hero_root.get_node_or_null("Boxes") as MultiMeshInstance3D
			if boxes_mm == null or boxes_mm.multimesh.instance_count != 25:
				bad.append("depot Boxes MM %s != the 25-box schedule" % (
						boxes_mm.multimesh.instance_count if boxes_mm != null else "<none>"))
			var loft_mesh := hero_root.get_node_or_null("HipRoof") as MeshInstance3D
			if loft_mesh == null or not (loft_mesh.mesh is ArrayMesh):
				bad.append("depot hip loft mesh missing")
			else:
				var slope_mat := (loft_mesh.mesh as ArrayMesh).surface_get_material(0) as StandardMaterial3D
				if slope_mat == null or _color_gap(slope_mat.albedo_color, Color(0.690, 0.290, 0.204)) > 0.02:
					bad.append("hip loft slope %s != the red tile #B04A34" % (
							slope_mat.albedo_color if slope_mat != null else "<null>"))
			for arch_name: String in ["DormerArchEast", "DormerArchWest"]:
				var arch := hero_root.get_node_or_null(arch_name) as MeshInstance3D
				if arch == null or not (arch.mesh is CylinderMesh):
					bad.append("depot %s missing" % arch_name)
				else:
					var arch_mat := (arch.mesh as CylinderMesh).material as StandardMaterial3D
					if arch_mat == null or _color_gap(arch_mat.albedo_color, Color(0.898, 0.875, 0.808)) > 0.02:
						bad.append("%s albedo %s != the cream trim" % [arch_name,
								arch_mat.albedo_color if arch_mat != null else "<null>"])
	var space := get_world_3d().direct_space_state
	var probe := func(from: Vector3, to: Vector3) -> Dictionary:
		var ray := PhysicsRayQueryParameters3D.create(world.to_global(from),
				world.to_global(to))
		ray.collision_mask = 1
		return space.intersect_ray(ray)
	var wall_ray: Dictionary = probe.call(
			Vector3(2652.99, 2.5, -170.0), Vector3(2652.99, 2.5, -184.99))
	if wall_ray.is_empty():
		bad.append("depot wall face ray missed")
	else:
		var wall_z: float = world.to_local((wall_ray as Dictionary)["position"]).z
		if absf(wall_z - -175.04) > 0.1:
			bad.append("depot south wall face z %.2f != -175.04 (±0.1)" % wall_z)
	var canopy_ray: Dictionary = probe.call(
			Vector3(2652.99, 10.0, -173.04), Vector3(2652.99, 0.5, -173.04))
	if canopy_ray.is_empty():
		bad.append("canopy slab ray missed")
	else:
		var canopy_y: float = world.to_local((canopy_ray as Dictionary)["position"]).y
		if absf(canopy_y - 4.0) > 0.1:
			bad.append("canopy top y %.2f != the slab's 4.0 (±0.1)" % canopy_y)
	var hip_ray: Dictionary = probe.call(
			Vector3(2652.99, 12.0, -188.0), Vector3(2652.99, 5.0, -188.0))
	if hip_ray.is_empty():
		bad.append("hip slope ray missed (the frustum convex must be live)")
	else:
		var hip_y: float = world.to_local((hip_ray as Dictionary)["position"]).y
		if absf(hip_y - 8.704) > 0.15:
			bad.append("hip north slope at z -188 reads y %.2f != the frustum read 8.704 (±0.15)" % hip_y)

	## --- D. the crossbucks (T-205 re-pin: 14 at-grade crossings, 28/56) ----
	if world.crossbuck_pins.size() != 14:
		bad.append("crossbuck pins %d != the 14 at-grade crossings" % world.crossbuck_pins.size())
	if world._crossbuck_post_xfs.size() != 28 or world._crossbuck_arm_xfs.size() != 56:
		bad.append("crossbuck hardware %d posts / %d arms != 28 / 56" % [
				world._crossbuck_post_xfs.size(), world._crossbuck_arm_xfs.size()])
	for pin: Dictionary in world.crossbuck_pins:
		var pin_pos: Vector2 = pin["pos"]
		var matched := {}
		for c: Dictionary in at_grade:
			var cpos := Vector2(float((c["pos"] as Array)[0]), float((c["pos"] as Array)[1]))
			if cpos.distance_to(pin_pos) < 0.5:
				matched = c
				break
		if matched.is_empty():
			bad.append("crossbuck pin %s matches no pack at-grade crossing" % pin_pos)
			continue
		if int(pin["assemblies"]) != 2:
			bad.append("crossing %s carries %d assemblies != 2" % [pin["road"], int(pin["assemblies"])])
		## The setback past the matched street's half-width (the road axis
		## re-derived here from the pack streets).
		var road := _rail_road_axis(pin_pos, str(matched.get("road_name", "")),
				str(matched.get("road_class", "")))
		if road.is_empty():
			bad.append("no pack street serves %s" % pin["road"])
			continue
		var want_setback: float = float(road["width"]) * 0.5 + 2.5
		var axis: Vector2 = road["axis"]
		var side := Vector2(-axis.y, axis.x)
		var pin_pos3 := Vector3(pin_pos.x, 0.0, pin_pos.y)
		## The assembly siting, in the crossing's own road frame: the along-axis
		## component at the exact setback, the cross-axis component ~0 (the
		## band separates the Hazel/Brookridge pair's parallel posts).
		var hits := 0
		for xf: Transform3D in world._crossbuck_post_xfs:
			var rel := Vector2(xf.origin.x, xf.origin.z) - pin_pos
			var along := rel.dot(axis)
			var cross := rel.dot(side)
			if absf(absf(along) - want_setback) < 1.2 and absf(cross) < 0.5:
				hits += 1
		if hits != 2:
			bad.append("crossing %s has %d posts at the setback siting != 2" % [pin["road"], hits])
		var near_arms := 0
		for xf: Transform3D in world._crossbuck_arm_xfs:
			var rel := Vector2(xf.origin.x, xf.origin.z) - pin_pos
			var along := rel.dot(axis)
			var cross := rel.dot(side)
			if absf(absf(along) - want_setback) < 1.2 and absf(cross) < 0.5:
				near_arms += 1
				var arm_dir := xf.basis.y.normalized()
				if absf(absf(arm_dir.y) - 0.7071) > 0.03 \
						or absf(Vector2(arm_dir.x, arm_dir.z).length() - 0.7071) > 0.03:
					bad.append("crossing %s arm not at the 45° X read (basis.y %s)" % [
							pin["road"], xf.basis.y])
		if near_arms != 4:
			bad.append("crossing %s has %d arms at the setback siting != 4" % [pin["road"], near_arms])
	if world.wigwag_parts.size() != 5:
		bad.append("wigwag parts %d != 4 boxes + the disc" % world.wigwag_parts.size())
	else:
		var duff := Vector2.ZERO
		for c: Dictionary in at_grade:
			if str(c.get("road_name", "")) == "Duff Avenue":
				duff = Vector2(float((c["pos"] as Array)[0]), float((c["pos"] as Array)[1]))
		var wg_pos: Vector3 = world.wigwag_parts[0]["p"]
		if Vector2(wg_pos.x, wg_pos.z).distance_to(duff) > 16.0:
			bad.append("wigwag %.1f m off Duff — the museum piece stands at the busiest crossing"
					% Vector2(wg_pos.x, wg_pos.z).distance_to(duff))
		var has_disc := false
		for wp: Dictionary in world.wigwag_parts:
			if bool(wp.get("mesh", false)) and str(wp["band"]) == "wigwag_red":
				has_disc = true
		if not has_disc:
			bad.append("wigwag disc missing")

	## --- E. the fence -----------------------------------------------------------
	var post_xfs := world._fence_post_xfs
	var wire_xfs := world._fence_wire_xfs
	if post_xfs.size() % 2 != 0 or post_xfs.size() < 440:
		bad.append("fence posts %d — both sides' 18 m run must survive the crossing gaps" % post_xfs.size())
	if wire_xfs.size() < 700:
		bad.append("fence wires %d < 700 — the strand lines are missing" % wire_xfs.size())
	var wire_lengths_ok := true
	var wire_heights_ok := true
	var wire_len_min := INF
	var wire_len_max := 0.0
	for xf: Transform3D in wire_xfs:
		if absf(xf.origin.y - 0.55) > 0.02 and absf(xf.origin.y - 1.05) > 0.02:
			wire_heights_ok = false
		wire_len_min = minf(wire_len_min, xf.basis.x.length())
		wire_len_max = maxf(wire_len_max, xf.basis.x.length())
		if xf.basis.x.length() > 19.0 or xf.basis.x.length() < 17.0:
			wire_lengths_ok = false
	if not wire_heights_ok:
		bad.append("a wire rides neither the 0.55 nor the 1.05 strand line")
	if not wire_lengths_ok:
		bad.append("a wire span outside the 18 m pitch's fence-line chord band [17.0, 19.0] (min %.3f max %.3f)"
				% [wire_len_min, wire_len_max])
	var fence_off_south := 0
	var fence_off_north := 0
	var gap_violation := false
	var gap_points: Array[Vector2] = []
	for c: Dictionary in at_grade:
		gap_points.append(Vector2(float((c["pos"] as Array)[0]), float((c["pos"] as Array)[1])))
	for xf: Transform3D in post_xfs:
		var lp := xf.origin ## The retained queues are world-local already.
		var dmin := INF
		for i in route.size() - 1:
			var a3 := Vector2(route[i].x, route[i].z)
			var b3 := Vector2(route[i + 1].x, route[i + 1].z)
			var seg := b3 - a3
			var l2 := seg.length_squared()
			var t := 0.0
			if l2 > 1e-12:
				t = clampf((Vector2(lp.x, lp.z) - a3).dot(seg) / l2, 0.0, 1.0)
			dmin = minf(dmin, (a3 + seg * t).distance_to(Vector2(lp.x, lp.z)))
		if absf(dmin - 5.0) < 0.3:
			fence_off_north += 1
		elif absf(dmin - 9.5) < 0.3:
			fence_off_south += 1
		for gp: Vector2 in gap_points:
			if Vector2(lp.x, lp.z).distance_to(gp) < 17.5:
				gap_violation = true
	if fence_off_north < 200 or fence_off_south < 200:
		bad.append("fence sides thin: %d posts at 5.0 / %d at 9.5 — both right-of-way lines must run" % [
				fence_off_north, fence_off_south])
	if gap_violation:
		bad.append("a fence post stands inside an at-grade crossing's 18 m gap")

	## --- F. the no-gating probe -------------------------------------------------
	Car.traffic_frozen = false ## Clean slate on the static freeze (suite convention).
	Car._last_fleet_patience_honk = -INF
	## The probe straddles whichever ROUTE crossing a real graph lane runs
	## mid-edge (the deterministic first pick among the drag's own 6 — Duff
	## preferred, the rest as edge geometry allows).
	if train != null:
		var graph: AmesTrafficGraph = _city.traffic_graph
		var probe_pos := Vector2.ZERO
		var probe_arc := 0.0
		var probe_edge := -1
		var probe_hold := 0.0
		var probe_dir := Vector2.RIGHT
		for c: Dictionary in at_grade:
			var cpos := Vector2(float((c["pos"] as Array)[0]), float((c["pos"] as Array)[1]))
			var c_arc := _rail_arc_of(train.extended_route, cpos)
			if c_arc < 0.0:
				continue ## Off the drag's track (the Jewell branch, the abandoned lead).
			for e in graph.edge_count():
				if graph.edge_length(e) < 70.0:
					continue
				var lane := graph.edge_points(e)
				for i in lane.size() - 1:
					var a5 := Vector2(lane[i].x, lane[i].y)
					var b5 := Vector2(lane[i + 1].x, lane[i + 1].y)
					var seg3 := b5 - a5
					var l23 := seg3.length_squared()
					var t3 := 0.0
					if l23 > 1e-12:
						t3 = clampf((cpos - a5).dot(seg3) / l23, 0.0, 1.0)
					if (a5 + seg3 * t3).distance_to(cpos) > 20.0:
						continue
					var acc3 := 0.0
					for j in i:
						acc3 += Vector2(lane[j].x, lane[j].y).distance_to(
								Vector2(lane[j + 1].x, lane[j + 1].y))
					var proj_arc := acc3 + seg3.length() * t3
					if proj_arc < 45.0 or proj_arc > graph.edge_length(e) - 35.0:
						continue ## The crossing sits mid-edge, clear of the end stop's brake.
					probe_edge = e
					probe_arc = proj_arc
					probe_pos = cpos
					probe_dir = seg3.normalized()
					probe_hold = train.RUN_START_DELAY_S \
							+ (c_arc + 110.0
							- (train.consist_length() - AmesTrain.LOCO_LEN * 0.5)) \
							/ train.RUN_SPEED_MPS
					break
				if probe_edge >= 0:
					break
			if probe_edge >= 0:
				break
		if probe_edge < 0:
			bad.append("no graph edge runs a drag crossing mid-edge — the probe cannot stage")
		else:
			var probe_global := _city.to_global(Vector3(probe_pos.x, 0.0, probe_pos.y))
			var spawner := CarSpawner.new()
			spawner.city = _city
			spawner.player = _player
			spawner.target_moving = 0
			spawner.target_parked = 0
			spawner.name = "CarSpawner_rail_probe"
			add_child(spawner)
			await _wait_frames(2)
			## Hold the consist straddling the crossing: the loco center 110 m
			## PAST it puts the crossing mid-consist; the clock re-pins every
			## frame so the drag stays parked there for the whole pass.
			if not bool(train.state_at(probe_hold)["visible"]):
				bad.append("the straddle hold clock parks the drag hidden — the probe proves nothing")
			var mover := _calm_stage_mover(spawner, probe_edge, probe_arc - 45.0)
			var mover_pos := mover.position
			var min_d := INF
			var crossed := false
			var last_side := signf((Vector2(mover_pos.x, mover_pos.z)
					- Vector2(probe_global.x, probe_global.z)).dot(probe_dir))
			var last_speed := 0.0
			var last_frame := 0
			for frame in 1080:
				train.clock = probe_hold
				await get_tree().physics_frame
				if not is_instance_valid(mover):
					break ## The run ended early — the samples decide below.
				var mp := mover.position
				min_d = minf(min_d, Vector2(mp.x, mp.z).distance_to(
						Vector2(probe_global.x, probe_global.z)))
				var side := signf((Vector2(mp.x, mp.z)
						- Vector2(probe_global.x, probe_global.z)).dot(probe_dir))
				if side != last_side and side != 0.0:
					crossed = true
				last_side = side
				last_speed = mover.velocity.length()
				last_frame = frame
				if crossed and frame > 30:
					break
			var ok_probe := crossed and min_d < 12.0
			if not ok_probe:
				bad.append("the mover did not cross the straddled crossing (crossed=%s min_d=%.1f speed@%d=%.2f) — something gated it" % [
						crossed, min_d, last_frame, last_speed])
			mover.queue_free() ## The staged car must not join the fleet the dev_verb_pack reads.
			spawner.free()
			await _wait_frames(2)

	print("SIM DATA %s: crossings=%d route=%.1f m parts=%d posts=%d wires=%d wire_span=[%.3f, %.3f] traverse=%.1f s consist=%d boxes train_total=%.1f m" % [
			S, world.crossbuck_pins.size(), total, parts.size(),
			post_xfs.size(), wire_xfs.size(), wire_len_min, wire_len_max,
			train.traverse_time() if train != null else -1.0,
			train.consist_boxes() if train != null else 0,
			train.route_length() if train != null else -1.0])
	_check(S, bad.is_empty(),
		"crossings=%d route=%.1f m parts=%d posts=%d wires=%d; %s"
		% [world.crossbuck_pins.size(), total, parts.size(),
		post_xfs.size(), wire_xfs.size(), "; ".join(bad)])
	world.queue_free()


## (T-194) The pack street axis at a crossing — the scenario-local re-derivation
## of the road direction (nearest segment of the named street; the unnamed
## lead falls back to the nearest segment of any class, the world's own law).
func _rail_road_axis(pos: Vector2, road_name: String, _road_class: String) -> Dictionary:
	var best: Dictionary = {}
	var best_d := INF
	for street: Dictionary in AmesDataPack.streets():
		if not road_name.is_empty() and str(street.get("name", "")) != road_name:
			continue
		var pts: Array = street.get("points", [])
		for i in range(pts.size() - 1):
			var a := Vector2(float((pts[i] as Array)[0]), float((pts[i] as Array)[1]))
			var b := Vector2(float((pts[i + 1] as Array)[0]), float((pts[i + 1] as Array)[1]))
			var seg := b - a
			var l2 := seg.length_squared()
			var t := 0.0
			if l2 > 1e-12:
				t = clampf((pos - a).dot(seg) / l2, 0.0, 1.0)
			var d := (a + seg * t).distance_to(pos)
			if d < best_d:
				best_d = d
				best = {"axis": seg.normalized(), "width": float(street.get("width_m", 8.0))}
	return best


## (T-194) The probe edge's flat travel direction (first→last lane vertex).
func _rail_edge_dir(graph: AmesTrafficGraph, edge: int) -> Vector2:
	var lane := graph.edge_points(edge)
	return (Vector2(lane[lane.size() - 1].x, lane[lane.size() - 1].y)
			- Vector2(lane[0].x, lane[0].y)).normalized()


## (T-194) A position's arc along a route polyline, or −1.0 when the nearest
## projection sits farther than 5 m off it (the off-track discriminator).
func _rail_arc_of(route: PackedVector3Array, pos: Vector2) -> float:
	var acc := 0.0
	var best_arc := -1.0
	var best_d := 5.0
	for i in route.size() - 1:
		var a := Vector2(route[i].x, route[i].z)
		var b := Vector2(route[i + 1].x, route[i + 1].z)
		var seg := b - a
		var l2 := seg.length_squared()
		var t := 0.0
		if l2 > 1e-12:
			t = clampf((pos - a).dot(seg) / l2, 0.0, 1.0)
		var d := (a + seg * t).distance_to(pos)
		if d < best_d:
			best_d = d
			best_arc = acc + seg.length() * t
		acc += seg.length()
	return best_arc


## --- scenario (T-195 the SE grain-elevator cluster) ---------------------------

## The agricultural skyline (LANDMARKS T7 / MODELING-SPECS §1.8 item 4) on the
## resident Ames world, every expectation re-derived from the COMMITTED DATA
## (the bake's chunk files — never through the world's own constants). The
## HONESTY IS THE PIN: heights assert the documented V-30 30–40 m placeholder
## BAND, never exact dims — no photo of the actual Ames SE cluster exists
## under CC (the refs are `images/rail/10,11,12`: Hull's pale concrete silo
## bank + headhouse slab, Jefferson's box annex, Batavia's steel bins + leg
## tower), so nothing here may pretend to a surveyed height. Arms:
## A. THE SLOT — the bake's seven placeholder parts (4 silos + headhouse +
##    2 bins) walked in chunk (13,−1), the bank centered on the
##    survey-anchored approximation (3420, −20), the headhouse 8 m north and
##    the bins 8 m south of the bank, the V-30 band ALREADY holding on the
##    slot's own silo/headhouse spans;
## B. THE SWAP — the slot's gray stack retired (chunk (13,−1)'s placeholder
##    family shrinks to exactly its non-superseded remainder) and the hero
##    mounting through its own root (Boxes = 12: headhouse + roof slab + the
##    10-member leg tower);
## C. THE BAND (the honesty pin) — the styled cluster's union top inside
##    30..40 (NOT an exact-dim pin), base on the plate, every family kept
##    inside its slot's own span (the keep-the-stack law: the hero's
##    headhouse box IS the slot box, the silo walls the slot silo spans,
##    wall+cone sums the slot bin spans);
## D. THE COMPOSITION vs the refs — 4 silo cylinders + 4 cap rims + the
##    headhouse + roof slab + 2 bins + 2 cone roofs + the leg tower (4 posts
##    + 5 collars + the crown arm) at the slot's own grid, the leg rising
##    with the bank against the headhouse's east wall;
## E. THE PALETTE — the CLOSED six-band set at the literals + laws (the
##    §1.8 pale #D9D2C4 concrete reading warm/high-luminance, the galvanized
##    steel reading cool, roof slab + leg reading dark, and NO sign band —
##    the honesty note's no-branding law);
## F. THE SEAMS, LIVE — layer-1 rays answer the silo wall (Ø7 on the east
##    vertex plane), the headhouse east face, the bin wall (Ø5) and the bin
##    cone slope; the walk-parity ground record (34 / 38 / 12 / 12 — the
##    slot's own answers, byte-identical); the leg tower visual-only (the
##    crown-arm and post lines ray-clear); no roof crumb filed (the slot
##    never carried one).
func _scenario_elevator_cluster_dims() -> void:
	const S := "elevator_cluster_dims"
	var bad: PackedStringArray = PackedStringArray()
	const SLOT_ID := "grain_elevators"

	## --- A. the bake slot, walked independently --------------------------------
	var silos: Array[Dictionary] = []
	var bins: Array[Dictionary] = []
	var headhouse := {}
	for entry: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		for ph: Dictionary in doc.get("placeholders", []):
			if str(ph.get("id", "")) != SLOT_ID:
				continue
			var part := {
				"part": str(ph.get("part", "")),
				"p": Vector3(float(ph["p"][0]), float(ph["p"][1]), float(ph["p"][2])),
				"s": Vector3(float(ph["s"][0]), float(ph["s"][1]), float(ph["s"][2])),
			}
			match part["part"]:
				"silo":
					silos.append(part)
				"bin":
					bins.append(part)
				"headhouse":
					headhouse = part
	if silos.size() != 4 or bins.size() != 2 or headhouse.is_empty():
		_check(S, false, "slot walk failed: silos=%d bins=%d headhouse=%s (want 4/2/1)"
				% [silos.size(), bins.size(), headhouse.is_empty()])
		return
	silos.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return (a["p"] as Vector3).x < (b["p"] as Vector3).x)
	bins.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return (a["p"] as Vector3).x < (b["p"] as Vector3).x)
	var bank_z: float = (silos[0]["p"] as Vector3).z
	var bank_x := 0.0
	for sl: Dictionary in silos:
		bank_x += (sl["p"] as Vector3).x
	bank_x /= silos.size()
	for k in silos.size() - 1:
		var gap: float = (silos[k + 1]["p"] as Vector3).x - (silos[k]["p"] as Vector3).x
		var width: float = (silos[k]["s"] as Vector3).x
		if absf(gap - (width + 2.0)) > 0.01:
			bad.append("silo spacing %.2f != the bank read (Ø %.1f boxes + 2 m gaps)" % [gap, width])
	for sl2: Dictionary in silos:
		var sp: Vector3 = sl2["p"]
		var ss: Vector3 = sl2["s"]
		if absf(sp.z - bank_z) > 0.01:
			bad.append("silo at z %.1f off the bank line %.1f" % [sp.z, bank_z])
		if absf(ss.x - ss.z) > 0.01:
			bad.append("silo plan %.1fx%.1f not square (the Ø read)" % [ss.x, ss.z])
		## The V-30 band on the slot's own span — the honesty holds BEFORE the dress.
		if ss.y < 30.0 or ss.y > 40.0:
			bad.append("silo span %.1f outside the 30–40 m placeholder band" % ss.y)
	var hp: Vector3 = headhouse["p"]
	var hs: Vector3 = headhouse["s"]
	if absf(hp.x - bank_x) > 0.01:
		bad.append("headhouse x %.1f off the bank center %.1f" % [hp.x, bank_x])
	if absf(hp.z - (bank_z - 8.0)) > 0.01:
		bad.append("headhouse z %.1f != 8 m north of the bank %.1f" % [hp.z, bank_z - 8.0])
	if hs.y < 30.0 or hs.y > 40.0:
		bad.append("headhouse span %.1f outside the 30–40 m placeholder band" % hs.y)
	if hs.y < (silos[0]["s"] as Vector3).y:
		bad.append("headhouse %.1f shorter than the silos — must read the tall element" % hs.y)
	var bank_center := Vector2(bank_x, bank_z)
	if bank_center.distance_to(Vector2(3420.0, -20.0)) > 0.01:
		bad.append("bank center %s off the survey-anchored approximation (3420, −20)" % bank_center)
	for bn: Dictionary in bins:
		var bp: Vector3 = bn["p"]
		var bs: Vector3 = bn["s"]
		if absf(bp.z - (bank_z + 8.0)) > 0.01:
			bad.append("bin at z %.1f != 8 m south of the bank %.1f" % [bp.z, bank_z + 8.0])
		if bs.y <= 5.0 or bs.y >= 30.0:
			bad.append("bin span %.1f outside the annex read (low, under the band)" % bs.y)

	## --- B+C+D+E. the hero: swap, band, composition, palette -------------------
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var parts := world.elevator_hero_parts
	if parts.is_empty():
		_check(S, false, "no retained elevator parts — the hero never built")
		world.queue_free()
		return
	if parts.size() != 24:
		bad.append("record %d != the 24 schedule (12 boxes: headhouse + roof slab "
				+ "+ 10 leg members; 12 meshes: 4 silos + 4 caps + 2 bins + 2 cones)" % parts.size())
	var band_counts := {}
	var lo := Vector3(INF, INF, INF)
	var hi := Vector3(-INF, -INF, -INF)
	for part: Dictionary in parts:
		var p: Vector3 = part["p"]
		var s: Vector3 = part["s"]
		lo = lo.min(p - s * 0.5)
		hi = hi.max(p + s * 0.5)
		var band := str(part["band"])
		band_counts[band] = int(band_counts.get(band, 0)) + 1
	var want_counts := {
		"concrete": 5, "concrete_cap": 4, "roof": 1,
		"steel": 2, "steel_roof": 2, "leg": 10,
	}
	for want_band: String in want_counts:
		if int(band_counts.get(want_band, 0)) != int(want_counts[want_band]):
			bad.append("band %s count %d != %d" % [want_band,
					int(band_counts.get(want_band, 0)), int(want_counts[want_band])])
	for seen_band: String in band_counts:
		if not want_counts.has(seen_band):
			bad.append("band %s outside the closed six — no sign band may exist" % seen_band)
	## C. THE BAND — the honesty pin: the styled union sits INSIDE the
	## documented 30–40 m placeholder range (a band assertion, deliberately
	## not the exact 38.0 the slot carries).
	if hi.y < 30.0 or hi.y > 40.0:
		bad.append("cluster union top %.2f outside the 30–40 m placeholder band "
				+ "(the honesty is the pin)" % hi.y)
	if lo.y < -0.05:
		bad.append("cluster base %.2f sinks past the plate" % lo.y)
	## The keep-the-stack law: every family inside its slot's own span.
	var headhouse_part := {}
	for part2: Dictionary in parts:
		if str(part2["band"]) == "concrete" and not bool(part2["mesh"]) \
				and absf((part2["s"] as Vector3).y - hs.y) < 0.001:
			headhouse_part = part2
			break
	if headhouse_part.is_empty():
		bad.append("no headhouse box at the slot's own %.1f span — the stack law broke" % hs.y)
	for sl3: Dictionary in silos:
		var want_h: float = (sl3["s"] as Vector3).y
		var found := false
		for part3: Dictionary in parts:
			if str(part3["band"]) == "concrete" and bool(part3["mesh"]) \
					and absf((part3["s"] as Vector3).y - want_h) < 0.001 \
					and absf((part3["p"] as Vector3).x - (sl3["p"] as Vector3).x) < 0.01:
				found = true
				break
		if not found:
			bad.append("no silo wall at x %.1f on the slot's own %.1f span" % [
					(sl3["p"] as Vector3).x, want_h])
	for bn2: Dictionary in bins:
		var want_bin: float = (bn2["s"] as Vector3).y
		var bin_sum := 0.0
		for part4: Dictionary in parts:
			if str(part4["band"]) == "steel" and bool(part4["mesh"]) \
					and absf((part4["p"] as Vector3).x - (bn2["p"] as Vector3).x) < 0.01:
				bin_sum += (part4["s"] as Vector3).y
			elif str(part4["band"]) == "steel_roof" and bool(part4["mesh"]) \
					and absf((part4["p"] as Vector3).x - (bn2["p"] as Vector3).x) < 0.01:
				bin_sum += (part4["s"] as Vector3).y
		if absf(bin_sum - want_bin) > 0.001:
			bad.append("bin x %.1f wall+roof %.2f != the slot's own %.1f span" % [
					(bn2["p"] as Vector3).x, bin_sum, want_bin])
	## D. THE COMPOSITION: the leg tower against the headhouse's east wall,
	## rising to a meter under the headhouse top — ABOVE the bank line, so
	## the rail/12 mast reads in the skyline from the town side (a leg that
	## stopped at the silo top would stand occluded behind the bank) — with
	## 5 collars evenly over the lower leg and the crown arm at leg-top − 0.6
	## running 8 m alongside the wall.
	var leg_x := hp.x + hs.x * 0.5 + 1.4
	var leg_top := hs.y - 1.0
	var silo_span: float = (silos[0]["s"] as Vector3).y
	if leg_top <= silo_span:
		bad.append("leg top %.1f not above the bank line %.1f — the mast would never read" % [
				leg_top, silo_span])
	var posts := 0
	var collars := 0
	var arms := 0
	for part5: Dictionary in parts:
		if str(part5["band"]) != "leg":
			continue
		var lp: Vector3 = part5["p"]
		var ls: Vector3 = part5["s"]
		if absf(ls.x - 0.16) < 0.001 and absf(ls.z - 0.16) < 0.001:
			posts += 1
			if absf(absf(lp.x - leg_x) - 0.8) > 0.01 or absf(absf(lp.z - hp.z) - 0.8) > 0.01 \
					or absf(ls.y - leg_top) > 0.001:
				bad.append("leg post %s off the lattice square or the headhouse-top line" % lp)
		elif absf(ls.y - 0.14) < 0.001:
			collars += 1
			if absf(lp.y - leg_top * float(collars) / 6.0) > 0.01:
				bad.append("leg collar %d at y %.2f != the even lower-leg line %.2f" % [
						collars, lp.y, leg_top * float(collars) / 6.0])
		elif absf(ls.z - 8.0) < 0.001:
			arms += 1
			if absf(lp.y - (leg_top - 0.6)) > 0.01 \
					or absf(lp.x - leg_x) > 0.01:
				bad.append("leg arm %s off the crown line (leg top − 0.6)" % lp)
	if posts != 4 or collars != 5 or arms != 1:
		bad.append("leg schedule %d posts / %d collars / %d arms != 4/5/1" % [posts, collars, arms])
	## E. THE PALETTE: every band at its literal ±0.02 + the read laws.
	var literals := {
		"concrete": Color(0.851, 0.824, 0.769),
		"concrete_cap": Color(0.784, 0.753, 0.682),
		"roof": Color(0.30, 0.29, 0.28),
		"steel": Color(0.776, 0.796, 0.824),
		"steel_roof": Color(0.651, 0.675, 0.714),
		"leg": Color(0.34, 0.35, 0.36),
	}
	for part6: Dictionary in parts:
		var band6 := str(part6["band"])
		var got: Color = part6["color"]
		if _color_gap(got, literals[band6]) > 0.02:
			bad.append("band %s color %s != the pinned literal %s" % [band6, got, literals[band6]])
		var wl: float = got.r * 0.299 + got.g * 0.587 + got.b * 0.114
		var sat: float = (maxf(got.r, maxf(got.g, got.b)) - minf(got.r, minf(got.g, got.b))) \
				/ maxf(maxf(got.r, maxf(got.g, got.b)), 1e-6)
		match band6:
			"concrete", "concrete_cap":
				var hue := _hue_deg(got)
				if hue < 30.0 or hue > 70.0:
					bad.append("band %s hue %.0f outside the warm pale law 30..70" % [band6, hue])
				if wl < 0.7:
					bad.append("band %s luminance %.3f < 0.7 — must read pale" % [band6, wl])
				if sat > 0.16:
					bad.append("band %s saturation %.2f > 0.16 — too tinted for concrete" % [band6, sat])
			"steel", "steel_roof":
				if got.b < got.r:
					bad.append("band %s reads warm (b < r) — galvanized must read cool" % band6)
				if sat > 0.12:
					bad.append("band %s saturation %.2f > 0.12 — too tinted for steel" % [band6, sat])
			"roof", "leg":
				if wl > 0.45:
					bad.append("band %s luminance %.3f > 0.45 — must read dark" % [band6, wl])
	var concrete_lum: float = literals["concrete"].r * 0.299 + literals["concrete"].g * 0.587 \
			+ literals["concrete"].b * 0.114
	var cap_lum: float = literals["concrete_cap"].r * 0.299 + literals["concrete_cap"].g * 0.587 \
			+ literals["concrete_cap"].b * 0.114
	if cap_lum >= concrete_lum:
		bad.append("cap rims %.3f not darker than the walls %.3f — the rim read dies" % [cap_lum, concrete_lum])

	## --- F. the meshes + seams, live -------------------------------------------
	var chunk_node := world.get_node_or_null("Chunks/Chunk_13_-1") as Node3D
	if chunk_node == null:
		bad.append("chunk Chunk_13_-1 missing")
	else:
		## The gray family shrank to exactly its non-superseded remainder
		## (the chunk file walked by its tile — the chunk node sits at the
		## tile center, the file grid's own key).
		var ph_mm := chunk_node.get_node_or_null("Placeholders") as MultiMeshInstance3D
		var want_remainder := 0
		for entry3: Dictionary in AmesBaker.read_manifest(AMES_CHUNKS_DIR).get("chunks", []):
			var tile := Vector2i(int(entry3["cx"]), int(entry3["cz"]))
			var tile_center := Vector3(tile.x * 256.0 + 128.0, 0.0, tile.y * 256.0 + 128.0)
			if (chunk_node as Node3D).position.distance_to(tile_center) > 0.5:
				continue
			var doc3: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry3["file"]))
			for ph: Dictionary in doc3.get("placeholders", []):
				if not _is_superseded_t195(str(ph.get("id", ""))):
					want_remainder += 1
		if ph_mm == null:
			if want_remainder > 0:
				bad.append("Chunk_13_-1 lost its placeholder family (%d non-superseded remain)"
						% want_remainder)
		elif ph_mm.multimesh.instance_count != want_remainder:
			bad.append("Chunk_13_-1 placeholder MM %d != the non-superseded remainder %d" % [
					ph_mm.multimesh.instance_count, want_remainder])
		var hero_root := chunk_node.get_node_or_null("HeroElevatorCluster") as Node3D
		if hero_root == null:
			bad.append("no HeroElevatorCluster under Chunk_13_-1")
		else:
			var boxes_mm := hero_root.get_node_or_null("Boxes") as MultiMeshInstance3D
			if boxes_mm == null or boxes_mm.multimesh.instance_count != 12:
				bad.append("Boxes MM %s != the headhouse + roof slab + 10 leg members" % [
						boxes_mm.multimesh.instance_count if boxes_mm != null else -1])
			var want_albedo := {
				"Silo1": literals["concrete"], "Silo2": literals["concrete"],
				"Silo3": literals["concrete"], "Silo4": literals["concrete"],
				"SiloCap1": literals["concrete_cap"], "SiloCap2": literals["concrete_cap"],
				"SiloCap3": literals["concrete_cap"], "SiloCap4": literals["concrete_cap"],
				"Bin1": literals["steel"], "Bin2": literals["steel"],
				"BinRoof1": literals["steel_roof"], "BinRoof2": literals["steel_roof"],
			}
			for mesh_name: String in want_albedo:
				var mesh_node := hero_root.get_node_or_null(mesh_name) as MeshInstance3D
				if mesh_node == null or not (mesh_node.mesh is CylinderMesh):
					bad.append("named mesh %s missing (want a CylinderMesh)" % mesh_name)
					continue
				var mat := (mesh_node.mesh as CylinderMesh).material as StandardMaterial3D
				if mat == null or _color_gap(mat.albedo_color, want_albedo[mesh_name]) > 0.02:
					bad.append("%s albedo %s != the pinned literal" % [
							mesh_node.name if mesh_node != null else mesh_name,
							mesh_name, mat.albedo_color if mat != null else "<null>"])
	var space := get_world_3d().direct_space_state
	var probe := func(from: Vector3, to: Vector3) -> Dictionary:
		var ray := PhysicsRayQueryParameters3D.create(world.to_global(from),
				world.to_global(to))
		ray.collision_mask = 1
		return space.intersect_ray(ray)
	## The silo wall at Ø7 on the east vertex plane (the 8-gon's vertex ring) —
	## probed on the EASTMOST silo from clear eastern air (the bank is a row;
	## a ray at any inner member would answer its eastern neighbor first).
	var silo_c: Vector3 = silos[3]["p"]
	var silo_ray: Dictionary = probe.call(
			Vector3(silo_c.x + 30.0, 17.0, silo_c.z), Vector3(silo_c.x, 17.0, silo_c.z))
	if silo_ray.is_empty():
		bad.append("silo wall ray missed")
	else:
		var sx: float = world.to_local((silo_ray as Dictionary)["position"]).x
		if absf(sx - (silo_c.x + 3.5)) > 0.15:
			bad.append("silo wall x %.2f != Ø7 (±0.15)" % sx)
	## The headhouse east face (the box's own wall — the leg posts beside it
	## are visual-only and must not answer).
	var face_ray: Dictionary = probe.call(
			Vector3(hp.x + 30.0, 20.0, hp.z), Vector3(hp.x, 20.0, hp.z))
	if face_ray.is_empty():
		bad.append("headhouse east face ray missed")
	else:
		var fx: float = world.to_local((face_ray as Dictionary)["position"]).x
		if absf(fx - (hp.x + hs.x * 0.5)) > 0.05:
			bad.append("headhouse east face x %.2f != the slot wall %.2f (±0.05)" % [
					fx, hp.x + hs.x * 0.5])
	## The bin wall at Ø5 (the EAST bin, from clear eastern air — same row
	## law) + the cone slope over the frustum read (down at r 2.0 on the west
	## bin: the taper 2.5→0.25 over 10.4..12 lands the surface at 10.756).
	var bin_c: Vector3 = bins[1]["p"]
	var bin_ray: Dictionary = probe.call(
			Vector3(bin_c.x + 20.0, 5.0, bin_c.z), Vector3(bin_c.x, 5.0, bin_c.z))
	if bin_ray.is_empty():
		bad.append("bin wall ray missed")
	else:
		var bx: float = world.to_local((bin_ray as Dictionary)["position"]).x
		if absf(bx - (bin_c.x + 2.5)) > 0.15:
			bad.append("bin wall x %.2f != Ø5 (±0.15)" % bx)
	var cone_ray: Dictionary = probe.call(
			Vector3(bin_c.x + 2.0, 20.0, bin_c.z), Vector3(bin_c.x + 2.0, 8.0, bin_c.z))
	if cone_ray.is_empty():
		bad.append("bin cone ray missed")
	else:
		var cy: float = world.to_local((cone_ray as Dictionary)["position"]).y
		if absf(cy - 10.756) > 0.1:
			bad.append("bin cone y %.2f != the frustum read 10.756 (±0.1)" % cy)
	## The leg tower visual-only: the crown arm's line and the post line
	## answer NOTHING (the thin-member law).
	var arm_ray: Dictionary = probe.call(
			Vector3(leg_x, leg_top - 0.6, hp.z - 6.0),
			Vector3(leg_x, leg_top - 0.6, hp.z - 2.0))
	if not arm_ray.is_empty():
		bad.append("leg crown arm answered a ray — the lattice must stay visual-only")
	var post_ray: Dictionary = probe.call(
			Vector3(leg_x - 0.8, 20.0, hp.z - 6.0), Vector3(leg_x - 0.8, 20.0, hp.z + 2.5))
	if not post_ray.is_empty():
		bad.append("leg post line answered a ray — the lattice must stay visual-only")
	## The walk-parity ground record: the slot's own answers survive the swap
	## byte-identically (silos 34, headhouse 38, bins 12).
	var ground_pins := [[silos[1]["p"], (silos[1]["s"] as Vector3).y],
			[hp, hs.y], [bins[0]["p"], (bins[0]["s"] as Vector3).y],
			[bins[1]["p"], (bins[1]["s"] as Vector3).y]]
	for gp: Array in ground_pins:
		var gpos: Vector3 = gp[0]
		var want_top: float = gp[1]
		var gh := world.ground_height(world.to_global(gpos))
		if absf(gh - want_top) > 0.05:
			bad.append("ground record answers %.2f at (%.1f, %.1f) != the slot's own %.1f"
					% [gh, gpos.x, gpos.z, want_top])
	## No roof crumb filed (the slot never carried one — the swap files none).
	if world._hero_roof_tops.has(SLOT_ID):
		bad.append("roof crumb filed for %s — the slot never carried one" % SLOT_ID)
	_check(S, bad.is_empty(),
		"parts=%d bank=(%.1f, %.1f) band=[30, 40] union_top=%.1f slot_top=%.1f; %s"
		% [parts.size(), bank_center.x, bank_center.y, hi.y, hs.y, "; ".join(bad)])
	world.queue_free()


## (T-195) The scenario-local supersede mirror — the id the cluster's hero
## retires, walked against the runtime placeholder MM (the world's own
## `_row_superseded_placeholder` covers the other heroes too; the remainder
## arm here counts only the elevator slot so the chunk file walk stays local).
func _is_superseded_t195(id: String) -> bool:
	return id == "grain_elevators"


## (T-204) The Reiman Gardens south-gate set piece — the QA item 1 split made
## STRUCTURAL and the town's garden gate landed. Legs re-derived from the
## committed pack + bake + the live world, never echoed:
## A. THE DATA — the conservatory's own OSM way (way/180765068, named) is
##    in-core, authored, at the WHOLE-building dims (58.7 × 87.8 m, QA item
##    1: 59 × 88 m the survey's rounding; the 465 m² Hughes glasshouse is a
##    DISTINCT volume, never this footprint); the gardens' 73,202 m² park way
##    + the Reiman Gardens POI both flipped in_core with the v3 bbox south,
##    and the strip's vet-med context mass is present by name;
## B. THE SUPERSEDE — the way joins the bake's HERO_BUILDING_IDS law (the
##    manifest `heroes` list names it, the slot massing still flagged `a` at
##    the pack centroid — the T-203 bandshell-way pattern);
## C. THE HERO — the 58.7 × 87.8 × 10.0 glass envelope at the slot's own
##    center, the wing-form roof massing over it (four glass bands + the
##    spine crown at 14.0 m — photo 11's faceted-wing read, model-to-look),
##    and the NAMED Hughes glasshouse volume: a live mesh node standing
##    31.0 × 15.0 m (= 465 m² exactly) INSIDE the envelope with its own part
##    record — the split is structural or the QA's ~11× oversize read
##    returns;
## D. THE CANOPY — the butterfly-wing entrance canopy at the ticket's
##    recorded estimate (two swept shells + spine + two posts over the east
##    arrival walk; LANDMARKS C10 pins NO sourced dimension — the estimate
##    is the deliverable, typed here as the second recording, UNVERIFIED per
##    V-30);
## E. THE ACCENTS — exactly 8 butterflies (≤ 12, the ticket's count law),
##    every one a live Butterfly node with NO collision anywhere under its
##    root (the ambient-only law), hovering the pinned entrance-bed ring;
## F. THE SLOT — the T-201 plaque placed on the hero's east face (the text
##    byte-exact, the mount on the envelope's arrival side — the full mount
##    law rides `campus_plaques_pins`);
## G. PLAYABLE — the ground record answers the envelope top at the building,
##    the spine ridge at the crown strip, the plate at the arrival walk, and
##    the gardens lawn bakes under the entrance beds.
func _scenario_reiman_gardens_dims() -> void:
	const S := "reiman_gardens_dims"
	var bad: PackedStringArray = PackedStringArray()
	const WAY_ID := "way/180765068"

	## --- A. the pack legs -----------------------------------------------------
	var cons: Dictionary = {}
	var wing_bld: Dictionary = {}
	for b: Dictionary in AmesDataPack.buildings():
		if str(b.get("id", "")) == WAY_ID:
			cons = b
		elif str(b.get("id", "")) == "way/479976960":
			wing_bld = b
	if cons.is_empty():
		_check(S, false, "the conservatory way is not in the pack")
		return
	if str(cons.get("name", "")) != "Reiman Gardens Conservatory":
		bad.append("pack name '%s' want the named whole building" % str(cons.get("name")))
	## Buildings carry no in_core flag — the strip membership derives from
	## the centroid against the meta box (the pack's own rule).
	var meta_box: Array = AmesDataPack.meta().get("core_bbox_wsen", [])
	var cons_wgs: Array = cons.get("wgs84", [])
	if cons_wgs.size() < 2 or not (
			float(cons_wgs[0]) >= float(meta_box[0])
			and float(cons_wgs[0]) <= float(meta_box[2])
			and float(cons_wgs[1]) >= float(meta_box[1])
			and float(cons_wgs[1]) <= float(meta_box[3])):
		bad.append("conservatory centroid %s outside the core box %s — the "
				+ "v3 bbox south never landed" % [str(cons_wgs), str(meta_box)])
	if str(cons.get("class", "")) != "authored":
		bad.append("conservatory class '%s' want authored" % str(cons.get("class")))
	## The QA-split whole-building dims: 58.7 × 87.8 m bbox (59 × 88 the
	## survey's rounding — the ±2 m hero-dims band), h 10, one level.
	var dims: Array = cons.get("bbox_m", [0.0, 0.0])
	if absf(float(dims[0]) - 58.7) > 0.05 or absf(float(dims[1]) - 87.8) > 0.05:
		bad.append("conservatory bbox %s want [58.7, 87.8]" % str(dims))
	if absf(float(cons.get("height_m", 0.0)) - 10.0) > 0.01:
		bad.append("conservatory height %s want the OSM 10" % str(cons.get("height_m")))
	var cons_c := Vector2(float(cons["centroid"][0]), float(cons["centroid"][1]))
	## The named glasshouse and the wing building stay DISTINCT slots nearby
	## (the split's data side: the 465 m² named range is never the 59 × 88
	## footprint; the Christina Reiman Butterfly Wing building is its own
	## authored mass next door).
	if wing_bld.is_empty() or str(wing_bld.get("name", "")) != "Christina Reiman Butterfly Wing":
		bad.append("the butterfly-wing building slot missing from the pack")
	var gardens_park: Dictionary = {}
	for p: Dictionary in AmesDataPack.parks():
		if str(p.get("name", "")) == "Reiman Gardens":
			gardens_park = p
			break
	if gardens_park.is_empty():
		bad.append("the Reiman Gardens park way missing from the pack")
	elif absf(float(gardens_park.get("area_m2", 0.0)) - 73202.0) > 1.0:
		bad.append("gardens park area %s want 73202 m2" % str(gardens_park.get("area_m2")))
	var gardens_poi := Vector2.ZERO
	for poi: Dictionary in AmesDataPack.landmarks():
		if str(poi.get("id", "")) == "reiman_gardens":
			if not bool(poi.get("in_core", false)):
				bad.append("reiman_gardens POI still in_core false")
			gardens_poi = Vector2(float(poi["position"][0]), float(poi["position"][1]))
	if gardens_poi == Vector2.ZERO:
		bad.append("reiman_gardens landmark POI missing")
	## The vet-med context mass (the strip's named set, measured): four
	## named buildings carry "Veterinar", the big two at their bbox dims.
	var vet_named: Array[Dictionary] = []
	for b2: Dictionary in AmesDataPack.buildings():
		if str(b2.get("name", "")).contains("Veterinar"):
			vet_named.append(b2)
	if vet_named.size() != 4:
		bad.append("vet-named context %d want 4" % vet_named.size())
	for b3: Dictionary in vet_named:
		var nm := str(b3.get("name", ""))
		var vd: Array = b3.get("bbox_m", [0.0, 0.0])
		if nm == "Veterinary Medicine" \
				and (absf(float(vd[0]) - 264.6) > 0.2 or absf(float(vd[1]) - 246.4) > 0.2):
			bad.append("Vet Med mass bbox %s want [264.6, 246.4]" % str(vd))
		if nm == "Lloyd Veterinary Medical Center" \
				and (absf(float(vd[0]) - 154.2) > 0.2 or absf(float(vd[1]) - 153.2) > 0.2):
			bad.append("Lloyd VMC bbox %s want [154.2, 153.2]" % str(vd))

	## --- B. the bake legs (the supersede 1:1) ---------------------------------
	var manifest: Dictionary = AmesBaker.read_manifest(AMES_CHUNKS_DIR)
	if not (manifest.get("heroes", []) as Array).has(WAY_ID):
		bad.append("manifest heroes missing %s — the supersede never joined" % WAY_ID)
	var slot: Dictionary = {}
	var lawn_tile := Vector2i(-999, -999)
	## (Round 2) The bake masses flanking the arrival walk — the clearance
	## law's independent subjects (the v1 canopy station buried itself in
	## the Wing box; these boxes are the regression guard's subjects).
	var neighbor_boxes: Array[Dictionary] = []
	for entry: Dictionary in manifest.get("chunks", []):
		var doc: Dictionary = AmesBaker.read_chunk(AMES_CHUNKS_DIR, str(entry["file"]))
		for m: Dictionary in doc.get("massing", []):
			if str(m.get("id", "")) == WAY_ID:
				slot = m
			elif str(m.get("id", "")) in ["way/479976960", "way/180765069"]:
				var np: Array = m.get("p", [0.0, 0.0, 0.0])
				var ns: Array = m.get("s", [0.0, 0.0, 0.0])
				neighbor_boxes.append({
					"id": str(m.get("id", "")),
					"box": AABB(Vector3(float(np[0]) - float(ns[0]) * 0.5,
							float(np[1]) - float(ns[1]) * 0.5,
							float(np[2]) - float(ns[2]) * 0.5),
							Vector3(float(ns[0]), float(ns[1]), float(ns[2]))),
				})
		## The gardens lawn: the tile under the POI (the pack's own tile law)
		## carries the park flat.
		var px := gardens_poi.x
		var pz := gardens_poi.y
		if Vector2i(floori(px / 256.0), floori(pz / 256.0)) \
				== Vector2i(int(entry["cx"]), int(entry["cz"])):
			lawn_tile = Vector2i(int(entry["cx"]), int(entry["cz"]))
			if (doc.get("lawn_tris", []) as Array).is_empty():
				bad.append("tile (%d,%d) paints no gardens lawn" % [lawn_tile.x, lawn_tile.y])
	if neighbor_boxes.size() != 2:
		bad.append("neighbor masses %d want the Wing + Mahlstede boxes"
				% neighbor_boxes.size())
	if slot.is_empty():
		bad.append("the conservatory slot massing missing from the bake")
	else:
		if not bool(slot.get("a", false)):
			bad.append("the conservatory slot lost its authored flag")
		var sp: Array = slot.get("p", [0.0, 0.0, 0.0])
		if absf(float(sp[0]) - cons_c.x) > 0.05 or absf(float(sp[2]) - cons_c.y) > 0.05:
			bad.append("slot center %s off the pack centroid %s" % [str(sp), str(cons_c)])
		var ss: Array = slot.get("s", [0.0, 0.0, 0.0])
		if absf(float(ss[0]) - 58.7) > 0.05 or absf(float(ss[2]) - 87.8) > 0.05:
			bad.append("slot size %s want the 58.7 × 87.8 bbox" % str(ss))

	## --- C+D+E+F. the hero, the canopy, the accents, the plaque ---------------
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
	world.position = AMES_WORLD_OFFSET
	add_child(world)
	await get_tree().physics_frame
	var parts := world.gardens_hero_parts
	if parts.is_empty():
		_check(S, false, "no retained gardens parts — the hero never built")
		world.queue_free()
		return
	## C. the envelope: the whole building at the slot's own dims, blue glass.
	var wall_lo := Vector3(INF, INF, INF)
	var wall_hi := Vector3(-INF, -INF, -INF)
	var wall_n := 0
	var roof_bands := 0
	var roof_hi := -INF
	var canopy_lo := Vector3(INF, INF, INF)
	var canopy_hi := Vector3(-INF, -INF, -INF)
	var shell_lo_y := INF
	var canopy_shells := 0
	var canopy_posts := 0
	var gh_record: Dictionary = {}
	for part: Dictionary in parts:
		var p: Vector3 = part["p"]
		var s: Vector3 = part["s"]
		match str(part["band"]):
			"glass_wall":
				wall_n += 1
				wall_lo = (p - s * 0.5).min(wall_lo)
				wall_hi = (p + s * 0.5).max(wall_hi)
			"roof_glass":
				roof_bands += 1
				roof_hi = maxf(roof_hi, (p + s * 0.5).y)
			"canopy_glass":
				canopy_shells += 1
				canopy_lo = (p - s * 0.5).min(canopy_lo)
				canopy_hi = (p + s * 0.5).max(canopy_hi)
				shell_lo_y = minf(shell_lo_y, (p - s * 0.5).y)
			"canopy_frame":
				canopy_posts += 1
				canopy_lo = (p - s * 0.5).min(canopy_lo)
				canopy_hi = (p + s * 0.5).max(canopy_hi)
			"glasshouse":
				gh_record = part
			_:
				pass
	if wall_n != 1:
		bad.append("glass_wall bands %d want exactly the one envelope" % wall_n)
	var wall_size := wall_hi - wall_lo
	if absf(wall_size.x - 58.7) > 0.2 or absf(wall_size.z - 87.8) > 0.2:
		bad.append("envelope %.1f × %.1f m want the whole 59 × 88 building (QA split)" % [wall_size.x, wall_size.z])
	if absf(wall_size.y - 10.0) > 0.05:
		bad.append("envelope height %.2f want the OSM 10" % wall_size.y)
	var wall_center := (wall_lo + wall_hi) * 0.5
	if Vector2(wall_center.x, wall_center.z).distance_to(cons_c) > 0.1:
		bad.append("envelope center %s off the slot's own centroid %s" % [wall_center, cons_c])
	## The wing roof: four glass bands step down each way of the spine; the
	## glass crown reads just under the ridge (the faceted AABB read, 14.09
	## measured), the frame spine cap carries the 14.3 crown exactly — above
	## the walls (the silhouette law), below any honest storey.
	if roof_bands != 4:
		bad.append("roof glass bands %d want the 2 × 2 faceted wing" % roof_bands)
	if roof_hi < 13.9 or roof_hi > 14.2:
		bad.append("glass roof crown %.2f outside the faceted read [13.9, 14.2]" % roof_hi)
	var cap_top := -INF
	for part7: Dictionary in parts:
		if str(part7["band"]) == "spine_frame":
			cap_top = maxf(cap_top, (part7["p"] as Vector3).y
					+ (part7["s"] as Vector3).y * 0.5)
	if absf(cap_top - 14.3) > 0.05:
		bad.append("spine cap crown %.2f want the ridge 14.3" % cap_top)
	## The named Hughes glasshouse volume: the QA split made structural.
	var hero_root := world.get_node_or_null("Chunks/Chunk_3_4/HeroReimanGardens") as Node3D
	if hero_root == null:
		bad.append("HeroReimanGardens not under its carrier chunk (3, 4)")
	else:
		var gh_node := hero_root.get_node_or_null("HughesGlasshouse") as MeshInstance3D
		if gh_node == null:
			bad.append("the Hughes glasshouse volume missing from the scene tree")
		elif gh_record.is_empty():
			bad.append("the glasshouse carries no part record")
		else:
			var gh_size: Vector3 = gh_record["s"]
			var gh_area := gh_size.x * gh_size.z
			if absf(gh_area - 465.0) > 0.5:
				bad.append("glasshouse footprint %.1f m2 want the named 465 (QA item 1)" % gh_area)
			if absf(gh_size.y - 10.0) > 0.05:
				bad.append("glasshouse height %.2f want the full interior" % gh_size.y)
			## Contained: the split lives INSIDE the whole building.
			var gh_box := AABB(gh_record["p"] - gh_size * 0.5, gh_size)
			var env_box := AABB(wall_lo, wall_size)
			if not env_box.encloses(gh_box):
				bad.append("glasshouse volume escapes the envelope — the split broke")
	## D. the canopy at the recorded estimate (the ticket's numbers, typed
	## here as the second recording — LANDMARKS C10 pins no sourced span):
	## span 14.63 E–W, spine 7.03 top, eaves 4.2, two shells on two posts.
	if canopy_shells != 2 or canopy_posts != 3:
		bad.append("canopy schedule %d shells / %d frame parts want 2 shells / cap + 2 posts"
				% [canopy_shells, canopy_posts])
	else:
		var canopy_span := canopy_hi.x - canopy_lo.x
		if absf(canopy_span - 14.63) > 0.06:
			bad.append("canopy span %.2f want the recorded 14.63 estimate" % canopy_span)
		var canopy_top := canopy_hi.y
		if absf(canopy_top - 7.03) > 0.06:
			bad.append("canopy top %.2f want the recorded 7.03 estimate" % canopy_top)
		if shell_lo_y < 3.5:
			bad.append("canopy eaves %.2f below the recorded 4.2 walk clearance" % shell_lo_y)
		## (Round 2) THE CLEARANCE LAW: the set piece stands on the OPEN walk
		## — the shells' z span sits inside the gap between the Wing box's
		## south face (1233.56) and the Mahlstede box's north face (1250.07),
		## and NO canopy part intersects a flanking bake mass (the v1 station
		## buried the posts + spine + the north 5.48 m of the shells inside
		## the Wing box — the regression this leg pins).
		if canopy_lo.z <= 1233.56:
			bad.append("canopy north edge %.2f inside the Wing box's south face "
					+ "1233.56 — the set piece is buried" % canopy_lo.z)
		if canopy_hi.z >= 1250.07:
			bad.append("canopy south edge %.2f inside the Mahlstede box's north "
					+ "face 1250.07 — the set piece is buried" % canopy_hi.z)
		for nb2: Dictionary in neighbor_boxes:
			var mass_box: AABB = nb2["box"]
			var canopy_box := AABB(canopy_lo, canopy_hi - canopy_lo)
			if canopy_box.intersects(mass_box):
				bad.append("canopy intersects the %s bake mass — the set piece "
						+ "is buried" % str(nb2["id"]))
	## E. the accents: exactly 8, ambient only, on the pinned ring.
	if world.butterflies.size() != 8:
		bad.append("butterfly accents %d want exactly 8 (the ≤ 12 count law)" % world.butterflies.size())
	var bfly_root := world.get_node_or_null("ReimanButterflies") as Node3D
	if bfly_root == null:
		bad.append("no ReimanButterflies root")
	else:
		var accent_nodes := 0
		for c: Node in bfly_root.get_children():
			if c is Butterfly:
				accent_nodes += 1
		if accent_nodes != 8 or bfly_root.get_child_count() != 8:
			bad.append("accent root carries %d Butterfly of %d children" % [accent_nodes, bfly_root.get_child_count()])
		for co: Node in _find_type(bfly_root, "CollisionObject3D"):
			bad.append("accent %s carries collision — the ambient-only law" % co.name)
		for rec: Dictionary in world.butterflies:
			var node: Butterfly = rec["node"]
			if node == null or not is_instance_valid(node):
				bad.append("a butterfly record's node is gone")
				continue
			if Vector2(node.home.x, node.home.z).distance_to(Vector2(1028.0, 1310.0)) > 22.5:
				bad.append("butterfly home %s off the entrance-bed ring" % str(node.home))
			if node.home.y < 0.5 or node.home.y > 3.0:
				bad.append("butterfly hover y %.2f off the bed read" % node.home.y)
	## F. the reserved plaque slot, placed: the text byte-exact, the mount on
	## the arrival face (the full mount law lives in campus_plaques_pins).
	var reiman_plaque: Dictionary = {}
	for rec2: Dictionary in world.campus_plaques:
		if str(rec2.get("id", "")) == "reiman_gardens":
			reiman_plaque = rec2
	if reiman_plaque.is_empty():
		bad.append("the Reiman plaque never placed — the reserved slot stayed staged")
	else:
		if str(reiman_plaque.get("text", "")) != "Reiman Gardens — 1995":
			bad.append("plaque text '%s' want 'Reiman Gardens — 1995'" % str(reiman_plaque.get("text")))
		var pp: Vector3 = reiman_plaque["pos"]
		if pp.x < wall_hi.x:
			bad.append("plaque %.2f not proud of the arrival face %.2f" % [pp.x, wall_hi.x])
		## (Round 2) The station moved onto the open-walk bay (1241.5) — the
		## v1 station (1233.08) stood inside the Butterfly Wing bake box.
		if pp.distance_to(Vector3(984.41, 2.6, 1241.5)) > 0.05:
			bad.append("plaque mount %s off the pinned east-face station" % str(pp))
		## The slab reads over open air: it must not sit inside any NEIGHBOR
		## bake mass (the Butterfly Wing's box buried the v1 mount).
		var slab_aabb := AABB(pp - Vector3(0.05, 0.3, 1.4),
				Vector3(0.1, 0.6, 2.8))
		for nb: Dictionary in neighbor_boxes:
			if slab_aabb.intersects(nb["box"] as AABB):
				bad.append("plaque slab intersects the %s bake mass — the "
						+ "mount is buried again" % str(nb["id"]))
	## G. playable: the roof answers the envelope top (off the ridge strip),
	## the ridge the crown, the arrival walk the plate; the hero roof crumb
	## moved to the spine.
	var gh_envelope := world.ground_height(world.to_global(
			Vector3(cons_c.x + 12.0, 0.0, cons_c.y + 20.0)))
	if absf(gh_envelope - 10.0) > 0.05:
		bad.append("ground answers %.2f on the roof span — want the walkable 10.0" % gh_envelope)
	if absf(world.ground_height(world.to_global(Vector3(cons_c.x, 0.0, cons_c.y))) - 14.3) > 0.05:
		bad.append("ground does not answer the 14.3 ridge strip")
	if absf(world.ground_height(world.to_global(Vector3(992.0, 0.0, 1240.5)))) > 0.05:
		bad.append("the arrival walk does not answer the plate")
	var crumb: Variant = world._hero_roof_tops.get(WAY_ID)
	if crumb == null or absf((crumb as Vector3).y - 14.3) > 0.05:
		bad.append("roof crumb %s want the spine crown 14.3" % str(crumb))
	## The world report keys.
	var report: Dictionary = world.last_report
	if int(report.get("gardens_parts", -1)) != parts.size():
		bad.append("report gardens_parts %s != the %d records"
				% [str(report.get("gardens_parts")), parts.size()])
	if int(report.get("butterflies", -1)) != 8:
		bad.append("report butterflies %s want 8" % str(report.get("butterflies")))
	_check(S, bad.is_empty(),
		"parts=%d envelope=%.1fx%.1f ridge=%.1f glasshouse=%s butterflies=%d; %s"
		% [parts.size(), wall_size.x, wall_size.z, roof_hi,
		str(gh_record.get("s", Vector3.ZERO)), world.butterflies.size(),
		"; ".join(bad)])
	world.queue_free()


## Depth-first collect of live nodes whose class matches `klass` (the
## ambient-only law's read over a subtree).
func _find_type(root: Node, klass: String) -> Array[Node]:
	var out: Array[Node] = []
	for c: Node in root.get_children():
		if c.is_class(klass):
			out.append(c)
		out.append_array(_find_type(c, klass))
	return out


## (T-196) The R3 cutover's swap-set proof — the ring's own enforcement
## moment (the ticket's What item 1): every R3 hero ticket's slot is
## SWAPPED — the hero built live at its position, the gray stack retired —
## and ZERO orphan placeholders remain at hero positions, while the
## authored-but-not-yet-hero massing stays as honest LOD0. The RING SLOT
## TABLE below is the authority, derived verbatim from the ring's ticket
## list T-185..T-195 (each hero's slot id(s) + kind + retained record), NOT
## from the world's own law — the identity arms compare the world's
## supersede law AGAINST this table, so a future hero ticket that forgets
## to join the law fails here by name and an over-broad law that silently
## retires an honest gray box fails the same night:
## A. THE TABLE WALK — every placeholder-kind slot id has baked parts (the
##    slot existed to swap — a vacuous swap fails) and every massing-kind
##    slot id has its authored bbox slot in the bake;
## B. THE SUPERSEDE IDENTITY — the world's `_row_superseded_placeholder`
##    answers true for EXACTLY the table's placeholder ids across every
##    placeholder id the bake carries (the 11 venue fixups stay LOD0), and
##    the massing skip set (`_hero_ids`) is exactly the bake's own `heroes`
##    list plus the table's runtime massing ids — every other authored
##    building still renders, and no skipped id falls outside the authored
##    set (a stale skip);
## C. THE LIVE BUILD — every table row's retained record is non-empty (the
##    hero mounted on the resident world), and the ring's non-slot heroes
##    are live too: the two swans (T-185), the campus lawn's slab + fountain
##    (T-187), the tailgate lot dress (T-191), the 9-crossbuck pin set + the
##    coal drag (T-194);
	## D. THE POSITION — each hero's record union AABB stands on its slot's
	##    union AABB (centers within the row's tolerance). Shared records
	##    filter to the row's own hero via the parts' `hero` key; the
	##    bandshell carries the 40 m tolerance for its ticketed ~35 m
	##    true-position re-shape (T-192's documented exception) and the
	##    stadium its measured asymmetric-reshape band (the press tower,
	##    videoboard, statue and hillside wedges the hero adds beyond the
	##    ring's symmetric slot) — no hero wandered off its slot, no gray
	##    stack left standing where the hero should read;
	## E. THE BUDGET CROSS-CHECK — the superseded placeholder part count this
	##    table derives is exactly 94, the skipped massing set exactly 15 ids
	##    (the bake's own 10 — the 8 ring slots + the T-203 bandshell way +
	##    the T-204 conservatory way — + the ring's 5 runtime massing slots),
	##    and their render-budget cross-foot — 94 parts + the 5 runtime-massing
	##    boxes, with the bake's hero bboxes riding `hero_count` — equals the
	##    hand-counted subtraction 99 in `ames_world_render_budget`; the
	##    surviving placeholder family is exactly the 11 named venue fixups.
	##    The per-ticket hand counts re-derived from the ring table in one
	##    place, so a future hero ticket that retires a slot without
	##    re-deriving the budget fails here.
func _scenario_r3_cutover_swap_set() -> void:
	const S := "r3_cutover_swap_set"
	const RING := [
