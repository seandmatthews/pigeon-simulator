	if park_lawns < 1:
		bad.append("chunk (13,−2) carries no lawn_tris — the park lawn is unpainted")

	# --- leg 3: playable (ground, collision cover, bread reach) -----------
	var world := AMES_WORLD_SCENE.instantiate() as AmesWorld
