	return [
		_city._corner_paint_xfs.duplicate(),
		_city._corner_stop_line_xfs.duplicate(),
		_city._corner_post_xfs.duplicate(),
		_city._corner_red_xfs.duplicate(),
		_city._corner_border_xfs.duplicate(),
