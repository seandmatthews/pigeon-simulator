# Godot 4 imported cache — never commit
.godot/

# Godot mono / C# (we don't use it, but keep it out just in case)
.mono/
data_*/
mono_crash.*.json

# Translations generated from CSV files
*.translation

# Exported builds
build/
export/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor cruft
*.tmp
*.bak

# Capture runs (agent playtesting)
.captures/

# Editor-side godot-mcp wiring (T-020 worktree): project.godot references the
# MCPRuntimeProbe autoload, so every checkout needs the directory on disk, but
# the addon itself is per-machine tooling — untracked, like the .captures runs.
addons/godot_mcp/
