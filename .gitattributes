* text=auto
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.glb binary
*.gltf binary

# Shell scripts must stay LF everywhere — CRLF breaks bash (deploy script)
*.sh text eol=lf

# The Ames data pack must survive checkout BYTE-identically — the T-171
# gate re-runs tools/ames_distill.py and compares bytes against this file
# (the distiller writes LF; autocrlf=true would otherwise check it out CRLF)
data/ames/ames_core.json text eol=lf

# The Ames chunk bake must survive checkout BYTE-identically — the T-172
# determinism gate compares SHA-256s of these files against the committed
# manifest (the bake writes LF; autocrlf=true would otherwise break the hash
# on the next checkout)
data/ames/chunks/*.json text eol=lf
